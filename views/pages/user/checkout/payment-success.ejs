<%- include('../../../partials/header') %>

<main class="bg-[#F8F9FA] min-h-screen py-16 font-sans">
  <div class="max-w-2xl mx-auto px-4">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12 text-center relative overflow-hidden">
      <!-- Decorative background element -->
      <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-500"></div>
      
      <!-- Success Icon -->
      <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Payment Successful!</h1>
      <p class="text-gray-500 text-lg mb-8">Thank you for your purchase. Your transaction was completed successfully and you are now enrolled.</p>

      <div class="bg-gray-50 rounded-xl p-6 mb-8 text-left">
        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-4">Order Details</h3>
        
        <div class="flex justify-between items-center mb-3">
          <span class="text-gray-600 font-medium">Order ID</span>
          <span class="text-[#0B5ED7] font-bold text-sm bg-blue-50 border border-blue-100 px-2 py-1 rounded"><%= order.orderId %></span>
        </div>
        
        <div class="flex justify-between items-center mb-3">
          <span class="text-gray-600 font-medium">Date</span>
          <span class="text-gray-900 font-medium"><%= new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
        </div>
        
        <div class="flex justify-between items-center mb-3">
          <span class="text-gray-600 font-medium">Payment ID</span>
          <span class="text-gray-900 font-mono text-sm bg-gray-200 px-2 py-1 rounded"><%= order.razorpayPaymentId %></span>
        </div>

        <div class="border-t border-gray-200 my-4"></div>

        <h4 class="text-sm font-bold text-gray-900 mb-3">Purchased Courses</h4>
        <ul class="space-y-2 mb-4">
          <% if (order.courses && order.courses.length > 0) { %>
            <% order.courses.forEach(course => { %>
              <li class="flex items-start text-sm">
                <svg class="w-4 h-4 text-green-500 mr-2 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span class="text-gray-700 font-medium"><%= course.title %></span>
              </li>
            <% }) %>
          <% } %>
        </ul>

        <div class="border-t border-gray-200 my-4"></div>

        <div class="space-y-2 mb-4 text-sm text-gray-600">
          <div class="flex justify-between">
            <span>Subtotal</span>
            <span class="font-medium text-gray-900">₹<%= order.subtotal.toFixed(2) %></span>
          </div>
          <% if (order.courseDiscount > 0) { %>
            <div class="flex justify-between">
              <span>Course Discount</span>
              <span class="font-medium text-green-600">-₹<%= order.courseDiscount.toFixed(2) %></span>
            </div>
          <% } %>
          <% if (order.couponDiscount > 0) { %>
            <div class="flex justify-between">
              <span>Coupon Discount</span>
              <span class="font-medium text-green-600">-₹<%= order.couponDiscount.toFixed(2) %></span>
            </div>
          <% } %>
        </div>

        <div class="border-t border-gray-200 my-4"></div>

        <div class="flex justify-between items-center">
          <span class="text-gray-800 font-bold text-lg">Total Paid</span>
          <span class="text-blue-600 font-extrabold text-2xl">₹<%= order.finalAmount.toFixed(2) %></span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/user/my-courses" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-full transition-colors flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          Go to My Courses
        </a>
        <a href="/user/orders/<%= order._id %>/invoice" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold py-3 px-8 rounded-full transition-colors flex items-center justify-center gap-2 border border-indigo-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          Download Invoice
        </a>
        <a href="/" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 px-8 rounded-full transition-colors text-center">
          Browse More Courses
        </a>
      </div>

    </div>
  </div>
</main>

<%- include('../../../partials/footer') %>
