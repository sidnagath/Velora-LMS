<%- include('../../../partials/header') %>

<main style="background-color: #f8f9fa; min-height: 100vh; padding-bottom: 4rem;">
  <style>
    /* BYPASS UNCOMPILED TAILWIND FOR LAYOUT */
    .checkout-container {
      display: flex;
      flex-direction: column;
      gap: 4rem;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1.5rem;
      font-family: inherit;
    }
    @media (min-width: 1024px) {
      .checkout-container {
        flex-direction: row;
        align-items: flex-start;
      }
    }
    .checkout-left {
      width: 100%;
    }
    @media (min-width: 1024px) {
      .checkout-left {
        width: 55%;
        padding-right: 2rem;
      }
    }
    .checkout-right {
      width: 100%;
    }
    @media (min-width: 1024px) {
      .checkout-right {
        width: 45%;
        position: sticky;
        top: 6rem;
      }
    }

    .payment-card {
      background: white;
      border: 2px solid #f3f4f6;
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      cursor: pointer;
      transition: all 0.2s;
      margin-bottom: 1rem;
    }
    .payment-card.active {
      border-color: #0B5ED7;
      background-color: #ffffff;
      box-shadow: 0 4px 6px -1px rgba(11, 94, 215, 0.1);
    }
    .payment-icon-box {
      width: 3rem;
      height: 3rem;
      border-radius: 0.5rem;
      background-color: #e8f0fe;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #0B5ED7;
    }
    
    .summary-card {
      background: white;
      border-radius: 1.5rem;
      padding: 2.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }
    .course-item {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .course-thumb {
      width: 60px;
      height: 60px;
      border-radius: 0.5rem;
      object-fit: cover;
      background-color: #e5e7eb;
    }
  </style>

  <div class="checkout-container">
    <% 
      let calcSubtotal = 0;
      let calcCourseDiscount = 0;
      let calcCouponDiscount = typeof couponDiscount !== 'undefined' ? couponDiscount : 0;
      
      if (typeof cart !== 'undefined' && cart.length > 0) {
        cart.forEach(course => {
          const bPrice = course.basePrice || course.price || 0;
          const dPrice = course.discountPrice > 0 ? course.discountPrice : bPrice;
          
          calcSubtotal += bPrice;
          calcCourseDiscount += (bPrice - dPrice);
        });
      }
      
      let calcCartSubtotal = calcSubtotal - calcCourseDiscount;
      if (calcCouponDiscount > calcCartSubtotal) calcCouponDiscount = calcCartSubtotal;
      let calcTaxable = calcCartSubtotal - calcCouponDiscount;
      if (calcTaxable < 0) calcTaxable = 0;
      let calcGst = calcTaxable * 0.18;
      let calcTotal = calcTaxable + calcGst;
    %>
    <!-- LEFT SECTION: PAYMENT -->
    <div class="checkout-left">
      <h1 style="font-size: 2.25rem; font-weight: 800; color: #111827; margin-bottom: 0.5rem; letter-spacing: -0.025em;">Secure Checkout</h1>
      <p style="color: #6b7280; font-size: 1rem; margin-bottom: 3rem;">Complete your purchase to start your learning journey immediately.</p>

      <h3 style="font-size: 1.125rem; font-weight: 700; color: #111827; margin-bottom: 1.5rem;">Select Payment Method</h3>

      <form id="checkout-form" action="/api/v1/user/order" method="POST">
        
        <!-- RAZORPAY -->
        <label class="payment-card <%= typeof selectedPaymentMethod !== 'undefined' && selectedPaymentMethod === 'razorpay' ? 'active' : 'active' %>">
          <input type="radio" name="paymentMethod" value="razorpay" checked style="display: none;">
          <div class="payment-icon-box">
            <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
          </div>
          <div>
            <h4 style="font-weight: 700; color: #111827; font-size: 1rem; margin: 0;">Razorpay</h4>
            <p style="color: #6b7280; font-size: 0.875rem; margin: 0;">UPI, Cards, and Netbanking</p>
          </div>
        </label>

        <!-- PAYPAL (COMMENTED OUT / HIDDEN FOR FUTURE) -->
        <!--
        <label class="payment-card">
          <input type="radio" name="paymentMethod" value="paypal" style="display: none;">
          <div class="payment-icon-box">
            <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div>
            <h4 style="font-weight: 700; color: #111827; font-size: 1rem; margin: 0;">PayPal</h4>
            <p style="color: #6b7280; font-size: 0.875rem; margin: 0;">Faster, safer way to pay</p>
          </div>
        </label>
        -->

        <!-- WALLET -->
        <label id="wallet-payment-card" class="payment-card <%= (typeof walletBalance !== 'undefined' && walletBalance >= calcTotal) ? '' : 'disabled-wallet' %>" style="<%= (typeof walletBalance === 'undefined' || walletBalance < calcTotal) ? 'opacity: 0.6; cursor: not-allowed;' : '' %>">
          <input type="radio" name="paymentMethod" value="wallet" <%= (typeof walletBalance === 'undefined' || walletBalance < calcTotal) ? 'disabled' : '' %> style="display: none;">
          <div class="payment-icon-box" style="<%= (typeof walletBalance === 'undefined' || walletBalance < calcTotal) ? 'background-color: #f3f4f6; color: #6b7280;' : '' %>">
            <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div>
            <h4 style="font-weight: 700; color: #111827; font-size: 1rem; margin: 0;">Velora Wallet</h4>
            <p style="color: #6b7280; font-size: 0.875rem; margin: 0;">
              Balance: ₹<%= typeof walletBalance !== 'undefined' ? walletBalance.toFixed(2) : '0.00' %>
              <span id="wallet-insufficient" style="color: #dc2626; font-size: 0.75rem; font-weight: 700; margin-left: 0.5rem; display: <%= (typeof walletBalance !== 'undefined' && walletBalance < calcTotal) ? 'inline' : 'none' %>">(Insufficient)</span>
            </p>
          </div>
        </label>

        <!-- Hidden Input to store applied coupon so it gets submitted with Razorpay or Wallet -->
        <input type="hidden" id="hiddenAppliedCoupon" name="appliedCouponId" value="">

        <!-- PAY NOW BUTTON -->
        <button type="submit" style="width: 100%; background-color: #0B5ED7; color: white; padding: 1.25rem; border-radius: 1rem; font-size: 1.125rem; font-weight: 700; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; margin-top: 3rem; transition: background-color 0.2s; box-shadow: 0 4px 6px -1px rgba(11, 94, 215, 0.2);">
          <svg style="width: 20px; height: 20px; margin-right: 0.5rem;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path></svg>
          Pay Now
        </button>

        <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 1.5rem; color: #6b7280; font-size: 0.875rem; font-weight: 500;">
          <svg style="width: 16px; height: 16px; color: #0B5ED7;" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
          256-bit SSL Secure Encrypted Payment
        </div>

      </form>
    </div>

    <!-- RIGHT SECTION: ORDER SUMMARY -->
    <div class="checkout-right">
      <div class="summary-card">
        <h2 style="font-size: 1.25rem; font-weight: 800; color: #111827; margin-bottom: 2rem;">Order Summary</h2>

        <!-- Cart Items Loop -->
        <div style="border-bottom: 1px solid #f3f4f6; padding-bottom: 1.5rem; margin-bottom: 1.5rem;">
          <% if (typeof cart !== 'undefined' && cart.length > 0) { %>
            <% cart.forEach(course => { %>
              <div class="course-item">
                <img src="<%= course.thumbnail ? course.thumbnail : '/images/placeholder.jpg' %>" alt="Thumbnail" class="course-thumb">
                <div style="flex-grow: 1; display: flex; flex-direction: column; justify-content: center;">
                  <h4 style="font-weight: 700; color: #111827; font-size: 0.95rem; margin: 0 0 0.25rem 0; line-height: 1.2;"><%= course.title %></h4>
                  <p style="color: #6b7280; font-size: 0.8rem; margin: 0 0 0.25rem 0;"><%= course.level || 'Beginner' %> Level &bull; <%= course.modulesCount || 0 %> Modules</p>
                  <p style="color: #0B5ED7; font-weight: 800; font-size: 0.95rem; margin: 0;">
                    ₹<%= course.discountPrice > 0 ? course.discountPrice : (course.basePrice || course.price || 0) %>
                  </p>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p style="color: #6b7280; font-size: 0.9rem; margin-bottom: 0;">No items in checkout.</p>
          <% } %>
        </div>

        <!-- Calculations -->
        <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; color: #4b5563; font-size: 0.95rem;">
          <span>Subtotal</span>
          <span style="font-weight: 600;">₹<%= calcSubtotal.toFixed(2) %></span>
        </div>
        
        <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; color: #0B5ED7; font-size: 0.95rem; font-weight: 600;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            Course Discount 
            <% if (calcCourseDiscount > 0) { %>
              <span style="background-color: #e8f0fe; padding: 0.125rem 0.5rem; border-radius: 0.25rem; font-size: 0.65rem; font-weight: 800; text-transform: uppercase;">SAVE</span>
            <% } %>
          </div>
          <span>-₹<%= calcCourseDiscount.toFixed(2) %></span>
        </div>

        <div id="couponDiscountRow" style="display: <%= calcCouponDiscount > 0 ? 'flex' : 'none' %>; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; color: #0B5ED7; font-size: 0.95rem; font-weight: 600;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            Coupon Discount <span id="appliedCouponCode" style="background-color: #e8f0fe; padding: 0.125rem 0.5rem; border-radius: 0.25rem; font-size: 0.65rem; font-weight: 800; text-transform: uppercase;"></span>
          </div>
          <span id="couponDiscountAmount">-₹<%= calcCouponDiscount.toFixed(2) %></span>
        </div>

        <!-- Coupon Input -->
        <div style="margin-bottom: 2rem;">
          <label style="display: block; font-size: 0.75rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">Select a Coupon</label>
          <div style="display: flex; background-color: #f3f4f6; border-radius: 1.5rem; padding: 0.25rem;">
            <select id="couponSelect" <%= calcCouponDiscount > 0 ? 'disabled' : '' %> style="background: transparent; border: none; outline: none; padding: 0.75rem 1rem; flex-grow: 1; font-weight: 600; font-size: 0.95rem; color: #111827; cursor: pointer; appearance: none;">
              <option value="">-- Choose a Coupon --</option>
              <% if (typeof coupons !== 'undefined' && coupons.length > 0) { %>
                <% coupons.forEach(c => { %>
                  <option value="<%= c._id %>">
                    <%= c.code %> - <%= c.discountType === 'percentage' ? c.discountValue + '% off' : '₹' + c.discountValue + ' off' %>
                  </option>
                <% }) %>
              <% } %>
            </select>
            <button type="button" id="applyCouponBtn" style="background-color: <%= calcCouponDiscount > 0 ? '#fee2e2' : '#e5e7eb' %>; color: <%= calcCouponDiscount > 0 ? '#dc2626' : '#111827' %>; font-weight: 700; border: none; border-radius: 1.25rem; padding: 0 1.5rem; cursor: pointer; transition: background-color 0.2s;">
              <%= calcCouponDiscount > 0 ? 'Remove Coupon' : 'Apply' %>
            </button>
          </div>
          <div id="couponMessage" style="margin-top: 0.75rem; font-size: 0.85rem; font-weight: 600; text-align: center; display: none;"></div>
        </div>



        <div style="border-top: 2px dashed #f3f4f6; margin-bottom: 1.5rem;"></div>

        <!-- GST Breakdown (NEW) -->
        <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; color: #4b5563; font-size: 0.95rem;">
          <span>Taxable Amount</span>
          <span id="taxableAmount" style="font-weight: 600;">₹<%= calcTaxable.toFixed(2) %></span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; color: #4b5563; font-size: 0.95rem;">
          <span>GST (18%)</span>
          <span id="gstAmount" style="font-weight: 600;">₹<%= calcGst.toFixed(2) %></span>
        </div>
        
        <div style="border-top: 2px dashed #f3f4f6; margin-bottom: 1.5rem;"></div>

        <!-- Total -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
          <span style="font-size: 1.125rem; font-weight: 800; color: #111827;">Total Amount</span>
          <span id="finalTotalAmount" style="font-size: 1.5rem; font-weight: 900; color: #0B5ED7;">₹<%= calcTotal.toFixed(2) %></span>
        </div>

        <!-- Guarantee -->
        <div style="background-color: #f8f9fa; border-radius: 1rem; padding: 1.25rem; display: flex; gap: 1rem; align-items: flex-start;">
          <div style="color: #0B5ED7; margin-top: 0.125rem;">
            <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          </div>
          <div>
            <h5 style="font-size: 0.85rem; font-weight: 800; color: #111827; margin: 0 0 0.25rem 0;">5-Day Money Back Guarantee</h5>
            <p style="font-size: 0.75rem; color: #6b7280; margin: 0; line-height: 1.4;">Not satisfied? We'll refund your purchase, no questions asked.</p>
          </div>
        </div>

      </div>
    </div>

  </div>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const applyBtn = document.getElementById("applyCouponBtn");
      const couponSelect = document.getElementById("couponSelect");
      const msgDiv = document.getElementById("couponMessage");
      const discountRow = document.getElementById("couponDiscountRow");
      const codeSpan = document.getElementById("appliedCouponCode");
      const discountAmountSpan = document.getElementById("couponDiscountAmount");
      const finalTotalAmount = document.getElementById("finalTotalAmount");
      
      const cartSubtotal = parseFloat("<%= calcSubtotal %>") || 0;
      const currentCourseDiscount = parseFloat("<%= calcCourseDiscount %>") || 0;
      const amountBeforeCoupon = cartSubtotal - currentCourseDiscount;
      
      // Keep track of the final total in JS to avoid parsing DOM strings
      let currentTotal = amountBeforeCoupon;
      const walletBalance = <%= typeof walletBalance !== 'undefined' ? walletBalance : 0 %>;

      // Handle custom radio selection UI
      const paymentCards = document.querySelectorAll('.payment-card:not(#wallet-payment-card)');
      const walletCard = document.getElementById('wallet-payment-card');
      const walletRadio = walletCard.querySelector('input[type="radio"]');
      const allCards = document.querySelectorAll('.payment-card');

      allCards.forEach(card => {
        card.addEventListener('click', function(e) {
          if (this.classList.contains('disabled-wallet') || this.style.cursor === 'not-allowed') {
            e.preventDefault();
            return;
          }
          allCards.forEach(c => c.classList.remove('active'));
          this.classList.add('active');
          const radio = this.querySelector('input[type="radio"]');
          if (radio) radio.checked = true;
        });
      });

      function updateWalletStatus(newTotal) {
         const walletInsufficient = document.getElementById('wallet-insufficient');
         const walletIcon = walletCard.querySelector('.payment-icon-box');
         
         if (walletBalance < newTotal) {
            walletCard.style.opacity = '0.6';
            walletCard.style.cursor = 'not-allowed';
            walletCard.classList.add('disabled-wallet');
            walletRadio.disabled = true;
            if (walletRadio.checked) {
               walletRadio.checked = false;
               document.querySelector('input[value="razorpay"]').checked = true;
               document.querySelector('input[value="razorpay"]').closest('.payment-card').classList.add('active');
               walletCard.classList.remove('active');
            }
            walletInsufficient.style.display = 'inline';
            walletIcon.style.backgroundColor = '#f3f4f6';
            walletIcon.style.color = '#6b7280';
         } else {
            walletCard.style.opacity = '1';
            walletCard.style.cursor = 'pointer';
            walletCard.classList.remove('disabled-wallet');
            walletRadio.disabled = false;
            walletInsufficient.style.display = 'none';
            walletIcon.style.backgroundColor = '#e8f0fe';
            walletIcon.style.color = '#0B5ED7';
         }
      }
      
      applyBtn.addEventListener("click", async () => {
        if (applyBtn.textContent.trim() === "Remove Coupon") {
          discountRow.style.display = "none";
          
          // Recalculate total
          const newTaxable = amountBeforeCoupon;
          const newGst = newTaxable * 0.18;
          currentTotal = newTaxable + newGst;
          
          finalTotalAmount.textContent = "₹" + currentTotal.toFixed(2);
          document.getElementById("taxableAmount").textContent = "₹" + newTaxable.toFixed(2);
          document.getElementById("gstAmount").textContent = "₹" + newGst.toFixed(2);
          
          updateWalletStatus(currentTotal);
          
          couponSelect.value = "";
          couponSelect.disabled = false;
          
          const hiddenInput = document.getElementById("hiddenAppliedCoupon");
          if (hiddenInput) hiddenInput.value = "";
          
          applyBtn.textContent = "Apply";
          applyBtn.style.backgroundColor = "#e5e7eb";
          applyBtn.style.color = "#111827";
          
          msgDiv.style.display = "block";
          msgDiv.style.color = "#6b7280";
          msgDiv.textContent = "Coupon removed.";
          setTimeout(() => { msgDiv.style.display = "none"; }, 3000);
          return;
        }

        const couponId = couponSelect.value;
        if (!couponId) {
          msgDiv.style.display = "block";
          msgDiv.style.color = "#dc2626";
          msgDiv.textContent = "Please select a coupon first.";
          return;
        }
        
        applyBtn.textContent = "Applying...";
        applyBtn.disabled = true;
        
        try {
          const res = await fetch("/api/v1/user/checkout/coupon", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            // Pass the amount after course discounts to the backend for coupon validation
            body: JSON.stringify({ couponId, cartSubtotal: amountBeforeCoupon })
          });
          
          const data = await res.json();
          msgDiv.style.display = "block";
          
          if (data.success) {
            msgDiv.style.color = "#16a34a";
            msgDiv.textContent = data.message;
            
            // Update UI
            discountRow.style.display = "flex";
            codeSpan.textContent = data.couponCode;
            discountAmountSpan.textContent = "-₹" + data.discountAmount.toFixed(2);
            finalTotalAmount.textContent = "₹" + data.finalTotal.toFixed(2);
            document.getElementById("taxableAmount").textContent = "₹" + data.taxableAmount.toFixed(2);
            document.getElementById("gstAmount").textContent = "₹" + data.gstAmount.toFixed(2);
            
            // Update JS variable
            currentTotal = data.finalTotal;
            updateWalletStatus(currentTotal);
            
            // Pass the applied coupon back to backend via hidden input in the form
            let hiddenInput = document.getElementById("hiddenAppliedCoupon");
            if (!hiddenInput) {
              hiddenInput = document.createElement("input");
              hiddenInput.type = "hidden";
              hiddenInput.id = "hiddenAppliedCoupon";
              hiddenInput.name = "appliedCouponId";
              document.getElementById("checkout-form").appendChild(hiddenInput);
            }
            hiddenInput.value = data.couponId;
            
            // Transform Apply button into Remove Coupon button
            applyBtn.textContent = "Remove Coupon";
            applyBtn.style.backgroundColor = "#fee2e2";
            applyBtn.style.color = "#dc2626";
            couponSelect.disabled = true;
            
          } else {
            msgDiv.style.color = "#dc2626";
            msgDiv.textContent = data.message;
            
            // Revert UI if error
            discountRow.style.display = "none";
            finalTotalAmount.textContent = "₹" + amountBeforeCoupon.toFixed(2);
            currentTotal = amountBeforeCoupon;
            
            const hiddenInput = document.getElementById("hiddenAppliedCoupon");
            if (hiddenInput) hiddenInput.value = "";
          }
        } catch (error) {
          msgDiv.style.display = "block";
          msgDiv.style.color = "#dc2626";
          msgDiv.textContent = "An error occurred. Please try again.";
        } finally {
          if (applyBtn.textContent.trim() !== "Remove Coupon") {
            applyBtn.textContent = "Apply";
          }
          applyBtn.disabled = false;
        }
      });
      
      // Razorpay Checkout Logic
      const checkoutForm = document.getElementById("checkout-form");
      
      checkoutForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        const submitBtn = checkoutForm.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = "Processing...";
        submitBtn.disabled = true;

        try {
          // Check which payment method is selected
          const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;
          const hiddenInput = document.getElementById("hiddenAppliedCoupon");
          const appliedCouponId = hiddenInput ? hiddenInput.value : null;
          
          const expectedCourseIds = [
            <% cart.forEach(c => { %>
              "<%= c._id %>",
            <% }) %>
          ];

          if (paymentMethod === 'wallet') {
            // WALLET CHECKOUT FLOW
            
            // Show confirmation first
            const result = await Swal.fire({
              title: 'Confirm Wallet Payment',
              html: `
                <div style="margin: 1rem 0; padding: 1rem; background: #f8fafc; border-radius: 0.5rem; text-align: left;">
                  <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                    <span style="color: #64748b;">Payable Amount:</span>
                    <span style="font-weight: 700; color: #0f172a;">₹${currentTotal.toFixed(2)}</span>
                  </div>
                  <div style="display: flex; justify-content: space-between;">
                    <span style="color: #64748b;">Available Balance:</span>
                    <span style="font-weight: 700; color: #16a34a;">₹${walletBalance.toFixed(2)}</span>
                  </div>
                </div>
                <p style="font-size: 0.875rem; color: #64748b;">Are you sure you want to deduct this amount from your wallet?</p>
              `,
              icon: 'question',
              showCancelButton: true,
              confirmButtonColor: '#0B5ED7',
              cancelButtonColor: '#64748b',
              confirmButtonText: 'Confirm & Pay',
              cancelButtonText: 'Cancel'
            });

            if (!result.isConfirmed) {
              submitBtn.innerHTML = originalText;
              submitBtn.disabled = false;
              return;
            }

            const walletRes = await fetch("/api/v1/user/order/wallet", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ appliedCouponId, expectedCourseIds })
            });
            
            const walletData = await walletRes.json();
            if (!walletData.success) {
              if (walletData.redirectUrl) {
                Swal.fire({ title: "Cart Updated", text: walletData.message, icon: "warning" }).then(() => {
                  window.location.href = walletData.redirectUrl;
                });
                return;
              }
              Swal.fire({ text: walletData.message || "Wallet checkout failed", icon: "error" });
              submitBtn.innerHTML = originalText;
              submitBtn.disabled = false;
              return;
            }
            
            // Success
            window.location.href = "/user/payment-success/" + walletData.orderId;
            return;
          }

          // RAZORPAY CHECKOUT FLOW
          
          // 1. Call backend to recalculate totals and create order securely
          const orderRes = await fetch("/api/v1/user/order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ appliedCouponId, expectedCourseIds })
          });
          
          const orderData = await orderRes.json();
          document.querySelectorAll('[id^="error-"]').forEach(el => {
              el.textContent = '';
              el.classList.add('hidden');
          });
          if (!orderData.success) {
            if (orderData.redirectUrl) {
              Swal.fire({ title: "Cart Updated", text: orderData.message, icon: "warning" }).then(() => {
                window.location.href = orderData.redirectUrl;
              });
              return;
            }
            let hasInlineError = false;
            if (orderData.errors) {
                for (const [field, msg] of Object.entries(orderData.errors)) {
                    const span = document.getElementById(`error-${field}`);
                    if (span) {
                        span.textContent = msg;
                        span.classList.remove('hidden');
                        hasInlineError = true;
                    }
                }
            }
            if (!hasInlineError) {
                Swal.fire({ text: orderData.message || "Failed to create order", icon: "error" }).then(() => {
                   if (orderData.message && orderData.message.includes("Checkout blocked")) {
                       window.location.href = "/user/cart";
                   }
                });
            }
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
            return;
          }

          if (orderData.bypassRazorpay) {
            window.location.href = "/user/payment-success/" + orderData.dbOrderIds[0];
            return;
          }

          // Use exact server-calculated amount
          const serverPayableAmount = orderData.order.formattedAmount || (orderData.order.amount / 100).toFixed(2);

          // Update page summary DOM if server summary returned
          if (orderData.order.summary) {
            const s = orderData.order.summary;
            if (finalTotalAmount) finalTotalAmount.textContent = "₹" + Number(s.finalTotal).toFixed(2);
            const taxableEl = document.getElementById("taxableAmount");
            if (taxableEl) taxableEl.textContent = "₹" + Number(s.taxableAmount).toFixed(2);
            const gstEl = document.getElementById("gstAmount");
            if (gstEl) gstEl.textContent = "₹" + Number(s.gstAmount).toFixed(2);
          }

          // Show confirmation modal with exact server-calculated amount
          const rzpResult = await Swal.fire({
            title: 'Confirm Your Order',
            html: `
              <div style="margin: 1rem 0; padding: 1rem; background: #f8fafc; border-radius: 0.5rem; text-align: left;">
                <div style="display: flex; justify-content: space-between;">
                  <span style="color: #64748b;">Final Payable Amount:</span>
                  <span style="font-weight: 700; color: #0f172a;">₹${serverPayableAmount}</span>
                </div>
              </div>
              <p style="font-size: 0.875rem; color: #64748b;">Are you ready to proceed securely to payment?</p>
            `,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0B5ED7',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Proceed to Payment',
            cancelButtonText: 'Cancel'
          });

          if (!rzpResult.isConfirmed) {
            // User cancelled confirmation popup, cancel the pending order
            await fetch("/api/v1/user/payment/cancel", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ dbOrderIds: orderData.dbOrderIds })
            });
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
            return;
          }

          // 3. Open Razorpay Checkout Modal
          const options = {
            key: "<%= razorpayKeyId %>", 
            amount: orderData.order.amount,
            currency: orderData.order.currency,
            name: "Velora",
            description: "Course Purchase",
            order_id: orderData.order.id,
            handler: async function (response) {
              // 4. Verify Payment on Backend
              const verifyRes = await fetch("/api/v1/user/order/verify", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_signature: response.razorpay_signature,
                  dbOrderIds: orderData.dbOrderIds
                })
              });
              
              const verifyData = await verifyRes.json();
              if (verifyData.success) {
                // Redirect to success page
                window.location.href = "/user/payment-success/" + verifyData.orderId;
              } else {
                Swal.fire({ text: verifyData.message || "Payment verification failed. Please contact support.", icon: "error" }).then(() => {
                   if (verifyData.message && verifyData.message.includes("Payment verified but fulfillment blocked")) {
                       window.location.href = "/user/cart";
                   }
                });
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
              }
            },
            modal: {
              ondismiss: async function() {
                // Handle dismiss
                await fetch("/api/v1/user/payment/cancel", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ dbOrderIds: orderData.dbOrderIds })
                });
                window.location.href = `/user/payment-failure/${orderData.dbOrderIds[0]}`;
              }
            },
            prefill: {
              name: "Student",
              email: "student@example.com",
              contact: "9999999999"
            },
            theme: {
              color: "#0B5ED7"
            }
          };

          const rzp = new Razorpay(options);
           rzp.on('payment.failed', async function (response){
             // Handle payment failure
             await fetch("/api/v1/user/payment/failed", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ 
                  dbOrderIds: orderData.dbOrderIds, 
                  reason: response.error.description 
                })
             });
             window.location.href = `/user/payment-failure/${orderData.dbOrderIds[0]}`;
          });
          rzp.open();
          
        } catch (error) {
          console.error(error);
          Swal.fire({ text: "An error occurred during checkout.", icon: "error" });
          submitBtn.innerHTML = originalText;
          submitBtn.disabled = false;
        }
      });
    });
  </script>
</main>

<%- include('../../../partials/footer') %>
