<%- include('../../../partials/header') %>

<style>
  /* ── Course Detail Layout ── */
  .cd-wrapper {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .cd-wrapper {
      grid-template-columns: 1fr 380px;
      padding: 3rem 2rem 6rem;
    }
  }

  /* ── Sidebar Sticky ── */
  .cd-sidebar {
    position: static;
  }
  @media (min-width: 1024px) {
    .cd-sidebar {
      position: sticky;
      top: 6rem;
    }
  }

  /* ── Hero badge + rating row ── */
  .cd-meta-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .cd-level-badge {
    display: inline-block;
    background: #A78BFA;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .cd-rating-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #0B5ED7;
  }
  .cd-rating-row .star { font-size: 1rem; }
  .cd-rating-row .reviews { color: #6B7280; font-size: 0.75rem; font-weight: 500; margin-left: 0.25rem; }

  /* ── Card shared ── */
  .cd-card {
    background: #fff;
    border-radius: 1rem;
    border: 1px solid #F1F0F5;
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    overflow: hidden;
  }

  /* ── Sidebar card ── */
  .cd-sidebar-card {
    background: #fff;
    border-radius: 1.25rem;
    border: 1px solid #EEE;
    box-shadow: 0 4px 32px rgba(0,0,0,0.10);
    overflow: hidden;
  }
  .cd-video-thumb {
    position: relative;
    height: 220px;
    background: #0F0F0F;
    padding: 1rem;
    cursor: pointer;
  }
  .cd-video-thumb img {
    width: 100%; height: 100%; object-fit: cover; border-radius: 0.75rem; opacity: 0.92;
  }
  .cd-play-btn {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .cd-play-circle {
    width: 3.5rem; height: 3.5rem;
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(8px);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 1.5px solid rgba(255,255,255,0.3);
    box-shadow: 0 4px 24px rgba(0,0,0,0.25);
    transition: transform 0.2s;
  }
  .cd-video-thumb:hover .cd-play-circle { transform: scale(1.12); }

  .cd-sidebar-body { padding: 1.75rem; }
  .cd-price-row {
    display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 1.25rem;
  }
  .cd-price-main { font-size: 2.25rem; font-weight: 900; color: #111; }
  .cd-price-orig { font-size: 0.85rem; color: #9CA3AF; text-decoration: line-through; }

  .cd-btn-enroll {
    display: flex; align-items: center; justify-content: center; gap: 0.4rem;
    width: 100%; background: #0B5ED7; color: #fff;
    font-weight: 700; font-size: 0.9rem; padding: 0.9rem 1rem;
    border-radius: 0.75rem; border: none; cursor: pointer;
    text-decoration: none; margin-bottom: 0.65rem;
    box-shadow: 0 4px 16px rgba(11,94,215,0.25);
    transition: background 0.18s;
  }
  .cd-btn-enroll:hover { background: #0A58CA; }
  .cd-btn-wishlist {
    display: flex; align-items: center; justify-content: center; gap: 0.4rem;
    width: 100%; background: #fff; color: #6D28D9;
    font-weight: 700; font-size: 0.9rem; padding: 0.9rem 1rem;
    border-radius: 0.75rem; border: 1.5px solid #DDD6FE; cursor: pointer;
    margin-bottom: 1.5rem;
    transition: background 0.18s;
  }
  .cd-btn-wishlist:hover { background: #F5F3FF; }

  .cd-includes-title { font-weight: 700; font-size: 0.85rem; color: #111; margin-bottom: 0.85rem; }
  .cd-includes-list { list-style: none; padding: 0; margin: 0 0 1.5rem 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .cd-includes-list li { display: flex; align-items: center; gap: 0.65rem; font-size: 0.78rem; color: #4B5563; font-weight: 500; }
  .cd-includes-list li svg { flex-shrink: 0; color: #9CA3AF; }

  .cd-divider { border: none; border-top: 1px solid #F1F0F5; margin-bottom: 1.25rem; }
  .cd-share-title { font-weight: 700; font-size: 0.85rem; color: #111; text-align: center; margin-bottom: 1rem; }
  .cd-share-btns { display: flex; justify-content: center; gap: 1rem; }
  .cd-share-btn {
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    border: 1.5px solid #DDD6FE; background: #fff; color: #6D28D9;
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    transition: background 0.18s;
  }
  .cd-share-btn:hover { background: #F5F3FF; }

  /* ── Alert ── */
  .cd-alert {
    background: #F3F0FF; border: 1px solid #E9D5FF;
    border-radius: 0.85rem; padding: 1.1rem 1.25rem;
    display: flex; align-items: flex-start; gap: 0.85rem;
    margin-bottom: 2.5rem;
  }
  .cd-alert-icon {
    background: #8B5CF6; color: #fff; font-size: 0.7rem; font-weight: 700;
    border-radius: 0.3rem; min-width: 1.4rem; height: 1.4rem;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; margin-top: 0.05rem;
  }
  .cd-alert p { font-size: 0.85rem; color: #374151; font-weight: 500; }

  /* ── Learn grid ── */
  .cd-learn-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 600px) { .cd-learn-grid { grid-template-columns: 1fr; } }
  .cd-learn-item {
    background: #fff; border: 1px solid #F1F0F5; border-radius: 1rem;
    padding: 1.1rem; display: flex; align-items: flex-start; gap: 0.75rem;
    box-shadow: 0 1px 6px rgba(0,0,0,0.04);
  }
  .cd-learn-icon {
    background: #EFF6FF; color: #0B5ED7; border-radius: 50%;
    padding: 0.35rem; flex-shrink: 0; margin-top: 0.05rem;
  }
  .cd-learn-item span { font-size: 0.82rem; color: #4B5563; font-weight: 500; line-height: 1.5; }

  /* ── Curriculum ── */
  .cd-mod-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem 1.25rem; cursor: pointer;
  }
  .cd-mod-header-left { display: flex; align-items: center; gap: 0.7rem; }
  .cd-mod-header h3 { font-weight: 700; font-size: 0.875rem; color: #111; margin: 0; }
  .cd-lesson-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.85rem 1.25rem 0.85rem 3rem;
    border-top: 1px solid #F9FAFB; font-size: 0.82rem;
  }
  .cd-lesson-row-left { display: flex; align-items: center; gap: 0.6rem; color: #374151; font-weight: 500; }
  .cd-locked-row {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 1rem 1.25rem; font-size: 0.78rem;
    color: #9CA3AF; font-weight: 600;
    border-top: 1px solid #F9FAFB;
  }

  /* ── Related grid ── */
  .cd-related-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
  }
  @media (max-width: 900px) { .cd-related-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .cd-related-grid { grid-template-columns: 1fr; } }

  .cd-rc-card {
    background: #fff; border-radius: 0.875rem; overflow: hidden;
    border: 1px solid #F1F0F5; box-shadow: 0 1px 8px rgba(0,0,0,0.05);
    cursor: pointer; display: flex; flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .cd-rc-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.10); transform: translateY(-2px); }
  .cd-rc-thumb { height: 6.5rem; overflow: hidden; position: relative; }
  .cd-rc-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .cd-rc-card:hover .cd-rc-thumb img { transform: scale(1.05); }
  .cd-rc-body { padding: 0.85rem; flex-grow: 1; display: flex; flex-direction: column; }
  .cd-rc-cat { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #7C3AED; margin-bottom: 0.4rem; }
  .cd-rc-title { font-weight: 700; font-size: 0.8rem; color: #111; line-height: 1.4; margin-bottom: 0.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cd-rc-footer { margin-top: auto; display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; font-weight: 700; }
  .cd-rc-rating { color: #0B5ED7; display: flex; align-items: center; gap: 0.15rem; }
  .cd-rc-price { color: #6B7280; font-weight: 500; }
</style>

<main style="background:#F8F9FA; flex-grow:1;">
  <div class="cd-wrapper">

    <!-- ═══════════════════════════ LEFT COLUMN ═══════════════════════════ -->
    <div>

      <!-- 1. Hero -->
      <div style="margin-bottom:2.5rem;">
        <div class="cd-meta-row">
          <span class="cd-level-badge"><%= course.level ? course.level : 'ALL LEVELS' %></span>
          <div class="cd-rating-row">
            <span class="star" style="color:#F59E0B;">★</span>
            <span><%= course.rating || '0.0' %></span>
            <span class="reviews">(<%= course.reviewsCount || 0 %> reviews)</span>
          </div>
        </div>

        <h1 style="font-size:2.5rem;font-weight:900;color:#111;line-height:1.15;letter-spacing:-0.02em;margin:0 0 1rem;"><%= course.title %></h1>

        <p style="color:#6B7280;font-size:1.05rem;line-height:1.7;margin:0 0 2rem;max-width:38rem;">
          <%= course.description || 'Learn the core fundamentals and advanced concepts in this comprehensive course.' %>
        </p>

        <div style="display:flex;align-items:center;gap:1rem;">
          <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(course.instructor || 'Instructor') %>&background=0D8ABC&color=fff&rounded=true"
               alt="<%= course.instructor %>"
               style="width:3rem;height:3rem;border-radius:50%;border:2px solid #E5E7EB;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
          <div>
            <div style="font-weight:700;font-size:0.9rem;color:#111;"><%= course.instructor || 'Course Instructor' %></div>
            <div style="font-size:0.75rem;color:#9CA3AF;font-weight:500;">Lead Web Architect at Velora</div>
          </div>
        </div>
      </div>

      <!-- 2. Alert -->
      <div class="cd-alert">
        <div class="cd-alert-icon">i</div>
        <p>Continue learning and track your course progress from your dashboard.</p>
      </div>

      <!-- 3. What you'll learn -->
      <div style="margin-bottom:3rem;">
        <h2 style="font-size:1.5rem;font-weight:800;color:#111;margin:0 0 1.25rem;">What you will learn</h2>
        <div class="cd-learn-grid">
          <div class="cd-learn-item">
            <div class="cd-learn-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
            <span>Understand semantic HTML structure for modern web apps.</span>
          </div>
          <div class="cd-learn-item">
            <div class="cd-learn-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
            <span>Build accessible web pages that work for everyone.</span>
          </div>
          <div class="cd-learn-item">
            <div class="cd-learn-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
            <span>Improve SEO ranking with proper hierarchical tags.</span>
          </div>
          <div class="cd-learn-item">
            <div class="cd-learn-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
            <span>Write clean and meaningful markup for better dev collaboration.</span>
          </div>
        </div>
      </div>

      <!-- 4. Curriculum -->
      <div style="margin-bottom:3.5rem;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;">
          <h2 style="font-size:1.5rem;font-weight:800;color:#111;margin:0;">Course Curriculum</h2>
          <div style="display:flex;align-items:center;gap:0.35rem;font-size:0.78rem;color:#9CA3AF;font-weight:600;">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <%= totalLessons || 0 %> Lessons &bull; 4h 30m
          </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:0.6rem;">
          <% if (modulesWithLessons && modulesWithLessons.length > 0) { %>
            <% modulesWithLessons.forEach(function(mod, index) { %>
              <div class="cd-card">
                <div class="cd-mod-header">
                  <div class="cd-mod-header-left">
                    <svg width="18" height="18" fill="none" stroke="#0B5ED7" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                    <h3>Module <%= index + 1 %>: <%= mod.title %></h3>
                  </div>
                  <svg width="18" height="18" fill="none" stroke="#9CA3AF" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <% if (index === 0 && mod.lessons && mod.lessons.length > 0) { %>
                  <% mod.lessons.forEach(function(lesson) { %>
                    <div class="cd-lesson-row">
                      <div class="cd-lesson-row-left">
                        <svg width="14" height="14" fill="none" stroke="#9CA3AF" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        <%= lesson.title %>
                      </div>
                      <span style="font-size:0.75rem;color:#9CA3AF;font-weight:500;"><%= lesson.duration || '10:00' %></span>
                    </div>
                  <% }); %>
                <% } else if (index > 0) { %>
                  <div class="cd-locked-row">
                    <svg width="14" height="14" fill="none" stroke="#9CA3AF" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    Login to access full content
                  </div>
                <% } %>
              </div>
            <% }); %>
          <% } else { %>
            <p style="color:#9CA3AF;font-size:0.9rem;">Curriculum is currently being updated.</p>
          <% } %>
        </div>
      </div>

      <!-- 5. Related Courses -->
      <div>
        <h2 style="font-size:1.5rem;font-weight:800;color:#111;margin:0 0 1.25rem;">Related Courses</h2>
        <div class="cd-related-grid">
          <% if (relatedCourses && relatedCourses.length > 0) { %>
            <% relatedCourses.forEach(function(rc) { %>
              <div class="cd-rc-card" onclick="window.location.href='/user-courses/<%= rc._id %>'">
                <div class="cd-rc-thumb">
                  <img src="<%= rc.thumbnail || '/placeholder.png' %>" alt="<%= rc.title %>">
                </div>
                <div class="cd-rc-body">
                  <div class="cd-rc-cat"><%= (rc.category && rc.category.name) ? rc.category.name.toUpperCase() : 'DEVELOPMENT' %></div>
                  <div class="cd-rc-title"><%= rc.title %></div>
                  <div class="cd-rc-footer">
                    <div class="cd-rc-rating"><span style="color:#F59E0B;">★</span><%= rc.rating || '0.0' %></div>
                    <div class="cd-rc-price"><%= rc.pricingType === 'free' ? 'Free' : '$' + (rc.basePrice || 0).toFixed(2) %></div>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p style="color:#9CA3AF;font-size:0.9rem;grid-column:span 4;">No related courses found.</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════ RIGHT SIDEBAR ═══════════════════════════ -->
    <div class="cd-sidebar">
      <div class="cd-sidebar-card">

        <!-- Video Preview -->
        <div class="cd-video-thumb">
          <img src="<%= course.thumbnail || 'https://images.unsplash.com/photo-1542831371-29b0f74f9713?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80' %>" alt="Preview">
          <div class="cd-play-btn">
            <div class="cd-play-circle">
              <svg width="22" height="22" fill="white" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>

        <!-- Sidebar Body -->
        <div class="cd-sidebar-body">
          <!-- Price -->
          <div class="cd-price-row">
            <% if (course.pricingType === 'free') { %>
              <span class="cd-price-main">Free</span>
              <span class="cd-price-orig" style="text-decoration:line-through;">$49.99</span>
            <% } else { %>
              <span class="cd-price-main">$<%= (course.discountPrice || course.basePrice || 0).toFixed(2) %></span>
              <% if (course.discountPrice && course.discountPrice < course.basePrice) { %>
                <span class="cd-price-orig">$<%= (course.basePrice || 0).toFixed(2) %></span>
              <% } %>
            <% } %>
          </div>

          <!-- Enroll / Cart Button -->
          
            <a href="#" class="cd-btn-enroll">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              Add to Cart
            </a>
      

          <!-- Wishlist Button -->
          <button class="cd-btn-wishlist">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            Add to Wishlist
          </button>

          <!-- Course Includes -->
          <div class="cd-includes-title">This course includes:</div>
          <ul class="cd-includes-list">
            <li>
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              4.5 hours on-demand video
            </li>
            <li>
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              12 downloadable resources
            </li>
            <li>
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              Access on mobile and TV
            </li>
            <li>
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Certificate of completion
            </li>
          </ul>

          <hr class="cd-divider">

          <div class="cd-share-title">Share this course</div>
          <div class="cd-share-btns">
            <button class="cd-share-btn" title="Share">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
            </button>
            <button class="cd-share-btn" title="Gift">
