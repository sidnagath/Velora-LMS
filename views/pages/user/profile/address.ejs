<%- include('../../../partials/header') %>

<main class="min-h-screen bg-gray-100 font-sans py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row gap-8">
    
    <!-- SIDEBAR -->
    <aside class="w-full md:w-64 shrink-0 space-y-6">
      
      <!-- Profile Card -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center flex flex-col items-center">

<% if(user.avatar) { %>
  <img src="<%= user.avatar %>" alt="<%= user.name %>" class="w-20 h-20 rounded-full border-4 border-gray-50 mb-3 object-cover">
<% } else { %>
  <div class="w-20 h-20 rounded-full bg-blue-100 text-blue-600 border-4 border-gray-50 mb-3 flex items-center justify-center text-2xl font-bold">
    <%= user.name.split(" ").map(word => word[0]).join("").slice(0,2).toUpperCase() %>
  </div>
<% } %>
        <h3 class="font-extrabold text-gray-900"><%=user.name%></h3>
        <!-- <p class="text-xs text-gray-500 font-medium mt-1"><%=user.email%></p> -->
      </div>

      <!-- Upgrade Button -->
      <button class="w-full bg-[#6B46C1] hover:bg-[#553C9A] text-white font-bold py-3.5 px-4 rounded-xl shadow-md transition-colors flex justify-center items-center">
        Upgrade to Pro
      </button>

      <!-- Navigation Menu -->
      <div class="bg-white rounded-2xl py-4 shadow-sm border border-gray-100">
        <nav class="space-y-1 text-sm font-semibold">
          <a href="/user/profile" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            Account Details
          </a>
          <a href="/user/address" class="flex items-center px-6 py-3 text-blue-600 bg-blue-50/50 border-l-4 border-blue-600 transition-colors">
            <svg class="w-5 h-5 mr-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            Address
          </a>
          <a href="/user/orders" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            Orders
          </a>
          <!-- <a href="/user/wishlist" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            Wishlist
          </a> -->
          <a href="/user/wallet" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            Wallet
          </a>
          <a href="/user/coupons" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
            My Coupons
          </a>
          <div class="pt-4 mt-2 border-t border-gray-100">
            <a href="/user/logout" class="flex items-center px-6 py-3 text-red-600 hover:bg-red-50 transition-colors">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
              Logout
            </a>
          </div>
        </nav>
      </div>

    </aside>

    <!-- MAIN CONTENT AREA -->
    <div class="flex-1 max-w-4xl space-y-8">
      
      <!-- HEADER -->
      <div>
        <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Address Information</h2>
      </div>

      <%- include('../../../partials/user-banner') %>

      <!-- ADDRESS INFORMATION CARD -->
      <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
        <div class="flex items-center space-x-3 mb-8">
          <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          </div>
          <h2 class="text-xl font-bold text-gray-900">Your Address</h2>
        </div>

        <div class="space-y-6 max-w-3xl">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Address Line 1</label>
              <div class="px-4 py-3 bg-gray-100 rounded-xl text-gray-900"><%= user.address?.addressLine1 || 'Not Added' %></div>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Address Line 2</label>
              <div class="px-4 py-3 bg-gray-100 rounded-xl text-gray-900"><%= user.address?.addressLine2 || 'Not Added' %></div>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">City</label>
              <div class="px-4 py-3 bg-gray-100 rounded-xl text-gray-900"><%= user.address?.city || 'Not Added' %></div>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">State</label>
              <div class="px-4 py-3 bg-gray-100 rounded-xl text-gray-900"><%= user.address?.state || 'Not Added' %></div>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Country</label>
              <div class="px-4 py-3 bg-gray-100 rounded-xl text-gray-900"><%= user.address?.country || 'Not Added' %></div>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Postal Code</label>
              <div class="px-4 py-3 bg-gray-100 rounded-xl text-gray-900"><%= user.address?.postalCode || 'Not Added' %></div>
            </div>
          </div>

          <div class="pt-4 flex flex-wrap gap-4">
            <a href="/user/profile/edit-address">
              <button type="button" class="bg-blue-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-sm hover:bg-blue-700 transition-colors">
                Edit Address
              </button>
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</main>

<%- include('../../../partials/footer') %>
