</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const avatarForm = document.getElementById('avatarForm');
  if (avatarForm) {
    // Override native submit to intercept auto-submit from cropper
    avatarForm.submit = function() {
      const event = new Event('submit', { cancelable: true, bubbles: true });
      avatarForm.dispatchEvent(event);
    };

    avatarForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(avatarForm);
      try {
        const res = await fetch('/api/v1/user/profile/avatar', {
          method: 'PATCH',
          body: formData
        });
        const data = await res.json();
        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Success',
            text: data.message,
          }).then(() => {
            window.location.reload();
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: data.message || 'Failed to update avatar'
          });
        }
      } catch (err) {
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'An error occurred'
        });
      }
    });
  }
});
</script>

