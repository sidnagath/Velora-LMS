<%- include('../../../partials/header') %>

<main class="min-h-screen bg-gray-100 font-sans py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row gap-8">
    
    <!-- SIDEBAR -->
    <aside class="w-full md:w-64 shrink-0 space-y-6">
      
      <!-- Profile Card -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center flex flex-col items-center">
        <% if(user.avatar) { %>
          <img src="<%= user.avatar %>" alt="<%= user.name %>" class="w-20 h-20 rounded-full border-4 border-gray-50 mb-3 object-cover">
        <% } else { %>
          <div class="w-20 h-20 rounded-full bg-blue-100 text-blue-600 border-4 border-gray-50 mb-3 flex items-center justify-center text-2xl font-bold">
            <%= user.name.split(" ").map(word => word[0]).join("").slice(0,2).toUpperCase() %>
          </div>
        <% } %>
        <h3 class="font-extrabold text-gray-900"><%=user.name%></h3>
      </div>

      <!-- Upgrade Button -->
      <button class="w-full bg-[#6B46C1] hover:bg-[#553C9A] text-white font-bold py-3.5 px-4 rounded-xl shadow-md transition-colors flex justify-center items-center">
        Upgrade to Pro
      </button>

      <!-- Navigation Menu -->
      <div class="bg-white rounded-2xl py-4 shadow-sm border border-gray-100">
        <nav class="space-y-1 text-sm font-semibold">
          <a href="/user/profile" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            Account Details
          </a>
          <a href="/user/address" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            Address
          </a>
          <a href="/user/orders" class="flex items-center px-6 py-3 text-blue-600 bg-blue-50/50 border-l-4 border-blue-600 transition-colors">
            <svg class="w-5 h-5 mr-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            Orders
          </a>
          <!-- <a href="/user/wishlist" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            Wishlist
          </a> -->
          <a href="/user/wallet" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            Wallet
          </a>
          <a href="/user/coupons" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
            My Coupons
          </a>
          <div class="pt-4 mt-2 border-t border-gray-100">
            <a href="/user/logout" class="flex items-center px-6 py-3 text-red-600 hover:bg-red-50 transition-colors">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
              Logout
            </a>
          </div>
        </nav>
      </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <div class="flex-1 max-w-4xl space-y-8">
      
      <!-- HEADER Section -->
      <div>
        <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">My Orders</h2>
        <p class="text-gray-500 max-w-2xl mt-2 font-medium text-sm">Manage your learning investments and access invoices for all your premium course enrollments.</p>
      </div>

      <%- include('../../../partials/user-banner') %>

      <% if (orders && orders.length > 0) { %>
        <div class="space-y-6">
          <% orders.forEach((order, index) => { %>
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
              
              <!-- Order Header -->
              <div class="px-8 py-5 border-b border-gray-100 flex flex-wrap items-center justify-between gap-4">
                <div class="flex flex-wrap gap-8 md:gap-12">
                  <div class="flex flex-col">
                    <span class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest mb-1">Order ID</span>
                    <span class="text-sm font-bold text-blue-600"><%= order.orderId %></span>
                  </div>
                  <div class="flex flex-col">
                    <span class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest mb-1">Date</span>
                    <span class="text-sm font-bold text-gray-900"><%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                  </div>
                  <div class="flex flex-col">
                    <span class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest mb-1">Total</span>
                    <span class="text-sm font-bold text-gray-900">₹<%= order.finalAmount.toFixed(2) %></span>
                  </div>
                  <div class="flex flex-col">
                    <span class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest mb-1">Payment</span>
                    <span class="text-sm font-bold text-gray-900 capitalize"><%= order.paymentMethod %></span>
                  </div>
                </div>
                <div>
                  <% if (order.paymentStatus === 'paid') { %>
                    <span class="inline-flex text-[11px] font-bold rounded-full bg-green-50 text-green-700 items-center px-3 py-1">Completed</span>
                  <% } else if (order.paymentStatus === 'pending') { %>
                    <span class="inline-flex text-[11px] font-bold rounded-full bg-yellow-50 text-yellow-700 items-center px-3 py-1">Pending</span>
                  <% } else if (order.paymentStatus === 'failed') { %>
                    <span class="inline-flex text-[11px] font-bold rounded-full bg-red-50 text-red-600 items-center px-3 py-1">Failed</span>
                  <% } else if (order.paymentStatus === 'cancelled') { %>
                    <span class="inline-flex text-[11px] font-bold rounded-full bg-gray-100 text-gray-600 items-center px-3 py-1">Cancelled</span>
                  <% } else if (order.paymentStatus === 'refunded') { %>
                    <span class="inline-flex text-[11px] font-bold rounded-full bg-blue-50 text-blue-700 items-center px-3 py-1">Refunded</span>
                  <% } %>
                </div>
              </div>

              <!-- Order Body -->
              <div class="p-8 flex flex-col lg:flex-row items-center gap-6 relative">
                <% if (order.courseId) { %>
                  <% const course = order.courseId; %>
                  <!-- Image -->
                  <div class="w-full lg:w-48 h-32 shrink-0 rounded-2xl overflow-hidden bg-gray-100 shadow-sm border border-gray-100">
                    <% if (course.thumbnail) { %>
                      <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <div class="w-full h-full bg-blue-50"></div>
                    <% } %>
                  </div>

                  <!-- Details -->
                  <div class="flex-1 flex flex-col justify-center text-center lg:text-left">
                    <h3 class="text-xl font-bold text-gray-900 mb-1"><%= course.title %></h3>
                    <p class="text-sm text-gray-500 font-medium mb-4">Instructor: Velora Expert</p>
                    
                    <div class="flex flex-wrap justify-center lg:justify-start items-center gap-4">
                      <% if (order.paymentStatus === 'paid' || order.paymentStatus === 'completed') { %>
                        <a href="/user/courses/<%= course._id %>" class="inline-flex justify-center items-center px-6 py-2.5 text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full shadow-sm">
                          <%= (order.courseProgress && order.courseProgress > 0) ? 'Continue Learning' : 'Start Learning' %>
                        </a>
                      <% } else if (order.paymentStatus === 'pending' || order.paymentStatus === 'failed') { %>
                        <button onclick="retryPayment('<%= order._id %>')" id="retryBtn-<%= order._id %>" class="inline-flex justify-center items-center px-6 py-2.5 text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full shadow-sm">
                          Retry Payment
                        </button>
                      <% } %>
                      <button onclick="toggleOrderDetails('<%= order._id %>')" class="text-sm font-bold text-blue-600 hover:text-blue-800 focus:outline-none">
                        <span id="toggle-text-<%= order._id %>">View Details</span>
                      </button>
                    </div>
                  </div>

                  <!-- Price -->
                  <div class="mt-4 lg:mt-0 text-center lg:text-right w-full lg:w-auto self-center">
                    <p class="text-2xl font-black text-gray-900">₹<%= order.finalAmount.toFixed(2) %></p>
                  </div>
                <% } else { %>
                  <div class="p-8 text-center text-sm text-gray-500 italic font-medium w-full">Course not found.</div>
                <% } %>
              </div>

              <!-- Accordion Details (Hidden by default) -->
              <div id="order-details-<%= order._id %>" class="hidden border-t border-gray-100 bg-gray-50/50">
                <div class="p-8">
                  <div class="flex flex-col md:flex-row justify-between gap-6">
                    <!-- Left: Status & Actions -->
                    <div class="flex-1 space-y-4">
                      <% if (order.paymentStatus === 'failed' && order.failureReason) { %>
                        <div class="p-4 bg-red-50 rounded-xl border border-red-100 flex items-start max-w-sm">
                          <svg class="w-5 h-5 text-red-500 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                          <div>
                            <p class="text-sm font-bold text-red-800 uppercase tracking-wide">Payment Failed</p>
                            <p class="text-sm font-medium text-red-600 mt-1"><%= order.failureReason %></p>
                          </div>
                        </div>
                      <% } %>

                      <% if (order.paymentStatus === 'paid' || order.paymentStatus === 'refunded') { %>
                        <!-- Changed invoice download path to use the VEL- receipt ID! -->
                        <a href="/user/orders/<%= order.orderId %>/invoice" class="inline-flex justify-center items-center py-2 px-5 border border-gray-200 rounded-lg shadow-sm text-sm font-bold text-gray-700 bg-white hover:bg-gray-50 transition-colors mb-2 mr-2">
                          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                          Download Invoice
                        </a>
                        
                        <% const daysSincePurchase = (new Date() - new Date(order.createdAt)) / (1000 * 60 * 60 * 24); %>
                        <% if (order.refundStatus) { %>
                          <div class="flex flex-col w-max mt-2">
                            <% if (order.refundStatus === 'pending') { %>
                              <span class="inline-flex justify-center items-center py-2 px-5 border border-yellow-200 rounded-lg shadow-sm text-sm font-bold text-yellow-700 bg-yellow-50 cursor-not-allowed">
                                Refund Pending
                              </span>
                            <% } else if (order.refundStatus === 'approved') { %>
                              <span class="inline-flex justify-center items-center py-2 px-5 border border-green-200 rounded-lg shadow-sm text-sm font-bold text-green-700 bg-green-50">
                                Refund Approved
                              </span>
                            <% } else if (order.refundStatus === 'rejected') { %>
                              <span class="inline-flex justify-center items-center py-2 px-5 border border-red-200 rounded-lg shadow-sm text-sm font-bold text-red-700 bg-red-50">
                                Refund Rejected
                              </span>
                            <% } %>
                            <% if (order.refundReason) { %>
                              <div class="p-3 bg-white border border-gray-200 rounded-lg mt-3 w-full max-w-sm shadow-sm">
                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Refund Reason</span>
                                <p class="text-xs font-medium text-gray-700 line-clamp-3"><%= order.refundReason %></p>
                              </div>
                            <% } %>
                          </div>
                        <% } else if (daysSincePurchase <= 5 && order.paymentStatus === 'paid') { %>
                          <button onclick="openRefundModal('<%= order._id %>')" class="inline-flex justify-center items-center py-2 px-5 border border-gray-200 rounded-lg shadow-sm text-sm font-bold text-red-600 bg-white hover:bg-red-50 transition-colors mb-2">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z"></path></svg>
                            Request Refund
                          </button>
                        <% } %>
                      <% } else if (order.paymentStatus === 'pending') { %>
                        <button onclick="cancelPendingOrder('<%= order._id %>')" class="inline-flex justify-center items-center py-2 px-5 border border-red-200 rounded-lg shadow-sm text-sm font-bold text-red-600 bg-red-50 hover:bg-red-100 transition-colors mb-2">
                          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                          Cancel Order
                        </button>
                      <% } %>
                    </div>

                    <!-- Right: Summary Totals -->
                    <div class="w-full md:w-72 space-y-3 bg-white p-6 rounded-xl border border-gray-100 text-sm shadow-sm">
                      <div class="flex justify-between text-gray-500 font-medium">
                        <span>Subtotal</span>
                        <span>₹<%= (order.subtotal || 0).toFixed(2) %></span>
                      </div>
                      <% if (order.courseDiscount > 0) { %>
                        <div class="flex justify-between text-gray-500 font-medium">
                          <span>Course Discount</span>
                          <span class="text-green-600 font-bold">-₹<%= order.courseDiscount.toFixed(2) %></span>
                        </div>
                      <% } %>
                      <% if (order.couponDiscount > 0) { %>
                        <div class="flex justify-between text-gray-500 font-medium">
                          <span>Coupon Savings</span>
                          <span class="text-green-600 font-bold">-₹<%= order.couponDiscount.toFixed(2) %></span>
                        </div>
                      <% } %>
                      <div class="border-t border-gray-200 my-3"></div>
                      <% 
                         let taxableAmt = (order.subtotal || 0) - (order.courseDiscount || 0) - (order.couponDiscount || 0);
                         let gstAmt = taxableAmt * 0.18;
                      %>
                      <div class="flex justify-between text-gray-500 font-medium">
                        <span>Taxable Amount</span>
                        <span>₹<%= taxableAmt.toFixed(2) %></span>
                      </div>
                      <div class="flex justify-between text-gray-500 font-medium">
                        <span>GST (18%)</span>
                        <span>₹<%= gstAmt.toFixed(2) %></span>
                      </div>
                      <div class="flex justify-between text-gray-900 font-extrabold pt-3 border-t border-gray-200 mt-3 text-lg">
                        <span>Total Paid</span>
                        <span class="text-blue-600">₹<%= order.finalAmount.toFixed(2) %></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- <div class="mt-8 bg-gradient-to-r from-blue-700 to-indigo-600 rounded-3xl p-8 md:p-10 relative overflow-hidden shadow-md">
          <div class="absolute right-0 top-0 bottom-0 opacity-10 pointer-events-none flex items-center pr-8">
            <svg class="w-48 h-48" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2ZM12 5.82L9.89 9.8L5.19 10.48L8.6 13.84L7.8 18.52L12 16.35L16.2 18.52L15.4 13.84L18.81 10.48L14.11 9.8L12 5.82Z"></path></svg>
          </div>
          <div class="relative z-10 max-w-lg">
            <span class="inline-block px-3 py-1 bg-white/20 text-white text-[10px] font-bold uppercase tracking-widest rounded-full mb-4">Recommended for you</span>
            <h3 class="text-2xl font-extrabold text-white mb-2">Ready for the next level?</h3>
            <p class="text-blue-100 mb-6 font-medium text-sm">Based on your recent purchases, you might like the "Product Management 101" masterclass. Get 20% off today.</p>
            <a href="/user/courses" class="inline-block bg-white text-blue-700 font-bold px-6 py-2.5 rounded-full hover:bg-gray-50 transition-colors shadow-sm">Explore Now</a>
          </div>
        </div> -->
      <% } else { %>
        <div class="text-center py-16 bg-white rounded-3xl shadow-sm border border-gray-100">
          <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          <h3 class="mt-4 text-lg font-bold text-gray-900">No orders found</h3>
          <p class="mt-2 text-sm font-medium text-gray-500">You haven't made any purchases yet.</p>
          <div class="mt-6">
            <a href="/user/courses" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-bold rounded-xl text-white bg-blue-600 hover:bg-blue-700">
              Browse Courses
            </a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<!-- Refund Request Modal -->
<div id="refundModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999;">
  <div class="absolute inset-0 bg-black bg-opacity-50 transition-opacity" style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px);" onclick="closeRefundModal()"></div>
  <div class="bg-white rounded-2xl shadow-xl max-w-md w-full relative z-10 overflow-hidden transform transition-all">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
      <h3 class="text-lg font-bold text-gray-900">Request a Refund</h3>
      <button onclick="closeRefundModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <form id="refundForm" method="POST" onsubmit="submitRefund(event)">
      <div class="p-6">
        <p id="error-general" class="mt-1 text-sm text-red-500 hidden"></p>
        <input type="hidden" id="refundOrderId" name="orderId">
        <label for="refundReasonSelect" class="block text-sm font-bold text-gray-700 mb-2">Reason for Refund <span class="text-red-500">*</span></label>
        <select id="refundReasonSelect" required class="w-full border-gray-300 rounded-xl shadow-sm focus:ring-blue-500 focus:border-blue-500 text-sm font-medium p-3 border mb-3" onchange="toggleRefundReasonText()">
          <option value="" disabled selected>Select a reason...</option>
          <option value="Wrong Purchase">Wrong Purchase</option>
          <option value="Duplicate Purchase">Duplicate Purchase</option>
          <option value="Technical Issues">Technical Issues</option>
          <option value="Content Not as Expected">Content Not as Expected</option>
          <option value="Better Alternative">Better Alternative</option>
          <option value="Other">Other (Please specify)</option>
        </select>
        <p id="error-reason" class="mt-1 text-sm text-red-500 hidden"></p>
        <div id="refundReasonTextContainer" class="hidden mt-3">
            <textarea id="refundReasonText" name="comments" rows="3" class="w-full border-gray-300 rounded-xl shadow-sm focus:ring-blue-500 focus:border-blue-500 text-sm font-medium p-3 border" placeholder="Please explain your reason in detail..."></textarea>
            <p id="error-comments" class="mt-1 text-sm text-red-500 hidden"></p>
        </div>
        <p class="mt-2 text-xs text-gray-500 font-medium">Refund requests must be made within 5 days of purchase.</p>
      </div>
      <div class="px-6 py-4 border-t border-gray-100 bg-gray-50/50 flex justify-end space-x-3">
        <button type="button" onclick="closeRefundModal()" class="px-5 py-2.5 rounded-xl border border-gray-200 text-sm font-bold text-gray-700 bg-white hover:bg-gray-50 transition-colors">
          Cancel
        </button>
        <button type="submit" id="refundSubmitBtn" class="px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 transition-colors shadow-sm">
          Submit Request
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRefundModal(orderId) {
    document.getElementById('refundOrderId').value = orderId;
    document.getElementById('refundReasonSelect').value = '';
    document.getElementById('refundReasonText').value = '';
    document.getElementById('refundReasonTextContainer').classList.add('hidden');
    document.getElementById('refundModal').classList.remove('hidden');
  }

  function closeRefundModal() {
    document.getElementById('refundModal').classList.add('hidden');
  }

  function toggleRefundReasonText() {
    const select = document.getElementById('refundReasonSelect');
    const container = document.getElementById('refundReasonTextContainer');
    if (select.value === 'Other') {
        container.classList.remove('hidden');
        document.getElementById('refundReasonText').setAttribute('required', 'required');
    } else {
        container.classList.add('hidden');
        document.getElementById('refundReasonText').removeAttribute('required');
    }
  }

  async function submitRefund(event) {
    event.preventDefault();
    const orderId = document.getElementById('refundOrderId').value;
    const reasonSelect = document.getElementById('refundReasonSelect').value;
    let reason = reasonSelect;
    
    if (reasonSelect === 'Other') {
        reason = document.getElementById('refundReasonText').value;
    }
    
    const btn = document.getElementById('refundSubmitBtn');
    
    btn.disabled = true;
    btn.innerText = 'Submitting...';

    try {
    document.querySelectorAll('#refundForm [id^="error-"]').forEach(el => {
        el.textContent = '';
        el.classList.add('hidden');
    });

    const response = await fetch(`/api/v1/user/orders/${orderId}/refund`, {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({ reason })
    });

    const data = await response.json();

    if (data.success) {
        closeRefundModal();
        setTimeout(() => {
            Swal.fire({ text: data.message, icon: "success" }).then(() => {
                window.location.reload();
            });
        }, 100);
    } else {
        let hasInlineError = false;
        if (data.errors) {
            for (const [field, msg] of Object.entries(data.errors)) {
                const span = document.getElementById(`error-${field}`);
                if (span) {
                    span.textContent = msg;
                    span.classList.remove('hidden');
                    hasInlineError = true;
                }
            }
        }
        if (!hasInlineError) {
            closeRefundModal();
            setTimeout(() => {
                Swal.fire({ text: data.message || 'An error occurred', icon: "error" }).then(() => {
                    document.getElementById('refundModal').classList.remove('hidden');
                });
            }, 100);
        } else {
            btn.disabled = false;
            btn.innerText = "Submit Request";
            return;
        }
    }

} catch (err) {
    console.error(err);
    closeRefundModal();
    setTimeout(() => {
        Swal.fire({ text: "Something went wrong.", icon: "error" }).then(() => {
            document.getElementById('refundModal').classList.remove('hidden');
        });
    }, 100);
} finally {
    btn.disabled = false;
    btn.innerText = "Submit Request";
}  

  }

  function toggleOrderDetails(orderId) {
    const detailsDiv = document.getElementById(`order-details-${orderId}`);
    const icon = document.getElementById(`toggle-icon-${orderId}`);
    const text = document.getElementById(`toggle-text-${orderId}`);
    
    if (detailsDiv.classList.contains('hidden')) {
      detailsDiv.classList.remove('hidden');
      icon.classList.add('rotate-180');
      text.innerText = 'Hide Details';
    } else {
      detailsDiv.classList.add('hidden');
      icon.classList.remove('rotate-180');
      text.innerText = 'View Details';
    }
  }

  async function retryPayment(dbOrderId) {
    const retryBtn = document.getElementById(`retryBtn-${dbOrderId}`);
    if (!retryBtn) return;
    
    const originalText = retryBtn.innerText;
    retryBtn.innerText = "Processing...";
    retryBtn.disabled = true;

    try {
      // 1. Trigger retry payment API
      const res = await fetch("/api/v1/user/payment/retry", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ dbOrderId })
      });
      const data = await res.json();

      if (!data.success) {
        Swal.fire({ text: data.message || "Failed to initiate payment retry.", icon: "error" });
        retryBtn.innerText = originalText;
        retryBtn.disabled = false;
        return;
      }

      // 2. Open Razorpay
      const options = {
        key: "<%= razorpayKeyId %>", 
        amount: data.order.amount,
        currency: data.order.currency,
        name: "Velora",
        description: "Retry Purchase",
        order_id: data.order.id,
        handler: async function (response) {
          // Verify
          const verifyRes = await fetch("/api/v1/user/order/verify", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_order_id: response.razorpay_order_id,
              razorpay_signature: response.razorpay_signature,
              dbOrderIds: data.dbOrderIds
            })
          });
          
          const verifyData = await verifyRes.json();
          if (verifyData.success) {
            window.location.href = "/user/payment-success/" + verifyData.orderId;
          } else {
            Swal.fire({ text: "Payment verification failed. Please contact support.", icon: "error" }).then(() => {
              window.location.reload();
            });
          }
        },
        modal: {
          ondismiss: async function() {
            await fetch("/api/v1/user/payment/cancel", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ dbOrderIds: data.dbOrderIds })
            });
            window.location.reload();
          }
        },
        theme: { color: "#0B5ED7" }
      };

      const rzp = new Razorpay(options);
      rzp.on('payment.failed', async function (response) {
          await fetch("/api/v1/user/payment/failed", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ 
              dbOrderIds: data.dbOrderIds, 
              reason: response.error.description 
            })
          });
          window.location.reload();
      });
      rzp.open();

    } catch (err) {
      console.error(err);
      Swal.fire({ text: "An error occurred. Please try again.", icon: "error" });
      retryBtn.innerText = originalText;
      retryBtn.disabled = false;
    }
  }

  async function cancelPendingOrder(orderId) {
    const result = await Swal.fire({
      title: 'Cancel Order?',
      text: "Are you sure you want to cancel this pending order?",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      cancelButtonColor: '#3085d6',
      confirmButtonText: 'Yes, cancel it'
    });

    if (result.isConfirmed) {
      try {
        const response = await fetch(`/api/v1/user/orders/${orderId}/cancel`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason: "Cancelled by user via dashboard" })
        });
        
        const data = await response.json();
        
        if (data.success) {
          Swal.fire('Cancelled!', 'Your order has been cancelled.', 'success').then(() => {
            window.location.reload();
          });
        } else {
          Swal.fire('Error!', data.message || 'Failed to cancel order', 'error');
        }
      } catch (error) {
        console.error(error);
        Swal.fire('Error!', 'An unexpected error occurred.', 'error');
      }
    }
  }
</script>

