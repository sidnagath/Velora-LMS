<%- include('../../../partials/header') %>

<main class="min-h-screen bg-gray-100 font-sans py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row gap-8">
    
    <!-- SIDEBAR -->
    <aside class="w-full md:w-64 shrink-0 space-y-6">
      
      <!-- Profile Card -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center flex flex-col items-center">
        <% if(user.avatar) { %>
          <img src="<%= user.avatar %>" alt="<%= user.name %>" class="w-20 h-20 rounded-full border-4 border-gray-50 mb-3 object-cover">
        <% } else { %>
          <div class="w-20 h-20 rounded-full bg-blue-100 text-blue-600 border-4 border-gray-50 mb-3 flex items-center justify-center text-2xl font-bold">
            <%= user.name.split(" ").map(word => word[0]).join("").slice(0,2).toUpperCase() %>
          </div>
        <% } %>
        <h3 class="font-extrabold text-gray-900"><%=user.name%></h3>
      </div>

      <!-- Upgrade Button -->
      <button class="w-full bg-[#6B46C1] hover:bg-[#553C9A] text-white font-bold py-3.5 px-4 rounded-xl shadow-md transition-colors flex justify-center items-center">
        Upgrade to Pro
      </button>

      <!-- Navigation Menu -->
      <div class="bg-white rounded-2xl py-4 shadow-sm border border-gray-100">
        <nav class="space-y-1 text-sm font-semibold">
          <a href="/user-profile" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            Account Details
          </a>
          <a href="/user-address" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            Address
          </a>
          <a href="/user-orders" class="flex items-center px-6 py-3 text-blue-600 bg-blue-50/50 border-l-4 border-blue-600 transition-colors">
            <svg class="w-5 h-5 mr-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            Orders
          </a>
          <!-- <a href="/user-wishlist" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            Wishlist
          </a> -->
          <a href="#" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            Wallet
          </a>
          <a href="/user-profile/my-coupons" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
            My Coupons
          </a>
          <div class="pt-4 mt-2 border-t border-gray-100">
            <a href="/user-logout" class="flex items-center px-6 py-3 text-red-600 hover:bg-red-50 transition-colors">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
              Logout
            </a>
          </div>
        </nav>
      </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <div class="flex-1 max-w-4xl space-y-8">
      
      <!-- HEADER Section -->
      <div>
        <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Order History</h2>
        <p class="text-gray-500 max-w-2xl mt-2 font-medium">Keep track of your purchases, check payment statuses, and review your course enrollments all in one place.</p>
      </div>

      <%- include('../../../partials/user-banner') %>

      <% if (orders && orders.length > 0) { %>
        <div class="space-y-4">
          <% orders.forEach((order, index) => { %>
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow">
              
              <!-- Order Header Summary (Always Visible) -->
              <div class="px-6 py-5 flex flex-col md:flex-row md:items-center justify-between gap-4 cursor-pointer" onclick="toggleOrderDetails('<%= order._id %>')">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 flex-1">
                  <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Order ID</p>
                    <p class="text-sm font-bold text-gray-900"><%= order.orderId %></p>
                  </div>
                  <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Date Placed</p>
                    <p class="text-sm font-medium text-gray-900"><%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                  </div>
                  <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Total Amount</p>
                    <p class="text-sm font-bold text-blue-600">₹<%= order.finalAmount.toFixed(2) %></p>
                  </div>
                  <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Status</p>
                    <% if (order.paymentStatus === 'paid') { %>
                      <span class="inline-flex text-[11px] font-bold rounded-full bg-green-50 text-green-700 items-center px-2 py-0.5 border border-green-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span>Paid
                      </span>
                    <% } else if (order.paymentStatus === 'pending') { %>
                      <span class="inline-flex text-[11px] font-bold rounded-full bg-yellow-50 text-yellow-700 items-center px-2 py-0.5 border border-yellow-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 mr-1.5"></span>Pending
                      </span>
                    <% } else if (order.paymentStatus === 'failed') { %>
                      <span class="inline-flex text-[11px] font-bold rounded-full bg-red-50 text-red-600 items-center px-2 py-0.5 border border-red-100">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span>Failed
                      </span>
                    <% } else if (order.paymentStatus === 'cancelled') { %>
                      <span class="inline-flex text-[11px] font-bold rounded-full bg-gray-100 text-gray-600 items-center px-2 py-0.5 border border-gray-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-gray-500 mr-1.5"></span>Cancelled
                      </span>
                    <% } %>
                  </div>
                </div>
                
                <div class="flex items-center justify-end text-gray-400">
                  <span class="text-xs font-semibold mr-2 select-none" id="toggle-text-<%= order._id %>">View Details</span>
                  <svg id="toggle-icon-<%= order._id %>" class="w-5 h-5 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
              </div>

              <!-- Accordion Body (Hidden by default) -->
              <div id="order-details-<%= order._id %>" class="hidden border-t border-gray-50 bg-gray-50/50">
                <div class="p-6">
                  <!-- Courses List -->
                  <h4 class="text-xs font-bold text-gray-500 mb-3 uppercase tracking-wider">Purchased Courses</h4>
                  <div class="space-y-3 mb-6">
                    <% if (order.courses && order.courses.length > 0) { %>
                      <% order.courses.forEach(course => { %>
                        <div class="flex items-center bg-white p-3 rounded-xl border border-gray-100">
                          <div class="w-16 h-12 rounded-lg bg-gray-100 overflow-hidden flex-shrink-0">
                            <% if (course.thumbnail) { %>
                              <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
                            <% } else { %>
                              <div class="w-full h-full bg-blue-50"></div>
                            <% } %>
                          </div>
                          <div class="ml-4 flex-1">
                            <a href="/courses/<%= course._id %>" class="text-sm font-bold text-gray-900 hover:text-blue-600 transition-colors line-clamp-1"><%= course.title %></a>
                            <p class="text-[10px] font-medium text-gray-500 uppercase tracking-wider mt-0.5"><%= course.level || 'Beginner' %> Level</p>
                          </div>
                          <div class="text-right ml-4">
                            <% if (course.discountPrice && course.discountPrice < course.basePrice) { %>
                              <p class="text-sm font-bold text-gray-900">₹<%= course.discountPrice %></p>
                            <% } else { %>
                              <p class="text-sm font-bold text-gray-900">₹<%= course.basePrice || 0 %></p>
                            <% } %>
                          </div>
                        </div>
                      <% }) %>
                    <% } else { %>
                      <p class="text-sm text-gray-500 italic font-medium">No items found.</p>
                    <% } %>
                  </div>

                  <!-- Breakdown & Actions -->
                  <div class="flex flex-col md:flex-row justify-between gap-6">
                    <!-- Left: Status & Retry -->
                    <div class="flex-1 space-y-4">
                      <div class="flex gap-4 text-xs">
                        <div>
                          <span class="font-bold text-gray-400 uppercase">Payment Method</span>
                          <p class="font-medium text-gray-900 capitalize mt-0.5"><%= order.paymentMethod %></p>
                        </div>
                        <% if (order.razorpayPaymentId) { %>
                        <div>
                          <span class="font-bold text-gray-400 uppercase">Transaction ID</span>
                          <p class="font-medium text-gray-900 mt-0.5"><%= order.razorpayPaymentId %></p>
                        </div>
                        <% } %>
                      </div>

                      <% if (order.paymentStatus === 'failed' && order.failureReason) { %>
                        <div class="p-3 bg-red-50 rounded-lg border border-red-100 flex items-start max-w-sm">
                          <svg class="w-4 h-4 text-red-500 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                          <div>
                            <p class="text-xs font-bold text-red-800 uppercase tracking-wide">Payment Failed</p>
                            <p class="text-xs font-medium text-red-600 mt-0.5"><%= order.failureReason %></p>
                          </div>
                        </div>
                      <% } %>

                      <% if (order.paymentStatus === 'failed' || order.paymentStatus === 'pending') { %>
                        <button onclick="retryPayment('<%= order._id %>')" id="retryBtn-<%= order._id %>" class="inline-flex justify-center py-2.5 px-6 border border-transparent rounded-xl shadow-sm text-sm font-bold text-white bg-[#0B5ED7] hover:bg-[#0A58CA] transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                          Retry Payment
                        </button>
                      <% } %>
                    </div>

                    <!-- Right: Summary Totals -->
                    <div class="w-full md:w-64 space-y-2 bg-white p-4 rounded-xl border border-gray-100 text-sm">
                      <div class="flex justify-between text-gray-500 font-medium">
                        <span>Subtotal</span>
                        <span>₹<%= (order.subtotal || 0).toFixed(2) %></span>
                      </div>
                      <% if (order.courseDiscount > 0) { %>
                        <div class="flex justify-between text-gray-500 font-medium">
                          <span>Course Discount</span>
                          <span class="text-green-600 font-bold">-₹<%= order.courseDiscount.toFixed(2) %></span>
                        </div>
                      <% } %>
                      <% if (order.couponDiscount > 0) { %>
                        <div class="flex justify-between text-gray-500 font-medium">
                          <span>Coupon Savings</span>
                          <span class="text-green-600 font-bold">-₹<%= order.couponDiscount.toFixed(2) %></span>
                        </div>
                      <% } %>
                      <div class="flex justify-between text-gray-900 font-extrabold pt-2 border-t border-gray-100 mt-2">
                        <span>Total Paid</span>
                        <span class="text-blue-600">₹<%= order.finalAmount.toFixed(2) %></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-16 bg-white rounded-3xl shadow-sm border border-gray-100">
          <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          <h3 class="mt-4 text-lg font-bold text-gray-900">No orders found</h3>
          <p class="mt-2 text-sm font-medium text-gray-500">You haven't made any purchases yet.</p>
          <div class="mt-6">
            <a href="/courses" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-bold rounded-xl text-white bg-blue-600 hover:bg-blue-700">
              Browse Courses
            </a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  function toggleOrderDetails(orderId) {
    const detailsDiv = document.getElementById(`order-details-${orderId}`);
    const icon = document.getElementById(`toggle-icon-${orderId}`);
    const text = document.getElementById(`toggle-text-${orderId}`);
    
    if (detailsDiv.classList.contains('hidden')) {
      detailsDiv.classList.remove('hidden');
      icon.classList.add('rotate-180');
      text.innerText = 'Hide Details';
    } else {
      detailsDiv.classList.add('hidden');
      icon.classList.remove('rotate-180');
      text.innerText = 'View Details';
    }
  }

  async function retryPayment(dbOrderId) {
    const retryBtn = document.getElementById(`retryBtn-${dbOrderId}`);
    if (!retryBtn) return;
    
    const originalText = retryBtn.innerText;
    retryBtn.innerText = "Processing...";
    retryBtn.disabled = true;

    try {
      // 1. Trigger retry payment API
      const res = await fetch("/api/retry-payment", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ dbOrderId })
      });
      const data = await res.json();

      if (!data.success) {
        alert(data.message || "Failed to initiate payment retry.");
        retryBtn.innerText = originalText;
        retryBtn.disabled = false;
        return;
      }

      // 2. Open Razorpay
      const options = {
        key: "<%= razorpayKeyId %>", 
        amount: data.order.amount,
        currency: data.order.currency,
        name: "Velora",
        description: "Retry Purchase",
        order_id: data.order.id,
        handler: async function (response) {
          // Verify
          const verifyRes = await fetch("/api/verify-payment", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_order_id: response.razorpay_order_id,
              razorpay_signature: response.razorpay_signature,
              dbOrderId: data.dbOrderId
            })
          });
          
          const verifyData = await verifyRes.json();
          if (verifyData.success) {
            window.location.href = "/payment-success/" + verifyData.orderId;
          } else {
            alert("Payment verification failed. Please contact support.");
            window.location.reload();
          }
        },
        modal: {
          ondismiss: async function() {
            await fetch("/payment/cancel", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ dbOrderId: data.dbOrderId })
            });
            window.location.reload();
          }
        },
        theme: { color: "#0B5ED7" }
      };

      const rzp = new Razorpay(options);
      rzp.on('payment.failed', async function (response) {
          await fetch("/payment/failed", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ 
              dbOrderId: data.dbOrderId, 
              reason: response.error.description 
            })
          });
          window.location.reload();
      });
      rzp.open();

    } catch (err) {
      console.error(err);
      alert("An error occurred. Please try again.");
      retryBtn.innerText = originalText;
      retryBtn.disabled = false;
    }
  }
</script>

<%- include('../../../partials/footer') %>
