<%- include('../../../partials/header') %>

<main class="min-h-screen bg-gray-50 py-10 px-4">

  <div class="max-w-3xl mx-auto">

    <!-- HEADER -->
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
        Edit Address
      </h1>

      <p class="text-gray-500 mt-2 text-sm">
        Update your delivery and billing address information.
      </p>
    </div>

    <%- include('../../../partials/user-banner') %>

    <!-- CARD -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">

      <form
        id="editAddressForm"
        method="PATCH"
        action="/api/v1/user/profile/address"
        class="space-y-8"
      >
<p id="error-general" class="mt-1 text-sm font-medium text-red-500 <%= errors?.general ? '' : 'hidden' %>" style="color: #EF4444;">
  <%= errors?.general || '' %>
</p>

        <!-- FORM GRID -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              Address Line 1
            </label>

            <input
              type="text"
              name="addressLine1"
              value="<%= formData?.addressLine1 || '' %>"
              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
            >
<p id="error-addressLine1" class="mt-1 text-sm font-medium text-red-500 <%= errors?.addressLine1 ? '' : 'hidden' %>" style="color: #EF4444;">
  <%= errors?.addressLine1 || '' %>
</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              Address Line 2 <span class="text-gray-400 font-normal normal-case">(Optional)</span>
            </label>

            <input
              type="text"
              name="addressLine2"
              value="<%= formData?.addressLine2 || '' %>"
              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
            >
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              City
            </label>

            <input
              type="text"
              name="city"
              value="<%= formData?.city || '' %>"
              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
            >
<p id="error-city" class="mt-1 text-sm font-medium text-red-500 <%= errors?.city ? '' : 'hidden' %>" style="color: #EF4444;">
  <%= errors?.city || '' %>
</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              State
            </label>

            <input
              type="text"
              name="state"
              value="<%= formData?.state || '' %>"
              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
            >
<p id="error-state" class="mt-1 text-sm font-medium text-red-500 <%= errors?.state ? '' : 'hidden' %>" style="color: #EF4444;">
  <%= errors?.state || '' %>
</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              Country
            </label>

            <input
              type="text"
              name="country"
              value="<%= formData?.country || '' %>"
              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
            >
<p id="error-country" class="mt-1 text-sm font-medium text-red-500 <%= errors?.country ? '' : 'hidden' %>" style="color: #EF4444;">
  <%= errors?.country || '' %>
</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              Postal Code
            </label>

            <input
              type="text"
              name="postalCode"
              value="<%= formData?.postalCode || '' %>"
              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
            >
<p id="error-postalCode" class="mt-1 text-sm font-medium text-red-500 <%= errors?.postalCode ? '' : 'hidden' %>" style="color: #EF4444;">
  <%= errors?.postalCode || '' %>
</p>
          </div>

        </div>

        <!-- ACTIONS -->
        <div class="flex flex-wrap gap-4 pt-4">

          <button
            type="submit"
            class="bg-blue-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-sm hover:bg-blue-700 transition-colors"
          >
            Save Address
          </button>
      
          <a
            href="/user/address"
            class="bg-gray-100 text-gray-700 font-bold py-3.5 px-8 rounded-xl hover:bg-gray-200 transition-colors flex items-center"
          >
            Cancel
          </a>

        </div>

      </form>

    </div>

  </div>

</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('editAddressForm');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      
      // Clear previous errors
      ['general', 'addressLine1', 'city', 'state', 'country', 'postalCode'].forEach(field => {
        const errorEl = document.getElementById(`error-${field}`);
        if (errorEl) {
            errorEl.innerText = '';
            errorEl.classList.add('hidden');
        }
      });
      
      try {
        const res = await fetch(form.action, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        const result = await res.json();
        
        if (result.success) {
          Swal.fire({ icon: 'success', title: 'Success', text: result.message }).then(() => {
            window.location.href = '/user/address';
          });
        } else {
          if (result.errors && Object.keys(result.errors).length > 0) {
            let hasInlineError = false;
            for (const field in result.errors) {
              const errorEl = document.getElementById(`error-${field}`);
              if (errorEl) {
                errorEl.innerText = result.errors[field];
                errorEl.classList.remove('hidden');
                hasInlineError = true;
              }
            }
            if (!hasInlineError) {
              Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'Validation failed' });
            }
          } else {
             Swal.fire({ icon: 'error', title: 'Error', text: result.message });
          }
        }
      } catch (err) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred' });
      }
    });
  }
});
</script>

<%- include('../../../partials/footer') %>
