<%- include('../../../partials/header') %>

<main class="min-h-screen bg-gray-100 font-sans py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row gap-8">
    
    <!-- SIDEBAR -->
    <aside class="w-full md:w-64 shrink-0 space-y-6">
      
      <!-- Profile Card -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center flex flex-col items-center">
        <% if(user.avatar) { %>
          <img src="<%= user.avatar %>" alt="<%= user.name %>" class="w-20 h-20 rounded-full border-4 border-gray-50 mb-3 object-cover">
        <% } else { %>
          <div class="w-20 h-20 rounded-full bg-blue-100 text-blue-600 border-4 border-gray-50 mb-3 flex items-center justify-center text-2xl font-bold">
            <%= user.name.split(" ").map(word => word[0]).join("").slice(0,2).toUpperCase() %>
          </div>
        <% } %>
        <h3 class="font-extrabold text-gray-900"><%=user.name%></h3>
      </div>

      <!-- Upgrade Button -->
      <button class="w-full bg-[#6B46C1] hover:bg-[#553C9A] text-white font-bold py-3.5 px-4 rounded-xl shadow-md transition-colors flex justify-center items-center">
        Upgrade to Pro
      </button>

      <!-- Navigation Menu -->
      <div class="bg-white rounded-2xl py-4 shadow-sm border border-gray-100">
        <nav class="space-y-1 text-sm font-semibold">
          <a href="/user/profile" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            Account Details
          </a>
          <a href="/user/address" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            Address
          </a>
          <a href="/user/orders" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            Orders
          </a>
          <a href="/user/wallet" class="flex items-center px-6 py-3 text-blue-600 bg-blue-50/50 border-l-4 border-blue-600 transition-colors">
            <svg class="w-5 h-5 mr-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            Wallet
          </a>
          <a href="/user/coupons" class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 border-l-4 border-transparent transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
            My Coupons
          </a>
          <div class="pt-4 mt-2 border-t border-gray-100">
            <a href="/user/logout" class="flex items-center px-6 py-3 text-red-600 hover:bg-red-50 transition-colors">
              <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
              Logout
            </a>
          </div>
        </nav>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="flex-1 space-y-6">
      
      <!-- Top Section -->
      <div class="flex flex-col md:flex-row gap-6 mb-8">
        <!-- Balance Card -->
        <div class="flex-1 rounded-3xl p-10 text-white relative overflow-hidden" style="background: linear-gradient(135deg, #4A78D5, #678CE1);">
          <div class="relative z-10">
            <h3 class="text-sm font-medium text-blue-100 mb-2">Available Balance</h3>
            <div class="text-5xl font-bold tracking-tight mb-8">
              ₹<%= (wallet && typeof wallet.balance === 'number') ? wallet.balance.toFixed(2) : '0.00' %>
            </div>
            <p class="text-sm text-blue-100 max-w-sm leading-relaxed">Use your wallet balance during checkout for instant course enrollment and special rewards.</p>
          </div>
        </div>

        <!-- Action Buttons Card -->
        <div class="bg-white rounded-3xl p-8 shadow-xl w-full md:w-80 shrink-0 flex flex-col justify-center gap-4 border border-gray-100">
          <button class="w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-3.5 px-6 rounded-2xl transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add Money
          </button>
          <button class="w-full bg-purple-400 hover:bg-purple-500 text-white font-bold py-3.5 px-6 rounded-2xl transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            Withdraw
          </button>
        </div>
      </div>

      <!-- Transaction History -->
      <div class="bg-white rounded-3xl p-8 shadow-xl border border-gray-100">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
          <h3 class="text-xl font-bold text-gray-900">Transaction History</h3>
          <div class="flex bg-gray-100 rounded-full p-1 text-sm font-semibold">
            <button class="px-5 py-1.5 bg-white text-blue-600 rounded-full shadow-sm">All</button>
            <button class="px-5 py-1.5 text-gray-500 hover:text-gray-700 rounded-full transition-colors">Credits</button>
            <button class="px-5 py-1.5 text-gray-500 hover:text-gray-700 rounded-full transition-colors">Debits</button>
          </div>
        </div>
        
        <% if(wallet.transactions && wallet.transactions.length > 0) { %>
          <div class="space-y-6">
            <% wallet.transactions.forEach(tx => { %>
              <div class="flex justify-between items-center">
                <div class="flex items-center gap-4">
                  <% if(tx.type === 'credit') { %>
                    <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600 shrink-0">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
                    </div>
                  <% } else { %>
                    <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center text-red-600 shrink-0">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
                    </div>
                  <% } %>
                  <div>
                    <h4 class="text-sm font-bold text-gray-900"><%= tx.description %></h4>
                    <p class="text-xs text-gray-500 mt-1"><%= new Date(tx.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                  </div>
                </div>
                <div class="text-right">
                  <% if(tx.type === 'credit') { %>
                    <div class="text-sm font-extrabold text-green-600">+₹<%= tx.amount.toFixed(2) %></div>
                    <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1 flex items-center justify-end gap-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> SUCCESS</div>
                  <% } else { %>
                    <div class="text-sm font-extrabold text-red-600">-₹<%= tx.amount.toFixed(2) %></div>
                    <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1 flex items-center justify-end gap-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> SUCCESS</div>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
          <div class="mt-8 pt-6 border-t border-gray-100 text-center">
            <a href="#" class="text-sm font-bold text-blue-700 hover:underline">View All Transactions</a>
          </div>
        <% } else { %>
          <div class="text-center py-12">
            <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <p class="text-gray-500 font-medium">No transactions found.</p>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</main>

<%- include('../../../partials/footer') %>
