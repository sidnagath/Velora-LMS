
<%- include('../../../partials/header') %>

<main class="min-h-screen bg-gray-50 py-10 px-4">

  <div class="max-w-3xl mx-auto">

    <!-- HEADER -->
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
        Edit Profile
      </h1>

      <p class="text-gray-500 mt-2 text-sm">
        Update your personal information and profile details.
      </div>

      <%- include('../../../partials/user-banner') %>

      <!-- CARD -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">

      <form
        id="editProfileForm"
        method="PATCH"
        action="/api/v1/user/profile"
        class="space-y-8"
      >
<p id="error-general" class="mt-1 text-sm font-medium text-red-500 <%= errors?.general ? '' : 'hidden' %>" style="color: #EF4444;">
  <%= errors?.general || '' %>
</p>


        <!-- FORM GRID -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              Full Name
            </label>

            <input
              type="text"
              name="name"
              value="<%= formData?.name || user?.name || '' %>"
             

              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
            >
            <p id="error-name" class="mt-1 text-sm font-medium text-red-500 <%= errors?.name ? '' : 'hidden' %>" style="color: #EF4444;">
              <%= errors?.name || '' %>
            </p>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              Email Address
            </label>

<% const isGoogleUser = user?.authProvider === 'google'; %>
            <input
              type="email"
              name="email"
              value="<%= formData?.email || user?.email || '' %>"
              <%= isGoogleUser ? "readonly" : "" %>
              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none <%= isGoogleUser ? 'opacity-70 cursor-not-allowed' : '' %>"
            >

<% if(isGoogleUser) { %>
<p class="mt-2 text-xs text-gray-500">
  Email is managed through your Google account and cannot be changed.
</p>
<% } %>

            <p id="error-email" class="mt-1 text-sm font-medium text-red-500 <%= errors?.email ? '' : 'hidden' %>" style="color: #EF4444;">
              <%= errors?.email || '' %>
            </p>
          </div>

        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              Phone Number
            </label>

            <input
              type="tel"
              name="phone"
              value="<%= formData?.phone || user?.phone || '' %>"

              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
            >
            <p id="error-phone" class="mt-1 text-sm font-medium text-red-500 <%= errors?.phone ? '' : 'hidden' %>" style="color: #EF4444;">
              <%= errors?.phone || '' %>
            </p>
          </div>

          <% if (!isGoogleUser) { %>
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              Current Password <span class="text-xs font-normal text-gray-400 normal-case">(required to change email)</span>
            </label>

            <div class="relative">
              <input
                type="password"
                name="currentPassword"
                placeholder="••••••••"
                class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none pr-10"
              >
              <div class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer text-gray-400 hover:text-gray-600 toggle-password">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
              </div>
            </div>
            <p id="error-currentPassword" class="mt-1 text-sm font-medium text-red-500 <%= errors?.currentPassword ? '' : 'hidden' %>" style="color: #EF4444;">
              <%= errors?.currentPassword || '' %>
            </p>
          </div>
          <% } %>
        </div>

        <!-- ACTIONS -->
        <div class="flex flex-wrap gap-4 pt-4">

          <button
            type="submit"
            class="bg-blue-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-sm hover:bg-blue-700 transition-colors"
          >
            Save Changes
          </button>
      

          <a
            href="/user/profile"
            class="bg-gray-100 text-gray-700 font-bold py-3.5 px-8 rounded-xl hover:bg-gray-200 transition-colors"
          >
            Cancel
          </a>

        </div>

      </form>

    </div>

  </div>

</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('editProfileForm');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      
      // Clear previous errors
      ['name', 'email', 'phone', 'currentPassword', 'general'].forEach(field => {
        const errorEl = document.getElementById(`error-${field}`);
        if (errorEl) {
            errorEl.innerText = '';
            errorEl.classList.add('hidden');
        }
      });
      
      try {
        const res = await fetch(form.action, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        const result = await res.json();
        
        if (result.success) {
          if (result.data && result.data.redirect === "/user/verify-email-change-otp") {
            Swal.fire({
              icon: 'info',
              title: 'Email Change Verification',
              text: result.message
            }).then(() => {
              window.location.href = result.data.redirect;
            });
          } else if (result.data && result.data.redirect) {
            Swal.fire({ icon: 'success', title: 'Success', text: result.message }).then(() => {
              window.location.href = result.data.redirect;
            });
          } else {
            Swal.fire({ icon: 'success', title: 'Success', text: result.message }).then(() => {
              window.location.href = '/user/profile';
            });
          }
        } else {
          if (result.errors && Object.keys(result.errors).length > 0) {
            let hasInlineError = false;
            for (const field in result.errors) {
              const errorEl = document.getElementById(`error-${field}`);
              if (errorEl) {
                errorEl.innerText = result.errors[field];
                errorEl.classList.remove('hidden');
                hasInlineError = true;
              }
            }
            if (!hasInlineError) {
              Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'Validation failed' });
            }
          } else {
             Swal.fire({ icon: 'error', title: 'Error', text: result.message });
          }
        }
      } catch (err) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred' });
      }
    });
  }
});
</script>

<%- include('../../../partials/footer') %>
