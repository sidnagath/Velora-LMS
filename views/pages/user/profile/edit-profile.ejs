
<%- include('../../../partials/header') %>

<main class="min-h-screen bg-gray-50 py-10 px-4">

  <div class="max-w-3xl mx-auto">

    <!-- HEADER -->
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
        Edit Profile
      </h1>

      <p class="text-gray-500 mt-2 text-sm">
        Update your personal information and profile details.
      </p>
    </div>

    <!-- CARD -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">

      <form
        method="POST"
        action="/user-profile/edit"
        class="space-y-8"
      >
<% if(errors?.general){ %>
<p class="mt-1 text-sm font-medium text-red-500" style="color: var(--color-red-500);">
  <%= errors.general %>
</p>
<% } %>


        <!-- FORM GRID -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              Full Name
            </label>

            <input
              type="text"
              name="name"
              value="<%= formData?.name || user?.name || '' %>"
             

              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
            >
<% if(errors?.name){ %>
<p class="mt-1 text-sm font-medium text-red-500" style="color: var(--color-red-500);">
  <%= errors.name %>
</p>
<% } %>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
              Email Address
            </label>

            <input
              type="email"
              name="email"
              value="<%= formData?.email || user?.email || '' %>"
             

              class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
            >

<% if(errors?.email){ %>
<p class="mt-1 text-sm font-medium text-red-500" style="color: var(--color-red-500);">
  <%= errors.email %>
</p>
<% } %>
          </div>

        </div>

        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
            Phone Number
          </label>

          <input
            type="tel"
            name="phone"
            value="<%= formData?.phone || user?.phone || '' %>"

            class="w-full px-4 py-3 rounded-xl bg-gray-100 border border-transparent focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none"
          >
<% if(errors?.phone){ %>
<p class="mt-1 text-sm font-medium text-red-500" style="color: var(--color-red-500);">
  <%= errors.phone %>
</p>
<% } %>
        </div>

        <!-- ACTIONS -->
        <div class="flex flex-wrap gap-4 pt-4">

          <button
            type="submit"
            class="bg-blue-600 text-white font-bold py-3.5 px-8 rounded-xl shadow-sm hover:bg-blue-700 transition-colors"
          >
            Save Changes
          </button>
      

          <a
            href="/user-profile/edit"
            class="bg-gray-100 text-gray-700 font-bold py-3.5 px-8 rounded-xl hover:bg-gray-200 transition-colors"
          >
            Cancel
          </a>

        </div>

      </form>

    </div>

  </div>

</main>

<%- include('../../../partials/footer') %>





