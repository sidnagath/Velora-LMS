  <%- include('../../../partials/header') %>

<main class="flex-grow flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
        <!-- Verify email change OTP Card -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-10 text-center flex flex-col items-center">
            
            <!-- Icon -->
            <div class="w-16 h-16 bg-[#EEF2FF] rounded-full flex items-center justify-center mb-6">
                <div class="w-10 h-10 bg-[#0B5ED7] rounded-full flex items-center justify-center text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>

     <!-- Header Text -->
            <h2 class="text-2xl font-bold text-gray-900 mb-3 tracking-tight">Verify OTP</h2>
            <p class="text-gray-500 text-sm mb-8 px-4 leading-relaxed">
                Enter the verification code sent to your email
            </p>
            
            <%- include('../../../partials/user-banner') %>

               <% if(errors?.general){ %>
               <p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
               <%= errors.general %>
               </p>
               <% } %>
               <p id="error-general" class="mt-1 text-sm text-red-500 hidden"></p>

            <form id="verifyOtpForm" action="/api/v1/user/profile/verify-email-otp" method="POST" class="w-full text-left space-y-6">
                <div>
                    <label class="block text-xs font-medium text-gray-500 tracking-wide uppercase mb-2">Verification Code</label>
                    <div class="relative">
                        <input type="text" name="otp" class="input-field bg-gray-50 text-center tracking-[0.5em] text-lg font-semibold" placeholder="••••••">
                        <p id="error-otp" class="mt-1 text-sm text-red-500 hidden"></p>
                    </div>
                </div>

                <% if(errors?.otp){ %>
               <p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
               <%= errors.otp %>
               </p>
               <% } %>

                <button type="submit" class="btn-primary w-full text-center block mb-6">Verify Code</button>
            </form>

<div class="text-center mt-4 space-y-3">

  <!-- TIMER TEXT -->

<p id="timerText" class="text-sm text-gray-500">
  OTP expires in
  <span id="otpTimer" class="font-semibold text-[#0B5ED7]">
    01:00
  </span>
</p>

  <!-- RESEND FORM -->

  <form
    id="resendOtpForm"
    action="/api/v1/user/profile/resend-otp"
    method="POST"
  >

    <button
      id="resendBtn"
      type="submit"
      disabled
      class="text-sm font-medium text-gray-400 cursor-not-allowed"
    >

      Resend OTP

    </button>

  </form>

</div>
            
        </div>
        
        <p class="text-center text-xs text-gray-400 uppercase tracking-widest mt-8">Secure authentication for Velora</p>
    </div>
</main>

<script>

const otpExpiry =
    <%= otpExpires || 0 %>;

 const timerElement =
  document.getElementById(
    "otpTimer"
  );

const resendBtn =
  document.getElementById(
    "resendBtn"
  );

const timerText =
  document.getElementById(
    "timerText"
  );

function updateTimer() {

  const remaining =
    Math.floor(
      (otpExpiry - Date.now())
      / 1000
    );

  if (remaining <= 0) {

    timerElement.innerText =
      "00:00";

    timerText.innerHTML =
      '<span class="text-red-500 font-medium">OTP expired</span>';

    resendBtn.disabled =
      false;

    resendBtn.classList.remove(
      "text-gray-400",
      "cursor-not-allowed"
    );

    resendBtn.classList.add(
      "text-blue-600"
    );

    return;

  }

  const minutes =
    String(
      Math.floor(
        remaining / 60
      )
    ).padStart(2, "0");

  const seconds =
    String(
      remaining % 60
    ).padStart(2, "0");

  timerElement.innerText =
    `${minutes}:${seconds}`;

}

updateTimer();

setInterval(
  updateTimer,
  1000
);

document.addEventListener('DOMContentLoaded', () => {
  const verifyForm = document.getElementById('verifyOtpForm');
  const resendForm = document.getElementById('resendOtpForm');

  if (verifyForm) {
    verifyForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(verifyForm);
      const data = Object.fromEntries(formData.entries());
      
      try {
        const res = await fetch(verifyForm.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        const result = await res.json();
        
        document.querySelectorAll('[id^="error-"]').forEach(el => {
            el.textContent = '';
            el.classList.add('hidden');
        });

        if (result.success) {
          Swal.fire({ icon: 'success', title: 'Success', text: result.message }).then(() => {
            window.location.href = '/user/profile';
          });
        } else {
          let hasInlineError = false;
          if (result.errors) {
              for (const [field, msg] of Object.entries(result.errors)) {
                  const span = document.getElementById(`error-${field}`);
                  if (span) {
                      span.textContent = msg;
                      span.classList.remove('hidden');
                      hasInlineError = true;
                  }
              }
          }
          if (!hasInlineError) {
              Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'An error occurred' });
          }
        }
      } catch (err) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred' });
      }
    });
  }

  if (resendForm) {
    resendForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        const res = await fetch(resendForm.action, { method: 'POST' });
        const result = await res.json();
        
        if (result.success) {
          Swal.fire({ icon: 'success', title: 'Success', text: result.message }).then(() => {
            window.location.reload();
          });
        } else {
          Swal.fire({ icon: 'error', title: 'Error', text: result.message });
        }
      } catch (err) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred' });
      }
    });
  }
});

</script>


  <%- include('../../../partials/footer') %>
