<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof course !== 'undefined' ? course.title + ' - Velora Player' : 'Course Player' %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: { sans: ['Inter', 'sans-serif'] },
            colors: {
              brand: { 50: '#eff6ff', 100: '#dbeafe', 500: '#3b82f6', 600: '#0B5ED7', 700: '#0A58CA' }
            }
          }
        }
      }
    </script>
    <style>
        body { background-color: #F8F9FA; font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 4px; }
        .custom-scrollbar:hover::-webkit-scrollbar-thumb { background: #d1d5db; }
    </style>
</head>
<body class="text-gray-900 bg-[#F8F9FA] min-h-screen flex flex-col">

    <!-- Header (Assuming included via partials in a real scenario, but keeping it inline here as requested by mockup format) -->
    <%- include('../../../partials/header') %>

    <!-- Main Content -->
    <main class="flex-grow max-w-[1400px] mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex flex-col lg:flex-row gap-8">
        
        <!-- Left Column: Video & Details -->
        <div class="flex-1 min-w-0">
            <!-- Header Info -->
            <div class="mb-4">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold bg-purple-100 text-purple-700 uppercase tracking-widest mb-3">
                    <%= typeof course !== 'undefined' ? course.category?.name || course.category || 'Course Category' : 'Course Category' %>
                </span>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">
                    <%= typeof activeLesson !== 'undefined' ? activeLesson.title : (typeof course !== 'undefined' ? course.title : 'Course Title') %>
                </h1>
            </div>

            <!-- Video Player Placeholder -->
            <div class="relative w-full aspect-video bg-black rounded-2xl overflow-hidden shadow-xl group">
                <% if (typeof activeLesson !== 'undefined' && activeLesson.video) { %>
                    <!-- Real Video Player Integration -->
                    <video class="w-full h-full object-cover" id="courseVideo" controls controlsList="nodownload">
                        <source src="<%= activeLesson.video %>" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                    <!-- Overlay Speed Control -->
                    <div class="absolute top-4 right-4 z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <select id="playbackSpeed" class="bg-black/60 text-white text-xs font-bold rounded-md px-2 py-1 backdrop-blur-md border border-white/20 outline-none cursor-pointer hover:bg-black/80 transition-colors shadow-lg">
                            <option value="1.0" selected>1x Speed</option>
                            <option value="1.25">1.25x Speed</option>
                            <option value="1.5">1.5x Speed</option>
                            <option value="2.0">2x Speed</option>
                        </select>
                    </div>
                <% } else { %>
                    <img src="<%= typeof course !== 'undefined' && course.thumbnail ? course.thumbnail : 'https://images.unsplash.com/photo-1573164713988-8665fc963095?auto=format&fit=crop&q=80&w=1200' %>" alt="Video Thumbnail" class="w-full h-full object-cover opacity-80 mix-blend-overlay">
                    
                    <!-- Play Button Overlay -->
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="w-16 h-16 bg-[#0B5ED7] rounded-full flex items-center justify-center cursor-pointer shadow-lg transform transition-transform group-hover:scale-110">
                            <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" /></svg>
                        </div>
                    </div>
    
                    <!-- Video Controls Mockup -->
                    <div class="absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-black/80 to-transparent flex items-center space-x-4 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button class="text-white hover:text-blue-400"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></button>
                        <!-- Progress Bar -->
                        <div class="flex-1 h-1.5 bg-gray-600 rounded-full cursor-pointer relative">
                            <div class="absolute inset-y-0 left-0 bg-[#0B5ED7] w-[0%] rounded-full"></div>
                        </div>
                        <span class="text-white text-xs font-medium font-mono">00:00 / <%= typeof activeLesson !== 'undefined' ? activeLesson.durationFormatted || '00:00' : '00:00' %></span>
                        <button class="text-white hover:text-blue-400"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg></button>
                        <button class="text-white hover:text-blue-400"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg></button>
                    </div>
                <% } %>
            </div>

            <!-- Navigation Buttons -->
            <div class="flex items-center justify-between mt-6 mb-10">
                <% if (typeof previousLesson !== 'undefined' && previousLesson) { %>
                    <a href="?lesson=<%= previousLesson._id %>" class="flex items-center px-4 py-2 text-sm font-bold text-[#0B5ED7] hover:text-[#0A58CA] transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        Previous Lesson
                    </a>
                <% } else { %>
                    <div></div> <!-- Empty div to maintain flex justify-between -->
                <% } %>

                <% if (typeof nextLesson !== 'undefined' && nextLesson) { %>
                    <a href="?lesson=<%= nextLesson._id %>" class="flex items-center px-6 py-2.5 bg-[#0B5ED7] hover:bg-[#0A58CA] text-white text-sm font-bold rounded-xl shadow-sm transition-colors">
                        Next Lesson
                        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                <% } else { %>
                     <!-- Maybe a Complete Course button here if it's the last lesson -->
                <% } %>
            </div>

            <!-- Tabs -->
            <div class="border-b border-gray-200 mb-6">
                <nav class="-mb-px flex space-x-8" aria-label="Tabs">
                    <button class="border-[#0B5ED7] text-[#0B5ED7] whitespace-nowrap py-4 px-1 border-b-2 font-bold text-sm">Course Information</button>
                    <!-- Additional Tabs can be added here -->
                </nav>
            </div>

            <!-- Tab Content: Course Info -->
            <div class="space-y-8 pb-12">
                <!-- Banner / Instructor Info -->
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div class="flex items-center">
                        <div class="h-14 w-14 rounded-full border-2 border-gray-100 bg-blue-50 flex items-center justify-center text-blue-600 font-bold text-xl">
                            <%= typeof course !== 'undefined' && course.instructor ? course.instructor.substring(0,2).toUpperCase() : 'IN' %>
                        </div>
                        <div class="ml-4">
                            <p class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest">Instructor</p>
                            <h3 class="text-lg font-extrabold text-gray-900"><%= typeof course !== 'undefined' && course.instructor ? course.instructor : 'Course Instructor' %></h3>
                        </div>
                    </div>
                    <div class="flex items-center space-x-6">
                        <div class="text-right">
                            <p class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest">Ratings</p>
                            <div class="flex items-center mt-1">
                                <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                <span class="ml-1 text-sm font-extrabold text-gray-900"><%= typeof course !== 'undefined' && course.averageRating ? course.averageRating.toFixed(1) : '4.5' %></span>
                                <span class="ml-1 text-xs text-gray-500 font-medium">(<%= typeof course !== 'undefined' ? course.totalRatings || 0 : 0 %> reviews)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Description & Learning Outcomes -->
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100">
                    <h3 class="text-xl font-extrabold text-gray-900 mb-4 tracking-tight">About This Course</h3>
                    <div class="text-gray-600 text-sm leading-relaxed font-medium mb-8">
                        <%- typeof course !== 'undefined' && course.description ? course.description : 'Course Description Placeholder' %>
                    </div>

                    <h4 class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest mb-4">What you'll learn</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex items-start p-4 bg-blue-50/50 border border-blue-100/50 rounded-xl hover:bg-blue-50 transition-colors">
                            <div class="w-10 h-10 rounded-lg bg-white border border-blue-100 flex items-center justify-center flex-shrink-0 text-[#0B5ED7] shadow-sm">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            </div>
                            <div class="ml-4">
                                <h4 class="text-sm font-extrabold text-gray-900">Hands-on Projects</h4>
                                <p class="text-xs text-gray-500 font-medium mt-1">Build real applications</p>
                            </div>
                        </div>

                        <div class="flex items-start p-4 bg-blue-50/50 border border-blue-100/50 rounded-xl hover:bg-blue-50 transition-colors">
                            <div class="w-10 h-10 rounded-lg bg-white border border-blue-100 flex items-center justify-center flex-shrink-0 text-[#0B5ED7] shadow-sm">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            </div>
                            <div class="ml-4">
                                <h4 class="text-sm font-extrabold text-gray-900">Real-world Skills</h4>
                                <p class="text-xs text-gray-500 font-medium mt-1">Job-ready curriculum</p>
                            </div>
                        </div>

                        <div class="flex items-start p-4 bg-blue-50/50 border border-blue-100/50 rounded-xl hover:bg-blue-50 transition-colors">
                            <div class="w-10 h-10 rounded-lg bg-white border border-blue-100 flex items-center justify-center flex-shrink-0 text-[#0B5ED7] shadow-sm">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                            </div>
                            <div class="ml-4">
                                <h4 class="text-sm font-extrabold text-gray-900">Best Practices</h4>
                                <p class="text-xs text-gray-500 font-medium mt-1">Clean & scalable code</p>
                            </div>
                        </div>

                        <div class="flex items-start p-4 bg-blue-50/50 border border-blue-100/50 rounded-xl hover:bg-blue-50 transition-colors">
                            <div class="w-10 h-10 rounded-lg bg-white border border-blue-100 flex items-center justify-center flex-shrink-0 text-[#0B5ED7] shadow-sm">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                            </div>
                            <div class="ml-4">
                                <h4 class="text-sm font-extrabold text-gray-900">Industry Knowledge</h4>
                                <p class="text-xs text-gray-500 font-medium mt-1">Modern architecture</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Notes and Resources (Optional: If passed from controller) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Resources -->
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 h-full">
                        <h3 class="text-lg font-extrabold text-gray-900 flex items-center mb-6 tracking-tight">
                            <svg class="w-5 h-5 mr-2 text-[#0B5ED7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
                            Resources
                        </h3>
                        
                        <div class="space-y-3">
                            <% if (typeof resources !== 'undefined' && resources.length > 0) { %>
                                <% resources.forEach(resource => { %>
                                    <a href="<%= resource.file %>" target="_blank" class="flex items-center justify-between p-3.5 border border-gray-100 rounded-xl hover:bg-gray-50 transition-colors group">
                                        <div class="flex items-center text-sm font-bold text-gray-700 group-hover:text-[#0B5ED7]">
                                            <svg class="w-5 h-5 mr-3 text-gray-400 group-hover:text-[#0B5ED7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                            <%= resource.title %>
                                        </div>
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                    </a>
                                <% }); %>
                            <% } else { %>
                                <p class="text-sm text-gray-500 font-medium">No resources available for this lesson.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Curriculum Sidebar -->
        <div class="w-full lg:w-[400px] flex-shrink-0">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden sticky top-24 max-h-[calc(100vh-8rem)] flex flex-col">
                
                <!-- Sidebar Header -->
                <div class="p-6 border-b border-gray-100 bg-white">
                    <div class="flex items-start mb-4">
                        <div class="w-10 h-10 rounded-xl bg-[#0B5ED7] flex items-center justify-center text-white flex-shrink-0 mt-0.5">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                        </div>
                        <div class="ml-3">
                            <h2 class="text-base font-extrabold text-gray-900 leading-tight"><%= typeof course !== 'undefined' ? course.title : 'Course Title' %></h2>
                            <% 
                               let totalCompleted = typeof completedLessons !== 'undefined' ? completedLessons.length : 0;
                               let totalLessonsCount = typeof totalLessons !== 'undefined' ? totalLessons : 0;
                               let progressPercent = totalLessonsCount > 0 ? Math.round((totalCompleted / totalLessonsCount) * 100) : 0;
                            %>
                            <p class="text-xs font-semibold text-gray-500 mt-1"><%= totalCompleted %> / <%= totalLessonsCount %> Lessons Completed</p>
                        </div>
                    </div>
                    
                    <!-- Progress Bar -->
                    <div class="w-full h-1.5 bg-gray-100 rounded-full overflow-hidden">
                        <div class="h-full bg-[#0B5ED7] rounded-full transition-all duration-500" style="width: <%= progressPercent %>%"></div>
                    </div>
                </div>

                <!-- Curriculum List -->
                <div class="flex-1 overflow-y-auto custom-scrollbar p-6 bg-white space-y-6">
                    <% if (typeof modules !== 'undefined' && modules.length > 0) { %>
                        <% modules.forEach((mod, mIndex) => { %>
                            <div>
                                <div class="flex justify-between items-center mb-3">
                                    <h4 class="text-[10px] font-extrabold text-gray-900 uppercase tracking-widest">Module <%= mIndex + 1 %>: <%= mod.title %></h4>
                                    <span class="text-[10px] font-bold text-gray-400"><%= mod.lessons ? mod.lessons.length : 0 %> LESSONS</span>
                                </div>
                                <div class="space-y-1">
                                    <% if (mod.lessons && mod.lessons.length > 0) { %>
                                        <% mod.lessons.forEach(lesson => { %>
                                            <% 
                                               let isCompleted = typeof completedLessons !== 'undefined' && completedLessons.includes(lesson._id.toString());
                                               let isActive = typeof activeLesson !== 'undefined' && activeLesson && activeLesson._id.toString() === lesson._id.toString();
                                            %>
                                            
                                            <a href="?lesson=<%= lesson._id %>" class="block">
                                                <div class="flex items-center justify-between p-2 rounded-lg <%= isActive ? 'bg-blue-50' : 'hover:bg-gray-50' %> transition-colors cursor-pointer group">
                                                    <div class="flex items-center">
                                                        <% if (isCompleted) { %>
                                                            <div class="w-5 h-5 rounded-full bg-[#0B5ED7] flex items-center justify-center flex-shrink-0">
                                                                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                            </div>
                                                            <span class="ml-3 text-sm font-semibold text-gray-600 group-hover:text-gray-900 transition-colors"><%= lesson.title %></span>
                                                        <% } else if (isActive) { %>
                                                            <div class="w-5 h-5 rounded-full border-2 border-[#0B5ED7] flex items-center justify-center flex-shrink-0 text-[#0B5ED7]">
                                                                <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" /></svg>
                                                            </div>
                                                            <span class="ml-3 text-sm font-bold text-[#0B5ED7]"><%= lesson.title %></span>
                                                        <% } else { %>
                                                            <div class="w-5 h-5 rounded-full border-2 border-gray-300 flex-shrink-0 group-hover:border-[#0B5ED7] transition-colors"></div>
                                                            <span class="ml-3 text-sm font-semibold text-gray-600 group-hover:text-gray-900 transition-colors"><%= lesson.title %></span>
                                                        <% } %>
                                                    </div>
                                                    <span class="text-xs font-semibold <%= isActive ? 'text-[#0B5ED7]' : 'text-gray-400' %>"><%= lesson.durationFormatted || '00:00' %></span>
                                                </div>
                                            </a>
                                            
                                        <% }) %>
                                    <% } else { %>
                                        <p class="text-xs text-gray-400 italic px-2">No lessons in this module.</p>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-sm font-medium text-gray-500">Curriculum not available.</p>
                    <% } %>
                </div>

                <!-- Complete Course Button (Can wire this to a form later) -->
                <div class="p-4 border-t border-gray-100 bg-white">
                    <form action="/user/courses/<%= typeof course !== 'undefined' ? course._id : '' %>/complete" method="POST">
                        <button type="submit" class="w-full py-3 bg-[#6366f1] hover:bg-[#4f46e5] text-white text-sm font-bold rounded-xl shadow-sm transition-colors">
                            Complete Course
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <%- include('../../../partials/footer') %>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const video = document.querySelector("video");
    if (video) {
        video.addEventListener("ended", async () => {
            const courseId = "<%= typeof course !== 'undefined' ? course._id : '' %>";
            const lessonId = "<%= typeof activeLesson !== 'undefined' && activeLesson ? activeLesson._id : '' %>";
            if (!courseId || !lessonId) return;
            
            try {
                const response = await fetch(`/api/v1/user/mycourses/${courseId}/lessons/${lessonId}/complete`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                if (data.success) {
                    window.location.reload();
                }
            } catch (error) {
                console.error("Failed to mark lesson complete:", error);
            }
        });

        const speedControl = document.getElementById("playbackSpeed");
        if (speedControl) {
            speedControl.addEventListener("change", (e) => {
                video.playbackRate = parseFloat(e.target.value);
            });
        }
    }
});
</script>
</body>
</html>
