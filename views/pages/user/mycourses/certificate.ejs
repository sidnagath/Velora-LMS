<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .cert-title { font-family: 'Playfair Display', serif; }
        
        @media print {
            @page { margin: 0; size: landscape; }
            body { margin: 0; background: white; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .no-print { display: none !important; }
            .print-exact { padding: 0 !important; border: none !important; box-shadow: none !important; }
            .cert-container { width: 100% !important; max-width: none !important; height: 100vh !important; border-radius: 0 !important; }
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col items-center justify-center p-4 sm:p-8">

    <!-- Action Bar (Hidden when printing) -->
    <div class="no-print w-full max-w-5xl flex justify-between items-center mb-6">
        <a href="/user/my-courses" class="text-gray-500 hover:text-gray-800 font-semibold flex items-center gap-2 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to My Courses
        </a>
        <button onclick="window.print()" class="bg-[#0a58ca] hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-lg shadow-sm flex items-center gap-2 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Download as PDF
        </button>
    </div>

    <!-- Certificate Container -->
    <div class="cert-container w-full max-w-5xl bg-white rounded-xl shadow-2xl overflow-hidden relative print-exact border border-gray-100">
        
        <!-- Decorative Elements -->
        <div class="absolute top-0 left-0 w-full h-4 bg-gradient-to-r from-blue-600 via-blue-400 to-yellow-500"></div>
        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-bl-full opacity-50 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-40 h-40 bg-yellow-50 rounded-tr-full opacity-50 pointer-events-none"></div>

        <!-- Certificate Content border -->
        <div class="m-8 sm:m-12 border-[3px] border-double border-gray-200 p-8 sm:p-16 relative bg-white z-10">
            
            <!-- Corner Accents -->
            <div class="absolute top-0 left-0 w-6 h-6 border-t-[3px] border-l-[3px] border-yellow-500"></div>
            <div class="absolute top-0 right-0 w-6 h-6 border-t-[3px] border-r-[3px] border-blue-600"></div>
            <div class="absolute bottom-0 left-0 w-6 h-6 border-b-[3px] border-l-[3px] border-blue-600"></div>
            <div class="absolute bottom-0 right-0 w-6 h-6 border-b-[3px] border-r-[3px] border-yellow-500"></div>

            <!-- Header -->
            <div class="text-center mb-12">
                <div class="inline-flex items-center justify-center gap-2 mb-6">
                    <div class="w-10 h-10 bg-[#0a58ca] rounded-lg flex items-center justify-center">
                        <span class="text-white font-black text-xl tracking-tighter">V</span>
                    </div>
                    <span class="text-2xl font-black tracking-tight text-gray-900">VELORA</span>
                </div>
                <h1 class="cert-title text-4xl sm:text-5xl md:text-6xl text-gray-900 font-bold tracking-tight mb-4 uppercase">
                    Certificate <span class="text-yellow-600 italic font-medium lowercase text-3xl sm:text-4xl md:text-5xl mx-2">of</span> Completion
                </h1>
                <p class="text-gray-500 font-medium tracking-widest uppercase text-sm">This is to proudly certify that</p>
            </div>

            <!-- Recipient -->
            <div class="text-center mb-12">
                <h2 class="text-4xl sm:text-5xl font-black text-blue-900 mb-2 border-b-2 border-gray-200 pb-2 inline-block px-12">
                    <%= user.name %>
                </h2>
            </div>

            <!-- Course Info -->
            <div class="text-center mb-16 max-w-3xl mx-auto">
                <p class="text-gray-600 text-lg mb-4">has successfully completed all requirements and coursework for the program:</p>
                <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">
                    <%= course.title %>
                </h3>
            </div>

            <!-- Footer / Signatures -->
            <div class="flex justify-between items-end mt-12 pt-8">
                <!-- Date -->
                <div class="text-center w-48">
                    <p class="text-gray-900 font-bold text-lg mb-1"><%= currentDate %></p>
                    <div class="w-full h-px bg-gray-300 mb-2"></div>
                    <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Date of Issue</p>
                </div>
                
                <!-- Badge -->
                <div class="flex-shrink-0 flex flex-col items-center">
                    <div class="w-24 h-24 rounded-full border-4 border-yellow-500 flex items-center justify-center bg-yellow-50 shadow-inner relative">
                        <div class="absolute inset-2 border border-dashed border-yellow-600 rounded-full opacity-50"></div>
                        <svg class="w-10 h-10 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                        </svg>
                    </div>
                </div>

                <!-- Signature -->
                <div class="text-center w-48">
                    <p class="cert-title text-gray-800 text-3xl mb-1 italic">Velora Admin</p>
                    <div class="w-full h-px bg-gray-300 mb-2"></div>
                    <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Lead Instructor</p>
                </div>
            </div>

            <!-- Validation Info -->
            <div class="absolute bottom-6 left-0 w-full text-center">
                <p class="text-[10px] text-gray-400 font-mono tracking-wider">CERTIFICATE ID: <%= certificateId %></p>
            </div>
            
        </div>
    </div>
</body>
</html>
