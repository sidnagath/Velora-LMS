<%- include('../../../partials/header') %>

<main class="flex-grow bg-[#F3F4F6] py-8 px-4 md:px-8">
    <div class="max-w-7xl mx-auto space-y-6">
        
        <!-- Welcome Banner -->
        <div class="bg-gradient-to-r from-[#1d6ae5] to-[#4e8df0] rounded-2xl p-8 md:p-12 text-white flex flex-col md:flex-row justify-between items-center shadow-lg relative overflow-hidden">
            <div class="relative z-10">
                <span class="inline-block py-1 px-3 rounded-full bg-white/20 backdrop-blur-sm text-xs font-semibold tracking-wide uppercase mb-4">Learning Dashboard</span>
                <h1 class="text-3xl md:text-4xl font-bold mb-3">Welcome back, <%= user.name %>.</h1>
                <p class="text-blue-100 text-sm max-w-md mb-8 leading-relaxed">Continue your learning journey with top courses and master the skills of tomorrow in a focused, premium environment.</p>
                <div class="flex space-x-4">
                    <a href="/user/my-courses" class="bg-white text-[#0B5ED7] font-medium py-2.5 px-6 rounded-md hover:bg-gray-50 transition-colors shadow-sm">Continue Learning</a>
                    <!-- <a href="#" class="bg-white/20 backdrop-blur-sm border border-white/30 text-white font-medium py-2.5 px-6 rounded-md hover:bg-white/30 transition-colors">View Plan</a> -->
                </div>
            </div>
            <!-- Decorative Icon -->
            <div class="hidden md:block opacity-30 right-12 relative z-0">
                <svg class="w-64 h-64" fill="currentColor" viewBox="0 0 24 24"><path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"/></svg>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
            <!-- Enrolled & Completed -->
            <div class="col-span-1 md:col-span-4 flex gap-6">
                <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex-1 flex flex-col justify-center">
                    <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Enrolled</h3>
                    <p class="text-4xl font-bold text-[#0B5ED7]"><%= enrolledCount %></p>
                </div>
                <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex-1 flex flex-col justify-center">
                    <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Completed</h3>
                    <p class="text-4xl font-bold text-purple-600"><%= completedCount %></p>
                </div>
            </div>
            
            <!-- Overall Progress -->
            <div class="col-span-1 md:col-span-8 bg-white p-8 rounded-xl shadow-sm border border-gray-100 flex flex-col justify-center">
                <div class="flex justify-between items-end mb-4">
                    <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Overall Progress</h3>
                    <span class="text-xl font-bold text-[#0B5ED7]"><%= overallProgress %>%</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                    <div class="bg-gradient-to-r from-purple-500 to-[#0B5ED7] h-2.5 rounded-full" style="width: <%= overallProgress %>%"></div>
                </div>
            </div>
        </div>

        <!-- Wallet & Quick Access -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Wallet/Coupons -->
            <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 p-6 flex flex-col sm:flex-row divide-y sm:divide-y-0 sm:divide-x divide-gray-100">
                <div class="flex-1 flex items-center py-4 sm:py-0 sm:pr-6">
                    <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center text-[#0B5ED7] mr-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 font-medium mb-1">Wallet Balance</p>
                        <p class="text-xl font-bold text-gray-900">₹<%= walletBalance.toFixed(2) %></p>
                    </div>
                </div>
                <div class="flex-1 flex items-center py-4 sm:py-0 sm:px-6 justify-between">
                    <div class="flex items-center">
                        <div class="w-12 h-12 bg-purple-50 rounded-lg flex items-center justify-center text-purple-600 mr-4">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 font-medium mb-1">Available Coupons</p>
                            <% if (availableCoupon) { %>
                                <p class="text-lg font-bold text-purple-700"><%= availableCoupon.code %> 
                                    <span class="text-xs text-gray-400 font-normal ml-1">
                                        - <%= availableCoupon.discountType === 'percentage' ? availableCoupon.discountValue + '% off' : '₹' + availableCoupon.discountValue + ' off' %>
                                    </span>
                                </p>
                            <% } else { %>
                                <p class="text-sm font-medium text-gray-400">No active coupons</p>
                            <% } %>
                        </div>
                    </div>
                    <a href="#" class="text-sm font-semibold text-[#0B5ED7] hover:underline">Add Funds</a>
                </div>
            </div>

            <!-- Quick Access -->
            <div class="lg:col-span-1 bg-white rounded-xl shadow-sm border border-gray-100 p-6">
                <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Quick Access</h3>
                <div class="space-y-3">
                    <a href="/user/cart" class="flex justify-between items-center text-sm font-medium text-gray-700 hover:text-[#0B5ED7] group">
                        <span>Shopping Cart</span>
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-[#0B5ED7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </a>
                    <a href="/user/wishlist" class="flex justify-between items-center text-sm font-medium text-gray-700 hover:text-[#0B5ED7] group">
                        <span>Wishlist</span>
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-[#0B5ED7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </a>
                    <a href="/user/my-courses" class="flex justify-between items-center text-sm font-medium text-gray-700 hover:text-[#0B5ED7] group">
                        <span>My Enrolled Courses</span>
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-[#0B5ED7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- Continue Learning -->
        <div class="pt-6">
            <div class="flex justify-between items-end mb-6">
                <div>
                    <h2 class="text-xl font-bold text-gray-900 mb-1">Continue Learning</h2>
                    <p class="text-gray-500 text-xs">Pick up right where you left off</p>
                </div>
                <div class="flex space-x-2">
                    <button class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:bg-white transition-colors bg-gray-50">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <button class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:bg-white transition-colors bg-gray-50">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <% if (typeof continueLearningCourses !== 'undefined' && continueLearningCourses.length > 0) { %>
                  <% continueLearningCourses.forEach(enrollment => { %>
                    <% const course = enrollment.courseId; %>
                    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 flex flex-col h-full cursor-pointer" onclick="window.location.href='/user/my-courses/<%= course._id %>'">
                        <div class="h-40 bg-gray-900 relative">
                            <img src="<%= course.thumbnail %>" alt="Thumbnail" class="w-full h-full object-cover opacity-80 mix-blend-luminosity">
                            <span class="absolute bottom-3 left-3 bg-[#0B5ED7] text-white text-[10px] font-bold uppercase tracking-wider py-1 px-2 rounded"><%= course.level || 'All Levels' %></span>
                        </div>
                        <div class="p-5 flex flex-col flex-grow">
                            <h3 class="font-bold text-gray-900 mb-2 line-clamp-2"><%= course.title %></h3>
                            <div class="mt-auto">
                                <div class="flex justify-between items-end mb-2">
                                    <span class="text-xs text-gray-500 font-medium">Progress</span>
                                    <span class="text-xs font-bold text-[#0B5ED7]"><%= enrollment.progress || 0 %>%</span>
                                </div>
                                <div class="w-full bg-gray-100 rounded-full h-1.5 overflow-hidden">
                                    <div class="bg-[#0B5ED7] h-1.5 rounded-full" style="width: <%= enrollment.progress || 0 %>%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="col-span-3 text-center py-12 text-gray-500 font-semibold">No recommended courses available right now.</div>
                <% } %>
            </div>
        </div>

        <!-- Explore Categories -->
        <div class="pt-6">
            <div class="flex justify-between items-end mb-4">
                <h2 class="text-lg font-bold text-gray-900">Explore Categories</h2>
                <a href="/user/courses" class="text-[#0B5ED7] font-medium text-sm hover:underline flex items-center">
                    View all <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
                <% if (typeof exploreCategories !== 'undefined' && exploreCategories.length > 0) { %>
                    <% exploreCategories.forEach((cat, index) => { %>
                        <% const colors = ['bg-orange-50', 'bg-blue-50', 'bg-yellow-50', 'bg-cyan-50', 'bg-purple-50', 'bg-emerald-50']; %>
                        <% const textColors = ['text-orange-500', 'text-blue-500', 'text-yellow-500', 'text-cyan-500', 'text-purple-500', 'text-emerald-500']; %>
                        <% const hoverColors = ['group-hover:bg-orange-100', 'group-hover:bg-blue-100', 'group-hover:bg-yellow-100', 'group-hover:bg-cyan-100', 'group-hover:bg-purple-100', 'group-hover:bg-emerald-100']; %>
                        <% const colorIdx = index % colors.length; %>
                        
                        <a href="/user/courses?category=<%= cat._id %>" class="bg-white py-4 px-6 rounded-xl shadow-sm border border-gray-100 flex flex-col items-center justify-center hover:shadow-md transition-shadow group">
                            <div class="w-12 h-12 <%= colors[colorIdx] %> rounded-full flex items-center justify-center mb-3 <%= hoverColors[colorIdx] %> transition-colors">
                                <span class="<%= textColors[colorIdx] %> font-bold text-xs"><%= cat.name.substring(0, 2).toUpperCase() %></span>
                            </div>
                            <span class="text-sm font-bold text-gray-800 text-center line-clamp-1"><%= cat.name %></span>
                        </a>
                    <% }) %>
                <% } %>
            </div>
        </div>

        <!-- Featured Courses for You -->
        <div class="pt-6 pb-12">
            <div class="flex justify-between items-end mb-6">
                <h2 class="text-lg font-bold text-gray-900">Featured Courses for You</h2>
                <a href="/user/courses" class="text-[#0B5ED7] font-medium text-sm hover:underline flex items-center">
                    Explore More <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <% if (typeof featuredCourses !== 'undefined' && featuredCourses.length > 0) { %>
                    <% featuredCourses.forEach(course => { %>
                        <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 cursor-pointer hover:shadow-md transition-shadow flex flex-col" onclick="window.location.href='/user/courses/<%= course._id %>'">
                            <div class="h-32 bg-gray-900 relative">
                                <img src="<%= course.thumbnail %>" alt="Thumbnail" class="w-full h-full object-cover opacity-90">
                                <span class="absolute top-2 right-2 flex space-x-1">
                                    <button class="w-8 h-8 rounded-full bg-white/30 backdrop-blur-sm text-white flex items-center justify-center hover:bg-white/50 transition-colors shadow-sm"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg></button>
                                </span>
                            </div>
                            <div class="p-4 flex flex-col flex-grow">
                                <span class="text-[10px] font-bold text-[#0B5ED7] uppercase tracking-wider mb-1 block"><%= course.category?.name || 'Category' %></span>
                                <h4 class="font-bold text-sm text-gray-900 mb-1 line-clamp-2"><%= course.title %></h4>
                                <div class="flex items-center text-xs text-gray-500 mb-3 mt-auto">
                                    <svg class="w-3 h-3 text-yellow-400 fill-current mr-1" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                    <span class="font-bold text-gray-700"><%= course.rating || '0.0' %></span> <span class="ml-1">(<%= course.reviewsCount || 0 %>)</span>
                                </div>
                                <div class="flex items-end justify-between border-t border-gray-100 pt-3">
                                    <% if (course.pricingType === 'free') { %>
                                        <span class="font-bold text-[#0B5ED7]">Free</span>
                                    <% } else { %>
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-gray-900">₹<%= (course.discountPrice || course.basePrice).toFixed(2) %></span>
                                            <% if (course.discountPrice && course.discountPrice < course.basePrice) { %>
                                                <span class="text-xs text-gray-400 line-through">₹<%= course.basePrice.toFixed(2) %></span>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>

    </div>
</main>

<%- include('../../../partials/footer') %>
