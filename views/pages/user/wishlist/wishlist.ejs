<%- include('../../../partials/header') %>

<main class="min-h-screen bg-[#F8F9FA] py-12 px-4 sm:px-6 lg:px-8 font-sans">
  <div class="max-w-7xl mx-auto">
    
    <%- include('../../../partials/user-banner') %>

    <% if ((!wishlist || wishlist.length === 0) && (typeof search === 'undefined' || search.trim() === '')) { %>
      <!-- EMPTY STATE -->
      <div class="flex flex-col items-center justify-center py-24 text-center mt-8">
        <div class="relative w-64 h-64 mb-6 flex items-center justify-center">
          <!-- Floating icons -->
          <div class="absolute top-4 right-10 w-14 h-14 bg-[#9B89FF] rounded-2xl rotate-12 flex items-center justify-center text-white shadow-xl">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
          </div>
          <div class="absolute bottom-10 left-12 w-12 h-12 bg-[#FFD4B5] rounded-full flex items-center justify-center text-gray-800 shadow-xl">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
          </div>
          <!-- Main circle -->
          <div class="w-40 h-40 bg-[#E8EFFF] rounded-full flex items-center justify-center border-[16px] border-white shadow-[0_8px_30px_rgb(0,0,0,0.06)] relative z-10">
            <svg class="w-14 h-14 text-[#0B5ED7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
          </div>
        </div>
        
        <h2 class="text-[34px] font-extrabold text-gray-900 mb-3 tracking-tight">No items in your wishlist</h2>
        <p class="text-gray-600 mb-10 max-w-sm mx-auto text-[15px] leading-relaxed">Save courses you like and come back to them anytime.</p>
        
        <a href="/user/courses" class="bg-[#0B5ED7] hover:bg-[#0A58CA] text-white font-bold py-3.5 px-8 rounded-full shadow-sm transition-colors flex items-center justify-center w-max mx-auto mb-6">
          Explore Courses
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mt-2">Start browsing and add courses to your wishlist</p>
        <div class="w-8 h-1 bg-gray-200 rounded-full mx-auto mt-4"></div>
      </div>
    <% } else { %>
      <!-- POPULATED STATE -->
      <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h1 class="text-[40px] font-extrabold text-gray-900 tracking-tight leading-tight mb-1">My Wishlist</h1>
          <p class="text-gray-600 text-[15px]">You have <span class="font-bold text-[#0B5ED7]"><%= wishlist.length %> items</span> saved for later.</p>
        </div>
        
        <button class="bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 font-semibold py-2.5 px-5 rounded-xl shadow-sm text-sm flex items-center transition-colors w-max">
          <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"></path></svg>
          Sort by: Recently Added
        </button>
      </div>

      <!-- Search Bar -->
      <form action="/user/wishlist" method="GET" class="w-full mb-10 flex gap-3" style="position: relative;">
          <div class="flex-grow" style="position: relative;">
              <svg
                class="text-gray-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                style="position: absolute; left: 1.25rem; top: 50%; transform: translateY(-50%); width: 1.25rem; height: 1.25rem; pointer-events: none; z-index: 10;"
              >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                  />
              </svg>
          
              <input
                type="text"
                name="search"
                placeholder="Search courses..."
                value="<%= typeof search !== 'undefined' ? search : '' %>"
                class="w-full h-16 rounded-2xl bg-gray-100 border border-transparent focus:border-[#0B5ED7] focus:ring-2 focus:ring-[#0B5ED7]/20 outline-none text-gray-900 placeholder-gray-400"
                style="padding-left: 3.5rem; padding-right: 1rem; width: 100%; height: 4rem;"
              >
          </div>
          <button type="submit" class="h-16 px-8 rounded-2xl bg-[#0B5ED7] hover:bg-blue-700 text-white font-bold transition flex-shrink-0" style="height: 4rem;">
              Search
          </button>
      </form>

      <style>
        /* BYPASS TAILWIND CSS FOR WISHLIST GRID AND PROMO */
        .wishlist-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 2rem;
          width: 100%;
        }
        @media (min-width: 640px) {
          .wishlist-grid {
            grid-template-columns: repeat(2, 1fr);
          }
        }
        @media (min-width: 1024px) {
          .wishlist-grid {
            grid-template-columns: repeat(4, 1fr);
          }
        }

        .promo-banner {
          margin-top: 3rem;
          background-color: #EEF2FF;
          border-radius: 1.5rem;
          padding: 3rem 2rem;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: space-between;
          position: relative;
          overflow: hidden;
        }
        @media (min-width: 768px) {
          .promo-banner {
            flex-direction: row;
            padding: 4rem 5rem;
          }
        }

        .promo-content {
          width: 100%;
          text-align: center;
          z-index: 10;
        }
        @media (min-width: 768px) {
          .promo-content {
            width: 50%;
            text-align: left;
          }
        }

        .promo-image-container {
          width: 100%;
          margin-top: 3rem;
          display: flex;
          justify-content: center;
          z-index: 10;
        }
        @media (min-width: 768px) {
          .promo-image-container {
            width: 45%;
            margin-top: 0;
            justify-content: flex-end;
          }
        }
      </style>

      <!-- Course Grid -->
      <div class="wishlist-grid">
        <% if (wishlist && wishlist.length > 0) { %>
          <% wishlist.forEach(course => { %>
            <!-- Course Card -->
            <div style="background-color: #ffffff; border-radius: 20px; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05); border: 1px solid #f3f4f6; overflow: hidden; display: flex; flex-direction: column; height: 100%; transition: box-shadow 0.3s ease;">
              
              <div style="position: relative; height: 11rem; width: 100%; background-color: #e5e7eb; overflow: hidden;">
                <a href="/user/courses/<%= course._id %>">
                  <img src="<%= course.thumbnail ? course.thumbnail : '/images/placeholder.jpg' %>" alt="<%= course.title %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;">
                </a>
                
                <div style="position: absolute; top: 0.75rem; right: 0.75rem; background-color: white; padding: 0.25rem 0.5rem; border-radius: 9999px; font-size: 11px; font-weight: 800; display: flex; align-items: center; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05); color: #111827;">
                  <span style="color: #FFC730; margin-right: 0.25rem; font-size: 14px; line-height: 1;">★</span> <%= (course.rating || 0).toFixed(1) %>
                </div>
              </div>
              
              <div style="padding: 1.25rem; display: flex; flex-direction: column; flex-grow: 1;">
                <div style="font-size: 10px; font-weight: 800; color: #6b7280; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">
                  <%= course.category ? course.category.name : 'Uncategorized' %>
                </div>
                <h3 style="font-size: 17px; font-weight: 800; color: #111827; line-height: 1.3; margin-bottom: 0.375rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <a href="/user/courses/<%= course._id %>" style="color: inherit; text-decoration: none;"><%= course.title %></a>
                </h3>
                <p style="font-size: 13px; color: #6b7280; margin-bottom: 1.25rem;">By <%= course.instructor || 'Unknown Instructor' %></p>
                
                <div style="margin-top: auto; display: flex; align-items: flex-end; margin-bottom: 1.25rem;">
                  <span style="font-size: 22px; font-weight: 800; color: #111827; line-height: 1;">
                    <%= course.currency === 'USD' ? '$' : '₹' %><%= course.discountPrice > 0 ? course.discountPrice : course.basePrice %>
                  </span>
                  <% if(course.discountPrice > 0 && course.basePrice > course.discountPrice) { %>
                    <span style="font-size: 13px; font-weight: 600; color: #9ca3af; text-decoration: line-through; margin-left: 0.5rem; margin-bottom: 0.125rem;">
                      <%= course.currency === 'USD' ? '$' : '₹' %><%= course.basePrice %>
                    </span>
                  <% } %>
                </div>
                
                <% if (course.status === 'published' && !course.isDeleted) { %>
                  <form action="/api/v1/user/wishlist/<%= course._id %>/cart" onsubmit="handleWishlistAction(event, 'POST')" style="margin-bottom: 0.75rem; width: 100%;">
                    <button type="submit" style="width: 100%; background-color: #0B5ED7; color: white; padding: 0.75rem 0; border-radius: 0.75rem; font-weight: 700; font-size: 14px; display: flex; items-center; justify-content: center; cursor: pointer; border: none; align-items: center;">
                      <svg style="width: 16px; height: 16px; margin-right: 0.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                      Move to Cart
                    </button>
                  </form>
                <% } else { %>
                  <div style="margin-bottom: 0.75rem; width: 100%; background-color: #f3f4f6; color: #6b7280; padding: 0.75rem 0; border-radius: 0.75rem; font-weight: 700; font-size: 14px; display: flex; align-items: center; justify-content: center; cursor: not-allowed; border: 1px solid #e5e7eb;">
                    <svg style="width: 16px; height: 16px; margin-right: 0.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Coming Soon / Not Available Yet
                  </div>
                <% } %>
                
                <form action="/api/v1/user/wishlist/<%= course._id %>" onsubmit="handleWishlistAction(event, 'DELETE')" style="width: 100%;">
                  <button type="submit" style="width: 100%; color: #6b7280; padding: 0.375rem 0; border-radius: 0.5rem; font-weight: 600; font-size: 12px; display: flex; align-items: center; justify-content: center; cursor: pointer; border: none; background: transparent;">
                    <svg style="width: 14px; height: 14px; margin-right: 0.375rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    Remove
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="w-full py-16 text-center text-gray-500 font-medium bg-white rounded-[20px] shadow-sm border border-gray-100 flex flex-col items-center justify-center" style="grid-column: 1 / -1;">
            <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <p style="font-size: 1.125rem;">No courses found matching your search.</p>
          </div>
        <% } %>
      </div>

      <!-- Promo Banner -->
      <div class="promo-banner">
        <div class="promo-content">
          <h2 style="font-size: 1.875rem; font-weight: 800; color: #111827; margin-bottom: 1rem; letter-spacing: -0.025em; line-height: 1.2;">Ready to start learning?</h2>
          <p style="color: #4b5563; margin-bottom: 2rem; line-height: 1.625; font-size: 15px;">Bundle your wishlist items today and get an extra 15% off your entire order. Your sanctuary of knowledge is waiting.</p>
          <div style="display: flex; flex-direction: column; gap: 1rem; align-items: center; justify-content: center;">
            <button style="background-color: #6B46C1; color: white; font-weight: 700; padding: 0.875rem 2rem; border-radius: 0.75rem; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05); border: none; cursor: pointer; width: 100%; max-width: 200px;">Move All to Cart</button>
            <a href="/user/courses" style="color: #0B5ED7; font-weight: 700; padding: 0.875rem 2rem; display: flex; align-items: center; justify-content: center; border-radius: 0.75rem; text-decoration: none;">Continue Browsing</a>
          </div>
        </div>
        
        <div class="promo-image-container">
          <!-- Illustration Approximation matching reference -->
          <div style="width: 320px; height: 320px; background-color: #F05333; border-radius: 2rem; display: flex; flex-direction: column; items-center; justify-content: center; position: relative;">
            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 160px; height: 260px; background-color: #FFC730; border-radius: 1.5rem; display: flex; flex-direction: column; align-items: center; padding: 0.75rem; z-index: 10;">
              <div style="width: 2.5rem; height: 1.5rem; background-color: white; border-radius: 0.375rem 0.375rem 0 0; margin-top: -1.5rem;"></div>
              <div style="width: 100%; height: 160px; background-color: white; border-radius: 1rem; display: flex; align-items: center; justify-content: center; margin-top: 0.5rem;">
                <svg style="width: 48px; height: 48px; color: #1f2937;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              </div>
              <div style="margin-top: auto; background-color: white; padding: 0.375rem 1rem; border-radius: 9999px; font-size: 12px; font-weight: 800; color: #F05333; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.25rem;">SAFEE WORK</div>
            </div>
            <div style="position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); background-color: #E3A320; width: 1.5rem; height: 2rem; border-radius: 0 0 0.375rem 0.375rem; z-index: 0;"></div>
          </div>
        </div>
      </div>
    <% } %>

  </div>
</main>

<script>
async function handleWishlistAction(e, method) {
  e.preventDefault();
  const form = e.target;
  try {
    const res = await fetch(form.action, { method });
    const data = await res.json();
    if(data.success) {
      Swal.fire({ icon: 'success', title: 'Success', text: data.message }).then(() => {
        window.location.reload();
      });
    } else {
      Swal.fire({ icon: 'error', title: 'Error', text: data.message });
    }
  } catch(err) {
    Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred' });
  }
}
</script>

<%- include('../../../partials/footer') %>
