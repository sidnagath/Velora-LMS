<%- include('../../partials/header') %>

    <main class="flex-grow flex items-center justify-center py-16 px-4">
        <div class="w-full max-w-md">
            <!-- Header Text -->
            <div class="text-center mb-8">
                <h1 class="text-4xl font-bold text-[#0B5ED7] mb-2 tracking-tight">Velora</h1>
                <p class="text-gray-600 text-sm">Continue your learning excellence journey.</p>
            </div>

            <%- include('../../partials/user-banner') %>

            <!-- Login Card -->
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-10">
                <h2 class="text-2xl font-semibold text-gray-800 mb-2">Welcome Back</h2>
                <p class="text-gray-500 text-sm mb-8">Enter your credentials to access your sanctuary of learning.</p>

               <% if(errors?.general){ %>
               <p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
               <%= errors.general %>
               </p>
               <% } %>

                        
                                <form action="/login" method="POST" class="space-y-5">
                                    <div>
                                        <label
                                            class="block text-xs font-medium text-gray-500 tracking-wide uppercase mb-2">Email
                                            Address</label>
                                        <div class="relative">
                                            <div
                                                class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400"
                                                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                                </svg>
                                            </div>
                                            <input type="email" name="email"  value="<%= formData?.name || '' %>" class="input-field pl-11"
                                                placeholder="name@example.com">
                                        </div>
                                    </div>

               <% if(errors?.email){ %>
               <p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
               <%= errors.email %>
               </p>
               <% } %>

                                    <div>
                                        <div class="flex justify-between items-center mb-2">
                                            <label
                                                class="block text-xs font-medium text-gray-500 tracking-wide uppercase">Password</label>
                                            <a href="/forgot-password"
                                                class="text-xs font-semibold text-[#0B5ED7] hover:underline">Forgot
                                                password?</a>
                                        </div>
                                        <div class="relative">
                                            <div
                                                class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400"
                                                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                                </svg>
                                            </div>
                                            <input type="password" name="password" value="<%= formData?.name || '' %>" class="input-field pl-11 pr-11"
                                                placeholder="••••••••">
                                            <div
                                                class="absolute inset-y-0 right-0 pr-4 flex items-center cursor-pointer toggle-password">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400"
                                                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                            </div>
                                        </div>
                                    </div>

               <% if(errors?.password){ %>
               <p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
               <%= errors.password %>
               </p>
               <% } %>
                                    <button type="submit" class="btn-primary mt-6">Login</button>
                                </form>

                                <div class="mt-8 relative flex items-center justify-center">
                                    <hr class="w-full border-gray-200">
                                    <span
                                        class="absolute bg-white px-4 text-xs font-medium text-gray-400 tracking-wide uppercase">Or
                                        continue with</span>
                                </div>

                                <a href="/auth/google"

  class="mt-8 w-full flex items-center justify-center space-x-2 bg-[#F8F9FA] hover:bg-gray-100 border border-gray-200 py-3 px-4 rounded-md transition-colors text-gray-700 font-medium"
>

  <svg class="h-5 w-5" viewBox="0 0 24 24">

    <path fill="#4285F4"
      d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />

    <path fill="#34A853"
      d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />

    <path fill="#FBBC05"
      d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />

    <path fill="#EA4335"
      d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />

  </svg>

  <span>
    Continue with Google
  </span>

</a>

                          

                                <div class="mt-8 text-center text-sm space-y-3">
                                    <p class="text-gray-600">Don't have an account? <a href="/signup"
                                            class="text-purple-600 hover:text-purple-800 font-medium">Sign up</a></p>
                                    <p class="text-gray-600">Are you Admin? <a href="/admin-login"
                                            class="text-purple-600 hover:text-purple-800 font-medium">Login as Admin</a>
                                    </p>
                                </div>
            </div>
        </div>
    </main>

  <%- include('../../partials/footer') %>