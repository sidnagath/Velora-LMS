  <%- include('../../partials/header') %>

<main class="flex-grow">
    <!-- Hero Section -->
    <section class="py-20 px-8 bg-gradient-to-br from-[#F8F9FA] to-[#E9ECEF]">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between">
            <div class="md:w-1/2 mb-12 md:mb-0 pr-8">
                <span class="inline-block py-1 px-3 rounded-full bg-purple-100 text-purple-700 text-xs font-semibold tracking-wide uppercase mb-6">Future of Learning</span>
                <h1 class="text-5xl font-extrabold text-gray-900 leading-tight mb-6">
                    Learn Coding <br>
                    <span class="text-[#0B5ED7]">the Smart Way</span>
                </h1>
                <p class="text-gray-600 text-lg mb-8 leading-relaxed max-w-lg">
                    Experience a simplified e-learning platform designed for deep focus. Master modern technologies through high-end curated content and a distraction-free environment.
                </p>
                <div class="flex space-x-4">
                    <a href="/auth/signup" class="bg-[#0B5ED7] hover:bg-[#0A58CA] text-white font-medium py-3 px-8 rounded-md transition-colors text-center shadow-lg shadow-blue-500/30">Start Learning</a>
                    <a href="#" class="bg-white hover:bg-gray-50 text-gray-800 border border-gray-200 font-medium py-3 px-8 rounded-md transition-colors text-center shadow-sm">Browse Courses</a>
                </div>
            </div>
            <div class="md:w-1/2 relative">
                <!-- Replace with actual screenshot later -->
                <div class="bg-gray-900 rounded-2xl shadow-2xl overflow-hidden relative">
                    <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Code Editor" class="w-full h-auto opacity-80 mix-blend-luminosity">
                    
                    <!-- Floating Badge -->
                    <div class="absolute bottom-8 left-8 right-8 bg-white/90 backdrop-blur-sm rounded-xl p-4 shadow-xl flex items-center space-x-4">
                        <div class="bg-purple-100 p-3 rounded-lg text-purple-600">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-gray-900">Live Project Mentorship</p>
                            <p class="text-xs text-gray-500">Real-world experience starting today</p>
                        </div>
                    </div>
                </div>
                
                <!-- Decorative Blur -->
                <div class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 bg-blue-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20"></div>
            </div>
        </div>
    </section>

    <!-- Tech Stack Logos -->
    <section class="py-12 border-b border-gray-100 bg-white">
        <div class="max-w-7xl mx-auto px-8 flex flex-wrap justify-center gap-6 md:gap-12">
            <div class="flex items-center space-x-2 bg-gray-50 py-2 px-6 rounded-full border border-gray-100 shadow-sm">
                <span class="text-orange-500 font-bold text-sm">HTML5</span><span class="text-xs font-semibold text-gray-600">HTML</span>
            </div>
            <div class="flex items-center space-x-2 bg-gray-50 py-2 px-6 rounded-full border border-gray-100 shadow-sm">
                <span class="text-blue-500 font-bold text-sm">CSS3</span><span class="text-xs font-semibold text-gray-600">CSS</span>
            </div>
            <div class="flex items-center space-x-2 bg-gray-50 py-2 px-6 rounded-full border border-gray-100 shadow-sm">
                <span class="text-yellow-400 font-bold text-sm">JS</span><span class="text-xs font-semibold text-gray-600">JAVASCRIPT</span>
            </div>
            <div class="flex items-center space-x-2 bg-gray-50 py-2 px-6 rounded-full border border-gray-100 shadow-sm">
                <span class="text-blue-400 font-bold text-sm">React</span><span class="text-xs font-semibold text-gray-600">REACT</span>
            </div>
            <div class="flex items-center space-x-2 bg-gray-50 py-2 px-6 rounded-full border border-gray-100 shadow-sm">
                <span class="text-blue-600 font-bold text-sm">Py</span><span class="text-xs font-semibold text-gray-600">PYTHON</span>
            </div>
        </div>
    </section>

    <!-- Path to Mastery -->
    <section class="py-20 px-8 bg-white">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">Your Path to Mastery</h2>
                <p class="text-gray-500 text-sm">A simple three-step process to transform your career</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center relative">
                <!-- Lines connecting steps (Desktop only) -->
                <div class="hidden md:block absolute top-12 left-1/6 right-1/6 h-0.5 bg-gray-100 -z-10"></div>
                
                <!-- Step 1 -->
                <div class="flex flex-col items-center">
                    <div class="w-24 h-24 bg-blue-50 text-blue-500 rounded-full flex items-center justify-center mb-6 shadow-sm border border-blue-100">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Learn</h3>
                    <p class="text-gray-500 text-sm leading-relaxed">Master complex concepts through bite-sized, high-quality video lessons and documentation.</p>
                </div>
                
                <!-- Step 2 -->
                <div class="flex flex-col items-center">
                    <div class="w-24 h-24 bg-purple-50 text-purple-500 rounded-full flex items-center justify-center mb-6 shadow-sm border border-purple-100">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Practice</h3>
                    <p class="text-gray-500 text-sm leading-relaxed">Build real-world projects in our integrated development environment with live feedback.</p>
                </div>
                
                <!-- Step 3 -->
                <div class="flex flex-col items-center">
                    <div class="w-24 h-24 bg-orange-50 text-orange-500 rounded-full flex items-center justify-center mb-6 shadow-sm border border-orange-100">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Grow</h3>
                    <p class="text-gray-500 text-sm leading-relaxed">Join an elite community and get connected with top-tier tech companies globally.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Courses -->
    <section class="py-20 px-8 bg-[#F8F9FA]">
        <div class="max-w-7xl mx-auto">
            <div class="flex justify-between items-end mb-10">
                <div>
                    <h2 class="text-3xl font-bold text-gray-900 mb-2">Featured Courses</h2>
                    <p class="text-gray-500 text-sm">Most popular paths chosen by our global community</p>
                </div>
                <a href="#" class="text-[#0B5ED7] font-medium text-sm hover:underline flex items-center">
                    View All Courses <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
               <% if (typeof featuredCourses !== 'undefined' && featuredCourses.length > 0) { %>
                 <% featuredCourses.forEach(course => { %>
                    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow group cursor-pointer flex flex-col h-full" onclick="window.location.href='/courses/<%= course._id %>'">
                        <div class="h-40 bg-gray-900 relative overflow-hidden">
                            <img src="<%= course.thumbnail %>" alt="Thumbnail" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        </div>
                        <div class="p-5 flex-grow flex flex-col">
                            <div class="flex justify-between items-center mb-3 relative">
                                <span class="text-[10px] font-bold uppercase tracking-wider py-1 px-2 rounded <%= course.level === 'Beginner' ? 'bg-blue-100 text-blue-700' : course.level === 'Intermediate' ? 'bg-purple-100 text-purple-700' : 'bg-orange-100 text-orange-700' %>"><%= course.level %></span>
                                <% if(course.status === 'draft') { %>
                                <span class="text-[10px] font-bold uppercase tracking-wider py-1 px-2 rounded bg-gray-900 text-white shadow-sm ml-2">NOT AVAILABLE YET</span>
                                <% } %>
                            </div>
                            <h3 class="font-bold text-gray-900 mb-1 flex-grow"><%= course.title %></h3>
                            <p class="text-xs text-gray-500 mb-4 line-clamp-2"><%= course.description %></p>
                            <div class="flex justify-between items-center pt-3 border-t border-gray-100 mt-auto">
                                <% if(course.status === 'draft') { %>
                                    <span class="font-extrabold text-gray-400 text-sm uppercase tracking-wide">Coming Soon</span>
                                <% } else { %>
                                <span class="font-bold <%= course.pricingType === 'free' ? 'text-[#0B5ED7]' : 'text-gray-900' %>"><%= course.pricingType === 'free' ? 'Free' : '₹' + (course.discountPrice || course.basePrice) %></span>
                                <button class="w-8 h-8 rounded-full bg-blue-50 text-[#0B5ED7] flex items-center justify-center hover:bg-[#0B5ED7] hover:text-white transition-colors" title="View Course">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                 <% }) %>
               <% } else { %>
                 <div class="col-span-4 text-center py-12 text-gray-500 font-semibold">No featured courses available at the moment.</div>
               <% } %>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 px-8 bg-white">
        <div class="max-w-4xl mx-auto bg-gray-900 rounded-3xl p-12 text-center relative overflow-hidden shadow-2xl">
            <!-- Background Glow -->
            <div class="absolute -z-10 top-0 left-1/2 -translate-x-1/2 w-full h-full bg-blue-500 rounded-full mix-blend-screen filter blur-3xl opacity-20"></div>
            
            <h2 class="text-3xl font-bold text-white mb-4">Ready to start your journey?</h2>
            <p class="text-gray-400 text-sm mb-10 max-w-lg mx-auto">Join 50,000+ developers learning on Velora. No credit card required to start your first free lesson.</p>
            
            <form class="max-w-md mx-auto flex flex-col sm:flex-row gap-3">
                <input type="email" placeholder="Enter your email" class="flex-grow bg-gray-800 border border-gray-700 rounded-md px-4 py-3 text-white placeholder-gray-500 focus:ring-2 focus:ring-[#0B5ED7] outline-none">
                <button type="submit" class="bg-[#0B5ED7] hover:bg-[#0A58CA] text-white font-medium py-3 px-6 rounded-md transition-colors whitespace-nowrap">Get Started Free</button>
            </form>
        </div>
    </section>
</main>

    <%- include('../../partials/footer') %>
