            <!-- Alert Box -->
            <div class="bg-[#EDE9FE] rounded-2xl p-5 mb-10 flex items-start border border-[#DDD6FE]">
                <div class="bg-[#9061F9] text-white rounded-full w-6 h-6 flex items-center justify-center font-bold text-xs mt-0.5 mr-3 flex-shrink-0">i</div>
                <p class="text-gray-700 text-sm leading-relaxed font-medium">Create an account to start learning this course and track your progress.</p>
            </div>

            <!-- What you will learn -->
