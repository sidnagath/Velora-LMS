<%- include('../../partials/header') %>

<main class="flex-grow bg-[#F8F9FA] pb-20">
    <!-- Hero Header -->
    <section class="py-12 px-8 max-w-7xl mx-auto w-full">
        <div class="flex flex-col lg:flex-row gap-12">
            <!-- Left Info -->
            <div class="flex-grow max-w-3xl">
                <div class="flex items-center space-x-4 mb-4">
                    <span class="bg-[#9061F9] text-white text-xs font-bold px-3 py-1.5 rounded-full z-10 tracking-wider">BEGINNER</span>
                    <div class="flex items-center text-sm font-bold">
                        <span class="text-[#0B5ED7] mr-1.5">★</span>
                        <span class="text-[#0B5ED7] font-extrabold text-sm">4.6</span>
                        <span class="text-gray-400 font-medium text-xs ml-1.5">(300 reviews)</span>
                    </div>
                </div>
                <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6 tracking-tight leading-tight">Semantic HTML Guide</h1>
                <p class="text-gray-600 text-lg mb-8 leading-relaxed">
                    Learn how to write meaningful and accessible HTML using semantic elements to build high-quality, professional web experiences.
