                <div class="flex items-center">
                    <img src="https://ui-avatars.com/api/?name=Marcus+Thorne&background=0D8ABC&color=fff&rounded=true" alt="Dr. Marcus Thorne" class="w-12 h-12 rounded-full mr-4 border border-gray-200">
                    <div>
