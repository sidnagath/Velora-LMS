                        <p class="text-xs text-gray-400 font-semibold">Lead Web Architect at Velora</p>
                    </div>
                </div>
            </div>
            
            <!-- We will leave right space empty in header, the sidebar will pull up over it in the next section -->
            <div class="hidden lg:block w-96 flex-shrink-0"></div>
        </div>
    </section>

