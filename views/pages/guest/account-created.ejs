  <%- include('../../partials/header') %>

<main class="flex-grow flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
        <!-- Account Created Card -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-10 text-center flex flex-col items-center">
            
            <!-- Icon -->
            <div class="w-16 h-16 bg-[#EEF2FF] rounded-full flex items-center justify-center mb-6">
                <div class="w-10 h-10 bg-[#0B5ED7] rounded-full flex items-center justify-center text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
            </div>

            <!-- Header Text -->
            <h2 class="text-2xl font-bold text-gray-900 mb-3 tracking-tight">Account Created<br>Successfully</h2>
            <p class="text-gray-500 text-sm mb-8 px-4 leading-relaxed">
                Your account has been created successfully.<br>You can now log in with your credentials.
            </p>

            <a href="/auth/login" class="btn-primary w-full text-center block mb-6">Go to Login</a>
            
            <!-- Redirect Text -->
            <div class="flex items-center justify-center gap-2 text-xs text-gray-400 font-medium tracking-wide">
                <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
                Redirecting in a few seconds...
            </div>
        </div>
    </div>
</main>

<script>
    // Redirect to login after 3 seconds
    setTimeout(function() {
        window.location.href = '/auth/login';
    }, 3000);
</script>

  <%- include('../../partials/footer') %>
