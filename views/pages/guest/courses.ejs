<%- include('../../partials/header') %>

<main class="flex-grow bg-[#F8F9FA] pb-20">
    <form method="GET" action="/courses">
    <!-- Header Section -->
    <section class="pt-12 pb-8 px-8 max-w-7xl mx-auto w-full">
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight">Explore Courses</h1>
        <p class="text-gray-600 text-lg max-w-2xl mb-10 leading-relaxed">
            Learn coding from top courses. Join our Digital Sanctuary and master the skills of tomorrow in a focused, premium environment.
        </p>
        
        
            <!-- SEARCH ICON AND INPUT CONTAINER -->
            <div class="w-full mt-8 flex gap-3" style="position: relative;">
                <div class="flex-grow" style="position: relative;">
                    <svg
                      class="text-gray-400"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      style="position: absolute; left: 1.25rem; top: 50%; transform: translateY(-50%); width: 1.25rem; height: 1.25rem; pointer-events: none; z-index: 10;"
                    >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        />
                    </svg>
                
                    <input
                      type="text"
                      name="search"
                      value="<%= typeof search !== 'undefined' ? search : '' %>"
                      placeholder="Search courses..."
                      class="w-full h-16 rounded-2xl bg-gray-100 border border-transparent focus:border-[#0B5ED7] focus:ring-2 focus:ring-[#0B5ED7]/20 outline-none text-gray-900 placeholder-gray-400"
                      style="padding-left: 3.5rem; padding-right: 1rem; width: 100%; height: 4rem;"
                    >
                </div>
                <button type="submit" class="h-16 px-8 rounded-2xl bg-[#0B5ED7] hover:bg-blue-700 text-white font-bold transition flex-shrink-0" style="height: 4rem;">
                    Search
                </button>
            </div>
        
    </section>
    
    <!-- Content Section -->
    <section class="px-8 max-w-7xl mx-auto flex flex-row gap-8 items-start w-full">
        
        <!-- Sidebar Filters (Left) -->
        <aside class="w-64 flex-shrink-0 bg-gray-50 rounded-2xl p-6 border border-gray-100">
            <div class="mb-6">
                <h3 class="text-lg font-bold text-gray-900">Filters</h3>
                <p class="text-xs text-gray-400 font-semibold tracking-wider uppercase mt-1">Refine your journey</p>
            </div>

            <!-- Category -->
            <div class="mb-8">
                <div class="flex items-center text-gray-700 font-semibold mb-4 space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    <span class="text-sm font-bold tracking-wide">Category</span>
                </div>
                <div class="relative w-full" id="category-dropdown-container">
                    <input type="hidden" name="category" id="category-input" value="<%= typeof selectedCategoryId !== 'undefined' ? selectedCategoryId : '' %>">
                    
                    <% 
                      let selectedCatName = "All Categories";
                      if (typeof selectedCategoryId !== 'undefined' && selectedCategoryId) {
                        const foundCat = (allCategories || []).find(c => c._id.toString() === selectedCategoryId.toString());
                        if (foundCat) selectedCatName = foundCat.name;
                      }
                    %>
                    
                    <!-- Dropdown Button -->
                    <div class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 flex items-center justify-between cursor-pointer hover:border-[#0B5ED7] transition-colors" onclick="toggleCategoryDropdown()">
                        <span id="selected-category-text" class="text-sm font-medium text-gray-700 truncate"><%= selectedCatName %></span>
                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>

                    <!-- Dropdown Menu -->
                    <div id="category-dropdown-menu" class="absolute z-50 w-full mt-2 bg-white border border-gray-100 rounded-xl shadow-xl hidden flex-col overflow-hidden">
                        <div class="p-2 border-b border-gray-50">
                            <input type="text" id="category-search" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#0B5ED7]/20 focus:border-[#0B5ED7] transition-all" placeholder="Search category..." onkeyup="filterCategories()" onclick="event.stopPropagation()">
                        </div>
                        <ul class="max-h-48 overflow-y-auto py-1 custom-scrollbar" id="category-list">
                            <li class="px-4 py-2.5 text-sm text-gray-700 hover:bg-[#0B5ED7] hover:text-white cursor-pointer transition-colors" onclick="selectCategory('', 'All Categories')">
                                All Categories
                            </li>
                            <% (allCategories || []).forEach(cat => { %>
                                <li class="category-item px-4 py-2.5 text-sm text-gray-700 hover:bg-[#0B5ED7] hover:text-white cursor-pointer transition-colors" data-name="<%= cat.name.toLowerCase() %>" onclick="selectCategory('<%= cat._id %>', '<%= cat.name %>')">
                                    <%= cat.name %>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Level -->
            <div class="mb-8">
                <div class="flex items-center text-gray-700 font-semibold mb-4 space-x-2">
                    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    <span class="text-sm font-bold tracking-wide">Level</span>
                </div>
                <div class="space-y-3">
                    <% const levels = ['Beginner', 'Intermediate', 'Advanced']; %>
                    <% levels.forEach(lvl => { %>
                        <% const isChecked = (typeof selectedLevel !== 'undefined' && selectedLevel === lvl); %>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="radio" name="level" value="<%= lvl %>" <%= isChecked ? 'checked' : '' %>  class="level-filter w-4 h-4 accent-[#0B5ED7] border-gray-300 focus:ring-[#0B5ED7]" >
                            <span class="ml-3 text-sm <%= isChecked ? 'font-bold text-[#0B5ED7]' : 'font-medium text-gray-700 hover:text-[#0B5ED7]' %>"><%= lvl %></span>
                        </label>
                    <% }) %>
                </div>
            </div>

            <!-- Price -->
            <div>
                <div class="flex items-center text-gray-700 font-semibold mb-4 space-x-2">
                    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    <span class="text-sm font-bold tracking-wide">Price</span>
                </div>
                <div class="space-y-3">
                    <% const prices = [{ name: 'Free', val: 'free' }, { name: 'Paid', val: 'paid' }]; %>
                    <% prices.forEach(prc => { %>
                        <% const isChecked = (typeof selectedPrice !== 'undefined' && selectedPrice === prc.val); %>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="radio" name="price" value="<%= prc.val %>" <%= isChecked ? 'checked' : '' %>  class="price-filter w-4 h-4 accent-[#0B5ED7] border-gray-300 rounded focus:ring-[#0B5ED7]" >
                            <span class="ml-3 text-sm <%= isChecked ? 'font-bold text-[#0B5ED7]' : 'font-medium text-gray-700 hover:text-[#0B5ED7]' %>"><%= prc.name %></span>
                        </label>
                    <% }) %>
            </div>
            
            <button
              type="submit"
              class="w-full mt-6 bg-[#0B5ED7] hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition"
            >
              Apply Filters
            </button>
            <a
              href="/courses"
              class="w-full mt-3 block text-center bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-3 rounded-xl transition"
            >
              Reset Filters
            </a>
        </aside>

        <!-- Course Grid Area -->
        <div class="flex-grow w-full">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
               <% courses.forEach(course => { %>
<div onclick="window.location.href='/courses/<%= course._id %>'" class="w-full bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100 flex flex-col group cursor-pointer" style="height: 450px;">

    
    <!-- IMAGE -->

    <div class="w-full overflow-hidden bg-gray-200" style="position: relative; height: 14rem; width: 100%;">

        <img
          src="<%= course.thumbnail %>"
          class="group-hover:scale-105 transition-transform duration-500"
          style="width: 100%; height: 100%; object-fit: cover; object-position: center;"
        >

        <!-- LEVEL -->

        <span class="text-white text-[10px] font-bold px-3 py-1.5 rounded-full tracking-wider" style="position: absolute; top: 1rem; left: 1rem; z-index: 10; background-color: <%= course.level === 'Beginner' ? '#0B5ED7' : course.level === 'Intermediate' ? '#9061F9' : '#854D0E' %>;">

          <%= course.level.toUpperCase() %>

        </span>

    </div>

    <!-- CONTENT -->

    <div class="p-6 flex flex-col justify-between flex-grow">

        <!-- TOP CONTENT -->

        <div>

            <!-- RATING -->

            <div class="flex items-center text-sm font-bold mb-3">

                <svg class="w-4 h-4 text-amber-400 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>

                <span class="text-gray-900">
                    <%= course.rating || '4.8' %>
                </span>

                <span class="text-gray-400 text-xs ml-1.5 font-medium">
                    (<%= course.reviewsCount || 0 %> reviews)
                </span>

            </div>

            <!-- TITLE -->

            <h3 class="font-bold text-lg text-gray-900 leading-snug line-clamp-2 mb-2" style="min-height: 3rem;">

                <%= course.title %>

            </h3>

        </div>

        <!-- FOOTER -->

        <div class="flex justify-between items-center pt-4 border-t border-gray-100 mt-4">

            <span class="font-extrabold text-[#0B5ED7] text-xl">

                <%= course.basePrice === 0
                ? 'Free'
                : '₹' + course.basePrice %>

            </span>

            <a
              href="/login"
              onclick="event.stopPropagation()"
              class="bg-blue-50 hover:bg-blue-100 text-[#0B5ED7] font-bold py-2 px-4 rounded-xl transition duration-300 text-sm flex items-center justify-center"
            >

              Login to Enroll

            </a>

        </div>

    </div>

</div>

<% }) %>

    
            </div>

<!-- PAGINATION -->


<div class="mt-12 flex justify-center items-center space-x-2">

    <!-- PREVIOUS -->

    <% if(currentPage > 1) { %>

        <a
          href="/courses?page=<%= currentPage - 1 %>&category=<%= selectedCategoryId || '' %>&level=<%= selectedLevel %>&price=<%= selectedPrice %>&search=<%= search %>"
          class="w-10 h-10 rounded-full border border-gray-300 flex items-center justify-center text-gray-500 hover:bg-gray-100 transition-colors"
        >

            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"
                />

            </svg>

        </a>

    <% } %>



    <!-- PAGE NUMBERS -->

    <% for(let i = 1; i <= totalPages; i++) { %>

        <a
          href="/courses?page=<%= i %>&category=<%= selectedCategoryId || '' %>&level=<%= selectedLevel %>&price=<%= selectedPrice %>&search=<%= search %>"

          class="
            w-10 h-10 rounded-full flex items-center justify-center transition-colors

            <%= currentPage === i

            ? 'bg-[#0B5ED7] text-white font-bold shadow-md shadow-blue-500/20'

            : 'text-gray-700 font-semibold hover:bg-gray-100' %>
          "
        >

          <%= i %>

        </a>

    <% } %>



    <!-- NEXT -->

    <% if(currentPage < totalPages) { %>

        <a
          href="/courses?page=<%= currentPage + 1 %>&category=<%= selectedCategoryId || '' %>&level=<%= selectedLevel %>&price=<%= selectedPrice %>&search=<%= search %>"
          class="w-10 h-10 rounded-full border border-gray-300 flex items-center justify-center text-gray-500 hover:bg-gray-100 transition-colors"
        >

            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">

                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />

            </svg>

        </a>

    <% } %>

    

</section>
</form>

<script>
    function toggleCategoryDropdown() {
        const menu = document.getElementById('category-dropdown-menu');
        menu.classList.toggle('hidden');
        menu.classList.toggle('flex');
    }

    function selectCategory(id, name) {
        document.getElementById('category-input').value = id;
        document.getElementById('selected-category-text').innerText = name;
        toggleCategoryDropdown();
    }

    function filterCategories() {
        const search = document.getElementById('category-search').value.toLowerCase();
        const items = document.querySelectorAll('.category-item');
        items.forEach(item => {
            if (item.getAttribute('data-name').includes(search)) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const container = document.getElementById('category-dropdown-container');
        const menu = document.getElementById('category-dropdown-menu');
        if (container && !container.contains(event.target)) {
            menu.classList.add('hidden');
            menu.classList.remove('flex');
        }
    });
</script>
</main>



<%- include('../../partials/footer') %>
