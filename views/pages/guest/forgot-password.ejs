  <%- include('../../partials/header') %>

<main class="flex-grow flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
        <!-- Forgot Password Card -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-10 text-center flex flex-col items-center">
            
            <!-- Icon -->
            <div class="w-16 h-16 bg-[#EEF2FF] rounded-full flex items-center justify-center mb-6">
                <div class="w-10 h-10 bg-[#0B5ED7] rounded-full flex items-center justify-center text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </div>
            </div>

            <!-- Header Text -->
            <h2 class="text-2xl font-bold text-gray-900 mb-3 tracking-tight">Forgot Password</h2>
            <p class="text-gray-500 text-sm mb-8 px-4 leading-relaxed">
            Enter your email to receive a reset code
            </p>

            <%- include('../../partials/user-banner') %>
            
               <% if(errors?.general){ %>
               <p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
               <%= errors.general %>
               </p>
               <% } %>
            
            <form id="ajaxForm" data-action="/api/v1/auth/forgot-password" class="w-full text-left space-y-6">
                <div>
                    <label class="block text-xs font-medium text-gray-500 tracking-wide uppercase mb-2">Email Address</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <input type="email" name="email"  value="<%= formData?.email || '' %>" class="input-field pl-11 bg-gray-100/50 border-gray-200" placeholder="name@example.com" >
                    </div>
                </div>

                <% if(errors?.email){ %>
                <p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
                <%= errors.email %>
                </p>
                <% } %>
                

                <button type="submit" class="btn-primary w-full mt-2">Send OTP</button>

                <div class="flex justify-center mt-6">
                    <a href="/auth/login" class="text-sm font-medium text-[#0B5ED7] hover:underline flex items-center justify-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Back to Login
                    </a>
                </div>
            </form>

        
        <p class="text-center text-xs text-gray-400 uppercase tracking-widest mt-8">Secure authentication for Velora</p>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
localStorage.removeItem("forgotPasswordOtpExpiry");

document.getElementById('ajaxForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const url = form.getAttribute('data-action');
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        if (result.success) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: result.message,
                timer: 1500,
                showConfirmButton: false
            }).then(() => {
                window.location.href = result.data.redirectUrl || '/';
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: result.message || 'Something went wrong'
            });
        }
    } catch (err) {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Network error. Please try again.'
        });
    }
});
</script>

  <%- include('../../partials/footer') %>
