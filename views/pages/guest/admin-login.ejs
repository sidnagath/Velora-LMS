  <%- include('../../partials/header') %>

    <main class="flex-grow flex items-center justify-center py-16 px-4">
        <div class="w-full max-w-md">
            <!-- Header Text -->
            <div class="text-center mb-8">
                <h1 class="text-4xl font-bold text-[#0B5ED7] mb-2 tracking-tight">Velora</h1>
                <p class="text-gray-600 text-sm">Continue your learning excellence journey.</p>
            </div>

            <!-- Login Card -->
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-10">
                <h2 class="text-2xl font-semibold text-gray-800 mb-2">Welcome Back Admin</h2>
                <p class="text-gray-500 text-sm mb-8">Enter your credentials to access the admin control panel.</p>

<p id="error-general" class="text-red-500 text-[13px] font-medium mt-1.5 mb-4 <%= errors?.general ? '' : 'hidden' %>">
  <%= errors?.general || '' %>
</p>

                <form id="ajaxForm" data-action="/api/v1/auth/admin-login" class="space-y-5">
                    <div>
                        <label
                            class="block text-xs font-medium text-gray-500 tracking-wide uppercase mb-2">Username</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none"
                                    viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <input type="text" name="email" value="<%= formData?.email || '' %>" class="input-field pl-11" placeholder="name@example.com">
                        </div>
                    </div>

<p id="error-email" class="text-red-500 text-[13px] font-medium mt-1.5 <%= errors?.email ? '' : 'hidden' %>">
  <%= errors?.email || '' %>
</p>

                    <div>
                        <label
                            class="block text-xs font-medium text-gray-500 tracking-wide uppercase mb-2">Password</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none"
                                    viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </div>
                            <input type="password" name="password" class="input-field pl-11 pr-11" placeholder="••••••••">
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center cursor-pointer toggle-password">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </div>
                        </div>
                    </div>
                    
<p id="error-password" class="text-red-500 text-[13px] font-medium mt-1.5 <%= errors?.password ? '' : 'hidden' %>">
  <%= errors?.password || '' %>
</p>

                    <button type="submit" class="btn-primary mt-6">Login</button>
                </form>


                <div class="mt-8 text-center text-sm space-y-3">
                    <p class="text-gray-600">Already have an account? <a href="/auth/login"
                            class="text-purple-600 hover:text-purple-800 font-medium">Log in as User</a></p>
                    <p class="text-gray-600">Don't have an account? <a href="/auth/signup"
                            class="text-purple-600 hover:text-purple-800 font-medium">Sign up as User</a></p>
                </div>
            </div>
        </div>
    </main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.getElementById('ajaxForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const url = form.getAttribute('data-action');
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    // Clear previous errors
    ['general', 'email', 'password'].forEach(field => {
        const errorEl = document.getElementById(`error-${field}`);
        if (errorEl) {
            errorEl.innerText = '';
            errorEl.classList.add('hidden');
        }
    });
    
    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        if (result.success) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: result.message,
                timer: 1500,
                showConfirmButton: false
            }).then(() => {
                window.location.href = result.data.redirectUrl || '/admin/dashboard';
            });
        } else {
            if (result.errors && Object.keys(result.errors).length > 0) {
                let hasInlineError = false;
                for (const field in result.errors) {
                    const errorEl = document.getElementById(`error-${field}`);
                    if (errorEl) {
                        errorEl.innerText = result.errors[field];
                        errorEl.classList.remove('hidden');
                        hasInlineError = true;
                    }
                }
                
                if (!hasInlineError) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: result.message || 'Validation failed'
                    });
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: result.message || 'Something went wrong'
                });
            }
        }
    } catch (err) {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Network error. Please try again.'
        });
    }
});
</script>
      <%- include('../../partials/footer') %>