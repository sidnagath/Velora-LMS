  <%- include('../../partials/header') %>

<main class="flex-grow flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
        <!-- Verify Signup OTP Card -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-10 text-center flex flex-col items-center">
            
            <!-- Icon -->
            <div class="w-16 h-16 bg-[#EEF2FF] rounded-full flex items-center justify-center mb-6">
                <div class="w-10 h-10 bg-[#0B5ED7] rounded-full flex items-center justify-center text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>

            <!-- Header Text -->
            <h2 class="text-2xl font-bold text-gray-900 mb-3 tracking-tight">Verify OTP</h2>
            <p class="text-gray-500 text-sm mb-8 px-4 leading-relaxed">
                Enter the verification code sent to your email
            </p>
            
            <%- include('../../partials/user-banner') %>

               <% if(errors?.general){ %>
               <p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
               <%= errors.general %>
               </p>
               <% } %>

            <form id="ajaxForm" method="POST" data-action="/api/v1/auth/verify-signupotp" class="w-full text-left space-y-6">
                <div>
                    <label class="block text-xs font-medium text-gray-500 tracking-wide uppercase mb-2">Verification Code</label>
                    <div class="relative">
                        <input type="text" name="otp" class="input-field bg-gray-50 text-center tracking-[0.5em] text-lg font-semibold" placeholder="••••••">
                    </div>
                </div>

                <p id="error-otp" class="text-red-500 text-[13px] font-medium mt-1.5 <%= errors?.otp ? '' : 'hidden' %>"><%= errors?.otp || '' %></p>

                <button type="submit" class="btn-primary w-full text-center block mb-6">Verify Code</button>
            </form>

<div class="text-center mt-4 space-y-3">

  <!-- TIMER TEXT -->

<p id="timerText" class="text-sm text-gray-500">
  OTP expires in
  <span id="otpTimer" class="font-semibold text-[#0B5ED7]">
    01:00
  </span>
</p>

  <!-- RESEND FORM -->

  <form id="ajaxResendForm" data-action="/api/v1/auth/resend-signupotp">

    <button
      id="resendBtn"
      type="submit"
      disabled
      class="text-sm font-medium text-gray-400 cursor-not-allowed"
    >

      Resend OTP

    </button>

  </form>

</div>
            
        </div>
        
        <p class="text-center text-xs text-gray-400 uppercase tracking-widest mt-8">Secure authentication for Velora</p>
    </div>
</main>

<script>
let otpExpiry = <%= otpExpires || 0 %>;
let timerInterval;

const timerElement = document.getElementById("otpTimer");
const resendBtn = document.getElementById("resendBtn");
const timerText = document.getElementById("timerText");
const originalTimerHTML = timerText.innerHTML;

function startTimer() {
    if (timerInterval) clearInterval(timerInterval);
    
    // Reset UI
    timerText.innerHTML = `OTP expires in <span id="otpTimer" class="font-semibold text-[#0B5ED7]">00:00</span>`;
    const newTimerElement = document.getElementById("otpTimer");
    
    resendBtn.disabled = true;
    resendBtn.classList.remove("text-blue-600");
    resendBtn.classList.add("text-gray-400", "cursor-not-allowed");

    function updateTimer() {
        const remaining = Math.floor((otpExpiry - Date.now()) / 1000);

        if (remaining <= 0) {
            clearInterval(timerInterval);
            timerText.innerHTML = '<span class="text-red-500 font-medium">OTP expired</span>';
            resendBtn.disabled = false;
            resendBtn.classList.remove("text-gray-400", "cursor-not-allowed");
            resendBtn.classList.add("text-blue-600");
            return;
        }

        const minutes = String(Math.floor(remaining / 60)).padStart(2, "0");
        const seconds = String(remaining % 60).padStart(2, "0");
        newTimerElement.innerText = `${minutes}:${seconds}`;
    }

    updateTimer();
    timerInterval = setInterval(updateTimer, 1000);
}

startTimer();
</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.getElementById('ajaxForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const url = form.getAttribute('data-action');
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
    const errorEl = document.getElementById('error-otp');
    if (errorEl) {
        errorEl.innerText = '';
        errorEl.classList.add('hidden');
    }
    
    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        
        if (result.success) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: result.message,
                timer: 1500,
                showConfirmButton: false
            }).then(() => {
                if (result.data?.redirectUrl) {
                    window.location.href = result.data.redirectUrl;
                } else {
                    window.location.reload();
                }
            });
        } else {
            if (result.errors) {
                let hasInlineError = false;
                for (const field in result.errors) {
                    const errEl = document.getElementById(`error-${field}`);
                    if (errEl) {
                        errEl.innerText = result.errors[field];
                        errEl.classList.remove('hidden');
                        hasInlineError = true;
                    }
                }
                if (!hasInlineError) {
                    Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'Validation failed' });
                }
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'Verification failed' });
            }
        }
    } catch (err) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Network error. Please try again.' });
    }
});

document.getElementById('ajaxResendForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const url = form.getAttribute('data-action');
    
    try {
        const response = await fetch(url, { method: 'POST' });
        const result = await response.json();
        
        if (result.success) {
            Swal.fire({
                icon: 'success',
                title: 'OTP Resent',
                text: result.message,
                toast: true,
                position: 'top-end',
                timer: 3000,
                showConfirmButton: false
            });
            // Update the expiry time and restart timer
            if (result.data?.otpExpires) {
                otpExpiry = result.data.otpExpires;
                startTimer();
            } else {
                // fallback if backend doesn't send it, assume 60 seconds
                otpExpiry = Date.now() + 60000;
                startTimer();
            }
        } else {
            Swal.fire({ icon: 'error', title: 'Error', text: result.message || 'Failed to resend OTP' });
        }
    } catch (err) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Network error. Please try again.' });
    }
});
</script>

