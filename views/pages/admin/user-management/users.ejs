<%- include('../../../partials/header') %>

  <main class="flex min-h-screen bg-gray-50 font-sans">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-white border-r flex flex-col hidden md:flex min-h-screen">
      <div class="p-6 pb-8">
        <h1 class="text-2xl font-bold text-blue-600 tracking-tight">Velora Admin</h1>
      </div>

      <div class="px-6 flex items-center space-x-3 mb-8">
        <img src="https://i.pravatar.cc/150?u=admin" alt="Velora Admin" class="w-10 h-10 rounded-full border">
        <div>
          <p class="text-sm font-semibold text-gray-900">Velora Admin</p>
          <p class="text-xs text-gray-500">System Controller</p>
        </div>
      </div>

      <nav class="flex-1 space-y-1 text-sm font-medium">
        <a href="/admin-dashboard"
          class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 transition-colors">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z">
            </path>
          </svg>
          Dashboard
        </a>
        <a href="#"
          class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 transition-colors">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253">
            </path>
          </svg>
          Courses
        </a>
        <!-- Active state: Use margin/rounded classes based on image (e.g. gray bg, blue text, rounded-r-3xl or so) -->
        <a href="/admin-users"
          class="flex items-center px-6 py-3 text-blue-600 bg-gray-100 rounded-r-full mr-4 relative group">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
            </path>
          </svg>
          Users
          <span class="absolute inset-y-0 right-0 w-1 bg-blue-600 rounded-l-md hidden"></span>
        </a>
        <a href="#"
          class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 transition-colors">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
            </path>
          </svg>
          Orders
        </a>
        <a href="#"
          class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 transition-colors">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01">
            </path>
          </svg>
          Coupons
        </a>
        <a href="#"
          class="flex items-center px-6 py-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 transition-colors">
          <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
            </path>
          </svg>
          Reports
        </a>

        <div class="mt-8">
          <a href="/admin-logout" class="flex items-center px-6 py-3 text-red-600 hover:bg-red-50 transition-colors">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            Logout
          </a>
        </div>
      </nav>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="flex-1 flex flex-col h-screen overflow-y-auto">

      <!-- TOP NAVIGATION -->
      <header class="bg-white border-b sticky top-0 z-10 px-8 py-4 flex items-center justify-between">
        <div class="relative w-full max-w-2xl">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input type="text"
            class="block w-full pl-11 pr-3 py-2.5 border border-gray-200 rounded-full leading-5 bg-gray-50 placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-blue-500 focus:border-blue-500 sm:text-sm transition duration-150 ease-in-out"
            placeholder="Search users">
        </div>
        <div class="flex items-center space-x-6 ml-4">
          <button class="text-gray-400 hover:text-gray-500 relative">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
              </path>
            </svg>
          </button>
          <button class="text-gray-400 hover:text-gray-500">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z">
              </path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </button>
          <img class="h-9 w-9 rounded-full border border-gray-200" src="https://i.pravatar.cc/150?u=admin"
            alt="Admin Profile">
        </div>
      </header>

      <div class="p-8 max-w-7xl mx-auto w-full">
        <!-- HEADER -->
        <div class="mb-8">
          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">User Management</h1>
          <p class="text-gray-500 mt-2 text-sm max-w-2xl">
            Oversee your educational community. Manage permissions, monitor activity, and support your instructors and
            students from a centralized sanctuary.
          </p>
        </div>

        <!-- STATS -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="flex justify-between items-start mb-4">
              <div class="p-2.5 bg-blue-50 text-blue-600 rounded-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
                  </path>
                </svg>
              </div>
              <span
                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700">
                +12%
              </span>
            </div>
            <p class="text-xs font-bold text-gray-500 tracking-wider uppercase">Total Users</p>
            <h2 class="text-3xl font-extrabold text-gray-900 mt-1">
              <%=users.length%>
            </h2>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="flex justify-between items-start mb-4">
              <div class="p-2.5 bg-purple-50 text-purple-600 rounded-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
            <p class="text-xs font-bold text-gray-500 tracking-wider uppercase">Active Users</p>
            <h2 class="text-3xl font-extrabold text-gray-900 mt-1">
              <%=users.filter(user=>user.status==="active").length%>
            </h2>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="flex justify-between items-start mb-4">
              <div class="p-2.5 bg-orange-50 text-orange-600 rounded-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
            <p class="text-xs font-bold text-gray-500 tracking-wider uppercase">Inactive Users</p>
            <h2 class="text-3xl font-extrabold text-gray-900 mt-1">
              <%=users.filter(user=>user.status==="inactive").length%>
            </h2>
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="flex justify-between items-start mb-4">
              <div class="p-2.5 bg-yellow-50 text-yellow-600 rounded-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z">
                  </path>
                </svg>
              </div>
            </div>
            <p class="text-xs font-bold text-gray-500 tracking-wider uppercase">Google Users</p>
            <h2 class="text-3xl font-extrabold text-gray-900 mt-1"><%=users.filter(user=>user.authProvider==="google").length%></h2>
          </div>
        </div>

        <!-- MAIN TABLE AREA -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">

          <!-- Controls Row -->
          <div class="p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-100">
            <div class="relative w-full md:max-w-md">

              <form
  action="/admin-users"
  method="GET"
  class="flex items-center gap-3 w-full"
>

  <div class="flex-1">

    <input
      type="text"
      name="search"
      value="<%= search %>"
      placeholder="Search by name, email or status"

      class="w-full px-6 py-4 rounded-2xl border border-gray-200 bg-white text-sm"
    >

  </div>

               <button type="submit"
                  class="shrink-0 px-8 py-4 rounded-2xl bg-blue-600 text-white font-semibold hover:bg-blue-700 transition">
                  Search
                </button>

</form>
            </div>

            <div class="flex items-center gap-3">
              <button
                class="inline-flex items-center px-4 py-2.5 border border-transparent text-sm font-medium rounded-lg text-gray-700 bg-gray-100 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300 transition-colors">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z">
                  </path>
                </svg>
                Filters
              </button>
              <button
                class="inline-flex items-center px-4 py-2.5 border border-transparent text-sm font-medium rounded-lg text-gray-700 bg-gray-100 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300 transition-colors">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                Export
              </button>
              <a href="/admin-create-user"
                class="inline-flex items-center px-4 py-2.5 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Create User
              </a>
            </div>
          </div>

          <!-- Table -->
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-600">
              <thead
                class="bg-gray-50 text-xs font-bold uppercase tracking-wider text-gray-500 border-b border-gray-100">
                <tr>
                  <th scope="col" class="px-6 py-4">Name</th>
                  <th scope="col" class="px-6 py-4">Email</th>
                  <th scope="col" class="px-6 py-4">Joined Date</th>
                  <th scope="col" class="px-6 py-4">Status</th>
                  <th scope="col" class="px-6 py-4">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% if(users && users.length> 0) { %>
                  <% users.forEach(user=> { %>
                    <tr class="hover:bg-gray-50 transition-colors">
                      <td class="px-6 py-4">
                        <div class="flex items-center space-x-3">
                          <% if (user.avatar) { %>
                            <img src="<%= user.avatar %>" alt="<%= user.name %>"
                              class="w-10 h-10 rounded-full border border-gray-200">
                            <% } else { %>
                              <!-- Placeholder Avatar based on name -->
                              <img
                                src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&background=random"
                                alt="<%= user.name %>" class="w-10 h-10 rounded-full border border-gray-200">
                              <% } %>
                                <div>
                                  <p class="text-sm font-bold text-gray-900">
                                    <%= user.name %>
                                  </p>
                                  <p class="text-xs text-gray-500 mt-0.5">ID: <%= user._id %>
                                  </p>
                                </div>
                        </div>
                      </td>
                      <td class="px-6 py-4 text-gray-500">
                        <%= user.email %>
                      </td>
                      <td class="px-6 py-4 text-gray-500">
                        <%= user.createdAt.toDateString() %>
                      </td>
                      <td class="px-6 py-4">
                        <% if (user.status==='active' ) { %>
                          <span
                            class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-100">
                            <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span>
                            Active
                          </span>
                          <% } else if (user.status==='inactive' ) { %>
                            <span
                              class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                              <span class="w-1.5 h-1.5 rounded-full bg-gray-400 mr-1.5"></span>
                              Inactive
                            </span>
                            <% } %>
                      </td>
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-2">
                          <a href="/admin-edit-user/<%= user._id %>""
                            class=" inline-flex items-center px-3 py-1.5 border border-blue-600 text-xs font-semibold
                            rounded-md text-blue-600 bg-white hover:bg-blue-50 transition-colors">
                            <svg class="h-3.5 w-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                              </path>
                            </svg>
                            Edit
                          </a>
                          <form action="/admin-delete-user/<%= user._id %>" method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this user?')">
                            <button type="submit"
                              class="inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-semibold rounded-md text-white bg-red-600 hover:bg-red-700 transition-colors shadow-sm">
                              <svg class="h-3.5 w-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                </path>
                              </svg>

                              Delete
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                    <% }) %>
                      <% } else { %>
                        <tr>
                          <td colspan="5" class="px-6 py-8 text-center text-gray-500">No users found.</td>
                        </tr>
                        <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <div class="p-6 border-t border-gray-100 flex items-center justify-between bg-gray-50/50">

            <!-- LEFT -->
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">

              Showing

              <%= users.length ? ((currentPage - 1) * 5) + 1 : 0 %>

                to

                <%= ((currentPage - 1) * 5) + users.length %>

                  of

                  <%= totalUsers %>

                    users

            </p>



            <!-- RIGHT -->
            <div class="flex items-center space-x-2">

              <!-- PREV -->
              <% if(currentPage> 1) { %>

                <a href="/admin-users?page=<%= currentPage - 1 %>&search=<%= search %>"
                  class="w-8 h-8 flex items-center justify-center rounded-full bg-white text-gray-500 hover:bg-gray-100 border border-gray-200 transition-colors">

                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>

                </a>

                <% } %>



                  <!-- PAGE NUMBERS -->
                  <% for(let i=1; i <=totalPages; i++) { %>

                    <a href="/admin-users?page=<%= i %>&search=<%= search %>" class="
          w-8 h-8 flex items-center justify-center rounded-full text-sm font-semibold transition-colors border

          <%= currentPage === i
            ? 'bg-blue-600 text-white border-blue-600 shadow-sm'
            : 'bg-white text-gray-700 hover:bg-gray-50 border-gray-200'
          %>
        ">
                      <%= i %>
                    </a>

                    <% } %>



                      <!-- NEXT -->
                      <% if(currentPage < totalPages) { %>

                        <a href="/admin-users?page=<%= currentPage + 1 %>&search=<%= search %>"
                          class="w-8 h-8 flex items-center justify-center rounded-full bg-white text-gray-500 hover:bg-gray-100 border border-gray-200 transition-colors">

                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                            </path>
                          </svg>

                        </a>

                        <% } %>

            </div>

          </div>

        </div>
      </div>
  </main>

  <%- include('../../../partials/footer') %>