      class="sr-only"
      <%= user.status === "inactive" ? "checked" : "" %>
    >

    <div class="w-8 h-8 rounded-full bg-white text-gray-400 flex items-center justify-center mb-2 shadow-sm">
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"
        ></path>
      </svg>
    </div>

    <span class="font-bold text-gray-600">
      Inactive
    </span>

  </label>

</div>

            <div class="bg-gray-50 rounded-xl p-4 flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <p class="text-sm text-gray-500">Inactive users cannot log in or access purchased courses.</p>
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN (Sidebar Actions) -->
        <div class="space-y-8">
          
<!-- Profile Photo Card -->
<div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 flex flex-col items-center text-center">

  <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-6 w-full text-left">
    Profile Photo
  </h3>

  <!-- IMAGE PREVIEW -->
  <div class="relative mb-6">

    <img
      id="imagePreview"

      src="<%= user && user.avatar ? user.avatar : 'https://ui-avatars.com/api/?name=User&background=2563eb&color=fff' %>"

      class="w-40 h-40 rounded-full object-cover border-4 border-gray-100 shadow-sm"
    >

    <label
      for="avatarInput"
      class="absolute bottom-2 right-2 bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full cursor-pointer shadow-lg"
    >
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
        ></path>

        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
        ></path>
      </svg>
    </label>

  </div>

  <!-- FILE INPUT -->
  <input
    type="file"
    id="avatarInput"
    name="avatar"
    accept="image/*"
    class="hidden"
  >

  <p class="text-xs text-gray-500">
    JPG, PNG or WEBP. Max 2MB.
  </p>

</div>

<script>

  const avatarInput =
    document.getElementById("avatarInput");

  const imagePreview =
    document.getElementById("imagePreview");

  avatarInput.addEventListener(
    "change",
    function (e) {

      const file = e.target.files[0];

      if (!file) return;

      imagePreview.src =
        URL.createObjectURL(file);
    }
  );

</script>

          <!-- Actions Card -->
          <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200 border-dashed">
            <div class="flex justify-between items-center mb-8">
              <span class="text-xs font-semibold text-gray-500">Creation Date</span>
              <span class="text-sm font-bold text-gray-900">May 24, 2024</span>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3.5 px-4 rounded-xl shadow-sm hover:bg-blue-700 transition-colors flex items-center justify-center mb-4">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Update User
            </button>

            <button class="w-full bg-gray-200 text-gray-700 font-bold py-3.5 px-4 rounded-xl hover:bg-gray-300 transition-colors mb-6">
              Cancel
            </button>

            <p class="text-[10px] text-gray-400 text-center uppercase tracking-wider font-semibold leading-relaxed">
              By creating this user, you agree to Velora's Administrator Terms of Service and Privacy Policy.
            </p>
          </div>

        </div>
      </div>
     </form>

    </div>
  </div>
</main>

<script>

  const activeCard =
    document.getElementById("activeCard");

  const inactiveCard =
    document.getElementById("inactiveCard");

  const radios =
    document.querySelectorAll(
      'input[name="status"]'
    );



  function updateStatusUI() {

    const selected =
      document.querySelector(
        'input[name="status"]:checked'
      ).value;



    if (selected === "active") {

      activeCard.classList.add(
        "bg-blue-50",
        "border-blue-600"
      );

      activeCard.classList.remove(
        "bg-gray-100",
        "border-transparent"
      );



      inactiveCard.classList.add(
        "bg-gray-100",
        "border-transparent"
      );

      inactiveCard.classList.remove(
        "bg-blue-50",
        "border-blue-600"
      );

    }

    else {

      inactiveCard.classList.add(
        "bg-blue-50",
        "border-blue-600"
      );

      inactiveCard.classList.remove(
        "bg-gray-100",
        "border-transparent"
      );



      activeCard.classList.add(
        "bg-gray-100",
        "border-transparent"
      );

      activeCard.classList.remove(
        "bg-blue-50",
        "border-blue-600"
      );

    }

  }



  radios.forEach((radio) => {

    radio.addEventListener(
      "change",
      updateStatusUI
    );

  });



  updateStatusUI();

</script>

