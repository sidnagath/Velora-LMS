<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">

  <!-- SIDEBAR -->
  <%- include('../../../partials/admin-sidebar', { activePage: 'users' }) %>

  <!-- MAIN CONTENT -->
  <div class="flex-1 flex flex-col h-screen overflow-y-auto">
    
    <!-- TOP NAVIGATION -->
    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search users' }) %>

    <div class="p-8 max-w-5xl mx-auto w-full">
      <!-- HEADER -->
       <form id="editUserForm" method="PATCH" data-user-id="<%= user._id %>">
        <p id="error-general" class="hidden text-red-500"></p>
      <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Edit User</h1>
        <p class="text-gray-500 mt-2 text-sm max-w-2xl">
          Update authentication details, system roles, and account permissions.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- LEFT COLUMN (Form) -->
        <div class="lg:col-span-2 space-y-8">
          
          <!-- User Information Card -->
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100">
            <div class="flex items-center space-x-3 mb-6">
              <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              </div>
              <h2 class="text-xl font-bold text-gray-900">User Information</h2>
            </div>
<% if(errors?.general){ %>
<p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
  <%= errors.general %>
</p>
<% } %>        
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<% const isGoogleUser =
user.authProvider === "google"; %>
              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Full Name</label>
                <input type="text" name="name" value="<%= (formData && formData.name) || user.name || '' %>" class="block w-full px-4 py-3 bg-gray-100 border-transparent rounded-xl text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition-colors">
              <p id="error-name" class="input-error mt-1 text-sm text-red-500 hidden"></p>
<% if(errors?.name){ %>
<p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
<%= errors.name %>
</p>
<% } %>
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Email Address</label>
                <input type="email" name="email" value="<%= formData?.email || user.email || '' %>"   <%= isGoogleUser ? "readonly disabled" : "" %> class="block w-full px-4 py-3 bg-gray-100 border-transparent rounded-xl text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition-colors <%= isGoogleUser ? 'opacity-70 cursor-not-allowed' : '' %>">
              <p id="error-email" class="input-error mt-1 text-sm text-red-500 hidden"></p>
<% if(isGoogleUser) { %>
<p class="mt-2 text-xs text-gray-500">
  Email is managed through your Google account and cannot be changed.
</p>
<% } %>
<% if(errors?.email){ %>
<p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
<%= errors.email %>
</p>
<% } %>             
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Phone Number (Optional)</label>
                <input type="tel" name="phone" value="<%= formData?.phone || user.phone || '' %>" class="block w-full px-4 py-3 bg-gray-100 border-transparent rounded-xl text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition-colors">
              <p id="error-phone" class="input-error mt-1 text-sm text-red-500 hidden"></p>
<% if(errors?.phone){ %>
<p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
<%= errors.phone %>
</p>
<% } %>             
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Password</label>
                <div class="relative">
                  <!-- Usually empty on edit unless they want to change -->
                  <input type="password" name="password" placeholder="••••••••"  <%= isGoogleUser ? "readonly disabled" : "" %> class="block w-full px-4 py-3 bg-gray-100 border-transparent rounded-xl text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition-colors pr-10 <%= isGoogleUser ? 'opacity-70 cursor-not-allowed' : '' %>">
<% if(errors?.password){ %>
<p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
  <%= errors.password %>
</p>
<% } %> 
                  <div class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer text-gray-400 hover:text-gray-600 toggle-password">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>
                  </div>
                </div>
                <p id="error-password" class="input-error mt-1 text-sm text-red-500 hidden"></p>
              </div>

 <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Confirm Password</label>
                <div class="relative">
                  <input type="password" name="confirmPassword" placeholder="••••••••" class="block w-full px-4 py-3 bg-gray-100 border-transparent rounded-xl text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition-colors pr-10">
<% if(errors?.confirmPassword){ %>
<p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
  <%= errors.confirmPassword %>
</p>
<% } %> 
                  <div class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer text-gray-400 hover:text-gray-600 toggle-password">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>
                  </div>
                </div>
                <p id="error-confirmPassword" class="input-error mt-1 text-sm text-red-500 hidden"></p>
              </div>

            </div>
          </div>

          <!-- Account Access Card -->
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100">
            <div class="flex items-center space-x-3 mb-6">
              <div class="p-2 bg-purple-50 text-purple-600 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              </div>
              <h2 class="text-xl font-bold text-gray-900">Account Access</h2>
            </div>

<label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-4">
  Account Status
</label>

<div class="grid grid-cols-2 gap-4 mb-6">

  <!-- ACTIVE -->
  <label
    id="activeCard"
    class="relative flex flex-col items-center justify-center p-4 cursor-pointer rounded-xl border-2 transition-all"
  >

    <input
      type="radio"
      name="status"
      value="active"
      class="sr-only"
      <%= user.status === "active" ? "checked" : "" %>
    >

    <div class="w-8 h-8 rounded-full bg-white text-blue-600 flex items-center justify-center mb-2 shadow-sm">
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 13l4 4L19 7"
        ></path>
      </svg>
    </div>

    <span class="font-bold text-blue-800">
      Active
    </span>

  </label>



  <!-- INACTIVE -->
  <label
    id="inactiveCard"
    class="relative flex flex-col items-center justify-center p-4 cursor-pointer rounded-xl border-2 transition-all"
  >

    <input
      type="radio"
      name="status"
      value="inactive"
      class="sr-only"
      <%= user.status === "inactive" ? "checked" : "" %>
    >

    <div class="w-8 h-8 rounded-full bg-white text-gray-400 flex items-center justify-center mb-2 shadow-sm">
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"
        ></path>
      </svg>
    </div>

    <span class="font-bold text-gray-600">
      Inactive
    </span>

  </label>

</div>

            <div class="bg-gray-50 rounded-xl p-4 flex items-start space-x-3">
              <svg class="w-5 h-5 text-gray-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <p class="text-sm text-gray-500">Inactive users cannot log in or access purchased courses.</p>
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN (Sidebar Actions) -->
        <div class="space-y-8">
          
<!-- Profile Photo Card -->
<div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 flex flex-col items-center text-center">

  <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-6 w-full text-left">
    Profile Photo
  </h3>

  <!-- IMAGE PREVIEW -->
  <div class="relative mb-6">

    <img
      id="imagePreview"

      src="<%= user && user.avatar ? user.avatar : 'https://ui-avatars.com/api/?name=User&background=2563eb&color=fff' %>"

      class="w-40 h-40 rounded-full object-cover border-4 border-gray-100 shadow-sm"
    >

    <label
      for="avatarInput"
      class="absolute bottom-2 right-2 bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full cursor-pointer shadow-lg"
    >
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
        ></path>

        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
        ></path>
      </svg>
    </label>

  </div>

  <!-- FILE INPUT -->
  <input
    type="file"
    id="avatarInput"
    name="avatar"
    accept="image/*"
    class="hidden"
    onchange="initImageCrop(this, 'imagePreview', 1)"
  >

  <p class="text-xs text-gray-500">
    JPG, PNG or WEBP. Max 2MB.
  </p>
  <p id="error-avatar" class="input-error mt-1 text-sm text-red-500 hidden"></p>

<% if(errors?.avatar){ %>
<p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;text-align:center;">
  <%= errors.avatar %>
</p>
<% } %>

</div>

<script>

  const avatarInput =
    document.getElementById("avatarInput");

  const imagePreview =
    document.getElementById("imagePreview");

  if(avatarInput) {
    avatarInput.addEventListener(
      "change",
      function (e) {
        const file = e.target.files[0];
        if (!file) return;
        imagePreview.src = URL.createObjectURL(file);
      }
    );
  }

</script>

          <!-- Actions Card -->
          <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200 border-dashed">
            <div class="flex justify-between items-center mb-8">
              <span class="text-xs font-semibold text-gray-500">Creation Date</span>
              <span class="text-sm font-bold text-gray-900">May 24, 2024</span>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3.5 px-4 rounded-xl shadow-sm hover:bg-blue-700 transition-colors flex items-center justify-center mb-4">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              Update User
            </button>

            <a href="/admin/users" class="block text-center w-full bg-gray-200 text-gray-700 font-bold py-3.5 px-4 rounded-xl hover:bg-gray-300 transition-colors mb-6">
              Cancel
            </a>

            <p class="text-[10px] text-gray-400 text-center uppercase tracking-wider font-semibold leading-relaxed">
              By creating this user, you agree to Velora's Administrator Terms of Service and Privacy Policy.
            </p>
          </div>

        </div>
      </div>
     </form>

    </div>
  </div>
</main>

<script>

  const activeCard =
    document.getElementById("activeCard");

  const inactiveCard =
    document.getElementById("inactiveCard");

  const radios =
    document.querySelectorAll(
      'input[name="status"]'
    );



  function updateStatusUI() {

    const selected =
      document.querySelector(
        'input[name="status"]:checked'
      ).value;



    if (selected === "active") {

      activeCard.classList.add(
        "bg-blue-50",
        "border-blue-600"
      );

      activeCard.classList.remove(
        "bg-gray-100",
        "border-transparent"
      );



      inactiveCard.classList.add(
        "bg-gray-100",
        "border-transparent"
      );

      inactiveCard.classList.remove(
        "bg-blue-50",
        "border-blue-600"
      );

    }

    else {

      inactiveCard.classList.add(
        "bg-blue-50",
        "border-blue-600"
      );

      inactiveCard.classList.remove(
        "bg-gray-100",
        "border-transparent"
      );



      activeCard.classList.add(
        "bg-gray-100",
        "border-transparent"
      );

      activeCard.classList.remove(
        "bg-blue-50",
        "border-blue-600"
      );

    }

  }



  radios.forEach((radio) => {

    radio.addEventListener(
      "change",
      updateStatusUI
    );

  });



  updateStatusUI();

  document.getElementById('editUserForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    ['name', 'email', 'phone', 'password', 'confirmPassword', 'avatar', 'general'].forEach(id => {
      const el = document.getElementById('error-' + id);
      if (el) { el.classList.add('hidden'); el.innerText = ''; }
    });
    const formData = new FormData(this);
    const userId = this.dataset.userId;

    // Check if there is cropped image data from cropper-modal
    if (window.croppedBlob) {
      formData.set('avatar', window.croppedBlob, 'avatar.jpg');
    }
    
    try {
      const response = await fetch(`/api/v1/admin/users/${userId}`, {
        method: 'PATCH',
        body: formData
      });
      const data = await response.json();
      if (data.success) {
        Swal.fire('Success', data.message, 'success').then(() => {
          window.location.href = '/admin/users';
        });
      } else {
        const hasInlineError = data.errors && Object.keys(data.errors).length > 0;
        if (hasInlineError) {
          for (const key in data.errors) {
            const el = document.getElementById('error-' + key);
            if (el) {
              el.innerText = data.errors[key];
              el.classList.remove('hidden');
            }
          }
        } else {
          Swal.fire('Error', data.message || 'Validation failed', 'error');
        }
      }
    } catch (err) {
      Swal.fire('Error', 'An unexpected error occurred', 'error');
    }
  });

</script>
<%- include('../../../partials/cropper-modal') %>
<%- include('../../../partials/footer') %>
