              </div>
              <h2 class="text-xl font-bold text-gray-900">User Information</h2>
            </div>
<% if(errors?.general){ %>
<p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
  <%= errors.general %>
</p>
<% } %>        
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<% const isGoogleUser =
user.authProvider === "google"; %>
