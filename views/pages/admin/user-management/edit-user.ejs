                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Email Address</label>
                <input type="email" name="email" value="<%= formData?.email || user.email || '' %>"   <%= isGoogleUser ? "disabled" : "" %> class="block w-full px-4 py-3 bg-gray-100 border-transparent rounded-xl text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition-colors">
<% if(errors?.email){ %>
<p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
<%= errors.email %>
</p>
<% } %>             
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Phone Number (Optional)</label>
                <input type="tel" name="phone" value="<%= formData?.phone || user.phone || '' %>" class="block w-full px-4 py-3 bg-gray-100 border-transparent rounded-xl text-gray-900 placeholder-gray-400 focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-200 transition-colors">
<% if(errors?.phone){ %>
<p style="color:#EF4444;font-size:13px;font-weight:500;margin-top:6px;">
<%= errors.phone %>
</p>
<% } %>             
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Password</label>
                <div class="relative">
