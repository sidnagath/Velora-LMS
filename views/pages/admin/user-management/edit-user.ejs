      <%= user.status === "active" ? "checked" : "" %>
    >

    <div class="w-8 h-8 rounded-full bg-white text-blue-600 flex items-center justify-center mb-2 shadow-sm">
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 13l4 4L19 7"
        ></path>
      </svg>
    </div>

    <span class="font-bold text-blue-800">
      Active
    </span>

  </label>



  <!-- INACTIVE -->
  <label
    id="inactiveCard"
    class="relative flex flex-col items-center justify-center p-4 cursor-pointer rounded-xl border-2 transition-all"
  >

    <input
      type="radio"
      name="status"
