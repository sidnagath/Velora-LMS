<label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-4">
  Account Status
</label>

<div class="grid grid-cols-2 gap-4 mb-6">

  <!-- ACTIVE -->
  <label
    id="activeCard"
    class="relative flex flex-col items-center justify-center p-4 cursor-pointer rounded-xl border-2 transition-all"
  >

    <input
      type="radio"
      name="status"
      value="active"
