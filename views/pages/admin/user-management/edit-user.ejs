    <div class="p-8 max-w-5xl mx-auto w-full">
      <!-- HEADER -->
       <form action="/admin-edit-user/<%= user._id %>" method="POST"  enctype="multipart/form-data">
      <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Edit User</h1>
        <p class="text-gray-500 mt-2 text-sm max-w-2xl">
          Update authentication details, system roles, and account permissions.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- LEFT COLUMN (Form) -->
        <div class="lg:col-span-2 space-y-8">
          
