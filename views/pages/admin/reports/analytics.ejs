<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">
  <%- include('../../../partials/admin-sidebar', { activePage: 'reports' }) %>

  <div class="flex-1 flex flex-col h-screen overflow-y-auto">
    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search analytics...' }) %>

    <div class="p-8 max-w-7xl mx-auto w-full space-y-8">
      
      <!-- HEADER -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Analytics & Reports</h1>
          <p class="text-gray-500 mt-2 text-sm">Comprehensive metrics for your platform's performance.</p>
        </div>
        <button class="bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 font-bold py-2.5 px-5 rounded-xl shadow-sm flex items-center transition-colors text-sm">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          Export Report
        </button>
      </div>

      <!-- FILTERS -->
      <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
          <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Date Range</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </div>
            <input type="text" class="pl-10 w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-2.5 outline-none font-medium" placeholder="Last 30 Days">
          </div>
        </div>
        <div class="flex-1 min-w-[200px]">
          <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Category</label>
          <select class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-2.5 outline-none font-medium appearance-none">
            <option>All Categories</option>
            <option>Development</option>
            <option>Design</option>
            <option>Business</option>
          </select>
        </div>
        <div class="flex-1 min-w-[200px]">
          <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Course</label>
          <select class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-2.5 outline-none font-medium appearance-none">
            <option>All Courses</option>
            <option>React Masterclass</option>
            <option>UI/UX Design</option>
          </select>
        </div>
        <button class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-sm transition-colors text-sm h-[42px]">
          Apply Filters
        </button>
      </div>

      <!-- TOP SUMMARY CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Revenue -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-blue-200 transition-colors cursor-pointer">
          <div class="absolute top-0 right-0 p-4 opacity-5 text-blue-600 group-hover:scale-110 group-hover:opacity-10 transition-all duration-500">
            <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20"><path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"></path><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"></path></svg>
          </div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Revenue</p>
            <h3 class="text-3xl font-black text-gray-900 mb-2">₹1,248,500</h3>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-green-50 text-green-700">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              +14.5%
            </span>
          </div>
        </div>

        <!-- Orders -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-purple-200 transition-colors cursor-pointer">
          <div class="absolute top-0 right-0 p-4 opacity-5 text-purple-600 group-hover:scale-110 group-hover:opacity-10 transition-all duration-500">
            <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20"><path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"></path></svg>
          </div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Orders</p>
            <h3 class="text-3xl font-black text-gray-900 mb-2">3,492</h3>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-green-50 text-green-700">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              +8.2%
            </span>
          </div>
        </div>

        <!-- Users -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-orange-200 transition-colors cursor-pointer">
          <div class="absolute top-0 right-0 p-4 opacity-5 text-orange-600 group-hover:scale-110 group-hover:opacity-10 transition-all duration-500">
            <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path></svg>
          </div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Users</p>
            <h3 class="text-3xl font-black text-gray-900 mb-2">12,845</h3>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-green-50 text-green-700">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              +21.4%
            </span>
          </div>
        </div>

        <!-- Refunds -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-red-200 transition-colors cursor-pointer">
          <div class="absolute top-0 right-0 p-4 opacity-5 text-red-600 group-hover:scale-110 group-hover:opacity-10 transition-all duration-500">
            <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z"></path></svg>
          </div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Refunds</p>
            <h3 class="text-3xl font-black text-gray-900 mb-2">₹14,200</h3>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-red-50 text-red-700">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6"></path></svg>
              +2.1%
            </span>
          </div>
        </div>
      </div>

      <!-- SALES ANALYTICS CHART -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
        <div class="flex items-center justify-between mb-6">
          <div>
             <h2 class="text-lg font-bold text-gray-900">Sales Analytics</h2>
             <p class="text-xs text-gray-500 mt-1">Revenue vs. Orders over time</p>
          </div>
          <div class="flex bg-gray-100 rounded-full p-1">
            <button class="px-4 py-1.5 text-xs font-bold text-white bg-blue-600 rounded-full shadow-sm">Revenue</button>
            <button class="px-4 py-1.5 text-xs font-bold text-gray-600 hover:text-gray-900 rounded-full">Orders</button>
          </div>
        </div>
        <!-- Chart Placeholder -->
        <div class="h-80 w-full relative flex items-end justify-between px-4 pb-8 pt-4 border-b border-gray-100 mt-4">
          <!-- Horizontal Grid Lines -->
          <div class="absolute inset-0 flex flex-col justify-between pb-8 z-0">
            <div class="w-full border-b border-gray-100 border-dashed"></div>
            <div class="w-full border-b border-gray-100 border-dashed"></div>
            <div class="w-full border-b border-gray-100 border-dashed"></div>
            <div class="w-full border-b border-gray-100 border-dashed"></div>
            <div class="w-full border-b border-gray-100 border-dashed"></div>
          </div>
          <!-- Bars -->
          <% const heights = [30, 45, 20, 60, 80, 50, 75, 40, 90, 65, 85, 55]; %>
          <% const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']; %>
          <% heights.forEach((h, i) => { %>
            <div class="relative z-10 w-[7%] flex flex-col items-center justify-end h-full group cursor-pointer">
              <div class="w-full max-w-[40px] bg-blue-500 rounded-t-md transition-all duration-300 group-hover:bg-blue-600" style="height: <%= h %>%"></div>
              <span class="absolute -bottom-6 text-xs font-bold text-gray-400"><%= months[i] %></span>
              <!-- Tooltip -->
              <div class="absolute -top-10 opacity-0 group-hover:opacity-100 bg-gray-900 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-opacity whitespace-nowrap pointer-events-none z-20">
                ₹<%= (h * 1500).toLocaleString() %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- BOTTOM GRID: TABLES & BREAKDOWNS -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 pb-12">
        
        <!-- COURSE PERFORMANCE -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm flex flex-col">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-lg font-bold text-gray-900">Course Performance</h2>
            <a href="#" class="text-sm font-bold text-blue-600 hover:underline">View All</a>
          </div>
          <div class="overflow-x-auto flex-1">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-gray-50/50">
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider rounded-l-lg border-b border-gray-100">Course Name</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider text-right border-b border-gray-100">Enrollments</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider text-right rounded-r-lg border-b border-gray-100">Revenue</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-4 text-sm font-bold text-gray-900">React Pro Masterclass</td>
                  <td class="px-4 py-4 text-sm font-medium text-gray-600 text-right">1,204</td>
                  <td class="px-4 py-4 text-sm font-extrabold text-gray-900 text-right">₹360k</td>
                </tr>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-4 text-sm font-bold text-gray-900">Advanced UI/UX Design</td>
                  <td class="px-4 py-4 text-sm font-medium text-gray-600 text-right">942</td>
                  <td class="px-4 py-4 text-sm font-extrabold text-gray-900 text-right">₹210k</td>
                </tr>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-4 text-sm font-bold text-gray-900">Python Data Science</td>
                  <td class="px-4 py-4 text-sm font-medium text-gray-600 text-right">830</td>
                  <td class="px-4 py-4 text-sm font-extrabold text-gray-900 text-right">₹195k</td>
                </tr>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-4 text-sm font-bold text-gray-900">Node.js Backend Architecture</td>
                  <td class="px-4 py-4 text-sm font-medium text-gray-600 text-right">756</td>
                  <td class="px-4 py-4 text-sm font-extrabold text-gray-900 text-right">₹182k</td>
                </tr>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-4 text-sm font-bold text-gray-900">System Design Interviews</td>
                  <td class="px-4 py-4 text-sm font-medium text-gray-600 text-right">612</td>
                  <td class="px-4 py-4 text-sm font-extrabold text-gray-900 text-right">₹145k</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="flex flex-col gap-8">
          <!-- ORDER STATUS BREAKDOWN -->
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
            <h2 class="text-lg font-bold text-gray-900 mb-6">Order Status Breakdown</h2>
            
            <div class="space-y-5">
              <!-- Completed -->
              <div>
                <div class="flex justify-between items-end mb-2">
                  <span class="text-sm font-bold text-gray-700 flex items-center">
                    <span class="w-3 h-3 rounded-full bg-green-500 mr-2 shadow-sm"></span> Completed (75%)
                  </span>
                  <span class="text-sm font-black text-gray-900">2,619</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                  <div class="bg-green-500 h-2.5 rounded-full" style="width: 75%"></div>
                </div>
              </div>
              <!-- Pending -->
              <div>
                <div class="flex justify-between items-end mb-2">
                  <span class="text-sm font-bold text-gray-700 flex items-center">
                    <span class="w-3 h-3 rounded-full bg-yellow-500 mr-2 shadow-sm"></span> Pending (15%)
                  </span>
                  <span class="text-sm font-black text-gray-900">523</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                  <div class="bg-yellow-500 h-2.5 rounded-full" style="width: 15%"></div>
                </div>
              </div>
              <!-- Refunded -->
              <div>
                <div class="flex justify-between items-end mb-2">
                  <span class="text-sm font-bold text-gray-700 flex items-center">
                    <span class="w-3 h-3 rounded-full bg-red-500 mr-2 shadow-sm"></span> Refunded (7%)
                  </span>
                  <span class="text-sm font-black text-gray-900">244</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                  <div class="bg-red-500 h-2.5 rounded-full" style="width: 7%"></div>
                </div>
              </div>
              <!-- Cancelled -->
              <div>
                <div class="flex justify-between items-end mb-2">
                  <span class="text-sm font-bold text-gray-700 flex items-center">
                    <span class="w-3 h-3 rounded-full bg-gray-400 mr-2 shadow-sm"></span> Cancelled (3%)
                  </span>
                  <span class="text-sm font-black text-gray-900">106</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                  <div class="bg-gray-400 h-2.5 rounded-full" style="width: 3%"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- COUPON USAGE -->
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
            <h2 class="text-lg font-bold text-gray-900 mb-6">Top Performing Coupons</h2>
            <div class="space-y-3">
              <div class="flex items-center justify-between p-3.5 border border-gray-100 rounded-xl hover:bg-gray-50 hover:border-blue-100 transition-colors group cursor-pointer">
                <div class="flex items-center gap-3">
                  <div class="bg-blue-50 text-blue-600 font-mono font-bold px-2.5 py-1.5 rounded-lg text-xs border border-blue-100 group-hover:bg-blue-100 transition-colors">SUMMER50</div>
                  <div>
                    <p class="text-xs font-bold text-gray-900">342 Uses</p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="text-sm font-black text-green-600">₹45k Given</p>
                </div>
              </div>
              <div class="flex items-center justify-between p-3.5 border border-gray-100 rounded-xl hover:bg-gray-50 hover:border-purple-100 transition-colors group cursor-pointer">
                <div class="flex items-center gap-3">
                  <div class="bg-purple-50 text-purple-600 font-mono font-bold px-2.5 py-1.5 rounded-lg text-xs border border-purple-100 group-hover:bg-purple-100 transition-colors">NEWYEAR25</div>
                  <div>
                    <p class="text-xs font-bold text-gray-900">289 Uses</p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="text-sm font-black text-green-600">₹32k Given</p>
                </div>
              </div>
              <div class="flex items-center justify-between p-3.5 border border-gray-100 rounded-xl hover:bg-gray-50 hover:border-orange-100 transition-colors group cursor-pointer">
                <div class="flex items-center gap-3">
                  <div class="bg-orange-50 text-orange-600 font-mono font-bold px-2.5 py-1.5 rounded-lg text-xs border border-orange-100 group-hover:bg-orange-100 transition-colors">WELCOME10</div>
                  <div>
                    <p class="text-xs font-bold text-gray-900">195 Uses</p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="text-sm font-black text-green-600">₹14k Given</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</main>

<%- include('../../../partials/footer') %>
