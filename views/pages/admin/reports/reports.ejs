<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">
  <%- include('../../../partials/admin-sidebar', { activePage: 'reports' }) %>

  <div class="flex-1 flex flex-col h-screen overflow-y-auto">
    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search analytics...' }) %>

    <div class="p-8 max-w-7xl mx-auto w-full space-y-8">
      
      <!-- HEADER -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Analytics & Reports</h1>
          <p class="text-gray-500 mt-2 text-sm">Comprehensive metrics for your platform's performance.</p>
        </div>
        <button onclick="exportReport()" class="bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 font-bold py-2.5 px-5 rounded-xl shadow-sm flex items-center transition-colors text-sm">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          Export Report
        </button>
      </div>

      <!-- FILTERS -->
      <% 
        let hasFilters = false;
        let dateRangeLabel = filters.dateRange;
        
        if (filters.dateRange !== 'last30' && filters.dateRange !== 'allTime') {
           hasFilters = true;
        }
        if (filters.categoryId !== 'all' || filters.courseId !== 'all') {
           hasFilters = true;
        }
      %>
      <form id="reportFiltersForm" method="GET" action="/admin/reports" class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm mb-6">
        <div class="flex flex-wrap items-end gap-4">
          <div class="flex-1 min-w-[160px]">
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Date Range</label>
            <select id="dateRangeSelect" name="dateRange" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-2.5 outline-none font-medium appearance-none transition-colors">
              <option value="today" <%= filters.dateRange === 'today' ? 'selected' : '' %>>Today</option>
              <option value="yesterday" <%= filters.dateRange === 'yesterday' ? 'selected' : '' %>>Yesterday</option>
              <option value="last7" <%= filters.dateRange === 'last7' ? 'selected' : '' %>>Last 7 Days</option>
              <option value="last30" <%= filters.dateRange === 'last30' ? 'selected' : '' %>>Last 30 Days</option>
              <option value="thisMonth" <%= filters.dateRange === 'thisMonth' ? 'selected' : '' %>>This Month</option>
              <option value="lastMonth" <%= filters.dateRange === 'lastMonth' ? 'selected' : '' %>>Last Month</option>
              <option value="thisYear" <%= filters.dateRange === 'thisYear' ? 'selected' : '' %>>This Year</option>
              <option value="allTime" <%= filters.dateRange === 'allTime' ? 'selected' : '' %>>All Time</option>
              <option value="custom" <%= filters.dateRange === 'custom' ? 'selected' : '' %>>Custom Range</option>
            </select>
          </div>
          
          <div id="customDateWrapper" class="flex flex-1 min-w-[320px] gap-4 <%= filters.dateRange === 'custom' ? '' : 'hidden' %>">
            <div class="flex-1">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">From</label>
              <input type="date" name="startDate" value="<%= filters.startDate || '' %>" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-2.5 outline-none font-medium transition-colors">
            </div>
            <div class="flex-1">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">To</label>
              <input type="date" name="endDate" value="<%= filters.endDate || '' %>" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-2.5 outline-none font-medium transition-colors">
            </div>
          </div>

          <div class="flex-1 min-w-[160px]">
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Category</label>
            <select id="categorySelect" name="categoryId" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-2.5 outline-none font-medium appearance-none transition-colors">
              <option value="all" <%= filters.categoryId === 'all' ? 'selected' : '' %>>All Categories</option>
              <% categories.forEach(category => { %>
                <option value="<%= category._id %>" <%= filters.categoryId === String(category._id) ? 'selected' : '' %>><%= category.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="flex-1 min-w-[160px]">
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Course</label>
            <select id="courseSelect" name="courseId" class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-xl focus:ring-blue-500 focus:border-blue-500 block p-2.5 outline-none font-medium appearance-none transition-colors">
              <option value="all" <%= filters.courseId === 'all' ? 'selected' : '' %>>All Courses</option>
              <% courses.forEach(course => { %>
                <option value="<%= course._id %>" data-category="<%= course.category %>" <%= filters.courseId === String(course._id) ? 'selected' : '' %>><%= course.title %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="flex justify-end mt-4">
          <% if (hasFilters) { %>
            <button type="button" id="mainFilterBtn" onclick="window.location.href='/admin/reports'" class="w-full sm:w-auto bg-gray-100 border border-gray-200 hover:bg-gray-200 text-gray-700 font-bold py-2.5 px-6 rounded-xl shadow-sm transition-colors text-sm">
              Reset Filters
            </button>
          <% } else { %>
            <button type="submit" id="mainFilterBtn" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-sm transition-colors text-sm">
              Apply Filters
            </button>
          <% } %>
        </div>
      </form>

      <!-- ACTIVE FILTER CHIPS -->
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <% 
          if (dateRangeLabel === 'last30') dateRangeLabel = 'Last 30 Days';
          if (dateRangeLabel === 'last7') dateRangeLabel = 'Last 7 Days';
          if (dateRangeLabel === 'today') dateRangeLabel = 'Today';
          if (dateRangeLabel === 'yesterday') dateRangeLabel = 'Yesterday';
          if (dateRangeLabel === 'thisMonth') dateRangeLabel = 'This Month';
          if (dateRangeLabel === 'lastMonth') dateRangeLabel = 'Last Month';
          if (dateRangeLabel === 'thisYear') dateRangeLabel = 'This Year';
          if (dateRangeLabel === 'allTime') dateRangeLabel = 'All Time';
          
          if (filters.dateRange === 'custom') {
            dateRangeLabel = `Custom: ${filters.startDate || 'N/A'} to ${filters.endDate || 'N/A'}`;
          }
        %>
        
        <% if (hasFilters || filters.dateRange === 'custom') { %>
          <div class="inline-flex items-center bg-blue-50 text-blue-700 text-xs font-bold px-3 py-1.5 rounded-full border border-blue-100">
            <span class="mr-1 text-gray-500">Date:</span> <%= dateRangeLabel %>
            <button type="button" onclick="removeFilter('dateRange')" class="ml-2 hover:bg-blue-200 rounded-full p-0.5 transition-colors">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
        <% } %>

        <% if (filters.categoryId !== 'all') { 
            const cat = categories.find(c => String(c._id) === String(filters.categoryId));
            if (cat) {
        %>
          <div class="inline-flex items-center bg-purple-50 text-purple-700 text-xs font-bold px-3 py-1.5 rounded-full border border-purple-100">
            <span class="mr-1 text-gray-500">Category:</span> <%= cat.name %>
            <button type="button" onclick="removeFilter('categoryId')" class="ml-2 hover:bg-purple-200 rounded-full p-0.5 transition-colors">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
        <% }} %>

        <% if (filters.courseId !== 'all') { 
            const crs = courses.find(c => String(c._id) === String(filters.courseId));
            if (crs) {
        %>
          <div class="inline-flex items-center bg-orange-50 text-orange-700 text-xs font-bold px-3 py-1.5 rounded-full border border-orange-100">
            <span class="mr-1 text-gray-500">Course:</span> <%= crs.title %>
            <button type="button" onclick="removeFilter('courseId')" class="ml-2 hover:bg-orange-200 rounded-full p-0.5 transition-colors">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
        <% }} %>
      </div>

      <!-- TOP SUMMARY CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Revenue -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-blue-200 transition-colors cursor-pointer">
          <div class="absolute top-0 right-0 p-4 opacity-5 text-blue-600 group-hover:scale-110 group-hover:opacity-10 transition-all duration-500">
            <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20"><path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"></path><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"></path></svg>
          </div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Revenue</p>
            <h3 class="text-3xl font-black text-gray-900 mb-2">₹<%= totalRevenue.toLocaleString("en-IN") %></h3>
          </div>
        </div>

        <!-- Orders -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-purple-200 transition-colors cursor-pointer">
          <div class="absolute top-0 right-0 p-4 opacity-5 text-purple-600 group-hover:scale-110 group-hover:opacity-10 transition-all duration-500">
            <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20"><path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"></path></svg>
          </div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Orders</p>
            <h3 class="text-3xl font-black text-gray-900 mb-2"><%= totalOrders.toLocaleString("en-IN") %></h3>
          </div>
        </div>

        <!-- Users -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-orange-200 transition-colors cursor-pointer">
          <div class="absolute top-0 right-0 p-4 opacity-5 text-orange-600 group-hover:scale-110 group-hover:opacity-10 transition-all duration-500">
            <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path></svg>
          </div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Users</p>
            <h3 class="text-3xl font-black text-gray-900 mb-2"><%= totalUsers.toLocaleString("en-IN") %></h3>
          </div>
        </div>

        <!-- Refunds -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-red-200 transition-colors cursor-pointer">
          <div class="absolute top-0 right-0 p-4 opacity-5 text-red-600 group-hover:scale-110 group-hover:opacity-10 transition-all duration-500">
            <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z"></path></svg>
          </div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Refunds</p>
            <h3 class="text-3xl font-black text-gray-900 mb-2">₹<%= totalRefunds.toLocaleString("en-IN") %></h3>
          </div>
        </div>
      </div>

      <!-- SALES ANALYTICS CHART -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
        <div class="flex items-center justify-between mb-6">
          <div>
             <h2 class="text-lg font-bold text-gray-900">Sales Analytics</h2>
             <p class="text-xs text-gray-500 mt-1">Revenue vs. Orders over time</p>
          </div>
          <div class="flex bg-gray-100 rounded-full p-1">
            <button id="toggleRevBtn" class="px-4 py-1.5 text-xs font-bold text-white bg-blue-600 rounded-full shadow-sm transition-colors">Revenue</button>
            <button id="toggleOrdBtn" class="px-4 py-1.5 text-xs font-bold text-gray-600 hover:text-gray-900 rounded-full transition-colors">Orders</button>
          </div>
        </div>
        <!-- Chart Placeholder -->
        <div class="h-80 w-full relative flex items-end justify-between px-4 pb-8 pt-4 border-b border-gray-100 mt-4">
          <!-- Horizontal Grid Lines -->
          <div class="absolute inset-0 flex flex-col justify-between pb-8 z-0">
            <div class="w-full border-b border-gray-100 border-dashed"></div>
            <div class="w-full border-b border-gray-100 border-dashed"></div>
            <div class="w-full border-b border-gray-100 border-dashed"></div>
            <div class="w-full border-b border-gray-100 border-dashed"></div>
            <div class="w-full border-b border-gray-100 border-dashed"></div>
          </div>
          
          <!-- Revenue Bars -->
          <div id="reportRevBars" class="absolute inset-0 flex items-end justify-between px-4 pb-8 pt-4 z-10 w-full h-full">
            <% chartRevenueHeights.forEach((h, i) => { %>
              <div class="relative w-[7%] flex flex-col items-center justify-end h-full group cursor-pointer">
                <div class="w-full max-w-[40px] bg-blue-500 rounded-t-md transition-all duration-300 group-hover:bg-blue-600" style="height: <%= h %>%"></div>
                <span class="absolute -bottom-6 text-xs font-bold text-gray-400"><%= chartLabels[i] %></span>
                <!-- Tooltip -->
                <div class="absolute -top-10 opacity-0 group-hover:opacity-100 bg-gray-900 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-opacity whitespace-nowrap pointer-events-none z-20">
                  ₹<%= chartRevenues[i].toLocaleString("en-IN") %>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Orders Bars -->
          <div id="reportOrdBars" class="absolute inset-0 flex items-end justify-between px-4 pb-8 pt-4 z-10 w-full h-full" style="display: none;">
            <% chartOrderHeights.forEach((h, i) => { %>
              <div class="relative w-[7%] flex flex-col items-center justify-end h-full group cursor-pointer">
                <div class="w-full max-w-[40px] bg-green-500 rounded-t-md transition-all duration-300 group-hover:bg-green-600" style="height: <%= h %>%"></div>
                <span class="absolute -bottom-6 text-xs font-bold text-gray-400"><%= chartLabels[i] %></span>
                <!-- Tooltip -->
                <div class="absolute -top-10 opacity-0 group-hover:opacity-100 bg-gray-900 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-opacity whitespace-nowrap pointer-events-none z-20">
                  <%= chartOrders[i] %> Orders
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <script>
        function removeFilter(filterName) {
          const form = document.getElementById('reportFiltersForm');
          const element = form.elements[filterName];
          if (element) {
             element.value = (filterName === 'dateRange') ? 'last30' : 'all';
          }
          if (filterName === 'dateRange') {
             if (form.elements['startDate']) form.elements['startDate'].value = '';
             if (form.elements['endDate']) form.elements['endDate'].value = '';
          }
          form.submit();
        }

        document.addEventListener('DOMContentLoaded', () => {
          // Dynamic Single Button Logic
          const reportFiltersForm = document.getElementById('reportFiltersForm');
          const mainFilterBtn = document.getElementById('mainFilterBtn');
          if (reportFiltersForm && mainFilterBtn) {
             reportFiltersForm.addEventListener('change', () => {
                // If any input changes, ensure it acts as an "Apply Filters" submit button
                if (mainFilterBtn.type !== 'submit') {
                   mainFilterBtn.type = 'submit';
                   mainFilterBtn.className = 'bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-sm transition-colors text-sm';
                   mainFilterBtn.textContent = 'Apply Filters';
                   mainFilterBtn.onclick = null; // Remove the reset redirect
                }
             });
          }

          // Custom Date Toggle
          const dateRangeSelect = document.getElementById('dateRangeSelect');
          const customDateWrapper = document.getElementById('customDateWrapper');
          if (dateRangeSelect && customDateWrapper) {
             dateRangeSelect.addEventListener('change', (e) => {
                if (e.target.value === 'custom') {
                   customDateWrapper.classList.remove('hidden');
                } else {
                   customDateWrapper.classList.add('hidden');
                }
             });
          }

          // Dependent Course Dropdown
          const categorySelect = document.getElementById('categorySelect');
          const courseSelect = document.getElementById('courseSelect');
          if (categorySelect && courseSelect) {
             categorySelect.addEventListener('change', (e) => {
                const selectedCat = e.target.value;
                const options = courseSelect.querySelectorAll('option:not([value="all"])');
                
                if (selectedCat === 'all') {
                   options.forEach(opt => opt.style.display = '');
                } else {
                   options.forEach(opt => {
                      if (opt.getAttribute('data-category') === selectedCat) {
                         opt.style.display = '';
                      } else {
                         opt.style.display = 'none';
                      }
                   });
                   const selectedOption = courseSelect.options[courseSelect.selectedIndex];
                   if (selectedOption.value !== 'all' && selectedOption.style.display === 'none') {
                      courseSelect.value = 'all';
                   }
                }
             });
             categorySelect.dispatchEvent(new Event('change'));
          }

          const btnRev = document.getElementById('toggleRevBtn');
          const btnOrd = document.getElementById('toggleOrdBtn');
          const revBars = document.getElementById('reportRevBars');
          const ordBars = document.getElementById('reportOrdBars');
      
          if(btnRev && btnOrd) {
            btnRev.addEventListener('click', () => {
              btnRev.className = "px-4 py-1.5 text-xs font-bold text-white bg-blue-600 rounded-full shadow-sm transition-colors";
              btnOrd.className = "px-4 py-1.5 text-xs font-bold text-gray-600 hover:text-gray-900 rounded-full transition-colors";
              revBars.style.display = 'flex';
              ordBars.style.display = 'none';
            });
            btnOrd.addEventListener('click', () => {
              btnOrd.className = "px-4 py-1.5 text-xs font-bold text-white bg-blue-600 rounded-full shadow-sm transition-colors";
              btnRev.className = "px-4 py-1.5 text-xs font-bold text-gray-600 hover:text-gray-900 rounded-full transition-colors";
              ordBars.style.display = 'flex';
              revBars.style.display = 'none';
            });
          }
        });
      </script>

      <!-- BOTTOM GRID: TABLES & BREAKDOWNS -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 pb-12">
        
        <!-- COURSE PERFORMANCE -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm flex flex-col">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-lg font-bold text-gray-900">Course Performance</h2>
            <a href="#" class="text-sm font-bold text-blue-600 hover:underline">View All</a>
          </div>
          <div class="overflow-x-auto flex-1">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-gray-50/50">
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider rounded-l-lg border-b border-gray-100">Course Name</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider text-right border-b border-gray-100">Enrollments</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider text-right rounded-r-lg border-b border-gray-100">Revenue</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% if (coursePerformance && coursePerformance.length > 0) { %>
                  <% coursePerformance.forEach(item => { %>
                    <tr class="hover:bg-gray-50 transition-colors">
                      <td class="px-4 py-4 text-sm font-bold text-gray-900"><%= item.course.title %></td>
                      <td class="px-4 py-4 text-sm font-medium text-gray-600 text-right"><%= item.enrollments.toLocaleString("en-IN") %></td>
                      <td class="px-4 py-4 text-sm font-extrabold text-gray-900 text-right">₹<%= item.revenue.toLocaleString("en-IN") %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="3" class="px-4 py-8 text-center text-sm font-medium text-gray-500">No course data available.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="flex flex-col gap-8">
          <!-- ORDER STATUS BREAKDOWN -->
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
            <h2 class="text-lg font-bold text-gray-900 mb-6">Order Status Breakdown</h2>
            
            <div class="space-y-5">
              <!-- Completed -->
              <div>
                <div class="flex justify-between items-end mb-2">
                  <span class="text-sm font-bold text-gray-700 flex items-center">
                    <span class="w-3 h-3 rounded-full bg-green-500 mr-2 shadow-sm"></span> Completed (<%= statusBreakdown.completed.percent %>%)
                  </span>
                  <span class="text-sm font-black text-gray-900"><%= statusBreakdown.completed.count.toLocaleString("en-IN") %></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                  <div class="bg-green-500 h-2.5 rounded-full" style="width: <%= statusBreakdown.completed.percent %>%"></div>
                </div>
              </div>
              <!-- Pending -->
              <div>
                <div class="flex justify-between items-end mb-2">
                  <span class="text-sm font-bold text-gray-700 flex items-center">
                    <span class="w-3 h-3 rounded-full bg-yellow-500 mr-2 shadow-sm"></span> Pending (<%= statusBreakdown.pending.percent %>%)
                  </span>
                  <span class="text-sm font-black text-gray-900"><%= statusBreakdown.pending.count.toLocaleString("en-IN") %></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                  <div class="bg-yellow-500 h-2.5 rounded-full" style="width: <%= statusBreakdown.pending.percent %>%"></div>
                </div>
              </div>
              <!-- Refunded -->
              <div>
                <div class="flex justify-between items-end mb-2">
                  <span class="text-sm font-bold text-gray-700 flex items-center">
                    <span class="w-3 h-3 rounded-full bg-red-500 mr-2 shadow-sm"></span> Refunded (<%= statusBreakdown.refunded.percent %>%)
                  </span>
                  <span class="text-sm font-black text-gray-900"><%= statusBreakdown.refunded.count.toLocaleString("en-IN") %></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                  <div class="bg-red-500 h-2.5 rounded-full" style="width: <%= statusBreakdown.refunded.percent %>%"></div>
                </div>
              </div>
              <!-- Cancelled -->
              <div>
                <div class="flex justify-between items-end mb-2">
                  <span class="text-sm font-bold text-gray-700 flex items-center">
                    <span class="w-3 h-3 rounded-full bg-gray-400 mr-2 shadow-sm"></span> Cancelled (<%= statusBreakdown.cancelled.percent %>%)
                  </span>
                  <span class="text-sm font-black text-gray-900"><%= statusBreakdown.cancelled.count.toLocaleString("en-IN") %></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                  <div class="bg-gray-400 h-2.5 rounded-full" style="width: <%= statusBreakdown.cancelled.percent %>%"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- COUPON USAGE -->
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
            <h2 class="text-lg font-bold text-gray-900 mb-6">Top Performing Coupons</h2>
            <div class="space-y-3">
              <% if (topCoupons && topCoupons.length > 0) { %>
                <% const colors = ['blue', 'purple', 'orange']; %>
                <% topCoupons.forEach((couponItem, index) => { %>
                  <% const c = colors[index % colors.length]; %>
                  <div class="flex items-center justify-between p-3.5 border border-gray-100 rounded-xl hover:bg-gray-50 hover:border-<%= c %>-100 transition-colors group cursor-pointer">
                    <div class="flex items-center gap-3">
                      <div class="bg-<%= c %>-50 text-<%= c %>-600 font-mono font-bold px-2.5 py-1.5 rounded-lg text-xs border border-<%= c %>-100 group-hover:bg-<%= c %>-100 transition-colors"><%= couponItem.coupon.code %></div>
                      <div>
                        <p class="text-xs font-bold text-gray-900"><%= couponItem.uses.toLocaleString("en-IN") %> Uses</p>
                      </div>
                    </div>
                    <div class="text-right">
                      <p class="text-sm font-black text-green-600">₹<%= couponItem.totalDiscount.toLocaleString("en-IN") %> Given</p>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="text-sm font-medium text-gray-500">No coupon usage found.</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</main>

<script>
  function exportReport() {
    const qs = new URLSearchParams(window.location.search).toString();
    window.location.href = '/admin/reports/export?' + qs;
  }
</script>

<%- include('../../../partials/footer') %>
