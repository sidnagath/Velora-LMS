<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">

  <!-- SIDEBAR -->
  <%- include('../../../partials/admin-sidebar', { activePage: 'dashboard' }) %>

  <!-- MAIN CONTENT -->
  <div class="flex-1 flex flex-col h-screen overflow-y-auto">
    
    <!-- TOP NAVIGATION -->
    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search data, students, or reports...' }) %>

    <div class="p-8 max-w-7xl mx-auto w-full space-y-8 pb-12">
      <!-- HEADER -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Admin Dashboard</h1>
          <p class="text-gray-500 mt-2 text-sm">
            Welcome back! Here's a high-level overview of Velora's performance today.
          </p>
        </div>
        <div class="flex bg-white rounded-xl shadow-sm border border-gray-100 p-1">
          <button class="px-4 py-2 text-sm font-bold text-gray-700 bg-gray-100 rounded-lg">Today</button>
          <button class="px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-900 rounded-lg transition-colors">Week</button>
          <button class="px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-900 rounded-lg transition-colors">Month</button>
        </div>
      </div>

      <!-- FLASH BANNER -->
      <%- include('../../../partials/admin-banner') %>

      <!-- TOP SUMMARY CARDS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Total Users -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-blue-200 transition-colors cursor-pointer">
          <div class="flex justify-between items-start mb-4">
            <div class="p-3 bg-blue-50 text-blue-600 rounded-xl">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path></svg>
            </div>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-green-50 text-green-700">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              12.5%
            </span>
          </div>
          <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Users</p>
          <h3 class="text-3xl font-black text-gray-900">12,845</h3>
        </div>

        <!-- Total Courses -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-orange-200 transition-colors cursor-pointer">
          <div class="flex justify-between items-start mb-4">
            <div class="p-3 bg-orange-50 text-orange-600 rounded-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            </div>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-blue-50 text-blue-700">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              4 New
            </span>
          </div>
          <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Courses</p>
          <h3 class="text-3xl font-black text-gray-900">142</h3>
        </div>

        <!-- Total Orders -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-purple-200 transition-colors cursor-pointer">
          <div class="flex justify-between items-start mb-4">
            <div class="p-3 bg-purple-50 text-purple-600 rounded-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            </div>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-green-50 text-green-700">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              8.4%
            </span>
          </div>
          <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Orders</p>
          <h3 class="text-3xl font-black text-gray-900">3,492</h3>
        </div>

        <!-- Total Revenue -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative overflow-hidden group hover:border-green-200 transition-colors cursor-pointer">
          <div class="flex justify-between items-start mb-4">
            <div class="p-3 bg-green-50 text-green-600 rounded-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-green-50 text-green-700">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              14.5%
            </span>
          </div>
          <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Total Revenue</p>
          <h3 class="text-3xl font-black text-gray-900">₹1,248k</h3>
        </div>
      </div>

      <!-- MIDDLE SECTION: CHARTS -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Sales Overview Chart -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm lg:col-span-2">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-lg font-bold text-gray-900">Sales Overview</h2>
              <p class="text-sm text-gray-500 mt-1">Earnings across the last 7 days</p>
            </div>
            <div class="flex bg-gray-100 rounded-full p-1">
              <button class="px-4 py-1.5 text-xs font-bold text-white bg-blue-600 rounded-full shadow-sm">Revenue</button>
              <button class="px-4 py-1.5 text-xs font-bold text-gray-600 hover:text-gray-900 rounded-full">Orders</button>
            </div>
          </div>
          <!-- Chart Placeholder -->
          <div class="h-64 w-full relative flex items-end justify-between px-2 pb-6 pt-4 mt-4">
            <!-- Grid Lines -->
            <div class="absolute inset-0 flex flex-col justify-between pb-6 z-0">
              <div class="w-full border-b border-gray-100 border-dashed"></div>
              <div class="w-full border-b border-gray-100 border-dashed"></div>
              <div class="w-full border-b border-gray-100 border-dashed"></div>
              <div class="w-full border-b border-gray-100 border-dashed"></div>
            </div>
            <!-- Bars -->
            <% const salesHeights = [40, 60, 30, 80, 50, 90, 70]; %>
            <% const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']; %>
            <% salesHeights.forEach((h, i) => { %>
              <div class="relative z-10 w-[8%] flex flex-col items-center justify-end h-full group cursor-pointer">
                <div class="w-full max-w-[32px] bg-blue-500 rounded-t-md transition-all duration-300 group-hover:bg-blue-600" style="height: <%= h %>%"></div>
                <span class="absolute -bottom-6 text-xs font-bold text-gray-400"><%= days[i] %></span>
                <div class="absolute -top-10 opacity-0 group-hover:opacity-100 bg-gray-900 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-opacity whitespace-nowrap pointer-events-none z-20">
                  ₹<%= (h * 500).toLocaleString() %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- User Growth Chart -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-lg font-bold text-gray-900">User Growth</h2>
              <p class="text-sm text-gray-500 mt-1">New signups this week</p>
            </div>
          </div>
          <!-- Chart Placeholder -->
          <div class="h-64 w-full relative flex items-end justify-between px-2 pb-6 pt-4 mt-4">
            <!-- Grid Lines -->
            <div class="absolute inset-0 flex flex-col justify-between pb-6 z-0">
              <div class="w-full border-b border-gray-100 border-dashed"></div>
              <div class="w-full border-b border-gray-100 border-dashed"></div>
              <div class="w-full border-b border-gray-100 border-dashed"></div>
              <div class="w-full border-b border-gray-100 border-dashed"></div>
            </div>
            <!-- Line Chart Mock (using staggered dots) -->
            <% const userHeights = [20, 35, 30, 50, 45, 70, 85]; %>
            <% userHeights.forEach((h, i) => { %>
              <div class="relative z-10 w-[8%] flex flex-col items-center justify-end h-full group cursor-pointer">
                <div class="w-3 h-3 bg-purple-500 rounded-full border-2 border-white shadow-sm relative z-20 transition-transform group-hover:scale-150" style="margin-bottom: calc(<%= h %>% - 6px)"></div>
                <!-- Mock connecting line segments behind dots using tailwind arbitrary values could be complex, we just use bar for simplicity or just dots -->
                <div class="w-0.5 bg-purple-100 absolute bottom-0 rounded-t-full -z-10 transition-all duration-300 group-hover:bg-purple-200" style="height: <%= h %>%"></div>
                <span class="absolute -bottom-6 text-[10px] font-bold text-gray-400"><%= days[i] %></span>
                <div class="absolute -top-6 opacity-0 group-hover:opacity-100 bg-gray-900 text-white text-xs font-bold px-2 py-1 rounded-lg transition-opacity whitespace-nowrap pointer-events-none z-30" style="margin-bottom: <%= h %>%">
                  +<%= (h * 12) %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- BOTTOM GRID -->
      <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
        
        <!-- RECENT ORDERS -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm xl:col-span-2 flex flex-col">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-lg font-bold text-gray-900">Recent Orders</h2>
            <a href="/admin/orders" class="text-sm font-bold text-blue-600 hover:underline">View All Orders</a>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-gray-50/50">
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider rounded-l-lg border-b border-gray-100">Order ID</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">User</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Date</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100 text-right">Amount</th>
                  <th class="px-4 py-3 text-xs font-extrabold text-gray-500 uppercase tracking-wider rounded-r-lg border-b border-gray-100 text-center">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-4 text-sm font-bold text-gray-900">#ORD-9023</td>
                  <td class="px-4 py-4">
                    <p class="text-sm font-bold text-gray-900">John Doe</p>
                    <p class="text-xs text-gray-500">john@example.com</p>
                  </td>
                  <td class="px-4 py-4 text-sm font-medium text-gray-600">Aug 8, 2026</td>
                  <td class="px-4 py-4 text-sm font-extrabold text-gray-900 text-right">₹3,499</td>
                  <td class="px-4 py-4 text-center">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-green-50 text-green-700 border border-green-100">Completed</span>
                  </td>
                </tr>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-4 text-sm font-bold text-gray-900">#ORD-9022</td>
                  <td class="px-4 py-4">
                    <p class="text-sm font-bold text-gray-900">Sarah Jenkins</p>
                    <p class="text-xs text-gray-500">sarah.j@company.com</p>
                  </td>
                  <td class="px-4 py-4 text-sm font-medium text-gray-600">Aug 8, 2026</td>
                  <td class="px-4 py-4 text-sm font-extrabold text-gray-900 text-right">₹1,299</td>
                  <td class="px-4 py-4 text-center">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-yellow-50 text-yellow-700 border border-yellow-100">Pending</span>
                  </td>
                </tr>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-4 text-sm font-bold text-gray-900">#ORD-9021</td>
                  <td class="px-4 py-4">
                    <p class="text-sm font-bold text-gray-900">Michael Ross</p>
                    <p class="text-xs text-gray-500">m.ross@law.com</p>
                  </td>
                  <td class="px-4 py-4 text-sm font-medium text-gray-600">Aug 7, 2026</td>
                  <td class="px-4 py-4 text-sm font-extrabold text-gray-900 text-right">₹4,999</td>
                  <td class="px-4 py-4 text-center">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-green-50 text-green-700 border border-green-100">Completed</span>
                  </td>
                </tr>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-4 text-sm font-bold text-gray-900">#ORD-9020</td>
                  <td class="px-4 py-4">
                    <p class="text-sm font-bold text-gray-900">Emily Chen</p>
                    <p class="text-xs text-gray-500">emily.c@startup.io</p>
                  </td>
                  <td class="px-4 py-4 text-sm font-medium text-gray-600">Aug 7, 2026</td>
                  <td class="px-4 py-4 text-sm font-extrabold text-gray-900 text-right">₹2,499</td>
                  <td class="px-4 py-4 text-center">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-red-50 text-red-700 border border-red-100">Refunded</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- RIGHT SIDE: RECENT USERS & QUICK ACTIONS -->
        <div class="flex flex-col gap-8">
          
          <!-- QUICK ACTIONS -->
          <div class="bg-blue-600 rounded-2xl p-6 text-white shadow-md relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 rounded-full bg-blue-500 opacity-50 blur-xl"></div>
            <div class="relative z-10">
              <h2 class="text-lg font-bold mb-4">Quick Actions</h2>
              <div class="space-y-3">
                <a href="/admin/courses/create" class="flex items-center justify-between bg-white/10 hover:bg-white/20 px-4 py-3 rounded-xl transition-colors font-semibold text-sm backdrop-blur-sm border border-white/5">
                  <span class="flex items-center"><svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg> Add New Course</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
                <a href="/admin/categories/create" class="flex items-center justify-between bg-white/10 hover:bg-white/20 px-4 py-3 rounded-xl transition-colors font-semibold text-sm backdrop-blur-sm border border-white/5">
                  <span class="flex items-center"><svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg> Add Category</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
                <a href="/admin/analytics" class="flex items-center justify-between bg-white/10 hover:bg-white/20 px-4 py-3 rounded-xl transition-colors font-semibold text-sm backdrop-blur-sm border border-white/5">
                  <span class="flex items-center"><svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg> View Analytics</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- RECENT USERS -->
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm flex-1">
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-lg font-bold text-gray-900">New Signups</h2>
              <a href="/admin/users" class="text-sm font-bold text-blue-600 hover:underline">View All</a>
            </div>
            <div class="space-y-5">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm shrink-0 border border-blue-200">AJ</div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-bold text-gray-900 truncate">Alex Johnson</p>
                  <p class="text-xs font-medium text-gray-500 truncate">alex.j@example.com</p>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-xs font-bold text-gray-400">2 mins ago</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center font-bold text-sm shrink-0 border border-purple-200">SW</div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-bold text-gray-900 truncate">Samantha Wright</p>
                  <p class="text-xs font-medium text-gray-500 truncate">sam.wright@mail.com</p>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-xs font-bold text-gray-400">1 hr ago</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-sm shrink-0 border border-orange-200">DK</div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-bold text-gray-900 truncate">Daniel Kim</p>
                  <p class="text-xs font-medium text-gray-500 truncate">d.kim@studio.io</p>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-xs font-bold text-gray-400">3 hrs ago</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-green-100 text-green-600 flex items-center justify-center font-bold text-sm shrink-0 border border-green-200">MP</div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-bold text-gray-900 truncate">Maria Patel</p>
                  <p class="text-xs font-medium text-gray-500 truncate">maria.p@company.org</p>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-xs font-bold text-gray-400">Yesterday</p>
                </div>
              </div>
            </div>
          </div>
          
        </div>
      </div>

    </div>
  </div>
</main>

<%- include('../../../partials/footer') %>