<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">

  <!-- SIDEBAR -->
  <%- include('../../../partials/admin-sidebar', { activePage: 'dashboard' }) %>

  <!-- MAIN CONTENT -->
  <div class="flex-1 flex flex-col h-screen overflow-y-auto">
    
    <!-- TOP NAVIGATION -->
    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search data, students, or reports...' }) %>


    <div class="p-8 max-w-7xl mx-auto w-full">
      <!-- HEADER -->
      <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Systems Overview</h1>
        <p class="text-gray-500 mt-2 text-sm max-w-2xl">
          Welcome back, Controller. Your platform is currently experiencing a <span class="text-blue-600 font-medium">12% increase</span> in active learner engagement since last week.
        </p>
      </div>

      <!-- STATS -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
          <div class="flex justify-between items-start mb-4">
            <div class="p-2.5 bg-blue-50 text-blue-600 rounded-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700">
              +8.4%
            </span>
          </div>
          <p class="text-xs font-medium text-gray-500 tracking-wider uppercase">Total Revenue</p>
          <h2 class="text-3xl font-bold text-gray-900 mt-1">$124,592.00</h2>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
          <div class="flex justify-between items-start mb-4">
            <div class="p-2.5 bg-purple-50 text-purple-600 rounded-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700">
              +12%
            </span>
          </div>
          <p class="text-xs font-medium text-gray-500 tracking-wider uppercase">Active Students</p>
          <h2 class="text-3xl font-bold text-gray-900 mt-1">8,234</h2>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
          <div class="flex justify-between items-start mb-4">
            <div class="p-2.5 bg-orange-50 text-orange-600 rounded-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            </div>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
              Steady
            </span>
          </div>
          <p class="text-xs font-medium text-gray-500 tracking-wider uppercase">Courses Sold</p>
          <h2 class="text-3xl font-bold text-gray-900 mt-1">1,402</h2>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
          <div class="flex justify-between items-start mb-4">
            <div class="p-2.5 bg-red-50 text-red-600 rounded-xl">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            </div>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700">
              4.9/5
            </span>
          </div>
          <p class="text-xs font-medium text-gray-500 tracking-wider uppercase">Avg. Rating</p>
          <h2 class="text-3xl font-bold text-gray-900 mt-1">4.82</h2>
        </div>
      </div>

      <!-- MIDDLE SECTION -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        
        <!-- CHART AREA -->
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm lg:col-span-2">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-lg font-bold text-gray-900">Revenue Overview</h2>
              <p class="text-sm text-gray-500 mt-1">Monthly earnings compared to previous period</p>
            </div>
            <div class="flex bg-gray-100 rounded-full p-1">
              <button class="px-4 py-1.5 text-xs font-medium text-gray-600 rounded-full hover:bg-white hover:shadow-sm transition-all">Weekly</button>
              <button class="px-4 py-1.5 text-xs font-medium text-white bg-blue-600 rounded-full shadow-sm">Monthly</button>
            </div>
          </div>
          
          <!-- Mock Chart -->
          <div class="h-64 relative w-full flex items-end justify-between px-2 pb-6 mt-4">
            <!-- Grid lines -->
            <div class="absolute inset-0 flex flex-col justify-between pointer-events-none mb-6">
              <div class="w-full border-t border-gray-100 flex-1"></div>
              <div class="w-full border-t border-gray-100 flex-1"></div>
              <div class="w-full border-t border-gray-100 flex-1"></div>
              <div class="w-full border-t border-gray-100 flex-1"></div>
              <div class="w-full border-t border-gray-200"></div>
            </div>
            
            <!-- X Axis Labels -->
            <div class="absolute bottom-0 w-full flex justify-between text-xs text-gray-500 px-6 font-medium">
              <span>Jan</span>
              <span>Feb</span>
              <span>Mar</span>
              <span>Apr</span>
              <span>May</span>
              <span>Jun</span>
            </div>
          </div>
        </div>

        <!-- CTA CARD -->
        <div class="bg-blue-600 rounded-2xl p-8 text-white shadow-md flex flex-col justify-between relative overflow-hidden">
          <!-- decorative circle -->
          <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 rounded-full bg-blue-500 opacity-50 blur-xl"></div>
          
          <div class="relative z-10">
            <span class="inline-block px-3 py-1 bg-white/20 rounded-full text-xs font-bold tracking-wider uppercase mb-6 backdrop-blur-sm">
              Quick Action
            </span>
            <h3 class="text-2xl font-bold mb-3 leading-tight">Create new course</h3>
            <p class="text-blue-100 text-sm leading-relaxed mb-8">
              Add a new course to expand your learning catalog and grow student enrollments.
            </p>
          </div>
          
          <button class="relative z-10 w-full bg-white text-blue-600 font-bold py-3.5 rounded-xl hover:bg-gray-50 transition-colors shadow-sm">
            Create Course
          </button>
        </div>
      </div>

      <!-- TABLE -->
      <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-lg font-bold text-gray-900">Recent Activity</h2>
          <a href="#" class="text-sm font-semibold text-blue-600 hover:text-blue-700">View All Activity</a>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left">
            <thead class="text-xs text-gray-500 uppercase font-semibold bg-gray-50 border-y border-gray-100">
              <tr>
                <th class="px-4 py-4 rounded-tl-lg">Student</th>
                <th class="px-4 py-4">Course</th>
                <th class="px-4 py-4">Status</th>
                <th class="px-4 py-4 text-right rounded-tr-lg">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-4 flex items-center space-x-3">
                  <div class="w-9 h-9 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center font-bold text-xs shrink-0">EH</div>
                  <div>
                    <p class="font-bold text-gray-900">Elena Halpert</p>
                    <p class="text-xs text-gray-500">elena.h@example.com</p>
                  </div>
                </td>
                <td class="px-4 py-4 font-medium text-gray-600">Mastering Digital Sanctuary</td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-green-50 text-green-600 border border-green-100">
                    Completed
                  </span>
                </td>
                <td class="px-4 py-4 text-right font-bold text-gray-900">$199.00</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-4 flex items-center space-x-3">
                  <div class="w-9 h-9 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs shrink-0">JK</div>
                  <div>
                    <p class="font-bold text-gray-900">Julian Kross</p>
                    <p class="text-xs text-gray-500">j.kross@outlook.com</p>
                  </div>
                </td>
                <td class="px-4 py-4 font-medium text-gray-600">Intro to Cognitive Flow</td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-blue-600 border border-blue-100">
                    Processing
                  </span>
                </td>
                <td class="px-4 py-4 text-right font-bold text-gray-900">$89.00</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-4 flex items-center space-x-3">
                  <div class="w-9 h-9 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-xs shrink-0">MA</div>
                  <div>
                    <p class="font-bold text-gray-900">Mina Aris</p>
                    <p class="text-xs text-gray-500">mina.aris@mail.com</p>
                  </div>
                </td>
                <td class="px-4 py-4 font-medium text-gray-600">Visual Hierarchy Patterns</td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-green-50 text-green-600 border border-green-100">
                    Completed
                  </span>
                </td>
                <td class="px-4 py-4 text-right font-bold text-gray-900">$149.00</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-4 flex items-center space-x-3">
                  <div class="w-9 h-9 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center font-bold text-xs shrink-0">ST</div>
                  <div>
                    <p class="font-bold text-gray-900">Samuel Thorne</p>
                    <p class="text-xs text-gray-500">sam.t@company.org</p>
                  </div>
                </td>
                <td class="px-4 py-4 font-medium text-gray-600">Advanced Soft Minimalism</td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-blue-600 border border-blue-100">
                    Processing
                  </span>
                </td>
                <td class="px-4 py-4 text-right font-bold text-gray-900">$299.00</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</main>

<%- include('../../../partials/footer') %>