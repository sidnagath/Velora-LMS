              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-4 flex items-center space-x-3">
                  <div class="w-9 h-9 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs shrink-0">JK</div>
                  <div>
                    <p class="font-bold text-gray-900">Julian Kross</p>
                    <p class="text-xs text-gray-500">j.kross@outlook.com</p>
                  </div>
                </td>
                <td class="px-4 py-4 font-medium text-gray-600">Intro to Cognitive Flow</td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-blue-600 border border-blue-100">
                    Processing
                  </span>
                </td>
                <td class="px-4 py-4 text-right font-bold text-gray-900">$89.00</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-4 flex items-center space-x-3">
                  <div class="w-9 h-9 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center font-bold text-xs shrink-0">MA</div>
                  <div>
                    <p class="font-bold text-gray-900">Mina Aris</p>
                    <p class="text-xs text-gray-500">mina.aris@mail.com</p>
                  </div>
                </td>
                <td class="px-4 py-4 font-medium text-gray-600">Visual Hierarchy Patterns</td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-green-50 text-green-600 border border-green-100">
                    Completed
                  </span>
                </td>
                <td class="px-4 py-4 text-right font-bold text-gray-900">$149.00</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-4 flex items-center space-x-3">
                  <div class="w-9 h-9 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center font-bold text-xs shrink-0">ST</div>
                  <div>
                    <p class="font-bold text-gray-900">Samuel Thorne</p>
                    <p class="text-xs text-gray-500">sam.t@company.org</p>
                  </div>
                </td>
                <td class="px-4 py-4 font-medium text-gray-600">Advanced Soft Minimalism</td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-blue-600 border border-blue-100">
                    Processing
                  </span>
                </td>
                <td class="px-4 py-4 text-right font-bold text-gray-900">$299.00</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</main>

<%- include('../../../partials/footer') %>