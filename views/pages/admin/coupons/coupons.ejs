<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">

  <%- include('../../../partials/admin-sidebar', { activePage: 'coupons' }) %>

  <div class="flex-1 flex flex-col h-screen overflow-y-auto">

    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search coupons' }) %>

    <div class="p-8 max-w-7xl mx-auto w-full">
      <!-- HEADER -->
      <div class="mb-8 flex justify-between items-end">
        <div>
          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Coupon Management</h1>
          <p class="text-gray-500 mt-2 text-sm max-w-2xl">
            Monitor your platform's revenue stream and student enrollments in real-time.
          </p>
        </div>
        <div>
          <button class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition">
            <svg class="h-4 w-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Export
          </button>
        </div>
      </div>

      <!-- STATS -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Active Coupons -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
          <div class="flex justify-between items-start mb-4">
            <div class="p-2.5 bg-blue-50 text-blue-600 rounded-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
            </div>
          </div>
          <p class="text-xs font-bold text-gray-500 tracking-wider uppercase">Active Coupons</p>
          <h2 class="text-3xl font-extrabold text-gray-900 mt-1"><%= activeCouponsCount || 0 %></h2>
        </div>

        <!-- Total Redeemed -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
          <div class="flex justify-between items-start mb-4">
            <div class="p-2.5 bg-purple-50 text-purple-600 rounded-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            </div>
          </div>
          <p class="text-xs font-bold text-gray-500 tracking-wider uppercase">Total Redeemed</p>
          <h2 class="text-3xl font-extrabold text-gray-900 mt-1"><%= totalRedeemedCount || 0 %></h2>
        </div>

        <!-- Revenue Saved -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
          <div class="flex justify-between items-start mb-4">
            <div class="p-2.5 bg-orange-50 text-orange-600 rounded-xl">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
          </div>
          <p class="text-xs font-bold text-gray-500 tracking-wider uppercase">Revenue Saved</p>
          <h2 class="text-3xl font-extrabold text-gray-900 mt-1">₹<%= (totalRevenueSaved || 0).toLocaleString() %></h2>
        </div>
      </div>

      <%- include('../../../partials/admin-banner') %>

      <!-- MAIN TABLE AREA -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        
        <!-- Controls Row -->
        <div class="p-6 border-b border-gray-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold text-gray-900">Manage Coupons</h2>
            <p class="text-sm text-gray-500">View, edit, and track your promotional campaigns.</p>
          </div>
          
          <div class="flex items-center gap-3">
            <div class="relative">
              <input type="text" placeholder="Search by code..." class="pl-4 pr-10 py-2.5 bg-gray-100 border-transparent rounded-full text-sm focus:bg-white focus:border-blue-300 focus:ring-2 focus:ring-blue-100 transition-all w-64">
              <svg class="w-4 h-4 text-gray-500 absolute right-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <a href="/admin-coupons/create" class="inline-flex items-center px-5 py-2.5 border border-transparent text-sm font-medium rounded-full shadow-sm text-white bg-[#0B5ED7] hover:bg-[#0A58CA] transition-colors">
              <svg class="h-4 w-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Create Coupon
            </a>
          </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-xs font-bold uppercase tracking-wider text-gray-500 border-b border-gray-100">
              <tr>
                <th scope="col" class="px-6 py-4">Code</th>
                <th scope="col" class="px-6 py-4">Discount</th>
                <th scope="col" class="px-6 py-4">Min. Order</th>
                <th scope="col" class="px-6 py-4">Expiry</th>
                <th scope="col" class="px-6 py-4">Status</th>
                <th scope="col" class="px-6 py-4">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% if (coupons && coupons.length > 0) { %>
                <% coupons.forEach(coupon => { %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4">
                      <div class="flex flex-col">
                        <span class="font-extrabold text-gray-900 tracking-wide text-sm uppercase"><%= coupon.code %></span>
                        <span class="text-xs text-blue-600 font-semibold"><%= coupon.description %></span>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-100">
                        <%= coupon.discountType === 'percentage' ? coupon.discountValue + '% Off' : '₹' + coupon.discountValue.toFixed(2) + ' Flat' %>
                      </span>
                    </td>
                    <td class="px-6 py-4 font-medium text-gray-600">
                      ₹<%= coupon.minOrderValue.toFixed(2) %>
                    </td>
                    <td class="px-6 py-4 text-gray-500">
                      <%= new Date(coupon.expiryDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </td>
                    <td class="px-6 py-4">
                      <% if (coupon.status === 'active') { %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-widest bg-green-100 text-green-700">
                          <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span>Active
                        </span>
                      <% } else if (coupon.status === 'expired') { %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-widest bg-gray-200 text-gray-600">
                          <span class="w-1.5 h-1.5 rounded-full bg-gray-500 mr-1.5"></span>Expired
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-widest bg-yellow-100 text-yellow-700">
                          <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 mr-1.5"></span>Inactive
                        </span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-2">
                        <a href="/admin-coupons/<%= coupon._id %>/edit" class="inline-flex items-center px-3 py-1.5 border border-blue-600 text-xs font-semibold rounded-md text-blue-600 bg-white hover:bg-blue-50 transition-colors">
                          <svg class="h-3.5 w-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                          Edit
                        </a>
                        <form id="delCouponForm-<%= coupon._id %>" action="/admin-delete-coupon/<%= coupon._id %>" method="POST">
                          <button type="button"
                            onclick="openConfirmModal({title:'Delete Coupon?',message:'This will permanently delete coupon \&quot;<%= coupon.code %>\&quot;.',form:document.getElementById('delCouponForm-<%= coupon._id %>')})"
                            class="inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-semibold rounded-md text-white bg-red-600 hover:bg-red-700 transition-colors shadow-sm">
                            <svg class="h-3.5 w-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                    <div class="flex flex-col items-center justify-center">
                      <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
                      <p class="text-sm font-medium">No coupons found.</p>
                      <p class="text-xs mt-1">Create a coupon to get started.</p>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between bg-gray-50/50 rounded-b-2xl">
          <p class="text-sm font-medium text-gray-500">
            Showing <%= totalCoupons === 0 ? 0 : Math.min((currentPage - 1) * LIMIT + 1, totalCoupons) %> to <%= Math.min(currentPage * LIMIT, totalCoupons) %> of <%= totalCoupons %> coupons
          </p>

          <div class="flex items-center space-x-2">
            <% const buildCouponQuery = (p) => {
              const qs = new URLSearchParams();
              if (search) qs.set('search', search);
              if (filterStatus) qs.set('status', filterStatus);
              if (sortBy && sortBy !== 'newest') qs.set('sortBy', sortBy);
              qs.set('page', p);
              return '/admin-coupons?' + qs.toString();
            }; %>

            <% if(currentPage > 1){ %>
              <a href="<%= buildCouponQuery(currentPage - 1) %>" class="px-3 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                Previous
              </a>
            <% } else { %>
              <span class="px-3 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-400 bg-gray-50 cursor-not-allowed">
                Previous
              </span>
            <% } %>

            <% for(let i = Math.max(1, currentPage - 1); i <= Math.min(totalPages || 1, currentPage + 1); i++){ %>
              <a href="<%= buildCouponQuery(i) %>"
                class="w-9 h-9 flex items-center justify-center rounded-full text-sm font-semibold transition-colors
                <%= currentPage === i ? 'bg-blue-600 text-white shadow-sm' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50' %>">
                <%= i %>
              </a>
            <% } %>

            <% if(currentPage < totalPages){ %>
              <a href="<%= buildCouponQuery(currentPage + 1) %>" class="px-3 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                Next
              </a>
            <% } else { %>
              <span class="px-3 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-400 bg-gray-50 cursor-not-allowed">
                Next
              </span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Information Card -->
      <div class="mt-8 bg-[#F8F9FA] rounded-xl p-5 border border-gray-200 flex items-center gap-3">
        <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <p class="text-sm text-gray-600 font-medium">Looking for more analytics? Check the <a href="#" class="text-blue-600 hover:underline">Reports</a> section for detailed redemption history and revenue attribution.</p>
      </div>

    </div>
  </div>
</main>

<%- include('../../../partials/confirm-modal') %>

</body>
</html>
