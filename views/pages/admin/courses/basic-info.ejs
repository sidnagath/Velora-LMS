<%- include('../../../partials/header') %>

  <main class="flex min-h-screen bg-gray-50 font-sans">

    <%- include('../../../partials/admin-sidebar', { activePage: 'courses' }) %>

      <div class="flex-1 flex flex-col h-screen overflow-y-auto">

        <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search courses' }) %>

          <div class="p-8 max-w-5xl mx-auto w-full">
            <!-- HEADER -->
            <div class="mb-8">
              <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Basic Info</h1>
              <p class="text-gray-500 mt-2 text-sm">Organize your course into logical modules and lessons.</p>
            </div>

            <!-- PROGRESS STEPPER -->
            <div class="mb-12">
              <div class="flex items-center justify-between relative">
                <!-- Connection Lines -->
                <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-200 -translate-y-1/2 z-0"></div>

                <!-- Step 1 (Active) -->
                <div class="relative z-10 flex flex-col items-center">
                  <div
                    class="w-10 h-10 rounded-full bg-blue-600 border-4 border-white shadow-md flex items-center justify-center text-white font-bold">
                    1</div>
                  <span class="mt-3 text-xs font-bold text-blue-600 uppercase tracking-widest">1. Basic Info</span>
                </div>

                <!-- Step 2 -->
                <div class="relative z-10 flex flex-col items-center">
                  <div
                    class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">
                    2</div>
                  <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">2. Modules</span>
                </div>

                <!-- Step 3 -->
                <div class="relative z-10 flex flex-col items-center">
                  <div
                    class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">
                    3</div>
                  <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">3. Lessons</span>
                </div>

                <!-- Step 4 -->
                <div class="relative z-10 flex flex-col items-center">
                  <div
                    class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">
                    4</div>
                  <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">4. Resources</span>
                </div>

                <!-- Step 5 -->
                <div class="relative z-10 flex flex-col items-center">
                  <div
                    class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">
                    5</div>
                  <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">5. Publish</span>
                </div>
              </div>
            </div>
           


            <form action="/admin-courses/<%= course._id %>/basic-info" method="POST" enctype="multipart/form-data">
              <!-- COURSE DETAILS CARD -->
              <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm mb-8">
                <div class="flex items-center space-x-3 mb-8">
                  <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                      </path>
                    </svg>
                  </div>
                  <h2 class="text-xl font-bold text-gray-900">Course Details</h2>
                </div>

                <div class="space-y-6">

                  <% if (error.length> 0) { %>
                    <p class="!text-red-600 font-medium mb-4">
                      <%= error[0] %>
                    </p>
                    <% } %>

                      <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Course Title</label>
                        <input type="text" name="title" value="<%=course?.title ||'' %>"
                          placeholder="e.g. Masterclass in Digital Design Architecture"
                          class="w-full pl-4 pr-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none font-medium text-gray-900">
                      </div>

                      <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Short Description</label>
                        <textarea name="description" rows="4" placeholder="Briefly describe what students will learn..."
                          class="w-full pl-4 pr-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none font-medium text-gray-900 resize-none"><%= course?.description || '' %></textarea>
                      </div>

                      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                          <label class="block text-sm font-bold text-gray-700 mb-2">Category</label>
                          <div class="relative">
                            <select name="category"
                              class="w-full pl-4 pr-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none font-medium text-gray-900 appearance-none">

                              <option value="html" <%=course?.category==="html" ? "selected" : "" %>
                                >
                                HTML
                              </option>

                              <option value="css" <%=course?.category==="css" ? "selected" : "" %>
                                >
                                CSS
                              </option>

                              <option value="javascript" <%=course?.category==="javascript" ? "selected" : "" %>
                                >
                                JavaScript
                              </option>

                              <option value="react" <%=course?.category==="react" ? "selected" : "" %>
                                >
                                React
                              </option>

                              <option value="python" <%=course?.category==="python" ? "selected" : "" %>
                                >
                                Python
                              </option>

                              <option value="nodejs" <%=course?.category==="nodejs" ? "selected" : "" %>
                                >
                                Node.js
                              </option>

                              <option value="django" <%=course?.category==="django" ? "selected" : "" %>
                                >
                                Django
                              </option>
                            </select>
                            <div
                              class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-gray-400">
                              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M19 9l-7 7-7-7"></path>
                              </svg>
                            </div>
                          </div>
                        </div>
                        <div>
                          <label class="block text-sm font-bold text-gray-700 mb-2">Instructor Name</label>
                          <input type="text" name="instructor" value="<%= course?.instructor || '' %>"
                            placeholder="Full name of instructor"
                            class="w-full pl-4 pr-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none font-medium text-gray-900">
                        </div>
                      </div>

                      <div>
                        <label class="block text-sm font-bold text-gray-700 mb-4">
                          Difficulty Level
                        </label>

                        <div class="flex items-center space-x-3 p-1 bg-gray-50 rounded-xl w-fit">

                          <!-- BEGINNER -->
                          <label class="cursor-pointer">

                            <input type="radio" name="level" value="Beginner" class="sr-only peer"
                              <%=course?.level==="Beginner" ? "checked" : "" %>
                            >

                            <div
                              class="px-6 py-2.5 rounded-lg font-bold text-sm transition-all peer-checked:bg-blue-600 peer-checked:text-white peer-checked:shadow-sm text-gray-400 hover:text-gray-600">
                              Beginner
                            </div>

                          </label>



                          <!-- INTERMEDIATE -->
                          <label class="cursor-pointer">

                            <input type="radio" name="level" value="Intermediate" class="sr-only peer"
                              <%=course?.level==="Intermediate" ? "checked" : "" %>
                            >

                            <div
                              class="px-6 py-2.5 rounded-lg font-bold text-sm transition-all peer-checked:bg-blue-600 peer-checked:text-white peer-checked:shadow-sm text-gray-400 hover:text-gray-600">
                              Intermediate
                            </div>

                          </label>



                          <!-- ADVANCED -->
                          <label class="cursor-pointer">

                            <input type="radio" name="level" value="Advanced" class="sr-only peer"
                              <%=course?.level==="Advanced" ? "checked" : "" %>
                            >

                            <div
                              class="px-6 py-2.5 rounded-lg font-bold text-sm transition-all peer-checked:bg-blue-600 peer-checked:text-white peer-checked:shadow-sm text-gray-400 hover:text-gray-600">
                              Advanced
                            </div>

                          </label>

                        </div>
                      </div>


                </div>
              </div>

              <!-- MEDIA ASSETS CARD -->
              <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm mb-12">
                <div class="flex items-center space-x-3 mb-8">
                  <div class="p-2 bg-orange-50 text-orange-600 rounded-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                      </path>
                    </svg>
                  </div>

                  <h2 class="text-xl font-bold text-gray-900">Media Assets</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                  <!-- Thumbnail -->
                  <div>

                    <label class="block text-sm font-bold text-gray-700 mb-4">
                      Course Thumbnail
                    </label>



                    <div
                      class="border-2 border-dashed border-gray-200 rounded-2xl p-6 flex flex-col items-center justify-center bg-gray-50 group hover:border-blue-400 hover:bg-blue-50/30 transition-all cursor-pointer relative overflow-hidden">


                      <% if(course?.thumbnail) { %>

                        <img id="existingThumbnail" src="<%= course.thumbnail %>" class="w-full h-56 object-cover rounded-xl mb-4 border">

                       <p id="thumbnailPlaceholderText" class="text-sm font-medium text-gray-500 mb-1">
                          Replace current thumbnail
                        </p>

                        <% } else { %>

                          <div id="thumbnailPlaceholderIcon" class="p-4 bg-blue-100/50 text-blue-600 rounded-full mb-4">

                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">

                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                              </path>

                            </svg>

                          </div>

                          <p id="thumbnailPlaceholderText" class="text-sm font-medium text-gray-500 mb-1">
                            JPG, PNG up to 5MB
                          </p>

                          <% } %>


                          <img id="thumbnailPreview" class="hidden w-full h-56 object-cover rounded-xl mb-4 border"/>   

                            <button type="button" onclick="document.getElementById('thumbnailInput').click()"
                              class="mt-4 px-6 py-2.5 bg-blue-600 text-white font-bold rounded-lg text-sm hover:bg-blue-700 transition-all shadow-md">
                              Upload image
                            </button>


                            <input type="file" name="thumbnail" id="thumbnailInput" class="hidden">

                    </div>

                  </div>

                  <!-- Trailer -->
                  <div>

                    <label class="block text-sm font-bold text-gray-700 mb-4">
                      Intro Trailer
                    </label>



                    <div
                      class="border-2 border-dashed border-gray-200 rounded-2xl p-6 flex flex-col items-center justify-center bg-gray-50 group hover:border-blue-400 hover:bg-blue-50/30 transition-all cursor-pointer relative overflow-hidden">


                      <% if(course?.trailer) { %>

                        <video controls  id="existingTrailer" class="w-full h-64 object-cover rounded-xl mb-4 border">

                          <source src="<%= course.trailer %>" type="video/mp4">

                        </video>

                        <p class="text-sm font-medium text-gray-500 mb-1">
                          Replace current trailer
                        </p>

                        <% } else { %>

                          <div id="trailerPlaceholderIcon" class="p-4 bg-blue-100/50 text-blue-600 rounded-full mb-4">

                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">

                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.868v4.264a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z">
                              </path>

                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"></path>

                            </svg>

                          </div>

                          <p id="trailerPlaceholderText" class="text-sm font-medium text-gray-500 mb-1">
                            MP4, MOV up to 100MB
                          </p>

                          <% } %>

                          <video
                         id="trailerPreview"
                         controls
                         class="hidden w-full h-64 object-cover rounded-xl mb-4 border">
                         </video>

                            <button type="button" onclick="document.getElementById('trailerInput').click()"
                              class="mt-4 px-6 py-2.5 bg-blue-600 text-white font-bold rounded-lg text-sm hover:bg-blue-700 transition-all shadow-md">
                              Upload Trailer
                            </button>



                            <input type="file" name="trailer" id="trailerInput" class="hidden">

                    </div>

                  </div>


                </div>
              </div>

              <!-- FOOTER ACTIONS -->
              <div class="flex items-center justify-between pt-8 border-t border-gray-100">
                <a href="/admin-courses"
                  class="flex items-center text-gray-500 font-bold hover:text-gray-800 transition-colors">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M11 17l-5-5m0 0l5-5m-5 5h12"></path>
                  </svg>
                  Back to Courses
                </a>
                <div class="flex items-center space-x-4">
                  <a href="/admin-courses" type="button"
                    class="px-8 py-3.5 border border-gray-200 text-gray-600 font-bold rounded-xl hover:bg-gray-50 transition-all">Save
                    Draft</a>
                  <button type="submit"
                    class="inline-flex items-center px-8 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-lg group">
                    Continue to Modules
                    <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none"
                      stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </form>

          </div>
      </div>
  </main>

<script>

const thumbnailInput =
  document.getElementById(
    "thumbnailInput"
  );

const thumbnailPreview =
  document.getElementById(
    "thumbnailPreview"
  );

const existingThumbnail =
  document.getElementById(
    "existingThumbnail"
  );

const thumbnailPlaceholderIcon =
  document.getElementById(
    "thumbnailPlaceholderIcon"
  );

const thumbnailPlaceholderText =
  document.getElementById(
    "thumbnailPlaceholderText"
  );



thumbnailInput.addEventListener(

  "change",

  function () {

    const file =
      this.files[0];



    if (file) {

      thumbnailPreview.src =

        URL.createObjectURL(
          file
        );



      thumbnailPreview
      .classList
      .remove("hidden");


      // HIDE OLD IMAGE

      if (existingThumbnail) {

        existingThumbnail
        .style.display = "none";

      }


      // HIDE PLACEHOLDER

      if (thumbnailPlaceholderIcon) {

        thumbnailPlaceholderIcon
        .style.display = "none";

      }



      if (thumbnailPlaceholderText) {

        thumbnailPlaceholderText
        .style.display = "none";

      }

    }

  }

);

const trailerInput =
  document.getElementById(
    "trailerInput"
  );

const trailerPreview =
  document.getElementById(
    "trailerPreview"
  );

const trailerPlaceholderIcon =
  document.getElementById(
    "trailerPlaceholderIcon"
  );
 
const existingTrailer =
document.getElementById(
  "existingTrailer"
);  

const trailerPlaceholderText =
  document.getElementById(
    "trailerPlaceholderText"
  );



trailerInput.addEventListener(

  "change",

  function () {

    const file =
      this.files[0];



    if (file) {

      trailerPreview.src =

        URL.createObjectURL(
          file
        );



      trailerPreview
      .classList
      .remove("hidden");
      

      //HIDE OLD VIDEO
      if(existingTrailer){

      existingTrailer.style.display =
      "none";

      }

      // HIDE PLACEHOLDER

      if (trailerPlaceholderIcon) {

        trailerPlaceholderIcon
        .style.display = "none";

      }
      


      if (trailerPlaceholderText) {

        trailerPlaceholderText
        .style.display = "none";

      }

    }

  }

);


</script>

  <%- include('../../../partials/footer') %>