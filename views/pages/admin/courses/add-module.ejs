<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">

  <%- include('../../../partials/admin-sidebar', { activePage: 'courses' }) %>

  <div class="flex-1 flex flex-col h-screen overflow-y-auto">
    
    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search courses' }) %>

    <div class="p-8 max-w-5xl mx-auto w-full">
      <!-- HEADER -->
      <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight"><%= typeof isEdit !== 'undefined' && isEdit ? 'Edit Module' : 'Add Module' %></h1>
        <p class="text-gray-500 mt-2 text-sm">Organize your course into logical modules and lessons.</p>
      </div>

      <!-- PROGRESS STEPPER -->
      <div class="mb-12">
        <div class="flex items-center justify-between relative">
          <!-- Connection Lines -->
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-200 -translate-y-1/2 z-0"></div>
          <div class="absolute top-1/2 left-0 w-[25%] h-0.5 bg-blue-600 -translate-y-1/2 z-0"></div>
          
          <!-- Step 1 (Completed) -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-blue-600 border-4 border-white shadow-md flex items-center justify-center text-white font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">1. Basic Info</span>
          </div>

          <!-- Step 2 (Active) -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-4 border-blue-600 shadow-md flex items-center justify-center text-blue-600 font-bold">2</div>
            <span class="mt-3 text-xs font-bold text-blue-600 uppercase tracking-widest">2. Modules</span>
          </div>

          <!-- Step 3 -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">3</div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">3. Lessons</span>
          </div>

          <!-- Step 4 -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">4</div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">4. Resources</span>
          </div>

          <!-- Step 5 -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">5</div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">5. Publish</span>
          </div>
        </div>
      </div>

      <!-- FORM CARD -->
      <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm mb-12">
        <div class="flex items-center space-x-3 mb-8">
          <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-900">Module Details</h2>
        </div>

                <% if (error.length> 0) { %>
                <p class="!text-red-600 font-medium mb-4">
                <%= error[0] %>
                </p>
                <% } %>

        <form action=" <%= isEdit ? `/admin-courses/${course._id}/modules/${module._id}/edit` : `/admin-courses/${course._id}/modules/create`%> " method="POST" class="space-y-8">
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Module Title</label>
            <input type="text" name="title" placeholder="Introduction" class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none font-medium text-gray-900">
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Short Description</label>
            <textarea name="description" rows="5" placeholder="Learn the foundational principles of user experience design, visual hierarchy, and modern interface design patterns through hands-on project building." class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none font-medium text-gray-900 resize-none"></textarea>
          </div>

      <!-- FOOTER ACTIONS -->
      <div class="flex items-center justify-between pt-8 border-t border-gray-100">
        <a href="/admin-courses/<%=course._id%>/modules" class="flex items-center text-gray-500 font-bold hover:text-gray-800 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"></path></svg>
          Back to Modules List
        </a>
        <div class="flex items-center space-x-4">
          <a href="/admin-courses" type="button" class="px-8 py-3.5 border border-gray-200 text-gray-600 font-bold rounded-xl hover:bg-gray-50 transition-all">Save Draft</a>
          <button type="submit" class="inline-flex items-center px-8 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-lg group">
            <%= typeof isEdit !== 'undefined' && isEdit ? 'Update Module' : 'Add Module' %>
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </button>
        </div>
      </div>
      </form>
      </div>

    </div>
  </div>
</main>

<%- include('../../../partials/footer') %>
