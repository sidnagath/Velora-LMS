<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">

  <%- include('../../../partials/admin-sidebar', { activePage: 'courses' }) %>

  <div class="flex-1 flex flex-col h-screen overflow-y-auto">
    
    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search courses' }) %>

    <div class="p-8 max-w-5xl mx-auto w-full">
      <!-- HEADER -->
      <div class="mb-8 text-center md:text-left">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight"><%= isEdit ? 'Edit' : 'Add' %> Lesson</h1>
        <p class="text-gray-500 mt-2 text-sm">Organize your course into logical modules and lessons.</p>
      </div>

      <!-- PROGRESS STEPPER -->
      <div class="mb-12">
        <div class="flex items-center justify-between relative">
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-200 -translate-y-1/2 z-0"></div>
          <div class="absolute top-1/2 left-0 w-[50%] h-0.5 bg-blue-600 -translate-y-1/2 z-0"></div>
          


          <!-- Step 1 (Completed) -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-blue-600 border-4 border-white shadow-md flex items-center justify-center text-white font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">1. Basic Info</span>
          </div>

           <!-- Step 2 (Completed) -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-blue-600 border-4 border-white shadow-md flex items-center justify-center text-white font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">2. Modules</span>
          </div>


          <!-- Step 3 (Active) -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-4 border-blue-600 shadow-md flex items-center justify-center text-blue-600 font-bold">3</div>
            <span class="mt-3 text-xs font-bold text-blue-600 uppercase tracking-widest">3. Lessons</span>
          </div>

          <!-- Step 4 -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">4</div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">4. Resources</span>
          </div>

          <!-- Step 5 -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">5</div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">5. Publish</span>
          </div>
        </div>
      </div>

      
        <!-- LESSON DETAILS -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <div class="flex items-center space-x-3 mb-6">
            <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            </div>
            <h2 class="text-xl font-bold text-gray-900">Lesson Details</h2>
          </div>

<% if(errors?.general){ %>

<p class="input-error">

  <%= errors.general %>

</p>

<% } %>

           <form action="<%= isEdit ? `/admin-courses/${course._id}/modules/${module._id}/lessons/${lesson._id}/edit`: `/admin-courses/${course._id}/modules/${module._id}/lessons/create`%>" method="POST" class="space-y-8" enctype="multipart/form-data">        
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">Lesson Title</label>
              <input type="text" name="title" value="<%= formData?.title || lesson?.title || '' %>" placeholder="Introduction" value="<%= lesson?.title || '' %>" class="w-full px-6 py-4 rounded-xl border border-gray-100 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none">
           <% if(errors?.title){ %>

<p class="input-error">

  <%= errors.title %>

</p>

<% } %>
            </div>

            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">Short Description</label>
<textarea
  rows="4"
  name="description"
  placeholder="Learn the foundational principles..."
  class="w-full px-6 py-4 rounded-xl border border-gray-100 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none resize-none"
><%= formData?.description || lesson?.description || '' %></textarea>

<% if(errors?.description){ %>

<p class="input-error">

  <%= errors.description %>

</p>

<% } %>
            </div>
          </div>
        

        <!-- VIDEO CONTENT -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <div class="flex items-center space-x-3 mb-6">
            <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            </div>
            <h2 class="text-xl font-bold text-gray-900">Video Content</h2>
          </div>


<div class="border-2 border-dashed border-gray-200 rounded-2xl p-12 text-center hover:border-blue-400 transition-colors cursor-pointer group">

  <!-- EXISTING VIDEO -->

  <% if (lesson?.video) { %>

    <video
    id="existingVideo"
      controls
      class="w-full rounded-2xl border mb-6"
    >

      <source
        src="<%= lesson.video %>"
        type="video/mp4"
      >

    </video>

    <p class="text-gray-500 font-medium">
      Replace current lesson video
    </p>

  <% } else { %>

    <!-- PLACEHOLDER ICON -->

    <div
      id="lessonVideoPlaceholderIcon"
      class="w-16 h-16 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform"
    >

      <svg
        class="w-8 h-8"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >

        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
        ></path>

      </svg>

    </div>



    <!-- PLACEHOLDER TEXT -->

    <p
      id="lessonVideoPlaceholderText"
      class="text-gray-500 font-medium"
    >

      MP4, MOV or AVI (Max. 2GB)

    </p>

  <% } %>



  <!-- REALTIME VIDEO PREVIEW -->

  <video
    id="lessonVideoPreview"
    controls
    class="hidden w-full rounded-xl border mt-6"
  >
  </video>



  <!-- HIDDEN INPUT -->

  <input
    type="file"
    name="video"
    id="videoInput"
    class="hidden"
  >



  <!-- BUTTON -->

  <button
    type="button"
    onclick="document.getElementById('videoInput').click()"
    class="mt-6 px-8 py-3 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-200"
  >

    Upload Video

  </button>

  <% if(errors?.video){ %>

<p class="input-error">

  <%= errors.video %>

</p>

<% } %>

</div>

        </div>

        <!-- ACTIONS -->
        <div class="flex items-center justify-between pt-6 border-t border-gray-100">
          <a href="/admin-courses/<%=course._id%>/modules" class="inline-flex items-center text-sm font-bold text-gray-500 hover:text-gray-900 transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to Modules
          </a>
          <div class="flex items-center space-x-4">
            <a href="/admin-courses" type="button" class="px-8 py-3.5 border border-gray-200 text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition">Save Draft</a>
            <button type="submit" class="px-8 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition flex items-center shadow-lg shadow-blue-200">
              <%= isEdit ? 'Update' : 'Add' %> Lesson
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
          </div>
        </div>

      </form>

    </div>
  </div>
</main>

<script>

const lessonVideoInput =
  document.getElementById(
    "videoInput"
  );

const lessonVideoPreview =
  document.getElementById(
    "lessonVideoPreview"
  );

const lessonVideoPlaceholderText =
  document.getElementById(
    "lessonVideoPlaceholderText"
  );

const existingVideo =
  document.getElementById(
    "existingVideo"
  );

const lessonVideoPlaceholderIcon =
  document.getElementById(
    "lessonVideoPlaceholderIcon"
  );



lessonVideoInput.addEventListener(

  "change",

  function () {

    const file =
      this.files[0];



    if (file) {

      lessonVideoPreview.src =

        URL.createObjectURL(
          file
        );



      lessonVideoPreview
      .classList
      .remove("hidden");

      
      //HIDE VIDEO
       if (existingVideo) {

        existingVideo
        .style.display = "none";

      }

      // HIDE PLACEHOLDER TEXT

      if (
        lessonVideoPlaceholderText
      ) {

        lessonVideoPlaceholderText
        .style.display = "none";

      }



      // HIDE PLACEHOLDER ICON

      if (
        lessonVideoPlaceholderIcon
      ) {

        lessonVideoPlaceholderIcon
        .style.display = "none";

      }

    }

  }

);

</script>
<style>
  .input-error {
    color: #EF4444 !important;
    font-size: 13px;
    font-weight: 500;
    margin-top: 6px;
    display: block;
  }
</style>
<%- include('../../../partials/footer') %>
