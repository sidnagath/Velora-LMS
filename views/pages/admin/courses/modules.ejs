<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">

  <%- include('../../../partials/admin-sidebar', { activePage: 'courses' }) %>

  <div class="flex-1 flex flex-col h-screen overflow-y-auto">
    
    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search courses' }) %>

    <div class="p-8 max-w-5xl mx-auto w-full">
      <!-- HEADER -->
      <div class="mb-8 text-center md:text-left">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Modules</h1>
        <p class="text-gray-500 mt-2 text-sm">Organize your course into logical modules and lessons.</p>
      </div>

      <!-- PROGRESS STEPPER -->
      <div class="mb-12">
        <div class="flex items-center justify-between relative">
          <!-- Connection Lines -->
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-200 -translate-y-1/2 z-0"></div>
          <div class="absolute top-1/2 left-0 w-[25%] h-0.5 bg-blue-600 -translate-y-1/2 z-0"></div>
          
          <!-- Step 1 (Completed) -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-blue-600 border-4 border-white shadow-md flex items-center justify-center text-white font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">1. Basic Info</span>
          </div>

          <!-- Step 2 (Active) -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-4 border-blue-600 shadow-md flex items-center justify-center text-blue-600 font-bold">2</div>
            <span class="mt-3 text-xs font-bold text-blue-600 uppercase tracking-widest">2. Modules</span>
          </div>

          <!-- Step 3 -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">3</div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">3. Lessons</span>
          </div>

          <!-- Step 4 -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">4</div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">4. Resources</span>
          </div>

          <!-- Step 5 -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">5</div>
            <span class="mt-3 text-xs font-bold text-gray-400 uppercase tracking-widest">5. Publish</span>
          </div>
        </div>
      </div>

      <!-- MODULE LIST SECTION -->
      <div class="space-y-6 mb-12">
<% if(errors?.general){ %>

<p class="text-sm text-red-500 mb-4">

  <%= errors.general %>

</p>

<% } %>


        <!-- Module Card -->
         <% if(modules.length > 0){ %>
         <% modules.forEach(module => { %>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden transition-all hover:shadow-md">
          <div class="p-6 bg-gray-50/50 flex items-center justify-between border-b border-gray-100">
            <div class="flex items-center space-x-4">
              <div class="cursor-move text-gray-400 hover:text-gray-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900"><%=module.title%></h3>
            </div>
            <div class="flex items-center space-x-2">
              <a href='/admin-courses/<%=course._id%>/modules/<%=module._id%>/edit' class="p-2 text-gray-400 hover:text-blue-600 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
              </a>
      
              <form action='/admin-courses/<%=course._id%>/modules/<%=module._id%>/delete' method="POST" onsubmit="return confirm('Are you sure you want to delete this module?')">
              <button class="p-2 text-gray-400 hover:text-red-600 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </button>
               
              </form>

            </div>
          </div>
          
          <div class="p-6 space-y-3 bg-white">
          

            <%

const moduleLessons =

  lessons.filter(

    lesson =>

      lesson.moduleId.toString()

      ===

      module._id.toString()

  );

%>



<% if(moduleLessons.length > 0) { %>

  <% moduleLessons.forEach(lesson => { %>

    <div class="flex items-center justify-between p-4 bg-gray-50/50 border border-gray-100 rounded-xl group hover:bg-white hover:border-blue-100 transition-all">

      <div>

        <span class="font-semibold text-gray-700">

          <%= lesson.title %>

        </span>



        <p class="text-sm text-gray-400 mt-1">

          <%= lesson.duration %>

        </p>

      </div>



      <div class="flex items-center space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">

        <!-- EDIT -->

        <a
          href="/admin-courses/<%= course._id %>/modules/<%= module._id %>/lessons/<%= lesson._id %>/edit"

          class="p-1.5 text-gray-400 hover:text-blue-600 transition-colors"
        >

          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">

            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"

              d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">

            </path>

          </svg>

        </a>



        <!-- DELETE -->

        <form

          action="/admin-courses/<%= course._id %>/modules/<%= module._id %>/lessons/<%= lesson._id %>/delete"

          method="POST"

          onsubmit="return confirm('Delete this lesson?')"

        >

          <button

            class="p-1.5 text-gray-400 hover:text-red-600 transition-colors"
          >

            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">

              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"

                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">

              </path>

            </svg>

          </button>

        </form>

      </div>

    </div>

  <% }) %>

<% } else { %>

  <p class="text-sm text-gray-400">

    No lessons added yet

  </p>

<% } %>

            <!-- Add Lesson Placeholder -->
            <a href='/admin-courses/<%=course._id%>/modules/<%=module._id%>/lessons/create' class="w-full py-4 border-2 border-dashed border-gray-100 rounded-xl text-gray-400 font-bold text-sm hover:border-blue-200 hover:text-blue-500 hover:bg-blue-50/30 transition-all flex items-center justify-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Add Lesson or Content
            </a>
      
          </div>
        </div>
        <% }) %>
        <% } %>

        <!-- Add Module Card Placeholder -->
        <div class="bg-white rounded-2xl border-2 border-dashed border-gray-100 p-12 flex flex-col items-center justify-center text-center group hover:border-blue-200 hover:bg-blue-50/20 transition-all cursor-pointer">
          <div class="p-4 bg-gray-50 text-gray-400 rounded-2xl mb-4 group-hover:bg-blue-100 group-hover:text-blue-600 transition-all">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
          </div>
          <h4 class="text-xl font-bold text-gray-900 mb-2">Untitled Module</h4>
          <p class="text-gray-400 text-sm mb-6">Start building this course by adding more modules</p>
          <a href="/admin-courses/<%=course._id %>/modules/create" class="px-8 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition flex items-center shadow-lg shadow-blue-200">
            Add Modules
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </div>

      <!-- FOOTER ACTIONS -->
      <div class="flex items-center justify-between pt-8 border-t border-gray-100">
        <a href="/admin-courses/<%= course._id %>/edit" class="flex items-center text-gray-500 font-bold hover:text-gray-800 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"></path></svg>
          Back to Basic Info
        </a>
        <div class="flex items-center space-x-4">
          <a href="/admin-courses" class="px-8 py-3.5 border border-gray-200 text-gray-600 font-bold rounded-xl hover:bg-gray-50 transition-all">Save Draft</a>
          <a href="/admin-courses/<%= course._id %>/resources" class="inline-flex items-center px-8 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-lg group">
            Continue to Resources
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</main>

<%- include('../../../partials/footer') %>
