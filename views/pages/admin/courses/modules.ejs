<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">
  <%- include('../../../partials/admin-sidebar', { activePage: 'courses' }) %>
  <div class="flex-1 flex flex-col h-screen overflow-y-auto">
    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search courses' }) %>
    <div class="p-8 max-w-5xl mx-auto w-full pb-20">
      
      <!-- HEADER -->
      <div class="mb-8 text-center md:text-left flex justify-between items-center">
        <div>
          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Curriculum Builder</h1>
          <p class="text-gray-500 mt-2 text-sm">Organize modules, lessons, and resources all in one place.</p>
        </div>
        <div>
           <button type="button" onclick="openModulePanel()" class="px-6 py-3 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition flex items-center shadow-lg shadow-blue-200">
             <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
             Add Module
           </button>
        </div>
      </div>

      <!-- FLASH BANNER (for redirect-based messages: course created/updated) -->
      <%- include('../../../partials/admin-banner') %>

      <!-- PROGRESS STEPPER -->
      <div class="mb-12">
        <div class="flex items-center justify-between relative">
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-200 -translate-y-1/2 z-0"></div>
          <div class="absolute top-1/2 left-0 w-1/2 h-0.5 bg-blue-600 -translate-y-1/2 z-0"></div>
          
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-blue-600 border-4 border-white shadow-md flex items-center justify-center text-white font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="absolute top-12 text-xs font-bold text-gray-900 whitespace-nowrap">1. Basic Info</span>
          </div>

          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-4 border-blue-600 shadow-md flex items-center justify-center text-blue-600 font-bold">2</div>
            <span class="absolute top-12 text-xs font-bold text-blue-600 whitespace-nowrap">2. Curriculum</span>
          </div>

          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">3</div>
            <span class="absolute top-12 text-xs font-bold text-gray-400 whitespace-nowrap">3. Publish</span>
          </div>
        </div>
      </div>

      <!-- CURRICULUM ACCORDION -->
      <div class="space-y-6 mb-12">
        <% if(modules.length > 0){ %>
          <% modules.forEach((module, mIdx) => { %>
            <!-- MODULE CARD -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden transition-all hover:shadow-md module-card" data-module-id="<%= module._id %>">
              <div class="p-5 bg-gray-50 flex items-center justify-between border-b border-gray-200 cursor-pointer module-header" onclick="toggleAccordion('module-<%= module._id %>-content', this)">
                <div class="flex items-center space-x-4">
                  <div class="p-2 bg-white rounded shadow-sm border border-gray-100 text-gray-500">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-extrabold text-gray-900">Module <%= mIdx + 1 %>: <%= module.title %></h3>
                    <% if(module.description) { %><p class="text-sm text-gray-500"><%= module.description %></p><% } %>
                  </div>
                </div>
                <div class="flex items-center space-x-3">
                  <span class="text-xs font-bold text-gray-400 bg-gray-200/50 px-3 py-1 rounded-full"><%= lessons.filter(l => l.moduleId.toString() === module._id.toString()).length %> Lessons</span>
                  <button type="button" 
                    data-id="<%= module._id %>" 
                    data-title="<%= module.title %>" 
                    data-desc="<%= module.description || '' %>" 
                    onclick="event.stopPropagation(); openModulePanel(this.dataset.id, this.dataset.title, this.dataset.desc)" 
                    class="p-2 text-gray-400 hover:text-blue-600 transition-colors bg-white rounded border border-gray-100 shadow-sm" title="Edit Module"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg></button>
                  <button type="button" onclick="event.stopPropagation(); deleteModule('<%= module._id %>', '<%= module.title.replace(/'/g, "'") %>')" class="p-2 text-gray-400 hover:text-red-600 transition-colors bg-white rounded border border-gray-100 shadow-sm" title="Delete Module"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                  <svg class="w-6 h-6 text-gray-400 transform transition-transform duration-300 accordion-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
              </div>
              
              <!-- LESSONS LIST -->
              <div id="module-<%= module._id %>-content" class="hidden p-6 space-y-4 bg-white transition-all duration-300">
                <% const moduleLessons = lessons.filter(l => l.moduleId.toString() === module._id.toString()); %>
                <% if(moduleLessons.length > 0) { %>
                  <% moduleLessons.forEach((lesson, lIdx) => { %>
                    <div class="border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:border-blue-200 transition-all lesson-card">
                      <!-- LESSON HEADER -->
                      <div class="bg-gray-50/50 p-4 flex items-center justify-between cursor-pointer" onclick="toggleAccordion('lesson-<%= lesson._id %>-resources', this)">
                        <div class="flex items-center space-x-4">
                          <div class="p-2 bg-blue-100 text-blue-600 rounded-full shadow-inner"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
                          <div>
                            <h4 class="font-bold text-gray-900">Lesson <%= lIdx + 1 %>: <%= lesson.title %></h4>
                          </div>
                        </div>
                        
                        <div class="flex items-center space-x-3">
                          <button type="button" 
                            data-module-id="<%= module._id %>" 
                            data-id="<%= lesson._id %>" 
                            data-title="<%= lesson.title %>" 
                            data-desc="<%= lesson.description || '' %>" 
                            data-duration="<%= lesson.duration || '' %>" 
                            data-video="<%= lesson.video || '' %>" 
                            onclick="event.stopPropagation(); openLessonPanel(this.dataset.moduleId, this.dataset.id, this.dataset.title, this.dataset.desc, this.dataset.duration, this.dataset.video)" 
                            class="p-2 text-gray-400 hover:text-blue-600 transition-colors bg-white rounded border border-gray-100 shadow-sm" title="Edit Lesson"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg></button>
                          <button type="button" onclick="event.stopPropagation(); deleteLesson('<%= module._id %>', '<%= lesson._id %>', '<%= lesson.title.replace(/'/g, "'") %>')" class="p-2 text-gray-400 hover:text-red-600 transition-colors bg-white rounded border border-gray-100 shadow-sm" title="Delete Lesson"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                          <svg class="w-5 h-5 text-gray-400 transform transition-transform duration-300 accordion-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </div>
                      </div>
                      <!-- RESOURCES SECTION -->
                      <% const lessonResource = resources.find(r => r.lessonId.toString() === lesson._id.toString()); %>
                      <div id="lesson-<%= lesson._id %>-resources" class="hidden p-5 border-t border-gray-100 bg-white">
                        <div class="flex justify-between items-center mb-4 border-b border-gray-100 pb-3">
                          <h5 class="font-bold text-sm text-gray-700">Lesson Resources</h5>
                          <button type="button" onclick="openResourcePanel('<%= module._id %>', '<%= lesson._id %>')" class="text-xs font-bold bg-blue-50 text-blue-600 hover:bg-blue-100 px-3 py-1.5 rounded-lg transition-colors flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                            Add Resource
                          </button>
                        </div>
                        
                        <!-- Video Preview -->
                        <% if (lesson.video) { %>
                          <div class="mb-6">
                            <h5 class="font-bold text-xs text-gray-500 uppercase tracking-widest mb-3">Lesson Video</h5>
                            <video src="<%= lesson.video %>" controls class="w-full rounded-xl border border-gray-200 shadow-sm bg-black" style="max-height: 350px; object-fit: contain;"></video>
                          </div>
                        <% } %>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                          <!-- Files -->
                          <div>
                            <h5 class="font-bold text-xs text-gray-500 uppercase tracking-widest mb-3">Materials</h5>
                            <div class="space-y-2">
                              <% if (lessonResource && lessonResource.files && lessonResource.files.length > 0) { %>
                                <% lessonResource.files.forEach(file => { %>
                                  <div class="flex items-center justify-between p-2.5 bg-gray-50 rounded-lg border border-gray-100 text-sm hover:border-blue-200 transition-colors group">
                                    <div class="flex items-center space-x-3 overflow-hidden">
                                      <div class="p-1.5 bg-blue-100 text-blue-600 rounded">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                      </div>
                                      <a href="<%= file.path %>" target="_blank" class="font-bold text-gray-700 hover:text-blue-600 truncate"><%= file.name %></a>
                                    </div>
                                    <button type="button" onclick="deleteResourceFile('<%= module._id %>', '<%= lesson._id %>', '<%= file._id %>', '<%= file.name.replace(/'/g, "\\'") %>')" class="text-gray-400 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-opacity p-1" title="Delete File"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                                  </div>
                                <% }) %>
                              <% } else { %>
                                <p class="text-xs text-gray-400 italic bg-gray-50/50 p-3 rounded-lg border border-dashed border-gray-200">No files uploaded.</p>
                              <% } %>
                            </div>
                          </div>
                          <!-- Links -->
                          <div>
                            <h5 class="font-bold text-xs text-gray-500 uppercase tracking-widest mb-3">Links</h5>
                            <div class="space-y-2">
                              <% if (lessonResource && lessonResource.links && lessonResource.links.length > 0) { %>
                                <% lessonResource.links.forEach(link => { %>
                                  <div class="flex items-center justify-between p-2.5 bg-gray-50 rounded-lg border border-gray-100 text-sm hover:border-blue-200 transition-colors group">
                                    <div class="flex items-center space-x-3 overflow-hidden">
                                      <div class="p-1.5 bg-purple-100 text-purple-600 rounded">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                                      </div>
                                      <a href="<%= link.url %>" target="_blank" class="font-bold text-gray-700 hover:text-blue-600 truncate"><%= link.title %></a>
                                    </div>
                                    <button type="button" onclick="deleteResourceLink('<%= module._id %>', '<%= lesson._id %>', '<%= link._id %>', '<%= link.title.replace(/'/g, "\\'") %>')" class="text-gray-400 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-opacity p-1" title="Delete Link"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                                  </div>
                                <% }) %>
                              <% } else { %>
                                <p class="text-xs text-gray-400 italic bg-gray-50/50 p-3 rounded-lg border border-dashed border-gray-200">No external links added.</p>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="text-center py-6 bg-gray-50/50 rounded-xl border-2 border-dashed border-gray-200">
                    <p class="text-sm text-gray-400 mb-2">No lessons added yet.</p>
                  </div>
                <% } %>
                <button type="button" onclick="openLessonPanel('<%= module._id %>')" class="w-full py-4 mt-2 border-2 border-dashed border-blue-200 rounded-xl text-blue-600 font-bold text-sm hover:bg-blue-50/50 transition-all flex items-center justify-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                  Add New Lesson
                </button>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="bg-white rounded-2xl border-2 border-dashed border-gray-200 p-16 flex flex-col items-center justify-center text-center">
            <div class="p-4 bg-gray-50 text-gray-400 rounded-full mb-4">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
            <h4 class="text-2xl font-bold text-gray-900 mb-2">No Modules Yet</h4>
            <p class="text-gray-500 text-sm mb-6 max-w-sm">Start building your course curriculum by adding your first module.</p>
            <button type="button" onclick="openModulePanel()" class="px-8 py-3 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition flex items-center shadow-lg shadow-blue-200">
              Create Module
            </button>
          </div>
        <% } %>
      </div>

      <!-- FOOTER ACTIONS -->
      <div class="flex items-center justify-between pt-6 border-t border-gray-200 mt-auto">
        <a href="/admin/courses/<%= course._id %>/edit" class="flex items-center text-sm font-bold text-gray-500 hover:text-gray-900 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"></path></svg>
          Back to Basic Info
        </a>
        <div class="flex items-center space-x-4">
          <a href="/admin/courses" class="px-8 py-3.5 border border-gray-200 text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition">Save Draft</a>
          <a href="/admin/courses/<%= course._id %>/publish" class="px-8 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition flex items-center shadow-lg shadow-blue-200">
            Continue to Publish
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- SLIDE-OVER PANELS -->

<!-- Shared Backdrop -->
<div id="slideOverBackdrop" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 9998; opacity: 0; pointer-events: none; transition: opacity 0.3s ease-in-out;" onclick="closeActivePanel()"></div>

<!-- Module Panel -->
<div id="modulePanel" style="position: fixed; top: 0; bottom: 0; right: 0; z-index: 9999; width: 100%; max-width: 450px; background: white; box-shadow: -10px 0 25px rgba(0,0,0,0.1); display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);">
  <div class="flex h-full w-full flex-col bg-white md:rounded-l-3xl">
    <!-- Header -->
    <div class="px-6 py-6 border-b border-gray-100 flex items-center justify-between sticky top-0 bg-white/95 backdrop-blur z-10 md:rounded-tl-3xl">
      <h2 class="text-xl font-bold text-gray-900" id="modulePanelTitle">Add Module</h2>
      <button type="button" onclick="closeActivePanel()" class="text-gray-400 hover:text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-full p-2 transition">
         <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <!-- Body -->
    <div class="flex-1 overflow-y-auto px-6 py-8">
      <form id="moduleForm" onsubmit="submitModule(event)" class="space-y-6">
        <input type="hidden" id="moduleIdInput" name="moduleId">
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Module Title</label>
          <input type="text" id="moduleTitleInput" name="title" oninput="markDirty(); clearError('moduleTitleError')" class="w-full px-5 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none" placeholder="e.g. Introduction to HTML">
          <p id="moduleTitleError" style="display:none; margin-top:6px; font-size:12px; color:#ef4444; font-weight:600;"></p>
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Description</label>
          <textarea id="moduleDescInput" name="description" rows="4" oninput="markDirty(); clearError('moduleDescError')" class="w-full px-5 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none resize-none" placeholder="Briefly describe what this module covers..."></textarea>
          <p id="moduleDescError" style="display:none; margin-top:6px; font-size:12px; color:#ef4444; font-weight:600;"></p>
        </div>
        <!-- Hidden Submit Button to catch Enter key -->
        <button type="submit" class="hidden">Submit</button>
      </form>
    </div>
    <!-- Footer -->
    <div class="px-6 py-5 border-t border-gray-100 bg-white md:rounded-bl-3xl sticky bottom-0 z-10 flex items-center space-x-4">
       <button type="button" onclick="closeActivePanel()" class="px-6 py-4 border border-gray-200 bg-white text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition w-1/3 text-center">Cancel</button>
      <button
  type="button"
  id="saveModuleBtn"
  onclick="document.getElementById('moduleForm').requestSubmit()"
  class="px-6 py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-200 text-center"
>
  Save Module
</button>
    </div>
  </div>
</div>

<!-- Lesson Panel -->
<div id="lessonPanel" style="position: fixed; top: 0; bottom: 0; right: 0; z-index: 9999; width: 100%; max-width: 450px; background: white; box-shadow: -10px 0 25px rgba(0,0,0,0.1); display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);">
  <div class="flex h-full w-full flex-col bg-white md:rounded-l-3xl">
    <div class="px-6 py-6 border-b border-gray-100 flex items-center justify-between sticky top-0 bg-white/95 backdrop-blur z-10 md:rounded-tl-3xl">
      <h2 class="text-xl font-bold text-gray-900" id="lessonPanelTitle">Add Lesson</h2>
      <button type="button" onclick="closeActivePanel()" class="text-gray-400 hover:text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-full p-2 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto px-6 py-8">
      <form id="lessonForm" onsubmit="submitLesson(event)" class="space-y-6">
        <input type="hidden" id="lessonModuleIdInput" name="moduleId">
        <input type="hidden" id="lessonIdInput" name="lessonId">
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Lesson Title</label>
          <input type="text" id="lessonTitleInput" name="title" oninput="markDirty(); clearError('lessonTitleError')" class="w-full px-5 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none" placeholder="e.g. Setting up your environment">
          <p id="lessonTitleError" style="display:none; margin-top:6px; font-size:12px; color:#ef4444; font-weight:600;"></p>
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Description</label>
          <textarea id="lessonDescInput" name="description" rows="4" oninput="markDirty(); clearError('lessonDescError')" class="w-full px-5 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none resize-none" placeholder="Describe the lesson content..."></textarea>
          <p id="lessonDescError" style="display:none; margin-top:6px; font-size:12px; color:#ef4444; font-weight:600;"></p>
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Duration (minutes)</label>
          <input type="number" step="any" id="lessonDurationInput" name="duration" oninput="markDirty(); clearError('lessonDurationError')" class="w-full px-5 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none" placeholder="e.g. 15">
          <p id="lessonDurationError" style="display:none; margin-top:6px; font-size:12px; color:#ef4444; font-weight:600;"></p>
        </div>
        <div>
          <div class="flex justify-between items-end mb-2">
            <label id="lessonVideoLabel" class="block text-xs font-bold text-gray-500 uppercase tracking-widest">Video *</label>
            <span id="currentLessonVideo" class="text-xs font-bold text-blue-600 hidden"></span>
          </div>
          <input type="file" id="lessonVideoInput" name="video" accept="video/mp4,video/quicktime" onchange="handleLessonVideoPreview(this); markDirty(); clearError('lessonVideoError')" class="w-full px-5 py-3 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 text-sm focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none">
          <p id="lessonVideoError" style="display:none; margin-top:6px; font-size:12px; color:#ef4444; font-weight:600;"></p>
          <video id="lessonVideoPreview" controls class="hidden w-full mt-3 rounded-xl border border-gray-200" style="max-height: 220px; object-fit: contain; background: #000;"></video>
          <p class="text-[10px] text-gray-400 mt-2">MP4 or MOV, max 500MB</p>
        </div>
        <button type="submit" class="hidden">Submit</button>
      </form>
    </div>
    <div class="px-6 py-5 border-t border-gray-100 bg-white md:rounded-bl-3xl sticky bottom-0 z-10 flex items-center space-x-4">
       <button type="button" onclick="closeActivePanel()" class="px-6 py-4 border border-gray-200 bg-white text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition w-1/3 text-center">Cancel</button>
<button
  type="button"
  id="saveLessonBtn"
  onclick="document.getElementById('lessonForm').requestSubmit()"
  class="px-6 py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-200 text-center"
>
  Save Lesson
</button>
    </div>
  </div>
</div>

<!-- Resource Panel (Unified File & Link) -->
<div id="resourcePanel" style="position: fixed; top: 0; bottom: 0; right: 0; z-index: 9999; width: 100%; max-width: 450px; background: white; box-shadow: -10px 0 25px rgba(0,0,0,0.1); display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);">
  <div class="flex h-full w-full flex-col bg-white md:rounded-l-3xl">
    <div class="px-6 py-6 border-b border-gray-100 flex items-center justify-between sticky top-0 bg-white/95 backdrop-blur z-10 md:rounded-tl-3xl">
      <h2 class="text-xl font-bold text-gray-900">Add Resource</h2>
      <button type="button" onclick="closeActivePanel()" class="text-gray-400 hover:text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-full p-2 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    
    <!-- Resource Type Selector -->
    <div class="px-6 py-5 border-b border-gray-100 bg-gray-50/30">
       <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-3">Resource Type</label>
       <div class="flex space-x-3 bg-gray-100/80 p-1.5 rounded-xl border border-gray-200/50">
         <button type="button" id="typeFileBtn" onclick="setResourceType('file')" class="flex-1 px-4 py-2 text-sm font-bold rounded-lg bg-white shadow-sm border border-gray-200 text-blue-600 transition-all">File Upload</button>
         <button type="button" id="typeLinkBtn" onclick="setResourceType('link')" class="flex-1 px-4 py-2 text-sm font-bold rounded-lg text-gray-500 hover:text-gray-700 transition-all">External Link</button>
       </div>
    </div>

    <div class="flex-1 overflow-y-auto px-6 py-8">
       <!-- File Form -->
       <form id="fileForm" onsubmit="submitFileResource(event)" class="space-y-6 block">
          <input type="hidden" id="fileModuleIdInput">
          <input type="hidden" id="fileLessonIdInput">
          
          <div id="dropZone" class="border-2 border-dashed border-gray-200 rounded-2xl p-10 text-center hover:border-blue-400 hover:bg-blue-50 transition cursor-pointer group" onclick="document.getElementById('realFileInput').click()">
             <div class="w-16 h-16 mx-auto bg-blue-50 text-blue-500 rounded-full flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
               <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
             </div>
             <p class="text-sm font-bold text-gray-700 mb-1">Click to upload or drag & drop</p>
             <p class="text-xs text-gray-400">PDF, ZIP, DOCX, up to 50MB</p>
             <input type="file" id="realFileInput" class="hidden" onchange="handleFileSelect(this)">
          </div>
          
          <div id="filePreview" class="hidden p-4 bg-gray-50 rounded-xl border border-gray-200 flex items-center justify-between shadow-sm">
             <div class="flex items-center space-x-3 overflow-hidden">
                <div class="p-2 bg-white rounded-lg shadow-sm text-blue-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg></div>
                <span id="fileNameDisplay" class="text-sm font-bold text-gray-700 truncate max-w-[200px]"></span>
             </div>
             <button type="button" onclick="clearFileSelection(event)" class="text-gray-400 hover:text-red-500 p-2 bg-white rounded-lg shadow-sm">
               <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
             </button>
          </div>
          <button type="submit" class="hidden">Submit</button>
       </form>
       
       <!-- Link Form -->
       <form id="linkForm" onsubmit="submitLinkResource(event)" class="space-y-6 hidden">
          <input type="hidden" id="linkModuleIdInput">
          <input type="hidden" id="linkLessonIdInput">
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Title</label>
            <input type="text" id="linkTitleInput" oninput="markDirty(); clearError('linkTitleError')" class="w-full px-5 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none" placeholder="e.g. Figma UI Kit">
            <p id="linkTitleError" style="display:none; margin-top:6px; font-size:12px; color:#ef4444; font-weight:600;"></p>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">URL</label>
            <input type="text" id="linkUrlInput" oninput="markDirty(); clearError('linkUrlError')" class="w-full px-5 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none" placeholder="https://">
            <p id="linkUrlError" style="display:none; margin-top:6px; font-size:12px; color:#ef4444; font-weight:600;"></p>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Description (Optional)</label>
            <textarea id="linkDescInput" rows="4" oninput="markDirty()" class="w-full px-5 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none resize-none" placeholder="Explain what this link is for..."></textarea>
          </div>
          <button type="submit" class="hidden">Submit</button>
       </form>
    </div>
    
    <div class="px-6 py-5 border-t border-gray-100 bg-white md:rounded-bl-3xl sticky bottom-0 z-10 flex items-center space-x-4">
       <button type="button" onclick="closeActivePanel()" class="px-6 py-4 border border-gray-200 bg-white text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition w-1/3 text-center">Cancel</button>
<button
  type="button"
  onclick="submitActiveResourceForm()"
  class="px-6 py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-200 text-center"
  id="saveResourceBtn"
>
  Save Resource
</button>
    </div>
  </div>
</div>

<div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2"></div>

<script>
  const courseId = '<%= course._id %>';

  // --- Accordion Logic ---
  function toggleAccordion(contentId, headerEl) {
    const content = document.getElementById(contentId);
    const icon = headerEl.querySelector('.accordion-icon');
    if (content.classList.contains('hidden')) {
      content.classList.remove('hidden');
      if(icon) icon.classList.add('rotate-180');
    } else {
      content.classList.add('hidden');
      if(icon) icon.classList.remove('rotate-180');
    }
  }

  // --- Slide-Over Panel Logic (Unified) ---
  let activePanel = null;
  let isFormDirty = false;

  function markDirty() {
    isFormDirty = true;
  }

  function showFieldError(id, msg) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    // Highlight the associated input border red
    const input = el.previousElementSibling;
    if (input) input.style.borderColor = '#ef4444';
  }

  function clearError(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = '';
    el.style.display = 'none';
    const input = el.previousElementSibling;
    if (input) input.style.borderColor = '';
  }

  function clearAllErrors(...ids) {
    ids.forEach(clearError);
  }

  function openPanel(panelId) {
    try {
      isFormDirty = false; // reset on open
      activePanel = panelId;
      
      const backdrop = document.getElementById('slideOverBackdrop');
      const panel = document.getElementById(panelId);
      
      if (!backdrop || !panel) {
        Swal.fire({ text: "Could not find panel elements in DOM!", icon: "error" });
        return;
      }
      
      // Prevent body scroll
      document.body.style.overflow = 'hidden';
      
      // Toggle visibility using inline CSS animations to bypass Tailwind JIT cache
      backdrop.style.pointerEvents = 'auto';
      backdrop.style.opacity = '1';
      panel.style.transform = 'translateX(0)';
      
      // Safety scroll to top
      window.scrollTo(0, 0);
    } catch (err) {
      Swal.fire({ text: "Error opening panel: " + err.message, icon: "error" });
    }
  }

  function closeActivePanel() {
    if (!activePanel) return;
    
    if (isFormDirty) {
      openConfirmModal({
        title: 'Discard Changes?',
        message: 'You have unsaved changes. Are you sure you want to discard them?',
        onConfirm: function () {
          _doPanelClose();
        }
      });
      return;
    }
    
    _doPanelClose();
  }

  function _doPanelClose() {
    isFormDirty = false;
    const backdrop = document.getElementById('slideOverBackdrop');
    const panel = document.getElementById(activePanel);
    
    backdrop.style.opacity = '0';
    backdrop.style.pointerEvents = 'none';
    panel.style.transform = 'translateX(100%)';
    
    document.body.style.overflow = ''; // restore body scroll
    activePanel = null;
    isFormDirty = false;
  }

  // Close on ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && activePanel) {
      closeActivePanel();
    }
  });


  // --- Module Panel Setup ---
  function openModulePanel(id = '', title = '', desc = '') {
    document.getElementById('moduleIdInput').value = id;
    document.getElementById('moduleTitleInput').value = title;
    document.getElementById('moduleDescInput').value = desc;
    document.getElementById('modulePanelTitle').innerText = id ? 'Edit Module' : 'Add Module';
    document.getElementById('saveModuleBtn').innerText = id ? 'Update Module' : 'Save Module';
    
    openPanel('modulePanel');
  }

  let isSubmittingModule = false;
  function submitModule(e) {
    e.preventDefault();
    if (isSubmittingModule) return;
    clearAllErrors('moduleTitleError', 'moduleDescError');

    const title = document.getElementById('moduleTitleInput').value.trim();
    const description = document.getElementById('moduleDescInput').value.trim();
    let valid = true;

    if (!title) {
      showFieldError('moduleTitleError', 'Module title is required.');
      valid = false;
    } else if (title.length < 3) {
      showFieldError('moduleTitleError', 'Title must be at least 3 characters.');
      valid = false;
    }

    if (!description) {
      showFieldError('moduleDescError', 'Description is required.');
      valid = false;
    } else if (description.length < 10) {
      showFieldError('moduleDescError', 'Description must be at least 10 characters.');
      valid = false;
    }

    if (!valid) return;

    isSubmittingModule = true;
    const btn = document.getElementById('saveModuleBtn');
    const originalText = btn ? btn.innerText : 'Save Module';
    if (btn) {
      btn.innerText = 'Saving...';
      btn.disabled = true;
      btn.classList.add('opacity-50', 'cursor-not-allowed');
    }

    const id = document.getElementById('moduleIdInput').value;
    const isEdit = !!id;
    const url = isEdit
      ? `/api/v1/admin/courses/${courseId}/modules/${id}`
      : `/api/v1/admin/courses/${courseId}/modules`;
    const method = isEdit ? "PATCH" : "POST";

    fetch(url, {
      method: method,
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ title, description })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        isFormDirty = false;
        const msg = id ? "Module '" + title + "' updated successfully" : "Module '" + title + "' added successfully";
        window.location.href = window.location.pathname + '?flashType=success&flashMsg=' + encodeURIComponent(msg);
      } else {
        isSubmittingModule = false;
        if (btn) {
          btn.innerText = originalText;
          btn.disabled = false;
          btn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
        showToast(data.error || "Failed to " + (id ? "update" : "create") + " module '" + title + "'", 'error');
      }
    })
    .catch(err => {
      console.error(err);
      isSubmittingModule = false;
      if (btn) {
        btn.innerText = originalText;
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
      showToast('Error saving module', 'error');
    });
  }

  function deleteModule(moduleId, moduleTitle) {
    openConfirmModal({
      title: 'Delete Module?',
      message: "Delete '" + (moduleTitle || 'this module') + "' and all its lessons and resources? This cannot be undone.",
      onConfirm: function () { _doDeleteModule(moduleId, moduleTitle); }
    });
  }

  function _doDeleteModule(moduleId, moduleTitle) {
    fetch(`/api/v1/admin/courses/${courseId}/modules/${moduleId}`, {
      method: 'DELETE',
      headers: { 'Accept': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        const msg = "Module '" + (moduleTitle || 'Module') + "' deleted successfully";
        window.location.href = window.location.pathname + '?flashType=success&flashMsg=' + encodeURIComponent(msg);
      } else {
        showToast("Failed to delete module '" + (moduleTitle || 'Module') + "'", 'error');
      }
    });
  }

  // --- Lesson Panel Setup ---
  function handleLessonVideoPreview(input) {
    const preview = document.getElementById('lessonVideoPreview');
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const validTypes = ['video/mp4', 'video/quicktime'];
      
      if (validTypes.includes(file.type) || file.name.toLowerCase().endsWith('.mp4') || file.name.toLowerCase().endsWith('.mov')) {
        const url = URL.createObjectURL(file);
        preview.src = url;
        preview.classList.remove('hidden');
      } else {
        preview.src = '';
        preview.classList.add('hidden');
        showFieldError('lessonVideoError', 'Invalid video file. Only MP4 and MOV are allowed.');
        input.value = ''; // clear invalid file
      }
    } else {
      if (preview.dataset.originalSrc) {
        preview.src = preview.dataset.originalSrc;
        preview.classList.remove('hidden');
      } else {
        preview.src = '';
        preview.classList.add('hidden');
      }
    }
  }

  function openLessonPanel(moduleId, lessonId = '', title = '', desc = '', duration = '', video = '') {
    document.getElementById('lessonModuleIdInput').value = moduleId;
    document.getElementById('lessonIdInput').value = lessonId;
    document.getElementById('lessonTitleInput').value = title;
    document.getElementById('lessonDescInput').value = desc;
    document.getElementById('lessonDurationInput').value = duration;
    document.getElementById('lessonPanelTitle').innerText = lessonId ? 'Edit Lesson' : 'Add Lesson';
    document.getElementById('saveLessonBtn').innerText = lessonId ? 'Update Lesson' : 'Save Lesson';
    
    // Clear video input
    document.getElementById('lessonVideoInput').value = '';
    
    const videoLabel = document.getElementById('lessonVideoLabel');
    const currentVideo = document.getElementById('currentLessonVideo');
    const videoPreview = document.getElementById('lessonVideoPreview');
    
    if (lessonId && video) {
      videoLabel.innerText = "Video (Optional, upload to replace)";
      const fileName = video.split('/').pop();
      currentVideo.innerText = "Current: " + fileName;
      currentVideo.style.display = 'block';
      
      videoPreview.src = video;
      videoPreview.classList.remove('hidden');
      videoPreview.dataset.originalSrc = video;
    } else {
      videoLabel.innerText = "Video *";
      currentVideo.style.display = 'none';
      
      videoPreview.src = '';
      videoPreview.classList.add('hidden');
      videoPreview.dataset.originalSrc = '';
    }

    // Clear all errors on open
    clearAllErrors('lessonTitleError', 'lessonDescError', 'lessonDurationError', 'lessonVideoError');
    openPanel('lessonPanel');
  }

  let isSubmittingLesson = false;
  function submitLesson(e) {
    e.preventDefault();
    if (isSubmittingLesson) return;
    clearAllErrors('lessonTitleError', 'lessonDescError', 'lessonDurationError', 'lessonVideoError');

    const lessonId = document.getElementById('lessonIdInput').value;
    const isEdit = !!lessonId;
    const title = document.getElementById('lessonTitleInput').value.trim();
    const description = document.getElementById('lessonDescInput').value.trim();
    const duration = document.getElementById('lessonDurationInput').value.trim();
    const videoFile = document.getElementById('lessonVideoInput').files[0];
    let valid = true;

    if (!title) {
      showFieldError('lessonTitleError', 'Lesson title is required.');
      valid = false;
    } else if (title.length < 3) {
      showFieldError('lessonTitleError', 'Title must be at least 3 characters.');
      valid = false;
    }

    if (!description) {
      showFieldError('lessonDescError', 'Description is required.');
      valid = false;
    } else if (description.length < 10) {
      showFieldError('lessonDescError', 'Description must be at least 10 characters.');
      valid = false;
    }

    if (!duration) {
      showFieldError('lessonDurationError', 'Duration is required.');
      valid = false;
    } else if (parseInt(duration) < 1 || parseInt(duration) > 600) {
      showFieldError('lessonDurationError', 'Duration must be between 1 and 600 minutes.');
      valid = false;
    }

    // Video required only for new lessons
    if (!videoFile && !lessonId) {
      showFieldError('lessonVideoError', 'Please upload a video for this lesson.');
      valid = false;
    }

    if (!valid) return;

    isSubmittingLesson = true;
    const btn = document.getElementById('saveLessonBtn');
    const originalText = btn ? btn.innerText : 'Save Lesson';
    if (btn) {
      btn.innerText = 'Saving...';
      btn.disabled = true;
      btn.classList.add('opacity-50', 'cursor-not-allowed');
    }

    const moduleId = document.getElementById('lessonModuleIdInput').value;
    const form = document.getElementById('lessonForm');
    const formData = new FormData(form);

    const url = isEdit
      ? `/api/v1/admin/courses/${courseId}/modules/${moduleId}/lessons/${lessonId}`
      : `/api/v1/admin/courses/${courseId}/modules/${moduleId}/lessons`;
    const method = isEdit ? "PATCH" : "POST";

    fetch(url, {
      method: method,
      headers: { 'Accept': 'application/json' },
      body: formData
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        isFormDirty = false;
        const lessonTitle = document.getElementById('lessonTitleInput') ? document.getElementById('lessonTitleInput').value.trim() : 'Lesson';
        const msg = lessonId ? "Lesson '" + lessonTitle + "' updated successfully" : "Lesson '" + lessonTitle + "' added successfully";
        window.location.href = window.location.pathname + '?flashType=success&flashMsg=' + encodeURIComponent(msg);
      } else {
        isSubmittingLesson = false;
        if (btn) {
          btn.innerText = originalText;
          btn.disabled = false;
          btn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
        if (data.errors && Object.keys(data.errors).length > 0) {
          if (data.errors.title) showFieldError('lessonTitleError', data.errors.title);
          if (data.errors.description) showFieldError('lessonDescError', data.errors.description);
          if (data.errors.duration) showFieldError('lessonDurationError', data.errors.duration);
          if (data.errors.video) showFieldError('lessonVideoError', data.errors.video);
        } else {
          const lessonTitle = document.getElementById('lessonTitleInput') ? document.getElementById('lessonTitleInput').value.trim() : 'Lesson';
          showToast(data.error || "Failed to " + (lessonId ? "update" : "create") + " lesson '" + lessonTitle + "'", 'error');
        }
      }
    })
    .catch(err => {
      console.error(err);
      isSubmittingLesson = false;
      if (btn) {
        btn.innerText = originalText;
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
      showToast('Error saving lesson', 'error');
    });
  }

  function deleteLesson(moduleId, lessonId, lessonTitle) {
    openConfirmModal({
      title: 'Delete Lesson?',
      message: "Delete '" + (lessonTitle || 'this lesson') + "'? This cannot be undone.",
      onConfirm: function () { _doDeleteLesson(moduleId, lessonId, lessonTitle); }
    });
  }

  function _doDeleteLesson(moduleId, lessonId, lessonTitle) {
    fetch(`/api/v1/admin/courses/${courseId}/modules/${moduleId}/lessons/${lessonId}`, {
      method: 'DELETE',
      headers: { 'Accept': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        const msg = "Lesson '" + (lessonTitle || 'Lesson') + "' deleted successfully";
        window.location.href = window.location.pathname + '?flashType=success&flashMsg=' + encodeURIComponent(msg);
      } else {
        showToast("Failed to delete lesson '" + (lessonTitle || 'Lesson') + "'", 'error');
      }
    });
  }


  // --- Resource Panel Setup ---
  let activeResourceType = 'file';

  function openResourcePanel(moduleId, lessonId) {
    document.getElementById('fileModuleIdInput').value = moduleId;
    document.getElementById('fileLessonIdInput').value = lessonId;
    
    document.getElementById('linkModuleIdInput').value = moduleId;
    document.getElementById('linkLessonIdInput').value = lessonId;
    
    // Reset forms
    document.getElementById('realFileInput').value = '';
    clearFileSelection(new Event('click')); // clear preview
    
    document.getElementById('linkTitleInput').value = '';
    document.getElementById('linkUrlInput').value = '';
    document.getElementById('linkDescInput').value = '';
    clearAllErrors('linkTitleError', 'linkUrlError');
    
    setResourceType('file'); // Default to file upload
    openPanel('resourcePanel');
  }

  function setResourceType(type) {
    activeResourceType = type;
    const fileBtn = document.getElementById('typeFileBtn');
    const linkBtn = document.getElementById('typeLinkBtn');
    const fileForm = document.getElementById('fileForm');
    const linkForm = document.getElementById('linkForm');
    const saveBtn = document.getElementById('saveResourceBtn');

    if (type === 'file') {
      // Style active
      fileBtn.className = 'flex-1 px-4 py-2 text-sm font-bold rounded-lg bg-white shadow-sm border border-gray-200 text-blue-600 transition-all';
      linkBtn.className = 'flex-1 px-4 py-2 text-sm font-bold rounded-lg text-gray-500 hover:text-gray-700 transition-all';
      
      // Show/Hide
      fileForm.classList.remove('hidden');
      linkForm.classList.add('hidden');
      
      saveBtn.innerText = 'Upload File';
    } else {
      // Style active
      linkBtn.className = 'flex-1 px-4 py-2 text-sm font-bold rounded-lg bg-white shadow-sm border border-gray-200 text-blue-600 transition-all';
      fileBtn.className = 'flex-1 px-4 py-2 text-sm font-bold rounded-lg text-gray-500 hover:text-gray-700 transition-all';
      
      // Show/Hide
      linkForm.classList.remove('hidden');
      fileForm.classList.add('hidden');
      
      saveBtn.innerText = 'Save Link';
      // Clear any old link errors
      clearAllErrors('linkTitleError', 'linkUrlError');
    }
  }

  function submitActiveResourceForm() {
    if (activeResourceType === 'file') {
      const form = document.getElementById('fileForm');
      if (document.getElementById('realFileInput').files.length === 0) {
        showToast('Please select a file to upload', 'error');
        return;
      }
      form.requestSubmit();
    } else {
      // Custom validation for link form
      clearAllErrors('linkTitleError', 'linkUrlError');
      const title = document.getElementById('linkTitleInput').value.trim();
      const url = document.getElementById('linkUrlInput').value.trim();
      let valid = true;

      if (!title) {
        showFieldError('linkTitleError', 'Link title is required.');
        valid = false;
      } else if (title.length < 2) {
        showFieldError('linkTitleError', 'Title must be at least 2 characters.');
        valid = false;
      }

      if (!url) {
        showFieldError('linkUrlError', 'URL is required.');
        valid = false;
      } else if (!/^https?:\/\//.test(url)) {
        showFieldError('linkUrlError', 'URL must start with http:// or https://');
        valid = false;
      }

      if (!valid) return;
      document.getElementById('linkForm').requestSubmit();
    }
  }

  // File Upload Logic
  function handleFileSelect(inputEl) {
    const file = inputEl.files[0];
    const dropZone = document.getElementById('dropZone');
    const preview = document.getElementById('filePreview');
    const nameDisplay = document.getElementById('fileNameDisplay');
    
    if (file) {
      nameDisplay.innerText = file.name;
      dropZone.classList.add('hidden');
      preview.classList.remove('hidden');
      preview.classList.add('flex');
      markDirty();
    }
  }

  function clearFileSelection(e) {
    e.stopPropagation();
    document.getElementById('realFileInput').value = '';
    document.getElementById('dropZone').classList.remove('hidden');
    document.getElementById('filePreview').classList.add('hidden');
    document.getElementById('filePreview').classList.remove('flex');
    if(activeResourceType === 'file') isFormDirty = false;
  }

  let isSubmittingFileResource = false;
  function submitFileResource(e) {
    e.preventDefault();
    if (isSubmittingFileResource) return;
    
    const moduleId = document.getElementById('fileModuleIdInput').value;
    const lessonId = document.getElementById('fileLessonIdInput').value;
    const inputEl = document.getElementById('realFileInput');
    const file = inputEl.files[0];
    
    if (!file) {
      showToast('Please select a file to upload.', 'warning');
      return;
    }

    isSubmittingFileResource = true;
    const formData = new FormData();
    formData.append('moduleId', moduleId);
    formData.append('lessonId', lessonId);
    formData.append('resourceFile', file);

    const btn = document.getElementById('saveResourceBtn');
    const originalText = btn.innerText;
    btn.innerText = 'Uploading...';
    btn.disabled = true;
    btn.classList.add('opacity-50', 'cursor-not-allowed');

    fetch(`/api/v1/admin/courses/${courseId}/resources/file`, {
      method: 'POST',
      body: formData
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        isFormDirty = false;
        const uploadedFileName = file ? file.name : 'File';
        const msg = "Resource '" + uploadedFileName + "' added successfully";
        window.location.href = window.location.pathname + '?flashType=success&flashMsg=' + encodeURIComponent(msg);
      } else {
        isSubmittingFileResource = false;
        btn.innerText = originalText;
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
        const uploadedFileName = file ? file.name : 'File';
        showToast(data.error || "Failed to add resource '" + uploadedFileName + "'", 'error');
      }
    })
    .catch(err => {
      isSubmittingFileResource = false;
      btn.innerText = originalText;
      btn.disabled = false;
      btn.classList.remove('opacity-50', 'cursor-not-allowed');
      const uploadedFileName = file ? file.name : 'File';
      showToast("Failed to add resource '" + uploadedFileName + "'", 'error');
    });
  }

  function deleteResourceFile(moduleId, lessonId, fileId, fileName) {
    openConfirmModal({
      title: 'Delete File?',
      message: "Delete '" + (fileName || 'this file') + "'? This cannot be undone.",
      onConfirm: function () { _doDeleteResourceFile(moduleId, lessonId, fileId, fileName); }
    });
  }

  function _doDeleteResourceFile(moduleId, lessonId, fileId, fileName) {
    fetch(`/api/v1/admin/courses/${courseId}/resources/file`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ moduleId, lessonId, fileId })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        const msg = "Resource '" + (fileName || 'File') + "' deleted successfully";
        window.location.href = window.location.pathname + '?flashType=success&flashMsg=' + encodeURIComponent(msg);
      } else {
        showToast("Failed to delete resource '" + (fileName || 'File') + "'", 'error');
      }
    })
    .catch(() => {
      showToast("Failed to delete resource '" + (fileName || 'File') + "'", 'error');
    });
  }

  // Link Logic
  let isSubmittingLinkResource = false;
  function submitLinkResource(e) {
    e.preventDefault();
    if (isSubmittingLinkResource) return;
    
    const moduleId = document.getElementById('linkModuleIdInput').value;
    const lessonId = document.getElementById('linkLessonIdInput').value;
    const title = document.getElementById('linkTitleInput').value;
    const url = document.getElementById('linkUrlInput').value;
    const description = document.getElementById('linkDescInput').value;

    isSubmittingLinkResource = true;
    const btn = document.getElementById('saveResourceBtn');
    const originalText = btn ? btn.innerText : 'Save Link';
    if (btn) {
      btn.innerText = 'Saving...';
      btn.disabled = true;
      btn.classList.add('opacity-50', 'cursor-not-allowed');
    }

    fetch(`/api/v1/admin/courses/${courseId}/resources/link`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ moduleId, lessonId, title, url, description })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        isFormDirty = false;
        const msg = "Resource '" + title + "' added successfully";
        window.location.href = window.location.pathname + '?flashType=success&flashMsg=' + encodeURIComponent(msg);
      } else {
        isSubmittingLinkResource = false;
        if (btn) {
          btn.innerText = originalText;
          btn.disabled = false;
          btn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
        showToast(data.error || "Failed to add resource '" + title + "'", 'error');
      }
    })
    .catch(() => {
      isSubmittingLinkResource = false;
      if (btn) {
        btn.innerText = originalText;
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
      showToast("Failed to add resource '" + title + "'", 'error');
    });
  }

  function deleteResourceLink(moduleId, lessonId, linkId, linkTitle) {
    openConfirmModal({
      title: 'Delete Link?',
      message: "Delete '" + (linkTitle || 'this link') + "'? This cannot be undone.",
      onConfirm: function () { _doDeleteResourceLink(moduleId, lessonId, linkId, linkTitle); }
    });
  }

  function _doDeleteResourceLink(moduleId, lessonId, linkId, linkTitle) {
    fetch(`/api/v1/admin/courses/${courseId}/resources/link`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ moduleId, lessonId, linkId })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        const msg = "Resource '" + (linkTitle || 'Link') + "' deleted successfully";
        window.location.href = window.location.pathname + '?flashType=success&flashMsg=' + encodeURIComponent(msg);
      } else {
        showToast("Failed to delete resource '" + (linkTitle || 'Link') + "'", 'error');
      }
    })
    .catch(() => {
      showToast("Failed to delete resource '" + (linkTitle || 'Link') + "'", 'error');
    });
  }

  // Toast Utility
  function showToast(message, type = 'info') {
    const toast = document.createElement('div');
    let colorClass = 'bg-blue-600';
    if (type === 'success') colorClass = 'bg-green-600';
    if (type === 'error') colorClass = 'bg-red-600';
    if (type === 'warning') colorClass = 'bg-yellow-500';

    toast.className = `text-white px-5 py-3 rounded-xl shadow-2xl flex items-center justify-between min-w-[200px] border border-white/10 ${colorClass} transition-all duration-300 animate-bounce`;
    toast.innerHTML = `<span class="text-sm font-bold">${message}</span><button onclick="this.parentElement.remove()" class="ml-4 text-white hover:text-gray-200 text-xs font-black">×</button>`;
    document.getElementById('toastContainer').appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 4000);
  }
</script>

