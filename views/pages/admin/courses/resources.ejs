<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">

  <%- include('../../../partials/admin-sidebar', { activePage: 'courses' }) %>

  <div class="flex-1 flex flex-col h-screen overflow-y-auto">
    
    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search courses' }) %>

    <div class="p-8 max-w-5xl mx-auto w-full">
      <!-- HEADER -->
      <div class="mb-8 text-center md:text-left">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Resources</h1>
        <p class="text-gray-500 mt-2 text-sm">Organize your course into logical modules and lessons.</p>
      </div>

      <!-- PROGRESS STEPPER -->
      <div class="mb-12">
        <div class="flex items-center justify-between relative">
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-200 -translate-y-1/2 z-0"></div>
          <div class="absolute top-1/2 left-0 w-[75%] h-0.5 bg-blue-600 -translate-y-1/2 z-0"></div>
          
          <!-- Step 1-3 (Done) -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-blue-600 border-4 border-white shadow-md flex items-center justify-center text-white font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="absolute top-12 text-xs font-bold text-gray-900 whitespace-nowrap">1. Basic Info</span>
          </div>

          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-blue-600 border-4 border-white shadow-md flex items-center justify-center text-white font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="absolute top-12 text-xs font-bold text-gray-900 whitespace-nowrap">2. Curriculum</span>
          </div>

          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-blue-600 border-4 border-white shadow-md flex items-center justify-center text-white font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="absolute top-12 text-xs font-bold text-gray-900 whitespace-nowrap">3. Lessons</span>
          </div>

          <!-- Step 4 (Active) -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-4 border-blue-600 shadow-md flex items-center justify-center text-blue-600 font-bold">4</div>
            <span class="absolute top-12 text-xs font-bold text-blue-600 whitespace-nowrap">4. Resources</span>
          </div>

          <!-- Step 5 -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-gray-200 flex items-center justify-center text-gray-400 font-bold">5</div>
            <span class="absolute top-12 text-xs font-bold text-gray-400 whitespace-nowrap">5. Publish</span>
          </div>
        </div>
      </div>

      <!-- MODULE & LESSON DROPDOWNS -->
      <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm mb-8">
<% if(errors?.general){ %>

<p class="text-sm text-red-500 mb-4">

  <%= errors.general %>

</p>

<% } %>
        <h2 class="text-xl font-bold text-gray-900 mb-6">Select Module and Lesson</h2>
        <p class="text-sm text-gray-500 mb-6">Choose a specific module and lesson to upload resources and add materials for.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Module</label>
            <div class="relative">
              <select id="moduleSelect" class="w-full px-6 py-4 rounded-xl border border-gray-200 bg-gray-50 text-gray-900 font-medium focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none appearance-none cursor-pointer">
                <% if (modules && modules.length > 0) { %>
                  <% modules.forEach((mod, idx) => { %>
                    <option value="<%= mod._id %>" <%= idx === 0 ? 'selected' : '' %>><%= mod.title %></option>
                  <% }) %>
                <% } else { %>
                  <option value="">-- No Modules Available --</option>
                <% } %>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-gray-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </div>
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Lesson</label>
            <div class="relative">
              <select id="lessonSelect" class="w-full px-6 py-4 rounded-xl border border-gray-200 bg-gray-50 text-gray-900 font-medium focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none appearance-none cursor-pointer">
                <!-- Populated dynamically via JS -->
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-gray-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- MAIN WORKSPACE FOR RESOURCES -->
      <div id="resourcesContainer" class="space-y-8">
        
        <!-- COURSE MATERIALS -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-900">Course Materials</h2>
            <span class="text-xs font-bold text-gray-400 uppercase tracking-widest" id="materialsCount">0 Files</span>
          </div>
          
          <!-- Files List -->
          <div class="space-y-4 mb-6" id="filesListContainer">
            <!-- Dynamically rendered -->
          </div>

          <!-- Upload Trigger Area -->
          <div class="relative">
            <button type="button" onclick="document.getElementById('resourceFileInput').click()" class="w-full py-4 border-2 border-dashed border-gray-200 rounded-xl text-gray-400 font-bold hover:bg-gray-50 hover:border-blue-200 hover:text-blue-600 transition-all flex items-center justify-center cursor-pointer">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
              Add Materials
            </button>
            <input type="file" id="resourceFileInput" class="hidden" onchange="uploadResourceFile()">
          </div>
        </div>

        <!-- SUPPLEMENTARY LINKS -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <h2 class="text-xl font-bold text-gray-900 mb-6">Supplementary Links</h2>
          
          <!-- Links List -->
          <div class="space-y-4 mb-8" id="linksListContainer">
            <!-- Dynamically rendered -->
          </div>

          <!-- Form to add Link -->
          <div class="border-t border-gray-100 pt-6 space-y-6">
            <h3 class="text-md font-bold text-gray-800">Add New Link</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Link Title</label>
                <input type="text" id="newLinkTitle" placeholder="e.g., Figma UI Kit" class="w-full px-6 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none">
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">URL</label>
                <input type="text" id="newLinkUrl" placeholder="https://..." class="w-full px-6 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none">
              </div>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Brief Description</label>
              <input type="text" id="newLinkDesc" placeholder="Describe how this link helps the student..." class="w-full px-6 py-4 rounded-xl border border-gray-200 bg-gray-50/50 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none">
            </div>
            <div class="flex justify-end">
              <button type="button" onclick="addSupplementaryLink()" class="px-6 py-3 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-md">
                Add Supplementary Link
              </button>
            </div>
          </div>
        </div>

        <!-- INSTRUCTOR NOTES -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center space-x-3">
              <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              </div>
              <h2 class="text-xl font-bold text-gray-900">Instructor Notes</h2>
            </div>
            <button type="button" onclick="saveInstructorNotes()" class="inline-flex items-center px-4 py-2 bg-green-600 text-white text-xs font-bold rounded-lg hover:bg-green-700 transition shadow-sm">
              <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
              Save Notes
            </button>
          </div>

          <div class="border border-gray-200 rounded-xl overflow-hidden shadow-inner">
            <div class="bg-gray-50 p-3 border-b border-gray-200 flex items-center space-x-4">
              <button type="button" class="p-1.5 text-gray-400 hover:text-blue-600 transition-colors font-bold">B</button>
              <button type="button" class="p-1.5 text-gray-400 hover:text-blue-600 transition-colors italic font-serif">I</button>
              <button type="button" class="p-1.5 text-gray-400 hover:text-blue-600 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
              </button>
              <button type="button" class="p-1.5 text-gray-400 hover:text-blue-600 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
              </button>
            </div>
            <textarea id="instructorNotesText" rows="6" placeholder="Write additional guidance or context for these resources here..." class="w-full px-6 py-4 bg-gray-50/30 text-gray-900 focus:bg-white focus:ring-2 focus:ring-blue-500 transition-all outline-none resize-none"></textarea>
          </div>
        </div>

      </div>

      <!-- NO CURRICULUM WARNING PLACEHOLDER -->
      <div id="noCurriculumPlaceholder" class="hidden bg-white rounded-2xl border-2 border-dashed border-gray-200 p-12 text-center flex flex-col items-center justify-center shadow-sm">
        <div class="p-4 bg-orange-50 text-orange-500 rounded-2xl mb-4">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Modules Required</h3>
        <p class="text-gray-500 text-sm max-w-md mb-6">You must first create modules and lessons in Step 2 & 3 before you can assign files and supplementary links to specific components.</p>
        <a href="/admin-courses/<%= course._id %>/modules" class="px-8 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition flex items-center shadow-lg shadow-blue-200">
          Go back to Modules
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>

      <!-- ACTIONS -->
      <div class="flex items-center justify-between pt-6 mt-12 border-t border-gray-100">
        <a href="/admin-courses/<%= course._id %>/modules" class="inline-flex items-center text-sm font-bold text-gray-500 hover:text-gray-900 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Back to Modules
        </a>
        <div class="flex items-center space-x-4">
          <a href="/admin-courses" class="px-8 py-3.5 border border-gray-200 text-gray-700 font-bold rounded-xl hover:bg-gray-50 transition">Save Draft</a>
          <a href="/admin-courses/<%= course._id %>/publish" class="px-8 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition flex items-center shadow-lg shadow-blue-200">
            Continue to Publish
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Toasts Container for slick premium notifications -->
<div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2"></div>

<script>
  // Serialize modules and lessons in raw array for instant filtering client-side
  const rawLessons = <%- JSON.stringify(lessons) %>;
  const courseId = '<%= course._id %>';

  const moduleSelect = document.getElementById('moduleSelect');
  const lessonSelect = document.getElementById('lessonSelect');
  const resourcesContainer = document.getElementById('resourcesContainer');
  const noCurriculumPlaceholder = document.getElementById('noCurriculumPlaceholder');
  const filesListContainer = document.getElementById('filesListContainer');
  const linksListContainer = document.getElementById('linksListContainer');
  const instructorNotesText = document.getElementById('instructorNotesText');
  const materialsCount = document.getElementById('materialsCount');

  // Trigger setup on page load
  window.addEventListener('DOMContentLoaded', () => {
    if (!moduleSelect.value) {
      // Toggle warnings if no modules created yet
      resourcesContainer.classList.add('hidden');
      noCurriculumPlaceholder.classList.remove('hidden');
      return;
    }
    
    // Wire up events
    moduleSelect.addEventListener('change', populateLessons);
    lessonSelect.addEventListener('change', fetchLessonResources);
    
    // Initial load
    populateLessons();
  });

  // Filters lessons list client-side based on active module and renders select options
  function populateLessons() {
    const moduleId = moduleSelect.value;
    lessonSelect.innerHTML = '';

    if (!moduleId) return;

    // Filter lessons matching this moduleId
    const lessons = rawLessons.filter(lesson => lesson.moduleId.toString() === moduleId.toString());

    if (lessons.length === 0) {
      lessonSelect.innerHTML = '<option value="">-- No Lessons in Module --</option>';
      filesListContainer.innerHTML = '<p class="text-sm text-gray-400 py-4 text-center">Add lessons in step 2 to assign resources.</p>';
      linksListContainer.innerHTML = '<p class="text-sm text-gray-400 py-4 text-center">Add lessons in step 2 to assign resources.</p>';
      instructorNotesText.value = '';
      materialsCount.innerText = '0 Files';
      return;
    }

    lessons.forEach(lesson => {
      const option = document.createElement('option');
      option.value = lesson._id;
      option.innerText = lesson.title;
      lessonSelect.appendChild(option);
    });

    fetchLessonResources();
  }

  // Dynamic AJAX fetch to load files, links, notes for specific Lesson ID
  function fetchLessonResources() {
    const moduleId = moduleSelect.value;
    const lessonId = lessonSelect.value;

    if (!moduleId || !lessonId) return;

    filesListContainer.innerHTML = '<div class="py-4 text-center"><span class="text-sm text-gray-400 animate-pulse">Loading files...</span></div>';
    linksListContainer.innerHTML = '<div class="py-4 text-center"><span class="text-sm text-gray-400 animate-pulse">Loading links...</span></div>';

    fetch(`/admin-courses/${courseId}/resources/data?moduleId=${moduleId}&lessonId=${lessonId}`)
      .then(res => res.json())
      .then(data => {
        renderFiles(data.files);
        renderLinks(data.links);
        instructorNotesText.value = data.notes || '';
      })
      .catch(err => {
        console.error('Error fetching resources:', err);
        showToast('Error loading resources', 'error');
      });
  }

  // Render file items with appropriate icons (ZIP, PDF, generic)
  function renderFiles(files) {
    filesListContainer.innerHTML = '';
    
    if (!files || files.length === 0) {
      filesListContainer.innerHTML = '<p class="text-sm text-gray-400 py-6 text-center border border-dashed border-gray-100 rounded-xl bg-gray-50/20">No files uploaded for this lesson yet.</p>';
      materialsCount.innerText = '0 Files';
      return;
    }

    materialsCount.innerText = `${files.length} File${files.length > 1 ? 's' : ''}`;

    files.forEach(file => {
      const isPdf = file.name.toLowerCase().endsWith('.pdf');
      const isZip = file.name.toLowerCase().endsWith('.zip') || file.name.toLowerCase().endsWith('.rar');
      
      let iconColor = 'bg-yellow-50 text-yellow-600';
      let iconSvg = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>';
      
      if (isPdf) {
        iconColor = 'bg-red-50 text-red-600';
      } else if (isZip) {
        iconColor = 'bg-blue-50 text-blue-600';
        iconSvg = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>';
      }

      const fileEl = document.createElement('div');
      fileEl.className = 'flex items-center justify-between p-4 bg-gray-50/50 rounded-xl border border-gray-100 hover:border-blue-200 transition-all';
      fileEl.innerHTML = `
        <div class="flex items-center space-x-4">
          <div class="p-3 ${iconColor} rounded-lg">
            ${iconSvg}
          </div>
          <div>
            <a href="${file.path}" target="_blank" class="font-bold text-gray-900 hover:text-blue-600 hover:underline transition-all block max-w-md truncate">${file.name}</a>
            <p class="text-xs text-gray-400 font-medium tracking-tight mt-0.5">${file.size} • Uploaded recently</p>
          </div>
        </div>
        <button type="button" onclick="deleteResourceFile('${file._id}')" class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Delete file">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
        </button>
      `;
      filesListContainer.appendChild(fileEl);
    });
  }

  // Render link list items
  function renderLinks(links) {
    linksListContainer.innerHTML = '';
    
    if (!links || links.length === 0) {
      linksListContainer.innerHTML = '<p class="text-sm text-gray-400 py-6 text-center border border-dashed border-gray-100 rounded-xl bg-gray-50/20">No supplementary links added for this lesson yet.</p>';
      return;
    }

    links.forEach(link => {
      const linkEl = document.createElement('div');
      linkEl.className = 'flex items-start justify-between p-4 bg-gray-50/50 rounded-xl border border-gray-100 hover:border-blue-200 transition-all';
      linkEl.innerHTML = `
        <div class="flex items-start space-x-4">
          <div class="p-3 bg-purple-50 text-purple-600 rounded-lg shrink-0 mt-0.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
          </div>
          <div>
            <a href="${link.url}" target="_blank" class="font-bold text-gray-900 hover:text-blue-600 hover:underline transition-all flex items-center">
              ${link.title}
              <svg class="w-3.5 h-3.5 ml-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
            ${link.description ? `<p class="text-sm text-gray-500 mt-1 font-medium leading-relaxed">${link.description}</p>` : ''}
            <span class="text-xs text-gray-400 block mt-1 break-all select-all font-mono">${link.url}</span>
          </div>
        </div>
        <button type="button" onclick="deleteSupplementaryLink('${link._id}')" class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all shrink-0 ml-4" title="Delete link">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
        </button>
      `;
      linksListContainer.appendChild(linkEl);
    });
  }

  // Upload file asynchronously via AJAX
  function uploadResourceFile() {
    const moduleId = moduleSelect.value;
    const lessonId = lessonSelect.value;
    const fileInput = document.getElementById('resourceFileInput');
    const file = fileInput.files[0];

    if (!file || !moduleId || !lessonId) return;

    const formData = new FormData();
    formData.append('moduleId', moduleId);
    formData.append('lessonId', lessonId);
    formData.append('resourceFile', file);

    showToast('Uploading file...', 'info');

    fetch(`/admin-courses/${courseId}/resources/upload-file`, {
      method: 'POST',
      body: formData
    })
      .then(res => res.json())
      .then(data => {
        if (!data.success) {
          showToast(data.error, 'error');
          return;
        }
        renderFiles(data.files);
        showToast('File uploaded successfully!', 'success');
        fileInput.value = '';
      })
      .catch(err => {
        console.error('Error uploading file:', err);
        showToast('File upload failed', 'error');
        fileInput.value = '';
      });
  }

  // Delete file dynamically via AJAX
  function deleteResourceFile(fileId) {
    if (!confirm('Are you sure you want to delete this file?')) return;

    const moduleId = moduleSelect.value;
    const lessonId = lessonSelect.value;

    fetch(`/admin-courses/${courseId}/resources/delete-file`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ moduleId, lessonId, fileId })
    })
      .then(res => res.json())
      .then(data => {
        if (!data.success) {
          showToast(data.error, 'error');
          return;
        }
        renderFiles(data.files);
        showToast('File deleted successfully!', 'success');
      })
      .catch(err => {
        console.error('Error deleting file:', err);
        showToast('Failed to delete file', 'error');
      });
  }

  // Add supplementary link dynamically via AJAX
  function addSupplementaryLink() {
    const moduleId = moduleSelect.value;
    const lessonId = lessonSelect.value;
    const titleInput = document.getElementById('newLinkTitle');
    const urlInput = document.getElementById('newLinkUrl');
    const descInput = document.getElementById('newLinkDesc');

    const title = titleInput.value.trim();
    const url = urlInput.value.trim();
    const description = descInput.value.trim();

    if (!title || !url) {
      showToast('Please fill out Title and URL', 'warning');
      return;
    }

    if (!moduleId || !lessonId) {
      showToast('Select a module and lesson first', 'warning');
      return;
    }

    fetch(`/admin-courses/${courseId}/resources/add-link`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ moduleId, lessonId, title, url, description })
    })
      .then(res => res.json())
      .then(data => {
        if (!data.success) {
          showToast(data.error, 'error');
          return;
        }
        renderLinks(data.links);
        showToast('Link added successfully!', 'success');
        titleInput.value = '';
        urlInput.value = '';
        descInput.value = '';
      })
      .catch(err => {
        console.error('Error adding link:', err);
        showToast('Failed to add link', 'error');
      });
  }

  // Delete supplementary link dynamically via AJAX
  function deleteSupplementaryLink(linkId) {
    if (!confirm('Are you sure you want to delete this link?')) return;

    const moduleId = moduleSelect.value;
    const lessonId = lessonSelect.value;

    fetch(`/admin-courses/${courseId}/resources/delete-link`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ moduleId, lessonId, linkId })
    })
      .then(res => res.json())
      .then(data => {
        if (!data.success) {
          showToast(data.error, 'error');
          return;
        }
        renderLinks(data.links);
        showToast('Link deleted successfully!', 'success');
      })
      .catch(err => {
        console.error('Error deleting link:', err);
        showToast('Failed to delete link', 'error');
      });
  }

  // Save instructor notes dynamically via AJAX
  function saveInstructorNotes() {
    const moduleId = moduleSelect.value;
    const lessonId = lessonSelect.value;
    const notes = instructorNotesText.value;

    if (!moduleId || !lessonId) {
      showToast('Please select a module and lesson', 'warning');
      return;
    }

    fetch(`/admin-courses/${courseId}/resources/save-notes`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ moduleId, lessonId, notes })
    })
      .then(res => res.json())
      .then(data => {
        if (!data.success) {
          showToast(data.error, 'error');
          return;
        }
        showToast('Notes saved successfully!', 'success');
      })
      .catch(err => {
        console.error('Error saving notes:', err);
        showToast('Failed to save notes', 'error');
      });
  }

  // Premium Slick Toast Notification Utility
  function showToast(message, type = 'info') {
    const toast = document.createElement('div');
    let colorClass = 'bg-blue-600';
    let bgColor = '#2563EB'; // fallback inline color
    
    if (type === 'success') { colorClass = 'bg-green-600'; bgColor = '#16A34A'; }
    if (type === 'error') { colorClass = 'bg-red-600'; bgColor = '#DC2626'; }
    if (type === 'warning') { colorClass = 'bg-yellow-500'; bgColor = '#EAB308'; }

    toast.className = `text-white px-5 py-3 rounded-xl shadow-2xl flex items-center justify-between min-w-[200px] border border-white/10 ${colorClass} transition-all duration-300 animate-bounce`;
    toast.style.backgroundColor = bgColor;
    
    toast.innerHTML = `
      <span class="text-sm font-bold">${message}</span>
      <button onclick="this.parentElement.remove()" class="ml-4 text-white hover:text-gray-200 text-xs font-black">×</button>
    `;
    
    document.getElementById('toastContainer').appendChild(toast);
    
    setTimeout(() => {
      toast.style.opacity = '0';
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }
</script>

