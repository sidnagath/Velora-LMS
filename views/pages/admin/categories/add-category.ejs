<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">

  <%- include('../../../partials/admin-sidebar', { activePage: 'categories' }) %>

  <div class="flex-1 flex flex-col h-screen overflow-y-auto">

    <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search category' }) %>

    <div class="p-8 max-w-3xl mx-auto w-full">

      <!-- HEADER -->
      <div class="mb-8">
        <div class="flex items-center gap-2 text-sm text-gray-400 mb-3">
          <a href="/admin/categories" class="hover:text-blue-600 transition-colors">Category Management</a>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-gray-600 font-medium">Add Category</span>
        </div>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Add New Category</h1>
        <p class="text-gray-500 mt-2 text-sm">Create a new category to organize courses on the platform.</p>
      </div>

      <% if(errors?.general){ %>
      <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-xl text-sm font-medium text-red-600">
        <%= errors.general %>
      </div>
      <% } %>

      <form id="addCategoryForm" method="POST" enctype="multipart/form-data">

        <!-- CATEGORY DETAILS CARD -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm mb-6">
          <div class="flex items-center space-x-3 mb-8">
            <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
            </div>
            <h2 class="text-xl font-bold text-gray-900">Category Details</h2>
          </div>

          <div class="space-y-6">

            <!-- Name -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">
                Category Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                name="name"
                id="categoryName"
                value="<%= formData?.name || '' %>"
                placeholder="e.g. Web Development"
                class="w-full pl-4 pr-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none font-medium text-gray-900 <%= errors?.name ? 'border-red-400 bg-red-50' : '' %>">
              <p id="error-name" class="input-error <%= errors?.name ? '' : 'hidden' %>"><%= errors?.name || '' %></p>
            </div>

            <!-- Description -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">
                Description <span class="text-red-500">*</span>
              </label>
              <textarea
                name="description"
                id="categoryDescription"
                rows="4"
                placeholder="Briefly describe what this category covers..."
                class="w-full pl-4 pr-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none font-medium text-gray-900 resize-none <%= errors?.description ? 'border-red-400 bg-red-50' : '' %>"><%= formData?.description || '' %></textarea>
              <p id="error-description" class="input-error <%= errors?.description ? '' : 'hidden' %>"><%= errors?.description || '' %></p>
            </div>

            <!-- Status -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-3">Status</label>
              <div class="flex items-center space-x-3 p-1 bg-gray-50 rounded-xl w-fit">
                <label class="cursor-pointer">
                  <input type="radio" name="status" value="active" class="sr-only peer"
                    <%= (!formData?.status || formData?.status === 'active') ? 'checked' : '' %>>
                  <div class="px-6 py-2.5 rounded-lg font-bold text-sm transition-all peer-checked:bg-blue-600 peer-checked:text-white peer-checked:shadow-sm text-gray-400 hover:text-gray-600">
                    Active
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="status" value="inactive" class="sr-only peer"
                    <%= formData?.status === 'inactive' ? 'checked' : '' %>>
                  <div class="px-6 py-2.5 rounded-lg font-bold text-sm transition-all peer-checked:bg-blue-600 peer-checked:text-white peer-checked:shadow-sm text-gray-400 hover:text-gray-600">
                    Inactive
                  </div>
                </label>
              </div>
            </div>

          </div>
        </div>

        <!-- THUMBNAIL CARD -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm mb-8">
          <div class="flex items-center space-x-3 mb-8">
            <div class="p-2 bg-orange-50 text-orange-600 rounded-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-bold text-gray-900">Category Thumbnail</h2>
              <p class="text-xs text-gray-400 mt-0.5">Optional — JPG, PNG up to 5MB</p>
            </div>
          </div>

          <div
            id="thumbnailDropzone"
            class="border-2 border-dashed border-gray-200 rounded-2xl p-8 flex flex-col items-center justify-center bg-gray-50 hover:border-blue-400 hover:bg-blue-50/30 transition-all cursor-pointer">

            <div class="preview-placeholder text-center">
              <div id="thumbnailPlaceholderIcon" class="p-4 bg-blue-100/50 text-blue-600 rounded-full mb-4 inline-block">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <p id="thumbnailPlaceholderText" class="text-sm font-medium text-gray-500 mb-1">Click to upload a thumbnail image</p>
              <p id="thumbnailPlaceholderSub" class="text-xs text-gray-400 mb-4">JPG, PNG up to 5MB</p>
            </div>

            <img id="thumbnailPreview" class="hidden w-full max-h-56 object-cover rounded-xl mb-4 border" alt="Preview">

            <button type="button" onclick="document.getElementById('thumbnailInput').click()"
              class="px-6 py-2.5 bg-blue-600 text-white font-bold rounded-lg text-sm hover:bg-blue-700 transition-all shadow-md">
              Upload Image
            </button>

            <input type="file" name="thumbnail" id="thumbnailInput" class="hidden" accept="image/*" onchange="initImageCrop(this, 'thumbnailPreview', 16/9)">
          </div>
          <p id="error-thumbnail" class="input-error mt-2 <%= errors?.thumbnail ? '' : 'hidden' %>"><%= errors?.thumbnail || '' %></p>
        </div>

        <!-- FOOTER ACTIONS -->
        <div class="flex items-center justify-between pt-2">
          <a href="/admin/categories"
            class="flex items-center text-gray-500 font-bold hover:text-gray-800 transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
            </svg>
            Cancel
          </a>
          <button type="submit"
            class="inline-flex items-center px-8 py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-lg">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Create Category
          </button>
        </div>

      </form>
    </div>
  </div>
</main>

<style>
  .input-error {
    color: #EF4444 !important;
    font-size: 13px;
    font-weight: 500;
    margin-top: 6px;
    display: block;
  }
</style>

<script>
  document.getElementById('addCategoryForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    
    // Add cropped image if available
    const cropper = window.croppers && window.croppers['thumbnailPreview'];
    if (cropper) {
      const blob = await new Promise(resolve => cropper.getCroppedCanvas().toBlob(resolve, 'image/jpeg'));
      if (blob) formData.set('thumbnail', blob, 'thumbnail.jpg');
    }

    // Clear previous errors
    ['name', 'description', 'thumbnail'].forEach(field => {
      const errorEl = document.getElementById(`error-${field}`);
      if (errorEl) {
        errorEl.innerText = '';
        errorEl.classList.add('hidden');
      }
    });

    try {
      const response = await fetch('/api/v1/admin/categories', {
        method: 'POST',
        body: formData
      });
      const data = await response.json();
      if (data.success) {
        Swal.fire({ title: 'Success', text: data.message, icon: 'success' }).then(() => {
          window.location.href = '/admin/categories';
        });
      } else {
        if (data.errors) {
          let hasInlineError = false;
          for (const field in data.errors) {
            const errorEl = document.getElementById(`error-${field}`);
            if (errorEl) {
              errorEl.innerText = data.errors[field];
              errorEl.classList.remove('hidden');
              hasInlineError = true;
            }
          }
          if (!hasInlineError) {
            Swal.fire({ icon: 'error', title: 'Error', text: data.message || 'Validation failed' });
          }
        } else {
          Swal.fire('Error', data.message || 'Validation failed', 'error');
        }
      }
    } catch (err) {
      console.error(err);
      Swal.fire('Error', 'An unexpected error occurred', 'error');
    }
  });
</script>
<%- include('../../../partials/cropper-modal') %>
<%- include('../../../partials/footer') %>

