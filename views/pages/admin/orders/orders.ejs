<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">
    
    <!-- SIDEBAR -->
    <%- include('../../../partials/admin-sidebar', { activePage: 'orders' }) %>
    
    <!-- MAIN CONTENT -->
    <div class="flex-1 flex flex-col h-screen overflow-y-auto">
        
        <!-- TOP NAVIGATION -->
        <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search orders...' }) %>

        <div class="p-8 max-w-7xl mx-auto w-full">
            <!-- Page Header -->
            <div class="flex justify-between items-start mb-8">
                <div>
                    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">Orders & Transactions</h1>
                    <p class="text-gray-500 font-medium">Monitor your platform's revenue stream and student enrollments in real-time.</p>
                </div>
                <button class="bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 font-bold py-2.5 px-6 rounded-xl flex items-center transition-colors shadow-sm text-sm">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    Export to CSV
                </button>
            </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <!-- Total Revenue -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="flex justify-between items-start mb-4">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    </div>
                   
                </div>
                <h3 class="text-gray-500 text-sm font-bold mb-1 uppercase tracking-wider">Total Revenue</h3>
                <p class="text-3xl font-black text-gray-900">₹<%= stats.totalRevenue %></p>
            </div>

            <!-- Monthly Orders -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="flex justify-between items-start mb-4">
                    <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-500 flex items-center justify-center">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    </div>
                    
                </div>
                <h3 class="text-gray-500 text-sm font-bold mb-1 uppercase tracking-wider">Monthly Orders</h3>
                <p class="text-3xl font-black text-gray-900"><%= stats.monthlyOrders.toLocaleString() %></p>
            </div>

            <!-- Avg Order Value -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="flex justify-between items-start mb-4">
                    <div class="w-12 h-12 rounded-xl bg-orange-50 text-orange-500 flex items-center justify-center">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                    </div>
                    
                </div>
                <h3 class="text-gray-500 text-sm font-bold mb-1 uppercase tracking-wider">Avg. Order Value</h3>
                <p class="text-3xl font-black text-gray-900">₹<%= stats.avgOrderValue %></p>
            </div>
        </div>

        <!-- Tabs Container -->
        <div class="flex space-x-4 mb-6">
            <button id="tab-orders" onclick="switchTab('orders')" class="px-6 py-3 rounded-xl font-bold text-sm bg-blue-600 text-white shadow-sm transition-all border border-blue-600">All Orders</button>
            <button id="tab-refunds" onclick="switchTab('refunds')" class="px-6 py-3 rounded-xl font-bold text-sm bg-white text-gray-600 hover:text-blue-600 hover:bg-blue-50 border border-gray-200 transition-all shadow-sm">Refund Requests</button>
        </div>

        <div id="allOrdersView">
          <!-- Table Container -->
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-8">
              <!-- Table Controls -->
            <div class="p-6 border-b border-gray-100 flex flex-wrap justify-between items-center gap-4">
                <div class="flex items-center space-x-2 bg-gray-50 p-1 rounded-xl border border-gray-100">
                    <button class="px-4 py-2 rounded-lg bg-white shadow-sm text-sm font-bold text-blue-600">This Week</button>
                    <button class="px-4 py-2 rounded-lg hover:bg-gray-100 text-sm font-bold text-gray-500 transition-colors">This Month</button>
                    <button class="px-4 py-2 rounded-lg hover:bg-gray-100 text-sm font-bold text-gray-500 transition-colors">Custom</button>
                </div>
                
                <div class="flex items-center space-x-3">
                    <div class="relative">
                        <select id="sortFilter" onchange="applyFilters()" class="appearance-none bg-gray-50 border border-gray-200 text-gray-700 py-2.5 pl-4 pr-10 rounded-xl text-sm font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer">
                            <option value="newest" <%= sortBy === 'newest' ? 'selected' : '' %>>Newest First</option>
                            <option value="oldest" <%= sortBy === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                            <option value="amount_desc" <%= sortBy === 'amount_desc' ? 'selected' : '' %>>Amount (High to Low)</option>
                            <option value="amount_asc" <%= sortBy === 'amount_asc' ? 'selected' : '' %>>Amount (Low to High)</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-500">
                            <svg class="fill-current h-4 w-4" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
                        </div>
                    </div>
                    <div class="relative">
                        <select id="statusFilter" onchange="applyFilters()" class="appearance-none bg-gray-50 border border-gray-200 text-gray-700 py-2.5 pl-4 pr-10 rounded-xl text-sm font-bold focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer">
                            <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>All Statuses</option>
                            <option value="paid" <%= statusFilter === 'paid' ? 'selected' : '' %>>Paid</option>
                            <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="failed" <%= statusFilter === 'failed' ? 'selected' : '' %>>Failed</option>
                            <option value="cancelled" <%= statusFilter === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-500">
                            <svg class="fill-current h-4 w-4" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
                        </div>
                    </div>
                    <button class="bg-[#0B5ED7] hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl flex items-center transition-colors shadow-sm text-sm">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Export to CSV
                    </button>
                </div>
            </div>

            <script>
                function applyFilters() {
                    const status = document.getElementById('statusFilter').value;
                    const sort = document.getElementById('sortFilter').value;
                    const search = '<%= typeof search !== "undefined" ? search : "" %>';
                    let url = '/admin/orders?page=1';
                    if (status && status !== 'all') url += '&status=' + status;
                    if (sort && sort !== 'newest') url += '&sortBy=' + sort;
                    if (search) url += '&search=' + encodeURIComponent(search);
                    window.location.href = url;
                }
            </script>

            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50">
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Order ID</th>
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Customer Name</th>
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Course Purchased</th>
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Amount</th>
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Date</th>
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Status</th>
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        <% if (orders && orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="font-bold text-[#0B5ED7]"><%= order.orderId || '#VL-' + (order.razorpayOrderId ? order.razorpayOrderId.substring(10,14).toUpperCase() : order._id.toString().substring(20,24).toUpperCase()) %></span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="flex-shrink-0 h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-xs overflow-hidden">
                                                <% if (order.userId && order.userId.avatar) { %>
                                                    <img src="<%= order.userId.avatar %>" alt="avatar" class="h-full w-full object-cover">
                                                <% } else { %>
                                                    <%= order.userId ? order.userId.name.charAt(0) : 'U' %>
                                                <% } %>
                                            </div>
                                            <div class="ml-3">
                                                <p class="text-sm font-bold text-gray-900"><%= order.userId ? order.userId.name : 'Unknown User' %></p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <p class="text-sm font-bold text-gray-800 line-clamp-2 max-w-xs"><%= order.courses && order.courses.length > 0 ? order.courses[0].title : 'Unknown Course' %></p>
                                        <% if (order.courses && order.courses.length > 1) { %>
                                            <p class="text-xs text-gray-400 font-medium">+<%= order.courses.length - 1 %> more</p>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="text-sm font-bold text-gray-900">₹<%= order.finalAmount.toFixed(2) %></span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-gray-600">
                                            <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <% if (order.paymentStatus === 'paid') { %>
                                            <span class="px-3 py-1 inline-flex text-xs leading-5 font-bold rounded-full bg-green-100 text-green-700 items-center gap-1.5 border border-green-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                                Paid
                                            </span>
                                        <% } else if (order.paymentStatus === 'pending') { %>
                                            <span class="px-3 py-1 inline-flex text-xs leading-5 font-bold rounded-full bg-yellow-100 text-yellow-700 items-center gap-1.5 border border-yellow-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>
                                                Pending
                                            </span>
                                        <% } else if (order.paymentStatus === 'cancelled') { %>
                                            <span class="px-3 py-1 inline-flex text-xs leading-5 font-bold rounded-full bg-gray-100 text-gray-600 items-center gap-1.5 border border-gray-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-gray-500"></span>
                                                Cancelled
                                            </span>
                                        <% } else if (order.paymentStatus === 'refunded') { %>
                                            <span class="px-3 py-1 inline-flex text-xs leading-5 font-bold rounded-full bg-blue-100 text-blue-700 items-center gap-1.5 border border-blue-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                                Refunded
                                            </span>
                                        <% } else { %>
                                            <span class="px-3 py-1 inline-flex text-xs leading-5 font-bold rounded-full bg-red-50 text-red-600 items-center gap-1.5 border border-red-100">
                                                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                                Failed
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right space-x-2">
                                        <% if (order.paymentStatus === 'pending') { %>
                                            <button onclick="cancelPendingOrder('<%= order._id %>')" class="text-red-600 hover:text-red-900 font-bold text-sm bg-red-50 hover:bg-red-100 px-4 py-2 rounded-lg transition-colors inline-block">
                                                Cancel
                                            </button>
                                        <% } %>
                                        <a href="/admin/orders/<%= order._id %>" class="text-blue-600 hover:text-blue-900 font-bold text-sm bg-blue-50 hover:bg-blue-100 px-4 py-2 rounded-lg transition-colors inline-block">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="px-6 py-12 text-center text-gray-500 font-medium">
                                    No orders found.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="px-6 py-4 border-t border-gray-100 bg-gray-50/30 flex items-center justify-between rounded-b-2xl">
                <span class="text-sm text-gray-500 font-medium">Showing <%= totalOrders === 0 ? 0 : Math.min((currentPage - 1) * 5 + 1, totalOrders) %> to <%= Math.min(currentPage * 5, totalOrders) %> of <%= totalOrders.toLocaleString() %> orders</span>
                
                <div class="flex items-center space-x-2">
                  <% const buildOrderQuery = (p) => {
                    const qs = new URLSearchParams();
                    if (search) qs.set('search', search);
                    if (statusFilter && statusFilter !== 'all') qs.set('status', statusFilter);
                    if (typeof sortBy !== 'undefined' && sortBy !== 'newest') qs.set('sortBy', sortBy);
                    qs.set('page', p);
                    return '/admin/orders?' + qs.toString();
                  }; %>
                  
                  <% if(currentPage > 1){ %>
                    <a href="<%= buildOrderQuery(currentPage - 1) %>" class="px-3 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                      Previous
                    </a>
                  <% } else { %>
                    <span class="px-3 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-400 bg-gray-50 cursor-not-allowed">
                      Previous
                    </span>
                  <% } %>
                  
                  <% for(let i = Math.max(1, currentPage - 1); i <= Math.min(totalPages || 1, currentPage + 1); i++){ %>
                    <a href="<%= buildOrderQuery(i) %>"
                      class="w-9 h-9 flex items-center justify-center rounded-full text-sm font-semibold transition-colors
                      <%= currentPage === i ? 'bg-blue-600 text-white shadow-sm' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50' %>">
                      <%= i %>
                    </a>
                  <% } %>

                  <% if(currentPage < totalPages){ %>
                    <a href="<%= buildOrderQuery(currentPage + 1) %>" class="px-3 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                      Next
                    </a>
                  <% } else { %>
                    <span class="px-3 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-400 bg-gray-50 cursor-not-allowed">
                      Next
                    </span>
                  <% } %>
                </div>
            </div>
        </div>
        </div>

        <!-- Refund Requests View -->
        <div id="refundsView" class="hidden">
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-8">
            <!-- Table Controls for Refunds -->
            <div class="p-6 border-b border-gray-100 flex flex-wrap justify-between items-center gap-4">
                <h3 class="text-lg font-bold text-gray-900">Pending Refund Requests</h3>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50">
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Order ID</th>
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Customer Name</th>
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Request Date</th>
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100">Reason</th>
                            <th class="px-6 py-4 text-xs font-extrabold text-gray-500 uppercase tracking-wider border-b border-gray-100 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        <% const pendingRefunds = orders ? orders.filter(o => o.refundStatus === 'pending') : []; %>
                        <% if (pendingRefunds.length > 0) { %>
                            <% pendingRefunds.forEach(order => { %>
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="font-bold text-[#0B5ED7]">
                                            <%= order.orderId || '#VL-' + (order.razorpayOrderId ? order.razorpayOrderId.substring(10,14).toUpperCase() : order._id.toString().substring(20,24).toUpperCase()) %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="font-bold text-gray-900 text-sm"><%= order.userId ? order.userId.name : 'Unknown User' %></div>
                                        <div class="text-xs text-gray-500 font-medium"><%= order.userId ? order.userId.email : '' %></div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                        <%= order.refundRequestedAt ? new Date(order.refundRequestedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A' %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-normal text-sm text-gray-700 italic max-w-xs">
                                        <%= order.refundReason || 'No reason provided.' %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-right space-x-2">
                                        <button onclick="approveRefund('<%= order._id %>')" class="text-green-600 hover:text-green-800 font-bold border border-green-200 bg-green-50 px-3 py-1.5 rounded-lg transition-colors">Approve</button>
                                        <button onclick="rejectRefund('<%= order._id %>')" class="text-red-600 hover:text-red-800 font-bold border border-red-200 bg-red-50 px-3 py-1.5 rounded-lg transition-colors">Reject</button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center text-gray-500 font-medium">
                                    No pending refund requests found on this page.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
          </div>
        </div>


        <script>
            function switchTab(tab) {
                const btnOrders = document.getElementById('tab-orders');
                const btnRefunds = document.getElementById('tab-refunds');
                const viewOrders = document.getElementById('allOrdersView');
                const viewRefunds = document.getElementById('refundsView');
                
                if(tab === 'orders') {
                    btnOrders.className = 'px-6 py-3 rounded-xl font-bold text-sm bg-blue-600 text-white shadow-sm transition-all border border-blue-600';
                    btnRefunds.className = 'px-6 py-3 rounded-xl font-bold text-sm bg-white text-gray-600 hover:text-blue-600 hover:bg-blue-50 border border-gray-200 transition-all shadow-sm';
                    viewOrders.classList.remove('hidden');
                    viewRefunds.classList.add('hidden');
                } else {
                    btnRefunds.className = 'px-6 py-3 rounded-xl font-bold text-sm bg-blue-600 text-white shadow-sm transition-all border border-blue-600';
                    btnOrders.className = 'px-6 py-3 rounded-xl font-bold text-sm bg-white text-gray-600 hover:text-blue-600 hover:bg-blue-50 border border-gray-200 transition-all shadow-sm';
                    viewRefunds.classList.remove('hidden');
                    viewOrders.classList.add('hidden');
                }
            }


            function approveRefund(orderId) {
                if (typeof window.openConfirmModal === 'function') {
                    window.openConfirmModal({
                        title: 'Approve Refund',
                        message: 'Are you sure you want to approve this refund? The amount will be credited to the user\'s wallet.',
                        confirmText: 'Approve',
                        confirmColor: 'blue',
                        onConfirm: async () => {
                            try {
                                const response = await fetch(`/api/v1/admin/orders/${orderId}/refund/approve`, {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json"
                                    }
                                });
                                const data = await response.json();
                                if (data.success) {
                                    window.location.reload();
                                } else {
                                    Swal.fire({ text: data.message || "Failed to approve refund", icon: "error" });
                                }
                            } catch (error) {
                                console.error("Error approving refund:", error);
                                Swal.fire({ text: "Something went wrong.", icon: "error" });
                            }
                        }
                    });
                }
            }

            function rejectRefund(orderId) {
                if (typeof window.openConfirmModal === 'function') {
                    window.openConfirmModal({
                        title: 'Reject Refund',
                        message: 'Are you sure you want to reject this refund request?',
                        confirmText: 'Reject',
                        confirmColor: 'red',
                        onConfirm: async () => {
                            try {
                                const response = await fetch(`/api/v1/admin/orders/${orderId}/refund/reject`, {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json"
                                    }
                                });
                                const data = await response.json();
                                if (data.success) {
                                    window.location.reload();
                                } else {
                                    Swal.fire({ text: data.message || "Failed to reject refund", icon: "error" });
                                }
                            } catch (error) {
                                console.error("Error rejecting refund:", error);
                                Swal.fire({ text: "Something went wrong.", icon: "error" });
                            }
                        }
                    });
                }
            }

            function cancelPendingOrder(orderId) {
                if (typeof window.openConfirmModal === 'function') {
                    window.openConfirmModal({
                        title: 'Cancel Pending Order',
                        message: 'Are you sure you want to cancel this pending order? This action will block any future payment attempts for this order ID.',
                        confirmText: 'Yes, Cancel Order',
                        confirmColor: 'red',
                        onConfirm: async () => {
                            try {
                                const response = await fetch(`/api/v1/admin/orders/${orderId}/cancel`, {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json"
                                    },
                                    body: JSON.stringify({ reason: "Cancelled by admin via dashboard" })
                                });
                                const data = await response.json();
                                if (data.success) {
                                    window.location.reload();
                                } else {
                                    Swal.fire({ text: data.message || "Failed to cancel order", icon: "error" });
                                }
                            } catch (error) {
                                console.error("Error cancelling order:", error);
                                Swal.fire({ text: "Something went wrong.", icon: "error" });
                            }
                        }
                    });
                } else {
                    // Fallback to SweetAlert if confirm modal isn't loaded
                    Swal.fire({
                        title: 'Cancel Order?',
                        text: "Are you sure you want to cancel this pending order?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, cancel it'
                    }).then(async (result) => {
                        if (result.isConfirmed) {
                            try {
                                const response = await fetch(`/api/v1/admin/orders/${orderId}/cancel`, {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json"
                                    },
                                    body: JSON.stringify({ reason: "Cancelled by admin via dashboard" })
                                });
                                const data = await response.json();
                                if (data.success) {
                                    window.location.reload();
                                } else {
                                    Swal.fire({ text: data.message || "Failed to cancel order", icon: "error" });
                                }
                            } catch (error) {
                                console.error("Error cancelling order:", error);
                                Swal.fire({ text: "Something went wrong.", icon: "error" });
                            }
                        }
                    });
                }
            }
        </script>
        <%- include('../../../partials/confirm-modal') %>

</main>
