<%- include('../../../partials/header') %>

<main class="flex min-h-screen bg-gray-50 font-sans">
    
    <!-- SIDEBAR -->
    <%- include('../../../partials/admin-sidebar', { activePage: 'orders' }) %>
    
    <!-- MAIN CONTENT -->
    <div class="flex-1 flex flex-col h-screen overflow-y-auto">
        
        <!-- TOP NAVIGATION -->
        <%- include('../../../partials/admin-header', { searchPlaceholder: 'Search orders...' }) %>

        <div class="p-8 max-w-5xl mx-auto w-full">
            
            <!-- Breadcrumb & Header -->
            <div class="mb-6">
                <a href="/admin/orders" class="text-sm font-bold text-gray-500 hover:text-blue-600 flex items-center mb-4 transition-colors w-max">
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Back to Orders
                </a>
                <div class="flex justify-between items-end">
                    <div>
                        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Order Details</h1>
                        <p class="text-gray-500 font-medium mt-1">Transaction <span class="text-blue-600 font-bold"><%= order.orderId || ('#VL-' + (order.razorpayOrderId ? order.razorpayOrderId.substring(10,14).toUpperCase() : order._id.toString().substring(20,24).toUpperCase())) %></span> • <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
                    </div>
                    <div class="flex items-center space-x-3">
                        <select id="updateStatusSelect" class="bg-white border border-gray-200 text-gray-700 text-sm font-bold rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5">
                            <option value="pending" <%= order.paymentStatus === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="paid" <%= order.paymentStatus === 'paid' ? 'selected' : '' %>>Paid</option>
                            <option value="failed" <%= order.paymentStatus === 'failed' ? 'selected' : '' %>>Failed</option>
                            <option value="cancelled" <%= order.paymentStatus === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                            <option value="refunded" <%= order.paymentStatus === 'refunded' ? 'selected' : '' %>>Refunded</option>
                        </select>
                        <button onclick="updateOrderStatus('<%= order._id %>')" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition-colors text-sm shadow-sm">
                            Update
                        </button>
                    </div>
                </div>
                
                <!-- Refund Request Info -->
                <% if (order.refundStatus === 'pending') { %>
                <div class="mt-4 p-4 bg-yellow-50 border border-yellow-200 rounded-xl flex justify-between items-center">
                    <div>
                        <h4 class="text-sm font-bold text-yellow-800">Pending Refund Request</h4>
                        <p class="text-xs text-yellow-700 mt-1">Reason: <%= order.refundReason || 'No reason provided.' %></p>
                    </div>
                    <div class="flex space-x-2">
                        <button onclick="approveRefund('<%= order._id %>')" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition-colors text-sm shadow-sm">Approve Refund</button>
                        <button onclick="rejectRefund('<%= order._id %>')" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg transition-colors text-sm shadow-sm">Reject Refund</button>
                    </div>
                </div>
                <% } else if (order.refundStatus) { %>
                <div class="mt-4 p-4 bg-gray-50 border border-gray-200 rounded-xl flex justify-between items-center">
                    <div>
                        <h4 class="text-sm font-bold text-gray-800">Refund Status: <span class="uppercase <%= order.refundStatus === 'approved' ? 'text-green-600' : 'text-red-600' %>"><%= order.refundStatus %></span></h4>
                        <p class="text-xs text-gray-500 mt-1">Reason: <%= order.refundReason || 'No reason provided.' %></p>
                    </div>
                </div>
                <% } %>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Left Column (Courses Focus) -->
                <div class="lg:col-span-2 space-y-8">

                    <!-- Purchased Course -->
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
                            <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                            Purchased Course
                        </h3>
                        
                        <div class="space-y-4">
                            <% if (order.courses && order.courses.length > 0) { %>
                                <% order.courses.forEach(course => { %>
                                    <div class="flex items-center p-4 bg-gray-50 rounded-xl border border-gray-100 group hover:border-blue-100 transition-colors">
                                        <div class="w-24 h-16 rounded-lg bg-gray-200 overflow-hidden flex-shrink-0 relative">
                                            <% if (course.thumbnail) { %>
                                                <img src="<%= course.thumbnail %>" class="w-full h-full object-cover">
                                            <% } else { %>
                                                <div class="w-full h-full bg-blue-100"></div>
                                            <% } %>
                                            <% if (course.level) { %>
                                                <span class="absolute top-1 left-1 text-[8px] font-bold text-white px-1.5 py-0.5 rounded bg-black/60 uppercase"><%= course.level %></span>
                                            <% } %>
                                        </div>
                                        <div class="ml-4 flex-1">
                                            <h4 class="text-sm font-bold text-gray-900 group-hover:text-blue-600 transition-colors line-clamp-1"><%= course.title %></h4>
                                            <p class="text-xs text-gray-500 font-medium mt-1">Course ID: <%= course._id.toString().substring(0,8) %></p>
                                        </div>
                                        <div class="text-right">
                                            <% if (course.discountPrice && course.discountPrice < course.basePrice) { %>
                                                <p class="text-sm font-bold text-gray-900">₹<%= course.discountPrice %></p>
                                                <p class="text-xs font-bold text-gray-400 line-through">₹<%= course.basePrice %></p>
                                            <% } else { %>
                                                <p class="text-sm font-bold text-gray-900">₹<%= course.basePrice || 0 %></p>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-sm text-gray-500 font-medium italic">No courses found in this order.</p>
                            <% } %>
                        </div>
                    </div>

                    <!-- Customer Information -->
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
                            <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            Customer Information
                        </h3>
                        <div class="flex items-center p-4 bg-gray-50 rounded-xl border border-gray-100">
                            <div class="h-12 w-12 rounded-full overflow-hidden bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-lg flex-shrink-0">
                                <% if (order.userId && order.userId.avatar) { %>
                                    <img src="<%= order.userId.avatar %>" alt="avatar" class="h-full w-full object-cover">
                                <% } else { %>
                                    <%= order.userId ? order.userId.name.charAt(0) : 'U' %>
                                <% } %>
                            </div>
                            <div class="ml-4 flex-1">
                                <h4 class="text-base font-bold text-gray-900"><%= order.userId ? order.userId.name : 'Unknown User' %></h4>
                                <div class="flex items-center text-sm text-gray-500 mt-1 space-x-4">
                                    <span class="flex items-center font-medium">
                                        <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                        <%= order.userId ? order.userId.email : 'N/A' %>
                                    </span>
                                    <% if (order.userId && order.userId.phone) { %>
                                        <span class="flex items-center font-medium">
                                            <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                            <%= order.userId.phone %>
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Right Column (Summary & Payment) -->
                <div class="space-y-8">
                    
                    <!-- Order Summary -->
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                        <h3 class="text-lg font-bold text-gray-900 mb-6 flex items-center">
                            <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            Payment Summary
                        </h3>
                        
                        <div class="space-y-4">
                            <div class="flex justify-between items-center text-sm">
                                <span class="font-medium text-gray-600">Subtotal</span>
                                <span class="font-bold text-gray-900">₹<%= (order.subtotal || 0).toFixed(2) %></span>
                            </div>
                            
                            <% if (order.courseDiscount > 0) { %>
                                <div class="flex justify-between items-center text-sm">
                                    <span class="font-medium text-gray-600">Course Discount</span>
                                    <span class="font-bold text-green-600">-₹<%= order.courseDiscount.toFixed(2) %></span>
                                </div>
                            <% } %>
                            
                            <% if (order.couponDiscount > 0) { %>
                                <div class="flex justify-between items-center text-sm">
                                    <span class="font-medium text-gray-600 flex items-center">
                                        Coupon Applied
                                        <% if (order.couponId && order.couponId.code) { %>
                                            <span class="ml-2 text-[10px] font-bold bg-blue-50 text-blue-600 px-2 py-0.5 rounded border border-blue-100 uppercase tracking-wider"><%= order.couponId.code %></span>
                                        <% } %>
                                    </span>
                                    <span class="font-bold text-green-600">-₹<%= order.couponDiscount.toFixed(2) %></span>
                                </div>
                            <% } %>
                        </div>
                        
                        <div class="border-t border-gray-100 mt-6 pt-6 space-y-4">
                            <% 
                               let taxableAmt = (order.subtotal || 0) - (order.courseDiscount || 0) - (order.couponDiscount || 0);
                               let gstAmt = taxableAmt * 0.18;
                            %>
                            <!-- GST Breakdown -->
                            <div class="flex justify-between items-center text-sm">
                                <span class="font-medium text-gray-600">Taxable Amount</span>
                                <span class="font-bold text-gray-900">₹<%= taxableAmt.toFixed(2) %></span>
                            </div>
                            <div class="flex justify-between items-center text-sm">
                                <span class="font-medium text-gray-600">GST (18%)</span>
                                <span class="font-bold text-gray-900">₹<%= gstAmt.toFixed(2) %></span>
                            </div>

                            <div class="flex justify-between items-center pt-2 border-t border-gray-50">
                                <span class="font-bold text-gray-900 text-lg">Total Amount</span>
                                <span class="font-black text-blue-600 text-2xl">₹<%= (order.finalAmount || 0).toFixed(2) %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Transaction Details -->
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
                            <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                            Transaction Details
                        </h3>
                        
                        <ul class="space-y-4">
                            <li class="flex flex-col">
                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Razorpay Order ID</span>
                                <span class="text-sm font-bold text-gray-900 break-all bg-gray-50 p-2 rounded-lg border border-gray-100 font-mono"><%= order.razorpayOrderId || 'N/A' %></span>
                            </li>
                            <li class="flex flex-col">
                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Razorpay Payment ID</span>
                                <span class="text-sm font-bold text-gray-900 break-all bg-gray-50 p-2 rounded-lg border border-gray-100 font-mono"><%= order.razorpayPaymentId || 'N/A' %></span>
                            </li>
                            <li class="flex flex-col">
                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Database Record ID</span>
                                <span class="text-sm font-bold text-gray-500 break-all font-mono"><%= order._id %></span>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>

        </div>

    </div>
</main>

<script>
    const currentStatus = '<%= order.paymentStatus %>';
    
    function updateOrderStatus(orderId) {
        const btn = event.currentTarget;
        const status = document.getElementById('updateStatusSelect').value;
        
        if (['cancelled', 'refunded'].includes(currentStatus)) {
            if (typeof window.openConfirmModal === 'function') {
                window.openConfirmModal({
                    title: 'Action Prevented',
                    message: 'This order is in a terminal state and its status cannot be changed.',
                    confirmText: 'Okay',
                    confirmColor: 'red',
                    onConfirm: () => {}
                });
            } else {
                Swal.fire({ text: 'This order is in a terminal state and its status cannot be changed.', icon: 'warning' });
            }
            return;
        }

        if (status === currentStatus) return; // No change
        
        let message = 'Are you sure you want to change this order status?';
        let confirmText = 'Update';
        let confirmColor = 'blue';

        if (status === 'paid') {
            message = 'Are you sure you want to mark this order as Paid?';
        } else if (status === 'cancelled') {
            message = 'Are you sure you want to cancel this order? This action cannot be easily reversed.';
            confirmText = 'Cancel Order';
            confirmColor = 'red';
        } else if (status === 'refunded') {
            message = 'Are you sure you want to mark this order as Refunded?';
            confirmText = 'Refund Order';
            confirmColor = 'red';
        } else if (status === 'failed') {
            message = 'Are you sure you want to mark this order as Failed?';
            confirmText = 'Mark as Failed';
            confirmColor = 'red';
        }

        if (typeof window.openConfirmModal === 'function') {
            window.openConfirmModal({
                title: 'Update Order Status',
                message: message,
                confirmText: confirmText,
                confirmColor: confirmColor,
                onConfirm: () => executeStatusUpdate(orderId, status, btn)
            });
        } else {
            if (confirm(message)) {
                executeStatusUpdate(orderId, status, btn);
            }
        }
    }

    async function executeStatusUpdate(orderId, status, btn) {
        const originalText = btn.innerText;
        btn.innerText = 'Updating...';
        btn.disabled = true;

        try {
            const response = await fetch(`/api/v1/admin/orders/${orderId}/status`, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ status })
            });

            const data = await response.json();
            
            if (data.success) {
                window.location.reload();
            } else {
                Swal.fire({ text: data.message || 'Failed to update order status', icon: 'error' });
                btn.innerText = originalText;
                btn.disabled = false;
            }
        } catch (error) {
            console.error('Error updating order status:', error);
            Swal.fire({ text: 'Something went wrong', icon: 'error' });
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    function approveRefund(orderId) {
        if (typeof window.openConfirmModal === 'function') {
            window.openConfirmModal({
                title: 'Approve Refund',
                message: 'Are you sure you want to approve this refund? The amount will be credited to the user\'s wallet.',
                confirmText: 'Approve',
                confirmColor: 'blue',
                onConfirm: async () => {
                    try {
                        const response = await fetch(`/api/v1/admin/orders/${orderId}/refund/approve`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" }
                        });
                        const data = await response.json();
                        if (data.success) {
                            window.location.reload();
                        } else {
                            Swal.fire({ text: data.message || "Failed to approve refund", icon: "error" });
                        }
                    } catch (error) {
                        console.error("Error approving refund:", error);
                        Swal.fire({ text: "Something went wrong.", icon: "error" });
                    }
                }
            });
        }
    }

    function rejectRefund(orderId) {
        if (typeof window.openConfirmModal === 'function') {
            window.openConfirmModal({
                title: 'Reject Refund',
                message: 'Are you sure you want to reject this refund request?',
                confirmText: 'Reject',
                confirmColor: 'red',
                onConfirm: async () => {
                    try {
                        const response = await fetch(`/api/v1/admin/orders/${orderId}/refund/reject`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" }
                        });
                        const data = await response.json();
                        if (data.success) {
                            window.location.reload();
                        } else {
                            Swal.fire({ text: data.message || "Failed to reject refund", icon: "error" });
                        }
                    } catch (error) {
                        console.error("Error rejecting refund:", error);
                        Swal.fire({ text: "Something went wrong.", icon: "error" });
                    }
                }
            });
        }
    }
</script>

<%- include('../../../partials/confirm-modal') %>
<%- include('../../../partials/footer') %>
