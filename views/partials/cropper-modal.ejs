<!-- Cropper.js CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />

<!-- Cropper Modal -->
<div id="cropperModal" class="hidden flex items-center justify-center" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 99999; background-color: rgba(0, 0, 0, 0.75);">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl flex flex-col max-h-[90vh] mx-4">
    <!-- Header -->
    <div class="px-6 py-4 border-b flex justify-between items-center bg-gray-50 rounded-t-2xl">
      <h3 class="text-xl font-bold text-gray-900">Crop Image</h3>
      <button type="button" id="cropperCancelBtn" class="text-gray-400 hover:text-gray-600 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <!-- Body -->
    <div class="p-6 overflow-hidden flex-1 flex justify-center items-center bg-gray-100 min-h-[400px]">
      <div class="w-full h-full max-h-[60vh] flex justify-center">
        <img id="cropperImage" src="" alt="Image to crop" class="max-w-full max-h-[60vh] object-contain">
      </div>
    </div>
    <!-- Footer -->
    <div class="px-6 py-4 border-t flex justify-end gap-3 bg-gray-50 rounded-b-2xl">
      <button type="button" id="cropperCancelBtn2" class="px-5 py-2.5 bg-gray-200 text-gray-800 rounded-xl font-bold hover:bg-gray-300 transition-colors">Cancel</button>
      <button type="button" id="cropperCropBtn" class="px-6 py-2.5 bg-blue-600 text-white rounded-xl font-bold hover:bg-blue-700 transition-colors flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        Confirm Crop
      </button>
    </div>
  </div>
</div>

<!-- Cropper.js JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
<script src="/js/image-cropper.js"></script>
