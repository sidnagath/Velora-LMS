<aside class="w-64 bg-white border-r flex flex-col hidden md:flex min-h-screen">
  <div class="p-6 pb-8">
    <h1 class="text-2xl font-bold text-blue-600 tracking-tight">Velora Admin</h1>
  </div>

  <div class="px-6 flex items-center space-x-3 mb-8">
    <img src="https://i.pravatar.cc/150?u=admin" alt="Velora Admin" class="w-10 h-10 rounded-full border">
    <div>
      <p class="text-sm font-semibold text-gray-900">Velora Admin</p>
      <p class="text-xs text-gray-500">System Controller</p>
    </div>
  </div>

  <nav class="flex-1 space-y-1 text-sm font-medium">
    <a href="/admin/dashboard" class="flex items-center px-6 py-3 transition-colors <%= activePage === 'dashboard' ? 'text-blue-600 bg-blue-50 relative group rounded-r-full mr-4' : 'text-gray-600 hover:text-blue-600 hover:bg-gray-50' %>">
      <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
      </svg>
      Dashboard
      <% if (activePage === 'dashboard') { %>
        <span class="absolute inset-y-0 right-0 w-1 bg-blue-600 rounded-l-md hidden"></span>
      <% } %>
    </a>
    <a href="/admin/categories" class="flex items-center px-6 py-3 transition-colors <%= activePage === 'categories' ? 'text-blue-600 bg-blue-50 relative group rounded-r-full mr-4' : 'text-gray-600 hover:text-blue-600 hover:bg-gray-50' %>">
