<script>
  // Handle browser back-forward cache
  window.addEventListener("pageshow", function (event) {

    if (
      event.persisted ||
      (window.performance &&
       window.performance.navigation.type === 2)
    ) {

      // Force full reload from server
      window.location.href = window.location.href;

    }

  });

  // Password toggle functionality
  document.addEventListener('click', function (e) {
    const toggleBtn = e.target.closest('.toggle-password');
    if (toggleBtn) {
      const input = toggleBtn.parentElement.querySelector('input');
      if (input) {
        const isPassword = input.getAttribute('type') === 'password';
        input.setAttribute('type', isPassword ? 'text' : 'password');
        
        // Toggle icon path
        const svg = toggleBtn.querySelector('svg');
        if (svg) {
          if (isPassword) {
            // Change to Eye-off icon
            svg.innerHTML = `
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
            `;
          } else {
            // Change to Eye icon
            svg.innerHTML = `
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            `;
          }
        }
      }
    }
  });

  // Global validation error clearer for all input types
  function clearValidationErrorsFor(target) {
    let current = target;
    
    // Walk up the DOM tree up to 4 levels
    for (let i = 0; i < 4; i++) {
      if (!current || current === document.body) break;
      
      let sibling = current.nextElementSibling;
      while (sibling) {
        if (sibling.matches('.input-error, .text-red-500, [style*="color: #EF4444"], [style*="color:#EF4444"]')) {
          sibling.classList.add('hidden');
          sibling.style.display = ''; // Clear any inline display
        }
        sibling = sibling.nextElementSibling;
      }
      
      current = current.parentElement;
    }

    // Remove error classes from the input itself
    if (target.classList && target.classList.contains('border-red-400')) {
      target.classList.remove('border-red-400', 'bg-red-50');
      target.classList.add('border-gray-200', 'bg-gray-50/50');
    }
  }

  function handleValidationEvent(e) {
    if (e.target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName)) {
      clearValidationErrorsFor(e.target);
    }
  }

  document.addEventListener('input', handleValidationEvent);
  document.addEventListener('change', handleValidationEvent);
</script>
</body>
