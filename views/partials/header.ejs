<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8F9FA; }
    </style>
</head>
<body>
    <!-- Navbar -->
    <% if (!title.includes('User - Profile')) { %>
    <nav class="w-full py-4 px-8 bg-[#F8F9FA] flex justify-between items-center top-0 z-50">
        <div class="flex items-center space-x-12">
            <a href="/" class="text-2xl font-bold text-[#0B5ED7]">Velora</a>
            <div class="hidden md:flex space-x-8 text-sm font-medium text-gray-600">
                <a href="#" class="<%= title.includes('Master') ? 'text-[#0B5ED7] border-b-2 border-[#0B5ED7]' : 'hover:text-[#0B5ED7]' %> pb-1">Home</a>
                <a href="#" class="hover:text-[#0B5ED7] pb-1">Courses</a>
                <% if (isLoggedIn) { %>
                    <a href="#" class="hover:text-[#0B5ED7] pb-1">Wishlist</a>
                    <a href="#" class="hover:text-[#0B5ED7] pb-1">My Courses</a>
                <% } %>
            </div>
        </div>
        
        <div class="flex items-center space-x-6">
            <!-- Search Icon -->
            <button class="text-gray-500 hover:text-[#0B5ED7]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </button>
            
            <% if (!isLoggedIn) { %>
                <a href="/login" class="<%= title.includes('Login') ? 'bg-[#0B5ED7] hover:bg-[#0A58CA] text-white py-2 px-6 rounded-md' : 'text-gray-600 hover:text-[#0B5ED7]' %> text-sm font-medium transition-colors">Login</a>
                <a href="/signup" class="<%= title.includes('Sign Up') || (!title.includes('Login') && !title.includes('Sign Up')) ? 'bg-[#0B5ED7] hover:bg-[#0A58CA] text-white py-2 px-6 rounded-md' : 'text-gray-600 hover:text-[#0B5ED7]' %> text-sm font-medium transition-colors">Signup</a>
            <% } else { %>
                <!-- Notification Bell -->
                <button class="text-gray-500 hover:text-[#0B5ED7]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                </button>
                <!-- Cart Icon -->
                <button class="text-gray-500 hover:text-[#0B5ED7]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </button>
                <!-- Avatar -->
<a
  href="/user-profile"

  class="h-8 w-8 rounded-full overflow-hidden border border-gray-300 flex items-center justify-center"
>

  <% if(user && user.avatar) { %>

    <img
      src="<%= user.avatar %>"

      alt="<%= user? user.name:"" %>"

      class="h-full w-full object-cover"
    >

  <% } else { %>

    <div
      class="h-full w-full bg-blue-100 text-blue-600 flex items-center justify-center text-xs font-bold"
    >

      <%= user.name
        .split(" ")
        .map(word => word[0])
        .join("")
        .slice(0,2)
        .toUpperCase()
      %>

    </div>

  <% } %>

</a>
               <% } %>


        </div>
    </nav>
    <% } %>
